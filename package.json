{
  "name": "tradetory-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "fetch-data": "node scripts/pipeline/collect.mjs",
    "pipeline": "node scripts/pipeline/collect.mjs && node scripts/pipeline/corp.mjs && node scripts/pipeline/dart-fs.mjs && node scripts/pipeline/trade.mjs && node scripts/pipeline/customs-fx.mjs && node scripts/pipeline/brief.mjs",
    "dart-fs": "node scripts/pipeline/dart-fs.mjs",
    "check-quality": "node scripts/check-quality.mjs",
    "audit": "node scripts/audit.mjs",
    "quality": "node scripts/quality-metrics.mjs --trend",
    "quality:save": "node scripts/quality-metrics.mjs --trend --save",
    "linkable": "node scripts/check-quality.mjs --linkable",
    "precheck": "node scripts/precheck-scheduled.mjs",
    "check-visit": "node scripts/check-visit-script.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "check-images": "node scripts/check-images.mjs",
    "series-check": "node scripts/series-check.mjs",
    "review": "node scripts/review.mjs",
    "check-bid-odds": "node scripts/check-bid-odds.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "astro": "^5.12.0",
    "pagefind": "^1.3.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
