---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';

// 승인된 소개 설계의 구성 그대로다 — 범위 → 보고서 구성 → 자료원 → 발행 → 고지.
// 결백을 주장하는 문장은 두지 않는다(CLAUDE.md 편집 규약 2).
const stat = [
  { k: '분석 보고서', v: '2', n: '수집 대상 8개사 · 순차 발행' },
  { k: '계산 도구', v: '4', n: '공공조달 · 무역 · 자금' },
  { k: '공개 지표', v: '25', n: '6개 묶음 · 기준일과 출처 병기' },
  { k: '축적 시계열', v: '45,646', n: '79개 계열의 관측치 누적' },
  { k: '용어 정의', v: '49', n: '7개 분류 · 본문에서 열람' },
];
const chapters = [
  ['1', '사업 구조', '사업부문별 매출과 원재료 구성, 생산 거점, 단가 변동 요인'],
  ['2', '매출 및 영업이익 추이', '분기 재무를 이어 붙인 구간 형태와 연도별 손익, 영업이익률'],
  ['3', '재무 건전성', '자본 구성의 변동, 부채비율·유동비율, 영업활동현금흐름'],
  ['4', '가치평가 지표', 'PBR·ROE 산출과 동일 분류 대조군과의 비교'],
  ['5', '리스크 요인 및 자본 정책', '지역별 매출 구성, 종속기업 재무, 지분 변동과 배당'],
  ['6', '향후 방향', '회사가 제시한 방향과 현재 수치의 대조, 검증 지표 및 확인 시점'],
  ['7', '반증 검토', '해당 보고서의 해석을 반박할 수 있는 설명을 세우고 검토'],
];
const sources = [
  ['금융감독원', '전자공시(DART) 정기보고서 원문 및 전체계정 재무정보', '보고서 제출 시'],
  ['한국은행', 'ECOS 경제통계 · 환율 · 금리 · 물가 · 대외 거래', '매일'],
  ['미국 연방준비제도', 'FRED 정책금리 · 국채금리 · 소비자물가 · 실업률', '매일'],
  ['금융위원회', '주식시세정보 · 종가 및 시가총액', '매일'],
  ['조달청', '나라장터 입찰공고', '매일'],
  ['관세청', '수출입실적 · 수입 과세 기준 관세환율', '주 단위 고시'],
];
---

<Base title="발행 범위와 편집 기준" description="도토리경제는 상장기업의 정기보고서를 분기 단위로 이어 분석하여 보고서로 발행하고, 공공조달·무역·자금 실무에 사용하는 계산 도구를 제공합니다." activeNav="about">
  <div class="ab-head">
    <div class="wrap">
      <div class="kick">소개</div>
      <h1 class="hd">발행 범위와 편집 기준</h1>
      <p class="lead">
        도토리경제는 상장기업의 정기보고서를 분석하여 보고서로 발행하고, 공공조달·무역·자금 실무에
        사용하는 계산 도구를 제공합니다. 분석의 배경이 되는 거시·시장 지표는 매일 갱신하여 공개합니다.
      </p>
      <div class="strip">
        {stat.map((s) => (
          <div class="strip-c">
            <div class="strip-k">{s.k}</div>
            <div class="strip-v mono">{s.v}</div>
            <div class="strip-n">{s.n}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="wrap ab-body">
    <section class="sec">
      <div class="sec-k">범위</div>
      <h2 class="hd sec-h">기업 분석 · 계산 도구 · 지표</h2>
      <p class="tx"><b>기업 분석.</b> 코스피·코스닥 상장기업의 정기보고서를 대상으로 합니다. 분기 재무를
        5~6개 사업연도에 걸쳐 이어 붙여 구성하며, 한 분기의 실적이 아니라 구간의 형태를 봅니다.</p>
      <p class="tx"><b>실무 계산 도구.</b> 공공조달 입찰공고의 참여 자격 선별, 수입 통관의 관세·부가세
        산출, 예금의 세후 실질수익 산출을 다룹니다. 산출식과 적용 전제를 화면에 표기합니다.</p>
      <p class="tx"><b>거시·시장 지표.</b> 환율·금리·물가·고용·원자재·대외 거래·증시 25종을 6개 묶음으로
        정리하여 기준일·출처와 함께 <a href={url('/numbers/')}>공개</a>합니다.</p>
    </section>

    <section class="sec">
      <div class="sec-k">보고서</div>
      <h2 class="hd sec-h">분석 보고서의 7개 장</h2>
      <p class="tx">기업마다 같은 순서를 따릅니다. 순서를 고정하는 이유는 기업 간 비교가 가능해지기 때문입니다.</p>
      <div class="tw">
        <table class="t">
          <thead><tr><th class="n">장</th><th>제목</th><th>다루는 내용</th></tr></thead>
          <tbody>
            {chapters.map(([n, t, d]) => (
              <tr><td class="n mono">{n}</td><td class="ch">{t}</td><td>{d}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tx">마지막 장을 따로 두는 이유가 있습니다. <b>7장은 해당 보고서의 해석을 반박할 수 있는
        설명을 직접 세우고 검토하는 절입니다.</b> 반론이 성립하는 부분은 성립한다고 적고, 그 검토를
        거치고도 남는 것만 결론으로 제시합니다. 6장의 검증 지표는 그 결론이 언제 어느 보고서에서
        판별되는지를 미리 지정하는 자리입니다.</p>
    </section>

    <section class="sec">
      <div class="sec-k">자료원</div>
      <h2 class="hd sec-h">6개 기관의 공개 자료</h2>
      <p class="tx">공개 API와 공시 원문에서 자료를 수집합니다. 수집은 매일 오전 6시 50분에 수행하며,
        수집한 값은 시계열로 축적하여 이후 보고서가 같은 계열을 참조합니다. 현재 79개 계열에
        관측치 45,646개가 쌓여 있습니다.</p>
      <div class="tw">
        <table class="t">
          <thead><tr><th>기관</th><th>자료</th><th class="n">갱신</th></tr></thead>
          <tbody>
            {sources.map(([o, d, c]) => (
              <tr><td class="ch">{o}</td><td>{d}</td><td class="n mono">{c}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sec">
      <div class="sec-k">발행</div>
      <h2 class="hd sec-h">갱신일 표기 원칙</h2>
      <p class="tx">분석 보고서는 기사가 아닙니다. 기업의 정기보고서가 제출될 때마다 같은 보고서를 다시
        작성하므로, <b>발행일을 표기하면 오래된 날짜를 단 화면이 새로운 수치를 담게 됩니다.</b>
        그래서 날짜 항목을 갱신일로 두고, 목록과 RSS에도 갱신일 기준으로 싣습니다.</p>
      <p class="tx">지표는 매일 오전에 갱신하며 화면마다 기준 시점을 함께 표기합니다. 기업의 시가총액과
        재무는 기준 시점이 서로 다르므로, 두 값을 함께 쓰는 계산에서는 각각의 기준일을 명기합니다.</p>
    </section>

    <section class="sec">
      <div class="sec-k">고지</div>
      <h2 class="hd sec-h">이용 범위와 연락</h2>
      <p class="tx">도토리경제는 개인이 운영합니다. 본 사이트의 내용은 정보 제공을 목적으로 하며
        <b>투자 자문이 아닙니다.</b> 주가 예측과 매수·매도 의견은 제시하지 않습니다. 계산 도구의
        산출값은 참고 자료이며 법적 효력을 가지는 판단의 근거로 사용할 수 없습니다.</p>
      <p class="tx">수치나 해석에 관하여 알려 주실 내용이 있으면 <a href={url('/contact/')}>문의 화면</a>으로
        연락 주십시오. 정정한 경우 <b>무엇을 어떻게 고쳤는지 해당 화면에 함께 기록합니다.</b></p>
    </section>
  </div>
</Base>

<style>
  .wrap { max-width: 1440px; margin: 0 auto; padding: 0 64px; }
  .ab-head { background: #fff; border-bottom: 1px solid #e4e4de; padding: 54px 0 42px; }
  .kick { font-size: 10.5px; font-weight: 600; letter-spacing: 1.6px; color: #8e9299; margin-bottom: 18px; }
  h1 { font-size: 44px; line-height: 1.34; font-weight: 900; color: #15171a; margin: 0 0 26px; letter-spacing: -1.8px; }
  .lead { font-size: 17px; line-height: 1.95; color: #2e3238; max-width: 900px; margin: 0 0 34px; }
  .strip { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px;
           background: #e4e4de; border-top: 1.6px solid #15171a; border-bottom: 1px solid #e4e4de; }
  .strip-c { background: #fff; padding: 17px 20px 18px; }
  .strip-k { font-size: 12px; color: #71767d; margin-bottom: 8px; }
  .strip-v { font-size: 24px; font-weight: 500; color: #15171a; letter-spacing: -0.7px; }
  .strip-n { font-size: 11.5px; color: #8e9299; margin-top: 7px; line-height: 1.65; }
  .ab-body { padding: 12px 64px 54px; }
  .sec { padding: 34px 0 38px; border-top: 1px solid #e4e4de; max-width: 980px; }
  .sec:first-child { border-top: none; }
  .sec-k { font-size: 11px; font-weight: 600; letter-spacing: 2.2px; color: #9a6b22; margin-bottom: 11px; }
  .sec-h { font-size: 26px; font-weight: 900; color: #15171a; letter-spacing: -0.95px; line-height: 1.45; margin: 0 0 18px; }
  .tx { font-size: 15px; line-height: 2; color: #3c4046; margin: 0 0 19px; }
  .tx b { font-weight: 600; color: #15171a; }
  .tw { overflow-x: auto; }
  table.t { width: 100%; border-collapse: collapse; margin: 4px 0 22px; }
  .t th { font-size: 12px; font-weight: 600; color: #71767d; text-align: left;
          padding: 0 14px 9px 0; border-bottom: 1.6px solid #15171a; white-space: nowrap; }
  .t td { font-size: 13.5px; line-height: 1.75; color: #3c4046; padding: 12px 14px 12px 0;
          border-bottom: 1px solid #eaeae4; vertical-align: top; }
  .t th.n, .t td.n { text-align: right; padding-left: 16px; }
  .t th:last-child, .t td:last-child { padding-right: 0; }
  .t tr:last-child td { border-bottom: none; }
  .t td.ch { font-family: 'Gothic A1', sans-serif; font-weight: 800; color: #15171a; white-space: nowrap; }
  @media (max-width: 720px) {
    .wrap, .ab-body { padding-left: 20px; padding-right: 20px; }
    h1 { font-size: 27px; letter-spacing: -1.1px; }
    .lead { font-size: 15px; }
    .sec-h { font-size: 20px; letter-spacing: -0.7px; }
    .tx { font-size: 14.5px; }
    .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tw > table { min-width: 560px; }
  }
</style>
