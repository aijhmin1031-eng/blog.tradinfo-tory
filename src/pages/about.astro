---
import Base from '../layouts/Base.astro';
import { SITE, url } from '../lib/site';

type Bubble = {
  text: string;
  kind: 'speech' | 'narration' | 'thought';
  pos: 'tl' | 'tr' | 'bl' | 'br';
};
type Panel = { img: string; alt: string; act: 'autumn' | 'winter' | 'night' | 'dawn'; bubbles: Bubble[] };

const panels: Panel[] = [
  {
    img: '01', alt: '가을 숲에서 분주히 도토리를 모으는 다람쥐들', act: 'autumn',
    bubbles: [{ kind: 'narration', pos: 'tl', text: '옛날, 사계절이 유난히 변덕스러운 숲이 있었습니다.' }],
  },
  {
    img: '02', alt: '자루에 도토리를 마구 쓸어 담는 다람쥐들', act: 'autumn',
    bubbles: [{ kind: 'speech', pos: 'tr', text: '빨리빨리! 많이 줍는 게 장땡이야!' }],
  },
  {
    img: '03', alt: '나무 아래에서 도토리를 살펴보고 장부에 적는 어린 토리', act: 'autumn',
    bubbles: [
      { kind: 'speech', pos: 'tr', text: '이건 꽉 찼고… 음, 이건 가볍네.' },
      { kind: 'narration', pos: 'bl', text: '줍기 전에 꼭 들여다보고 장부에 적는, 조금 이상한 다람쥐가 있었습니다.' },
    ],
  },
  {
    img: '04', alt: '장부를 안은 토리를 보며 웃는 이웃 다람쥐들', act: 'autumn',
    bubbles: [
      { kind: 'speech', pos: 'tr', text: '하하! 그럴 시간에 하나라도 더 주워!' },
      { kind: 'thought', pos: 'bl', text: '…그래도, 적어둘래.' },
    ],
  },
  {
    img: '05', alt: '숲 위로 몰려오는 먹구름과 첫눈', act: 'winter',
    bubbles: [{ kind: 'narration', pos: 'tl', text: '그해 겨울은 예고 없이 일찍 왔습니다.' }],
  },
  {
    img: '06', alt: '쪼갠 도토리가 텅 비어 있어 충격받은 다람쥐', act: 'winter',
    bubbles: [{ kind: 'speech', pos: 'tl', text: '속이… 비었잖아!?' }],
  },
  {
    img: '07', alt: '빈 도토리 앞에 낙담한 다람쥐들', act: 'winter',
    bubbles: [{ kind: 'speech', pos: 'tl', text: '이 겨울을… 어떻게 나지.' }],
  },
  {
    img: '08', alt: '눈보라를 뚫고 창고로 걸어가는 토리', act: 'winter',
    bubbles: [{ kind: 'narration', pos: 'tl', text: '그때, 토리가 조용히 일어났습니다.' }],
  },
  {
    img: '09', alt: '한밤의 창고 문이 열리며 쏟아지는 따뜻한 빛', act: 'night',
    bubbles: [{ kind: 'narration', pos: 'tl', text: '끼이익 —' }],
  },
  {
    img: '10', alt: '가지런히 쌓인 도토리 창고와 장부를 든 토리', act: 'night',
    bubbles: [{ kind: 'speech', pos: 'tl', text: '전부 기록해 뒀어. 속이 꽉 찬 것들만.' }],
  },
  {
    img: '11', alt: '모닥불에 둘러앉아 도토리를 나누는 다람쥐들', act: 'night',
    bubbles: [
      { kind: 'speech', pos: 'tr', text: '고마워, 토리야!' },
      { kind: 'narration', pos: 'bl', text: '숲의 모두가 함께 겨울을 났습니다.' },
    ],
  },
  {
    img: '12', alt: '눈 녹는 언덕에서 해돋이를 바라보는 토리', act: 'dawn',
    bubbles: [{ kind: 'speech', pos: 'tl', text: '좋은 도토리가 어디서 나는지, 매일 알려줄게.' }],
  },
  {
    img: '13', alt: '거울 앞에서 안경을 쓰는 토리, 옆에 걸린 네이비 베스트', act: 'dawn',
    bubbles: [{ kind: 'narration', pos: 'bl', text: '그렇게 토리는 숲의 이코노미스트가 되었습니다.' }],
  },
  {
    img: '14', alt: '컨테이너가 쌓인 항구를 걷는 어른 토리', act: 'dawn',
    bubbles: [{ kind: 'narration', pos: 'tl', text: '그날부터 토리는 어디든 갑니다 —' }],
  },
  {
    img: '15', alt: '시장 거리에서 수첩에 기록하는 토리', act: 'dawn',
    bubbles: [{ kind: 'narration', pos: 'tr', text: '거래가 있는 곳이라면, 어디든.' }],
  },
  {
    img: '16', alt: '아침 숲에서 차트를 들고 브리핑하는 토리', act: 'dawn',
    bubbles: [{ kind: 'speech', pos: 'tl', text: '안녕하세요, 토리입니다. 오늘 주운 도토리 세 알부터 보시죠.' }],
  },
];

const principles = [
  { title: '주운 도토리만 말합니다', desc: '출처 있는 공식 데이터만 인용합니다. 소문과 추측(속이 빈 도토리)은 다루지 않습니다.' },
  { title: '도토리를 대신 골라주지 않습니다', desc: '무역토리는 정보를 전할 뿐, 투자 판단을 대신하지 않습니다. 모든 콘텐츠는 투자 자문이 아닙니다.' },
  { title: '겨울을 팔지 않습니다', desc: '공포를 자극하는 헤드라인 대신, 숫자가 말하는 만큼만 말합니다.' },
];
---

<Base
  title="토리 이야기"
  description="무역토리의 마스코트, 다람쥐 이코노미스트 토리의 기원 이야기 — 거래가 있는 곳에, 토리가 갑니다."
  compact
>
  <section class="wrap story-head">
    <div class="kicker" style="color: var(--accent);">ORIGIN STORY</div>
    <h1 class="serif story-title">「첫 번째 도토리」</h1>
    <p class="story-sub">무역토리가 매일 아침 데이터를 줍는 이유</p>
  </section>

  <section class="strip wrap">
    {
      panels.map((p, i) => (
        <figure class:list={['panel', 'reveal', `act-${p.act}`]}>
          <div class="frame">
            <img
              src={url(`/images/story/${p.img}.jpg`)}
              alt={p.alt}
              width="880"
              height="660"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
            <div class="fx" aria-hidden="true">
              <i /><i /><i /><i /><i /><i />
            </div>
            {p.bubbles.map((b) => (
              <div class:list={['bubble', b.kind, `pos-${b.pos}`]}>{b.text}</div>
            ))}
          </div>
          <figcaption class="mono panel-no">{String(i + 1).padStart(2, '0')} / 16</figcaption>
        </figure>
      ))
    }
    <div class="story-close reveal serif">&ldquo;{SITE.tagline}&rdquo;</div>
  </section>

  <section class="wrap creed">
    <h2 class="serif creed-title">토리의 세 가지 철칙</h2>
    <div class="creed-grid">
      {
        principles.map((p, i) => (
          <div class="creed-item reveal">
            <div class="mono creed-no">{String(i + 1).padStart(2, '0')}</div>
            <div class="creed-name serif">{p.title}</div>
            <div class="creed-desc">{p.desc}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap glossary">
    <h2 class="serif creed-title">숲의 언어 사전</h2>
    <div class="prose" style="max-width: 720px; margin: 0;">
      <table>
        <thead>
          <tr><th>숲의 언어</th><th>실제 의미</th></tr>
        </thead>
        <tbody>
          <tr><td>도토리</td><td>검증된 데이터·정보 한 조각</td></tr>
          <tr><td>도토리를 줍다</td><td>공식 데이터를 확인하다</td></tr>
          <tr><td>속이 빈 도토리</td><td>출처 없는 소문과 추측</td></tr>
          <tr><td>겨울</td><td>경기 침체·불확실성</td></tr>
          <tr><td>도토리 창고</td><td>지표 대시보드·아카이브</td></tr>
          <tr><td>계절이 바뀐다</td><td>금리·환율의 국면 전환</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .story-head { text-align: center; padding-top: 56px; padding-bottom: 8px; }
  .story-title { font-size: clamp(30px, 5vw, 42px); font-weight: 900; margin: 12px 0 10px 0; }
  .story-sub { color: var(--sub); font-size: 14.5px; letter-spacing: 0.08em; }

  .strip { max-width: 760px; padding-top: 34px; }
  .panel { margin: 0 0 44px 0; }
  .frame {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--ink);
    padding: 10px;
    overflow: hidden;
  }
  .frame img { display: block; width: 100%; height: auto; }
  .panel-no { font-size: 10px; color: var(--muted); text-align: right; margin-top: 7px; }

  /* 말풍선 — HTML 텍스트라 선명하고 수정·번역·검색 전부 가능 */
  .bubble {
    position: absolute;
    max-width: 62%;
    font-size: clamp(12px, 2vw, 14.5px);
    line-height: 1.55;
    padding: 10px 14px;
    z-index: 2;
  }
  .bubble.speech {
    background: #fff;
    color: #231a10;
    border: 1.5px solid #231a10;
    border-radius: 14px;
    font-weight: 700;
    box-shadow: 2px 2px 0 rgba(35, 26, 16, 0.25);
  }
  .bubble.thought {
    background: #fff;
    color: #6e6252;
    border: 1.5px dashed #6e6252;
    border-radius: 18px;
    font-style: normal;
  }
  .bubble.narration {
    background: #231a10;
    color: #f8f4ec;
    font-size: clamp(11px, 1.8vw, 13px);
    border-radius: 2px;
    letter-spacing: 0.02em;
  }
  .pos-tl { top: 22px; left: 22px; }
  .pos-tr { top: 22px; right: 22px; }
  .pos-bl { bottom: 26px; left: 22px; }
  .pos-br { bottom: 26px; right: 22px; }

  /* 주변 효과 — 막마다 계절이 흐른다 */
  .fx { position: absolute; inset: 10px; pointer-events: none; z-index: 1; }
  .fx i { position: absolute; top: -8%; display: block; }
  .fx i:nth-child(1) { left: 12%; animation-delay: 0s; }
  .fx i:nth-child(2) { left: 30%; animation-delay: 1.4s; }
  .fx i:nth-child(3) { left: 48%; animation-delay: 0.6s; }
  .fx i:nth-child(4) { left: 63%; animation-delay: 2.1s; }
  .fx i:nth-child(5) { left: 78%; animation-delay: 0.9s; }
  .fx i:nth-child(6) { left: 90%; animation-delay: 1.8s; }

  @keyframes fx-fall {
    0% { transform: translateY(-10px) rotate(0deg); opacity: 0; }
    12% { opacity: 0.9; }
    100% { transform: translateY(560px) rotate(300deg); opacity: 0; }
  }
  @keyframes fx-twinkle {
    0%, 100% { opacity: 0; transform: scale(0.6); }
    50% { opacity: 0.9; transform: scale(1); }
  }

  .act-autumn .fx i {
    width: 10px; height: 7px;
    background: #d9a05b;
    border-radius: 60% 0 60% 0;
    animation: fx-fall 7s linear infinite;
  }
  .act-winter .fx i,
  .act-night .fx i {
    width: 6px; height: 6px;
    background: #fff;
    border-radius: 50%;
    opacity: 0.85;
    animation: fx-fall 9s linear infinite;
  }
  .act-night .fx i:nth-child(odd) {
    top: auto; left: auto;
    animation: fx-twinkle 3.2s ease-in-out infinite;
    background: #ffd98a;
    width: 5px; height: 5px;
  }
  .act-night .fx i:nth-child(1) { top: 18%; left: 14%; }
  .act-night .fx i:nth-child(3) { top: 10%; left: 66%; }
  .act-night .fx i:nth-child(5) { top: 26%; left: 86%; }
  .act-dawn .fx i {
    top: auto; bottom: 12%;
    width: 7px; height: 7px;
    background: #f0c46a;
    border-radius: 50%;
    animation: fx-twinkle 4s ease-in-out infinite;
  }
  .act-dawn .fx i:nth-child(2) { bottom: 30%; }
  .act-dawn .fx i:nth-child(4) { bottom: 46%; }

  @media (prefers-reduced-motion: reduce) { .fx { display: none; } }

  .story-close {
    text-align: center;
    font-size: clamp(19px, 3vw, 25px);
    font-weight: 900;
    padding: 18px 0 10px 0;
  }

  .creed { padding-top: 64px; }
  .creed-title {
    font-size: 25px;
    font-weight: 900;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
  }
  .creed-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding-top: 26px;
  }
  @media (max-width: 760px) { .creed-grid { grid-template-columns: 1fr; } }
  .creed-no { font-size: 12px; color: var(--accent); margin-bottom: 8px; }
  .creed-name { font-size: 17.5px; font-weight: 700; margin-bottom: 8px; }
  .creed-desc { font-size: 13.5px; color: var(--sub); line-height: 1.75; }

  .glossary { padding-top: 56px; }
</style>
