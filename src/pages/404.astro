---
// 404 — 2026-09-06 에 다시 썼다.
//
// 이 쪽의 무게가 개편으로 완전히 달라졌다. 그전에는 아무도 일부러 찾아오지 않는 쪽이었지만,
// **발행 82편과 옛 구역 190여 쪽이 한꺼번에 사라졌으므로** 검색 결과와 외부 링크를 타고
// 들어오는 사람이 당분간 여기 먼저 닿는다. 그래서 캐릭터 문구(「이 도토리는 다른 다람쥐가
// 먼저 가져갔네요」) 대신 **무슨 일이 있었는지와 어디로 가면 되는지**를 적는다.
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';

const dest = [
  { k: '기업 분석', href: '/corp/', v: '상장기업의 정기보고서를 분기 단위로 이어 분석한 보고서' },
  { k: '지원 도구', href: '/tools/', v: '공공조달·무역·자금 실무의 계산 도구 4종' },
  { k: '오늘의 지표', href: '/numbers/', v: '거시·시장 지표의 현재값·기준일·출처' },
  { k: '용어 목록', href: '/glossary/', v: '보고서에 쓰인 용어의 정의' },
];
---

<Base title="페이지를 찾을 수 없습니다" description="요청하신 주소의 페이지가 없습니다. 도토리경제의 기업 분석·지원 도구·오늘의 지표로 이동하실 수 있습니다.">
  <section class="th">
    <div class="wrap">
      <div class="kick">404</div>
      <h1>요청하신 페이지 없음</h1>
      <p class="lead">
        주소가 바뀌었거나 존재하지 않는 페이지입니다. 2026년 9월, 사이트의 구성을 기업 분석과
        지원 도구 중심으로 개편하면서 이전 주소 다수가 정리되었습니다. 아래에서 찾으시는 자료에
        해당하는 곳으로 이동하십시오.
      </p>
    </div>
  </section>

  <div class="tb">
    <div class="grid">
      {dest.map((d) => (
        <a class="card" href={url(d.href)}>
          <div class="card-k">{d.k}</div>
          <div class="card-v">{d.v}</div>
        </a>
      ))}
    </div>
    <p class="foot">
      찾으시던 자료가 위에 없다면 <a href={url('/search/')}>검색</a>을 이용하시거나
      <a href={url('/contact/')}>문의</a>로 알려 주십시오.
    </p>
  </div>
</Base>

<style>
  .wrap { max-width: 1440px; margin: 0 auto; padding: 0 64px; }
  .th { background: #fff; border-bottom: 1px solid #e4e4de; padding: 54px 0 44px; }
  .kick { font-size: 10.5px; font-weight: 600; letter-spacing: 1.6px; color: #8e9299; margin-bottom: 18px; }
  h1 { font-size: 44px; line-height: 1.34; font-weight: 900; color: #15171a; margin: 0 0 26px; letter-spacing: -1.8px; }
  .lead { font-size: 17px; line-height: 1.95; color: #2e3238; max-width: 900px; margin: 0; }
  .tb { max-width: 1440px; margin: 0 auto; padding: 40px 64px 54px; }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 34px; }
  .card { display: block; border-top: 2px solid #16355e; padding-top: 14px; text-decoration: none; }
  .card-k { font-size: 15.5px; font-weight: 800; color: #15171a; margin-bottom: 9px; }
  .card-v { font-size: 13.5px; line-height: 1.9; color: #4a4f56; }
  .card:hover .card-k { color: #16355e; }
  .foot { font-size: 13.5px; line-height: 1.95; color: #4a4f56; margin: 38px 0 0;
          border-top: 1px solid #e4e4de; padding-top: 20px; }
  .foot a { color: #16355e; text-decoration: none; border-bottom: 1px solid #d2d2ca; }
  .foot a:hover { border-bottom-color: #16355e; }
  @media (max-width: 720px) {
    .wrap, .tb { padding-left: 20px; padding-right: 20px; }
    h1 { font-size: 27px; letter-spacing: -1.1px; }
    .lead { font-size: 15px; line-height: 1.9; }
    .grid { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
</style>
