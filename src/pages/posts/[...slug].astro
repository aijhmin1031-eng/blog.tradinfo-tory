---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { isPublished, isPublishedEn } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 영문 짝 찾기. 영문 원고의 translationOf 가 이 글의 슬러그를 가리키면 짝이다.
// altPath 는 **중립 경로**를 넘기는 자리라 영문 슬러그로 만든다(Base 가 /en 을 붙인다).
const enPair = (await getCollection('postsEn', ({ data }) => !data.draft && isPublishedEn(data.pubDate)))
  .find((e) => e.data.translationOf === post.id);
const altPath = enPair ? `/posts/${enPair.id}/` : undefined;

const all = (await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const related = all
  .filter((p) => p.id !== post.id)
  .sort((a, b) => (b.data.category === post.data.category ? 1 : 0) - (a.data.category === post.data.category ? 1 : 0))
  .slice(0, 2);

// 발행일 순 이전·다음 기사 (all은 최신순이므로 next = 더 최신, prev = 더 과거)
const idx = all.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? all[idx - 1] : undefined;
const older = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;
---

<PostLayout post={post} related={related} newer={newer} older={older} altPath={altPath}>
  <Content />
</PostLayout>
