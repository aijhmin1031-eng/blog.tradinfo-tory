---
// 영문 그림함 목록. 영문판 최대의 유입·링크 획득 장치다(2026-08-26 개설).
// 이유: 우리 최대 병목이 「외부 링크 0개」인데, 이 그림들은 **출처 표기를 조건으로** 상업적
// 이용을 허용한다. 즉 쓰이는 만큼 링크가 생긴다. 그림은 번역이 필요 없어 영문화 비용도 낮다.
import Pic from '../../components/Pic.astro';
import Base from '../../layouts/Base.astro';
import { getImage } from 'astro:assets';
import { metaByPath } from '../../lib/images';
import { PACKS, EN_ITEMS, thumbOf } from '../../data/pack';

// 58장을 한 벽으로 쏟지 않는다. 팩(주제)별로 묶어 고르게 한다.
const groups = PACKS.map((pack) => ({ pack, items: pack.items.filter((i) => i.en) })).filter((g) => g.items.length > 0);
const EN_TITLES: Record<string, { title: string; note: string }> = {
  vol1: { title: 'Money, trade and logistics', note: 'Charts, cargo, currency and the instruments of trade. The set this publication draws on most.' },
  vol2: { title: 'Autumn and Korean holidays', note: 'Chuseok, the Korean harvest festival, and the autumn objects around it. Several are specific to Korea and are explained on their own pages.' },
  vol3: { title: 'Office and desk tools', note: 'Laptops, calendars, folders and the rest of the working desk. Blank screens and empty boards leave room for your own text.' },
  soso: { title: 'Watercolour still life', note: 'Softer, hand-painted pieces: coffee, desserts and small objects. Drawn by a guest illustrator, released on the same terms.' },
};

const _og = metaByPath('semiconductor.png') ?? metaByPath('semiconductor-export-engine.jpg');
const ogImage = _og ? (await getImage({ src: _og, width: 1200, height: 675, format: 'jpeg' })).src : undefined;

const title = 'Free finance and trade illustrations';
const description =
  `${EN_ITEMS.length} transparent PNG illustrations on finance, trade and logistics, free for commercial use with attribution. Drawn for Dotori Economy and released for anyone to reuse.`;
---

<Base
  ogImage={ogImage}
  title={title}
  description={description}
  lang="en"
  activeNav="pack"
  altPath="/pack/"
>
  <div class="ep">
    <header class="ep-head">
      <p class="ep-kicker">Free to use · attribution required</p>
      <h1>Free finance and trade illustrations</h1>
      <p class="ep-intro">
        {EN_ITEMS.length} illustrations, drawn for this publication and released for anyone to reuse:
        finance and trade, the working desk, autumn and Korean holidays, and a set of watercolour still
        lifes. Every file is a transparent PNG at 1600 × 1600 pixels, so it sits on any background
        without a white box behind it.
      </p>
      <p class="ep-licence">
        <strong>Licence.</strong> Free for personal and commercial use, including blogs, slide decks,
        reports and social posts. The one condition is attribution: credit
        <strong>Dotori Economy</strong> and link back to the page you took the file from. Reselling the
        files themselves, as files, is not permitted.
      </p>
    </header>

    {
      groups.map(({ pack, items }) => (
        <section class="ep-group">
          <h2>{EN_TITLES[pack.key]?.title ?? pack.title}</h2>
          <p class="ep-group-note">{EN_TITLES[pack.key]?.note}</p>
          <ul class="ep-grid">
            {items.map((item) => (
              <li class="ep-cell">
                <a href={`/en/pack/${item.slug}/`}>
                  <span class="ep-thumb alpha-grid">
                    <Pic path={thumbOf(pack, item)} alt={`${item.en!.name} illustration, free PNG`} width={400} height={400} />
                  </span>
                  <span class="ep-name">{item.en!.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .ep { max-width: var(--w-page); margin: 0 auto; padding: 8px 18px 48px; }
  .ep-head { max-width: var(--w-prose); }
  .ep-kicker { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .ep-head h1 { font-size: clamp(26px, 4vw, 38px); font-weight: 900; color: var(--ink); margin: 8px 0 0; }
  .ep-intro { font-size: 16px; line-height: 1.75; color: var(--sub); margin-top: 14px; }
  .ep-licence { font-size: 14px; line-height: 1.8; color: var(--sub); margin-top: 16px; padding: 14px 16px; border: 1px solid var(--hair); border-radius: 10px; }
  .ep-group { margin-top: 40px; }
  .ep-group h2 { font-size: 19px; font-weight: 900; color: var(--ink); border-bottom: 2px solid var(--ink); padding-bottom: 9px; }
  .ep-group-note { font-size: 13.5px; color: var(--muted); line-height: 1.8; margin-top: 10px; max-width: var(--w-prose); }
  .ep-grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 18px; padding: 0; margin: 32px 0 0; }
  .ep-cell a { display: block; text-decoration: none; }
  .ep-thumb { display: grid; place-items: center; aspect-ratio: 1; border: 1px solid var(--hair); border-radius: 10px; overflow: hidden; padding: 10px; box-sizing: border-box; }
  .ep-thumb :global(img) { width: 100%; height: 100%; object-fit: contain; display: block; }
  .ep-cell a:hover .ep-thumb { border-color: var(--accent); }
  .ep-name { display: block; font-size: 13.5px; font-weight: 700; color: var(--ink); margin-top: 8px; }
  .ep-cell a:hover .ep-name { color: var(--accent); }
  .ep-more { font-size: 14px; color: var(--sub); margin-top: 34px; }
</style>
