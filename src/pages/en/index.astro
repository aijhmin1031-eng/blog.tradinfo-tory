---
/**
 * 영문판 홈 (2026-08-26).
 * 「데이터 데스크」라 기사 목록이 아니라 **트래커 수치가 먼저** 온다.
 * 외국 독자가 이 사이트에 오는 이유는 서사가 아니라 원자료이기 때문이다.
 */
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/site';
// 시리즈는 **정적 import** 로 읽는다. 처음에는 import.meta.url 로 경로를 계산했는데,
// Astro 가 페이지를 어느 청크에 묶느냐에 따라 그 URL 이 달라져 같은 코드가 한 페이지에서는
// 되고 다른 페이지에서는 저장소 밖(/home/user/data/…)을 가리켰다. 정적 import 는
// 빌드 시점에 Vite 가 풀어 주므로 번들 배치와 무관하고, 의존 관계도 드러난다.
import total from '../../../data/series/trade_hs8542.json';

const last = total.points[total.points.length - 1];
const bn = (usd: number) => (usd / 1e9).toFixed(2);
const monthName = (d: string) =>
  new Date(Number(d.slice(0, 4)), Number(d.slice(4, 6)) - 1, 1).toLocaleDateString('en-US', {
    month: 'long', year: 'numeric', timeZone: 'UTC',
  });

const posts = (await getCollection('postsEn', ({ data }) => !data.draft && isPublished(data.pubDate)))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base
  title={null}
  description="Korean customs, currency and interest-rate data with independent analysis. Semiconductor exports by destination, drawn monthly from Korea Customs Service records and updated every morning."
  lang="en"
  activeNav="home"
  altPath="/"
>
  <div class="eh">
    <section class="eh-lede">
      <p class="eh-kicker">What this is</p>
      <h1>Korean trade data, taken from the source</h1>
      <p class="eh-intro">
        Dotori Economy collects Korean customs, central-bank and market records every morning and
        publishes them with its own analysis. The English edition concentrates on what is hardest to
        find elsewhere: monthly semiconductor trade broken out by destination, straight from Korea
        Customs Service records, free to read and free to cite.
      </p>
      <a class="eh-cta" href="/en/tracker/">
        Open the Export Tracker
        <span class="eh-cta-num mono">${bn(last.exp ?? 0)}bn in {monthName(last.d)}</span>
      </a>
    </section>

    <section class="eh-block">
      <h2>Why the destination column misleads</h2>
      <p>
        Customs statistics record where a shipment last cleared, not where the goods are used. In
        Korean chip trade that distinction is large enough to change conclusions: one major
        destination buys back 0.8 per cent of what it receives, another 85.1 per cent. The tracker
        carries that ratio alongside the headline figures so the difference is visible before it is
        argued about.
      </p>
    </section>

    {posts.length > 0 && (
      <section class="eh-block">
        <h2>Latest analysis</h2>
        <ul class="eh-list">
          {posts.slice(0, 5).map((p) => (
            <li>
              {p.data.hero && (
                <a href={`/en/posts/${p.id}/`} class="eh-thumb">
                  <Pic path={p.data.hero} alt="" width={160} height={90} />
                </a>
              )}
              <div>
                <h3><a href={`/en/posts/${p.id}/`}>{p.data.title}</a></h3>
                <p>{p.data.description}</p>
                <p class="eh-meta mono">{fmt(p.data.pubDate)}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="eh-block">
      <h2>Standards</h2>
      <p>
        Every figure published here comes from a named statistical source with the reference month
        attached, and the series behind each article are listed at its foot. Where this publication
        makes a causal claim from its own numbers, it also publishes the test that could have
        refuted it. A fuller account is on the <a href="/en/about/">about page</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .eh { max-width: var(--w-prose); margin: 0 auto; padding: 8px 18px 40px; /* 좌우 여백: .wrap 을 쓰지 않으므로 직접 준다(2026-08-26) */ }
  .eh-lede { border-bottom: 2px solid var(--ink); padding-bottom: 26px; margin-bottom: 8px; }
  .eh-kicker { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 700; margin: 0 0 8px; }
  .eh h1 { font-family: var(--font-serif); font-size: 40px; line-height: 1.18; margin: 0 0 14px; color: var(--ink); }
  .eh-intro { font-size: 17.5px; line-height: 1.8; color: var(--body-ink); margin: 0 0 22px; }
  .eh-cta {
    display: inline-flex; align-items: baseline; gap: 12px;
    background: var(--ink); color: var(--paper); padding: 12px 20px;
    font-weight: 700; font-size: 15.5px; border: 0;
  }
  .eh-cta:hover { background: var(--brand); color: var(--paper); }
  .eh-cta-num { font-size: 13px; opacity: 0.82; font-weight: 500; }
  .eh-block { border-top: 1px solid var(--hair); padding-top: 26px; margin-top: 34px; }
  .eh-block h2 { font-family: var(--font-serif); font-size: 24px; font-weight: 900; margin: 0 0 12px; color: var(--ink); }
  .eh-block p { font-size: 16.5px; line-height: 1.85; color: var(--body-ink); margin: 0 0 1em; }
  .eh-list { list-style: none; margin: 0; padding: 0; }
  .eh-list li { display: flex; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--hair); }
  .eh-list li:last-child { border-bottom: 0; }
  .eh-thumb { flex: 0 0 150px; }
  .eh-thumb :global(img) { width: 100%; height: auto; }
  .eh-list h3 { font-family: var(--font-serif); font-size: 19px; line-height: 1.35; margin: 0 0 6px; }
  .eh-list h3 a { color: var(--ink); }
  .eh-list h3 a:hover { color: var(--brand); }
  .eh-list p { font-size: 14px; line-height: 1.7; color: var(--sub); margin: 0 0 5px; }
  .eh-meta { font-size: 12px; color: var(--muted); }
  @media (max-width: 720px) {
    .eh h1 { font-size: 30px; }
    .eh-list li { flex-direction: column; }
    .eh-thumb { flex: none; max-width: 260px; }
  }
</style>
