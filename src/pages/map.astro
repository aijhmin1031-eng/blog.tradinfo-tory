</Base>

<script>
  // 리본 호버: 초점 리본만 강조하고 나머지는 물러난다 + 툴팁
  const svg = document.getElementById('sankey');
  const tip = document.getElementById('sk-tip');
  if (svg && tip) {
    const scroll = svg.parentElement as HTMLElement;
    svg.querySelectorAll<SVGGElement>('.ribbon').forEach((g) => {
      g.addEventListener('mouseenter', () => {
        svg.classList.add('focusing');
        g.classList.add('hot');
        tip.textContent = `${g.dataset.from} → ${g.dataset.to} · ${g.dataset.n}편`;
        tip.hidden = false;
      });
      g.addEventListener('mousemove', (e) => {
        const r = scroll.getBoundingClientRect();
        tip.style.left = `${e.clientX - r.left + 14}px`;
        tip.style.top = `${e.clientY - r.top - 34}px`;
      });
      g.addEventListener('mouseleave', () => {
        svg.classList.remove('focusing');
        g.classList.remove('hot');
        tip.hidden = true;
      });
    });

    // 좁은 화면: 가려진 방향을 가장자리 페이드로 표시, 첫 스크롤에 안내 칩 제거
    const hint = document.getElementById('sk-hint');
    const updateEdges = () => {
      const more = scroll.scrollWidth - scroll.clientWidth > 8;
      scroll.classList.toggle('has-left', more && scroll.scrollLeft > 8);
      scroll.classList.toggle(
        'has-right',
        more && scroll.scrollLeft < scroll.scrollWidth - scroll.clientWidth - 8
      );
      if (hint) hint.hidden = !more;
    };
    scroll.addEventListener(
      'scroll',
      () => {
        updateEdges();
        hint?.classList.add('seen');
      },
      { passive: true }
    );
    addEventListener('resize', updateEdges, { passive: true });
    updateEdges();
  }
</script>

