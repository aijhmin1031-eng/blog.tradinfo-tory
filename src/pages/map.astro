---
// 블로그 지도: 생키 다이어그램 리포트. 발행 컬렉션에서 빌드 시점 자동 산출(매일 아침 갱신).
// 팔레트는 dataviz 6종 검사(라이트·다크) 통과: 카테고리 4색 + 잉크 텍스트, 색은 식별만 담당.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, url, isPublished } from '../lib/site';
import { GLOSSARY } from '../lib/glossary';
import { TOPICS } from '../lib/topics';
import { ALL_ITEMS } from '../data/pack';
import { EPISODES } from '../data/story';

const posts = await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate));
// 기업 분석 낱장도 읽을거리다(2026-09-03). 세지 않으면 지도가 사이트 모양을 틀리게 그린다.
const corpPages = (await getCollection('corps', ({ data }) => !data.draft)).length;
const total = posts.length;

type Kind = 'topic' | 'series' | 'data' | 'guide';
const kindOf = (p: (typeof posts)[number]): Kind => {
  if ((p.data.topics ?? []).length > 0) return 'topic';
  const slug = (p as { slug?: string; id: string }).slug ?? p.id;
  if (slug.startsWith('tori-galimgil')) return 'series';
  if (p.data.chart) return 'data';
  return 'guide';
};
const KINDS: { key: Kind; name: string }[] = [
  { key: 'topic', name: '반도체·AI 특집' },
  { key: 'series', name: '갈림길 연재' },
  { key: 'data', name: '데이터 기사' },
  { key: 'guide', name: '해설·입문' },
];
const CAT_COLORS: Record<string, string> = {
  money: 'var(--cat-money)',
  tariff: 'var(--cat-tariff)',
  trade: 'var(--cat-trade)',
  basics: 'var(--cat-basics)',
};

const catKeys = Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[];
const catCount: Record<string, number> = {};
const cellCount: Record<string, Record<Kind, number>> = {};
for (const c of catKeys) { catCount[c] = 0; cellCount[c] = { topic: 0, series: 0, data: 0, guide: 0 }; }
for (const p of posts) {
  const c = p.data.category as string;
  catCount[c] = (catCount[c] ?? 0) + 1;
  cellCount[c][kindOf(p)] += 1;
}
const kindCount: Record<Kind, number> = { topic: 0, series: 0, data: 0, guide: 0 };
for (const c of catKeys) for (const k of KINDS) kindCount[k.key] += cellCount[c][k.key];
const liveKinds = KINDS.filter((k) => kindCount[k.key] > 0);

// ── 기하 (전부 사전 계산) ──
const W = 960, H = 540, NW = 14, PADY = 24, GAP = 16;
const X0 = 30, X1 = 448, X2 = 916;
const usable = (n: number) => H - PADY * 2 - GAP * (n - 1);
const scale = Math.min(usable(1) / total, usable(catKeys.length) / total, usable(liveKinds.length) / total);

type NodeBox = { x: number; y: number; h: number; name: string; n: number; color: string; anchor: 'start' | 'end' };
const nodes: NodeBox[] = [];
const rootH = total * scale;
const rootY = (H - rootH) / 2;
nodes.push({ x: X0, y: rootY, h: rootH, name: '발행 기사', n: total, color: 'var(--ink)', anchor: 'start' });
let y1 = PADY;
const catBox: Record<string, { y: number; h: number }> = {};
for (const c of catKeys) {
  const h = catCount[c] * scale;
  catBox[c] = { y: y1, h };
  nodes.push({ x: X1, y: y1, h, name: CATEGORIES[c].name, n: catCount[c], color: CAT_COLORS[c], anchor: 'start' });
  y1 += h + GAP;
}
let y2 = PADY;
const kindBox: Record<string, { y: number; h: number }> = {};
for (const k of liveKinds) {
  const h = kindCount[k.key] * scale;
  kindBox[k.key] = { y: y2, h };
  nodes.push({ x: X2, y: y2, h, name: k.name, n: kindCount[k.key], color: 'var(--ink)', anchor: 'end' });
  y2 += h + GAP;
}

type Ribbon = { d: string; color: string; n: number; delay: number; from: string; to: string; lx: number; ly: number };
const ribbons: Ribbon[] = [];
const ribbonPath = (xa: number, ya: number, ha: number, xb: number, yb: number, hb: number) => {
  const m = (xa + xb) / 2;
  return (
    `M ${xa} ${ya} C ${m} ${ya}, ${m} ${yb}, ${xb} ${yb} ` +
    `L ${xb} ${yb + hb} C ${m} ${yb + hb}, ${m} ${ya + ha}, ${xa} ${ya + ha} Z`
  );
};
let offRoot = rootY;
let d0 = 0;
for (const c of catKeys) {
  const h = catCount[c] * scale;
  const yb = catBox[c].y;
  ribbons.push({
    d: ribbonPath(X0 + NW, offRoot, h, X1, yb, h),
    color: CAT_COLORS[c], n: catCount[c], delay: d0,
    from: '발행 기사', to: CATEGORIES[c].name,
    lx: (X0 + NW + X1) / 2, ly: (offRoot + h / 2 + yb + h / 2) / 2,
  });
  offRoot += h; d0 += 0.1;
}
// 리본 중심 곡선(양 끝 수평 제어점 베지에) 위의 t 지점 좌표.
// 교차가 몰리는 2열에서는 라벨을 t=0.42/0.58로 번갈아 두어 숫자 겹침을 피한다.
const curveAt = (t: number, xa: number, ya: number, xb: number, yb: number) => {
  const m = (xa + xb) / 2;
  const u = 1 - t;
  return {
    x: u * u * u * xa + 3 * u * u * t * m + 3 * u * t * t * m + t * t * t * xb,
    y: ya + (yb - ya) * (3 * t * t - 2 * t * t * t),
  };
};
const kindOff: Record<string, number> = {};
for (const k of liveKinds) kindOff[k.key] = kindBox[k.key].y;
let cellIdx = 0;
for (const c of catKeys) {
  let off = catBox[c].y;
  for (const k of liveKinds) {
    const n = cellCount[c][k.key];
    if (!n) continue;
    const h = n * scale;
    const lp = curveAt(cellIdx % 2 === 0 ? 0.42 : 0.58, X1 + NW, off + h / 2, X2, kindOff[k.key] + h / 2);
    ribbons.push({
      d: ribbonPath(X1 + NW, off, h, X2, kindOff[k.key], h),
      color: CAT_COLORS[c], n, delay: d0,
      from: CATEGORIES[c].name, to: k.name,
      lx: lp.x, ly: lp.y,
    });
    off += h; kindOff[k.key] += h; d0 += 0.06; cellIdx += 1;
  }
}

// 표 보기 데이터
const tableRows = catKeys.map((c) => ({
  name: CATEGORIES[c].name,
  color: CAT_COLORS[c],
  cells: KINDS.map((k) => cellCount[c][k.key]),
  sum: catCount[c],
}));

// KPI 밴드 (전부 빌드 산출 실측)
const termCount = Object.keys(GLOSSARY).length;
const openEpisodes = EPISODES.filter((e) => !e.gateAtPosts || total >= e.gateAtPosts);
const cartoonCuts = openEpisodes.reduce((n, e) => n + e.cuts, 0);
const kpis = [
  { n: String(total), unit: '편', label: '발행 기사', note: '매일 2편 자동 발행' },
  { n: String(TOPICS.length), unit: '개', label: '연중 특집', note: '반도체·AI' },
  { n: String(termCount), unit: '개', label: '용어 도토리', note: '메모 칩·사전 연동' },
  { n: String(cartoonCuts), unit: '컷', label: '토리 카툰', note: `화별로 ${openEpisodes.length}편 공개` },
];
// ── 사이트 구조: 읽을거리(숲) vs 도구(창고) 두 갈래 ──
// 단위를 '페이지 수'로 통일해 두 갈래의 굵기를 정직하게 비교한다.
const galimgilCount = posts.filter((p) => ((p as { slug?: string; id: string }).slug ?? p.id).startsWith('tori-galimgil')).length;
const storyPages = openEpisodes.length + 1; // 화별 낱장 + 목차
const forestPages = total + catKeys.length + TOPICS.length + storyPages + 1 + corpPages + 1; // +corpPages 낱장, +1 착지 /corp/
const forestCorners = [
  ...catKeys.map((k) => ({
    name: CATEGORIES[k].name,
    href: `/category/${CATEGORIES[k].slug}/`,
    n: posts.filter((p) => p.data.category === k).length,
    unit: '편',
    note: CATEGORIES[k].desc,
  })),
  ...TOPICS.map((t) => ({
    name: `${t.name} 특집`,
    href: t.href,
    n: posts.filter((p) => (p.data.topics ?? []).includes(t.key)).length,
    unit: '편',
    note: t.desc,
  })),
  { name: '토리 이야기', href: '/story/', n: openEpisodes.length, unit: '화', note: `카툰 ${cartoonCuts}컷 · 화별로 읽기` },
];
const warehouseCorners = [
  { name: '도토리 그림함', href: '/pack/', n: ALL_ITEMS.length, unit: '장', note: '무료 이미지 낱장 페이지' },
  { name: '용어 도토리', href: '/glossary/', n: termCount, unit: '개', note: '무역·경제 용어 사전' },
  { name: '오늘의 지표', href: '/warehouse/', n: 6, unit: '종', note: '환율·금리·주가·무역수지' },
  { name: '토리의 갈림길', href: '/galimgil/', n: galimgilCount, unit: '화', note: '주간 전망·공개 채점' },
  { name: '도토리 광장', href: '/board/', n: 1, unit: '곳', note: '의견·제보 게시판' },
  { name: '블로그 지도', href: '/map/', n: 1, unit: '장', note: '지금 보고 있는 이 페이지' },
];
const warehousePages = ALL_ITEMS.length + warehouseCorners.length;
const sitePages = forestPages + warehousePages;
const BW = 900, BH = 156, BNW = 12, BPAD = 12;
const bScale = (BH - BPAD * 2 - 18) / sitePages;
const bRootH = sitePages * bScale;
const bForestH = forestPages * bScale;
const bWareH = warehousePages * bScale;
const bRootY = (BH - bRootH) / 2;
const bForestY = BPAD;
const bWareY = BPAD + bForestH + 18;
const branchPath = (ya: number, h: number, yb: number) =>
  `M 130 ${ya} C 330 ${ya}, 330 ${yb}, 530 ${yb} L 530 ${yb + h} C 330 ${yb + h}, 330 ${ya + h}, 130 ${ya + h} Z`;

const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '.');
const legend = catKeys.map((c) => ({ name: CATEGORIES[c].name, color: CAT_COLORS[c] }));
---

<Base
  title="블로그 지도"
  description="도토리경제의 전체 콘텐츠 구성을 한눈에 보는 생키 다이어그램 리포트. 매일 아침 빌드에서 자동으로 다시 그려집니다."
  activeNav="map"
  compact
>
  <section class="wrap map-head">
    <div class="mh-top">
      <div>
        <div class="kicker-en" style="color: var(--accent);">CONTENT ATLAS</div>
        <h1 class="serif map-title">블로그 지도</h1>
      </div>
      <div class="mh-meta">
        <span class="meta-badge mono">기준 {today}</span>
        <span class="meta-badge mono live"><i class="live-dot" aria-hidden="true"></i>매일 06:50 자동 갱신</span>
      </div>
    </div>
    <p class="map-sub">
      도토리경제가 어떻게 짜여 있는지 한 장으로 그린 지도입니다. 먼저 읽을거리(숲)와
      도구(창고) 두 갈래로 나뉘고, 숲 안에서 기사가 분야와 유형으로 갈라집니다.
      내용이 늘어나면 지도도 다음 날 아침 함께 자랍니다.
    </p>
  </section>

  <section class="wrap map-branch">
    <div class="chart-card">
      <div class="card-head">
        <div>
          <div class="card-title serif">두 갈래로 나뉜 집</div>
          <div class="card-sub">
            상단 메뉴는 읽을거리인 <strong>도토리 숲</strong>과 도구를 모은 <strong>도토리 창고</strong>
            두 갈래입니다. 굵기는 각 갈래에 속한 페이지 수({sitePages}쪽)에 비례합니다. 무료 이미지 낱장이 쌓이면서 창고가 숲보다 두꺼워졌습니다.
          </div>
        </div>
      </div>
      <svg viewBox={`0 0 ${BW} ${BH}`} class="branch-svg" role="img"
        aria-label={`사이트 구조 다이어그램. 전체 ${sitePages}쪽 가운데 도토리 숲이 ${forestPages}쪽, 도토리 창고가 ${warehousePages}쪽입니다.`}>
        <path d={branchPath(bRootY, bForestH, bForestY)} fill="var(--brand)" opacity="0.42" />
        <path d={branchPath(bRootY + bForestH, bWareH, bWareY)} fill="var(--accent)" opacity="0.42" />
        <rect x="118" y={bRootY} width={BNW} height={bRootH} rx="3" fill="var(--ink)" />
        <text x="112" y={bRootY + bRootH / 2 - 3} text-anchor="end" class="bl-name">도토리경제</text>
        <text x="112" y={bRootY + bRootH / 2 + 13} text-anchor="end" class="bl-num">{sitePages}쪽</text>
        <rect x="530" y={bForestY} width={BNW} height={bForestH} rx="3" fill="var(--brand)" />
        <text x="552" y={bForestY + bForestH / 2 - 3} class="bl-name">도토리 숲 · 읽을거리</text>
        <text x="552" y={bForestY + bForestH / 2 + 13} class="bl-num">{forestPages}쪽</text>
        <rect x="530" y={bWareY} width={BNW} height={bWareH} rx="3" fill="var(--accent)" />
        <text x="552" y={bWareY + bWareH / 2 - 3} class="bl-name">도토리 창고 · 쓸거리</text>
        <text x="552" y={bWareY + bWareH / 2 + 13} class="bl-num">{warehousePages}쪽</text>
      </svg>
      <div class="branch-label">도토리 숲 · 읽을거리</div>
      <div class="branch-corners">
        {forestCorners.map((c) => (
          <a class="bc" href={url(c.href)}>
            <span class="bc-name">{c.name}</span>
            <span class="bc-n mono">{c.n}{c.unit}</span>
            <span class="bc-note">{c.note}</span>
          </a>
        ))}
      </div>
      <div class="branch-label">도토리 창고 · 쓸거리</div>
      <div class="branch-corners">
        {warehouseCorners.map((c) => (
          <a class="bc" href={url(c.href)}>
            <span class="bc-name">{c.name}</span>
            <span class="bc-n mono">{c.n}{c.unit}</span>
            <span class="bc-note">{c.note}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="kpi-band" role="list">
      {kpis.map((k) => (
        <div class="kpi" role="listitem">
          <div class="kpi-n"><span class="mono">{k.n}</span><span class="kpi-unit">{k.unit}</span></div>
          <div class="kpi-label">{k.label}</div>
          <div class="kpi-note">{k.note}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap map-stage">
    <div class="chart-card">
      <div class="card-head">
        <div>
          <div class="card-title serif">도토리 숲의 흐름</div>
          <div class="card-sub">숲에 쌓인 기사 {total}편이 네 갈래 분야를 거쳐 콘텐츠 유형으로 모입니다. 리본의 굵기는 기사 수에 비례합니다.</div>
        </div>
        <div class="card-legend" aria-hidden="true">
          {legend.map((l) => (
            <span class="lg-item"><i class="lg-dot" style={`background:${l.color}`}></i>{l.name}</span>
          ))}
        </div>
      </div>

      <div class="col-heads mono" aria-hidden="true">
        <span>전체</span><span>카테고리</span><span>콘텐츠 유형</span>
      </div>

      <div class="sankey-stage">
      <div class="sankey-scroll" id="sankey-scroll">
        <svg viewBox={`0 0 ${W} ${H}`} class="sankey" id="sankey" role="img" aria-label="도토리경제 콘텐츠 구성 생키 다이어그램. 아래의 표로 보기에서 같은 데이터를 표로 확인할 수 있습니다.">
          <defs>
            <linearGradient id="sweepGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#fff" stop-opacity="0" />
              <stop offset="0.5" stop-color="#fff" stop-opacity="1" />
              <stop offset="1" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
            <mask id="sweepMask" maskUnits="userSpaceOnUse" x={-700} y={-40} width={W + 1400} height={H + 80}>
              <rect x={-620} y={-20} width="460" height={H + 40} fill="url(#sweepGrad)" transform="skewX(-14)">
                <animateTransform
                  attributeName="transform"
                  type="translate"
                  additive="sum"
                  values="0 0; 1860 0; 1860 0"
                  keyTimes="0; 0.5; 1"
                  calcMode="spline"
                  keySplines="0.4 0 0.2 1; 0 0 1 1"
                  dur="8s"
                  repeatCount="indefinite"
                />
              </rect>
            </mask>
          </defs>
          {ribbons.map((r, i) => (
            <g class="ribbon" style={`--d:${r.delay}s`} data-i={i} data-from={r.from} data-to={r.to} data-n={r.n}>
              <path d={r.d} fill={r.color} class="ribbon-fill" />
              {r.n >= 3 && (
                <text x={r.lx} y={r.ly + 4} text-anchor="middle" class="ribbon-n mono">{r.n}</text>
              )}
            </g>
          ))}
          <g class="sheen-layer" mask="url(#sweepMask)" aria-hidden="true">
            {ribbons.map((r) => <path d={r.d} fill={r.color} class="sheen-rib" />)}
          </g>
          {nodes.map((nd, i) => (
            <g class="node" style={`--d:${0.08 + i * 0.045}s`}>
              <rect x={nd.x} y={nd.y} width={NW} height={Math.max(nd.h, 3)} rx="2.5" fill={nd.color} />
              <text
                x={nd.anchor === 'end' ? nd.x - 9 : nd.x + NW + 9}
                y={nd.y + Math.max(nd.h, 3) / 2 - 3}
                text-anchor={nd.anchor}
                class="node-name"
              >{nd.name}</text>
              <text
                x={nd.anchor === 'end' ? nd.x - 9 : nd.x + NW + 9}
                y={nd.y + Math.max(nd.h, 3) / 2 + 13}
                text-anchor={nd.anchor}
                class="node-count mono"
              >{nd.n}편</text>
            </g>
          ))}
        </svg>
        <div class="sk-tip mono" id="sk-tip" role="status" aria-live="polite" hidden></div>
      </div>
      <div class="sk-fade left" aria-hidden="true"></div>
      <div class="sk-fade right" aria-hidden="true"></div>
      <div class="sk-hint mono" id="sk-hint" aria-hidden="true" hidden>옆으로 밀면 전체 흐름이 보입니다 →</div>
      </div>

      <div class="card-foot">
        <details class="tbl-details">
          <summary class="mono">데이터 표로 보기</summary>
          <div class="tbl-scroll">
            <table class="tbl">
              <thead>
                <tr><th>카테고리</th>{KINDS.map((k) => <th>{k.name}</th>)}<th>계</th></tr>
              </thead>
              <tbody>
                {tableRows.map((r) => (
                  <tr>
                    <th scope="row"><i class="lg-dot" style={`background:${r.color}`}></i>{r.name}</th>
                    {r.cells.map((v) => <td class="mono">{v || '·'}</td>)}
                    <td class="mono sum">{r.sum}</td>
                  </tr>
                ))}
                <tr class="total-row">
                  <th scope="row">계</th>
                  {KINDS.map((k) => <td class="mono">{kindCount[k.key] || '·'}</td>)}
                  <td class="mono sum">{total}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </details>
        <p class="method-note">
          분류 기준: 특집=<code>topics</code> 태그 보유 · 갈림길 연재=주간 전망 시리즈 ·
          데이터 기사=본문 차트 포함 · 해설·입문=그 외. 발행 기사 집계는 예약분을 제외한
          당일 기준이며, 빌드마다 재산출됩니다.
        </p>
      </div>
    </div>

    <p class="map-legend-links">
      특집은 <a href={url('/topics/')}>특집 인덱스</a>, 연재는 <a href={url('/galimgil/')}>토리의 갈림길</a>,
      지표 대시보드는 <a href={url('/warehouse/')}>도토리 창고</a>에서 이어 볼 수 있습니다.
