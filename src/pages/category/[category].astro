---
import Pic from '../../components/Pic.astro';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, url, fmtDate, isPublished, type CategoryKey } from '../../lib/site';

export async function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const cat = CATEGORIES[category as CategoryKey];
const posts = (await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate) && data.category === category)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title={cat.name} compact activeNav={cat.slug}>
  <section class="wrap">
    <header class="cat-head">
      <div class:list={['kicker-en', cat.cls]}>CATEGORY</div>
      <h1 class="serif cat-title">{cat.name}</h1>
      <p class="cat-desc">{cat.desc}</p>
    </header>
    {
      posts.length === 0 ? (
        <div class="empty">
          <Pic path="pose-04.jpg" alt="생각에 잠긴 토리" width={120} height={120} />
          <p>아직 이 창고에는 도토리가 없습니다. 새 기사가 준비되는 대로 이곳에 채워집니다.</p>
        </div>
      ) : (
        posts.map((p) => (
          <a class="row" href={url(`/posts/${p.id}/`)}>
            <div class="row-thumb">
              <Pic category={p.data.category} hero={p.data.hero} width={148} height={83} />
            </div>
            <div>
              <div class="row-title serif">{p.data.title}</div>
              <div class="row-dek">{p.data.description}</div>
            </div>
            <span class="row-date mono">{fmtDate(p.data.pubDate)}</span>
          </a>
        ))
      )
    }
  </section>
</Base>

<style>
  .cat-head { padding: 48px 0 18px 0; border-bottom: 1px solid var(--ink); }
  .cat-title { font-size: 30px; font-weight: 900; margin: 8px 0 6px 0; }
  .cat-desc { font-size: 14px; color: var(--sub); margin: 0 0 16px 0; line-height: 1.75; word-break: keep-all; }
  .row {
    display: grid;
    grid-template-columns: 148px 1fr auto;
    align-items: center;
    gap: 22px;
    padding: 22px 0;
    border-bottom: 1px solid var(--hair2);
  }
  .row-thumb {
    width: 148px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--hair);
    background: var(--surface);
    overflow: hidden;
  }
  .row-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 640px) {
    /* 작은 썸네일(96px·16:9=54px)이 긴 본문 옆 세로 가운데에 떠서 왼쪽에 빈 칸이 크게 남았다.
       홈에서 고친 것과 같은 병이다(2026-08-26 소유주 제보). 썸네일을 키워 4:3 으로 두고
       제목 위쪽에 맞춘다. 설명(dek)은 모바일에서 감춘다 — 제목과 날짜만으로 목록이 더 읽힌다. */
    .row { grid-template-columns: 124px 1fr; gap: 14px; align-items: start; }
    /* 원본이 16:9 다. 4:3 으로 억지로 맞추면 잘리거나 흰 띠가 생긴다. 비율은 그대로 두고 폭만 키운다. */
    .row-thumb { width: 124px; aspect-ratio: 16 / 9; }
    .row-dek { display: none; }
    .row-date { grid-column: 2; margin-top: 8px; }
  }
  .row-title { font-size: 18px; font-weight: 700; line-height: 1.5; }
  .row:hover .row-title { color: var(--accent); }
  .row-dek { font-size: 13.5px; color: var(--sub); margin-top: 6px; line-height: 1.7; }
  .row-date { font-size: 11px; color: var(--muted); flex-shrink: 0; }
  .empty {
    text-align: center;
    padding: 64px 0;
    color: var(--sub);
    font-size: 14.5px;
  }
  .empty :global(img) { border-radius: 50%; border: 1px solid var(--hair); margin-bottom: 14px; }
</style>
