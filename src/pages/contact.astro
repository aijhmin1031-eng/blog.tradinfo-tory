---
// 협업 문의 — 협업 착지 페이지.
// 용역을 수주하는 페이지가 아니다. 강의·자문·공동 개발처럼 같이 하는 일을 여는 자리다.
// 운영자를 익명으로 두는 대신 이 사이트 자체를 증거로 내세운다. 수치는 전부 빌드 시점 실측이라
// 손으로 고칠 일이 없고, 내용이 늘면 이 페이지의 근거도 같이 자란다.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url, isPublished } from '../lib/site';
import { GLOSSARY } from '../lib/glossary';
import { ALL_ITEMS } from '../data/pack';

const posts = await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate));
const scheduled = await getCollection('posts', ({ data }) => !data.draft && !isPublished(data.pubDate));
const termCount = Object.keys(GLOSSARY).length;

const proof = [
  {
    n: '4곳',
    label: '자동 수집 중인 공공 API',
    note: '한국은행 ECOS · 미 연준 FRED · 관세청 · 금융감독원 DART. 매일 아침 6시 50분에 스스로 거둬 옵니다.',
    href: '/warehouse/',
    hrefLabel: '수집 결과 보기',
  },
  {
    n: `${posts.length}편`,
    label: '사람 손 없이 발행된 기사',
    note: `예약분 ${scheduled.length}편이 날짜 게이트를 기다리고 있습니다. 발행일이 되면 그날 아침 빌드가 스스로 내보냅니다.`,
    href: '/forest/',
    hrefLabel: '기사 보기',
  },
  {
    n: `${ALL_ITEMS.length}장`,
    label: '자동 생성된 이미지 페이지',
    note: '등록부 파일 한 곳만 고치면 낱장 페이지와 이미지 사이트맵, 구조화 데이터가 함께 만들어집니다.',
    href: '/pack/',
    hrefLabel: '그림함 보기',
  },
  {
    n: `${termCount}개`,
    label: '본문과 연동된 용어 사전',
    note: '기사 안의 용어 칩이 사전 항목과 자동으로 이어집니다. 사전에 한 줄 넣으면 모든 기사에 반영됩니다.',
    href: '/glossary/',
    hrefLabel: '사전 보기',
  },
];

const desc =
  'AI 자동화와 데이터 수집·시각화를 주제로 강의, 자문, 공동 개발을 함께합니다. ' +
  '이 블로그가 매일 아침 네 곳의 공공 API에서 지표를 스스로 거둬 기사와 대시보드로 바꾸는 방식 그대로입니다.';
---

<Base title="협업 문의" description={desc} compact footerNewsletter={false}>
  <section class="wrap ct-head">
    <div class="kicker-en" style="color: var(--accent);">COLLABORATION</div>
    <h1 class="serif ct-title">협업 문의</h1>
    <p class="ct-sub">
      도토리경제는 사람이 매일 앉아서 쓰는 블로그가 아닙니다. 네 곳의 공공 API에서 지표를 거둬 오고,
      검증하고, 기사와 대시보드로 바꾸고, 배포까지 하는 일을 <strong>매일 아침 6시 50분에 스스로</strong> 합니다.
      이 구조를 만들며 겪은 것이 도움이 될 만한 자리가 있다면 편하게 말씀해 주십시오.
      맡아서 대신 만들어 드리는 자리가 아니라, 같이 하는 자리입니다.
    </p>
  </section>

  <section class="wrap ct-what">
    <h2 class="serif ct-h2">함께할 수 있는 일</h2>
    <div class="ct-cards three">
      <div class="ct-card">
        <div class="ct-card-title serif">강의와 워크숍</div>
        <p class="ct-card-lead">해 본 것만 이야기합니다.</p>
        <ul>
          <li>AI로 콘텐츠·이미지를 만들고 검수하는 실제 절차</li>
          <li>공공 API에서 지표를 거둬 대시보드까지 잇는 흐름</li>
          <li>Power Query·Power Pivot·Power BI 실무</li>
        </ul>
      </div>
      <div class="ct-card">
        <div class="ct-card-title serif">컨설팅과 자문</div>
        <p class="ct-card-lead">구조를 같이 잡습니다.</p>
        <ul>
          <li>어디까지 자동에 맡기고 어디부터 사람이 볼지 경계 잡기</li>
          <li>이미 굴리고 있는 자동화의 구멍 점검</li>
          <li>데이터 검증 규칙 설계(원자료 대조·이상값 적발)</li>
        </ul>
      </div>
      <div class="ct-card">
        <div class="ct-card-title serif">공동 개발</div>
        <p class="ct-card-lead">같이 만들고 같이 굴립니다.</p>
        <ul>
          <li>서로 가진 것을 합쳐 하나를 만드는 프로젝트</li>
          <li>운영까지 이어지는 자동화 체계 구축</li>
          <li>결과물과 배운 것을 양쪽이 가져가는 방식</li>
        </ul>
      </div>
    </div>
    <p class="ct-note">
      분야는 크게 둘입니다. <strong>데이터 수집·분석과 대시보드</strong>, 그리고 <strong>AI 자동화 시스템</strong>.
      이 블로그가 두 가지를 동시에 굴리고 있는 결과물입니다.
    </p>
  </section>

  <section class="wrap ct-proof">
    <h2 class="serif ct-h2">말 대신, 지금 돌아가는 것</h2>
    <p class="ct-note">
      아래 숫자는 이 페이지가 만들어질 때 실제로 세어 본 값입니다. 손으로 적지 않았고, 내용이 늘면 함께 자랍니다.
      전부 눌러서 확인하실 수 있습니다.
    </p>
    <div class="ct-proof-grid">
      {
        proof.map((p) => (
          <div class="ct-proof-item">
            <div class="ct-n mono">{p.n}</div>
            <div class="ct-label">{p.label}</div>
            <p class="ct-pnote">{p.note}</p>
            <a href={url(p.href)}>{p.hrefLabel}</a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap ct-how">
    <h2 class="serif ct-h2">이야기를 시작하는 방법</h2>
    <ol class="ct-steps">
      <li><strong>먼저 대화</strong> · 무엇을 해보고 싶은지 한 줄이면 충분합니다. 정리되지 않았어도 괜찮습니다.</li>
      <li><strong>서로 가진 것 확인</strong> · 각자 무엇을 들고 있고 무엇이 없는지 맞춰 봅니다. 여기서 함께할 형태가 정해집니다.</li>
      <li><strong>작게 시작</strong> · 문서보다 도는 물건이 빠릅니다. 작은 것 하나를 먼저 굴려 보고 판단합니다.</li>
      <li><strong>각자 가져갈 것</strong> · 결과물과 배운 것을 양쪽이 나눠 가지는 선에서 정리합니다.</li>
    </ol>
  </section>

  <section class="wrap ct-mail">
    <h2 class="serif ct-h2">문의</h2>
    <p class="ct-note">
      아래 주소로 보내 주십시오. <strong>무엇을 함께하고 싶은지 한 줄, 하시는 일, 생각하시는 형태
      (강의·자문·공동 개발)</strong>를 담아 주시면 이야기가 빨라집니다. 확인하는 대로 회신드립니다.
    </p>
    <p class="contact-mail" id="contact-mail" aria-label="문의 이메일">
      <noscript>이메일 주소는 스팸 방지를 위해 스크립트로 표시됩니다. dotori (점) workroom (골뱅이) gmail (점) com</noscript>
    </p>
    <p class="ct-fine">
      이 블로그는 캐릭터 토리의 이름으로 씁니다. 실제 논의가 시작되면 신원과 이력을 밝히고 진행합니다.
      먼저 만들어 둔 것을 보시고 판단하시라는 뜻입니다.
    </p>
  </section>

  <section class="wrap ct-etc">
    <h2 class="serif ct-h2">그 밖의 연락</h2>
    <ul class="ct-etc-list">
      <li><strong>제보와 정정</strong> · 데이터 오류 제보는 가장 큰 도움입니다. 확인되면 해당 기사에 정정 사실과 일시를 남기고, 원문은 지우지 않습니다.</li>
      <li><strong>의견과 주제 제안</strong> · 기사 하단 댓글, 또는 <a href={url('/board/')}>도토리 광장</a>으로 남겨 주십시오.</li>
      <li><strong>인용과 공유</strong> · 출처(도토리경제)를 표기하시면 기사와 차트를 자유롭게 인용하실 수 있습니다. 그림은 <a href={url('/pack/')}>그림함</a>에서 무료로 나눕니다.</li>
      <li><strong>투자 자문 아님</strong> · 이 사이트의 내용은 정보 제공을 목적으로 합니다.</li>
    </ul>
  </section>
</Base>

<script>
  // 스팸 수집기 회피를 위해 주소를 런타임에 조립한다.
  const u = ['dotori', 'workroom'].join('.');
  const d = ['gmail', 'com'].join('.');
  const addr = u + '@' + d;
  const el = document.getElementById('contact-mail');
  if (el) {
    const a = document.createElement('a');
    a.href = 'mailto:' + addr + '?subject=' + encodeURIComponent('[도토리경제] 협업 문의');
    a.textContent = addr;
    a.className = 'mail-link';
    el.prepend(a);
  }
</script>

<style>
  .ct-head { padding-top: 46px; max-width: var(--measure-wide); }
  .ct-title { font-size: clamp(30px, 4.6vw, 42px); font-weight: 900; color: var(--ink); margin-top: 6px; }
  .ct-sub { font-size: 15px; color: var(--sub); line-height: 1.95; margin-top: 14px; word-break: keep-all; }
  .ct-h2 { font-size: 19px; font-weight: 900; color: var(--ink); border-bottom: 2px solid var(--ink); padding-bottom: 10px; }
  .ct-note { font-size: 13.5px; color: var(--sub); line-height: 1.9; margin-top: 14px; max-width: var(--measure-wide); word-break: keep-all; }

  .ct-what { margin-top: 44px; }
  .ct-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
  .ct-cards.three { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 900px) { .ct-cards.three { grid-template-columns: 1fr; } }
  .ct-card-lead { font-size: 12.5px; color: var(--accent); font-weight: 700; margin-top: 6px; }
  @media (max-width: 760px) { .ct-cards { grid-template-columns: 1fr; } }
  .ct-card { border: 1px solid var(--line); border-radius: 12px; padding: 20px 22px; background: var(--paper); }
  .ct-card-title { font-size: 17px; font-weight: 900; color: var(--ink); }
  .ct-card ul { margin: 12px 0 0; padding-left: 18px; }
  .ct-card li { font-size: 13px; color: var(--sub); line-height: 1.9; word-break: keep-all; }

  .ct-proof { margin-top: 44px; }
  .ct-proof-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; margin-top: 20px; }
  .ct-proof-item { border-top: 2px solid var(--ink); padding-top: 12px; }
  .ct-n { font-size: 26px; font-weight: 900; color: var(--accent); }
  .ct-label { font-size: 13px; font-weight: 700; color: var(--ink); margin-top: 3px; }
  .ct-pnote { font-size: 12px; color: var(--sub); line-height: 1.8; margin-top: 7px; word-break: keep-all; }
  .ct-proof-item a { display: inline-block; font-size: 12px; font-weight: 700; color: var(--accent); margin-top: 8px; }

  .ct-how { margin-top: 44px; }
  .ct-steps { margin: 18px 0 0; padding-left: 20px; }
  .ct-steps li { font-size: 13.5px; color: var(--sub); line-height: 1.95; padding-left: 4px; margin-bottom: 6px; word-break: keep-all; }

  .ct-mail { margin-top: 44px; }
  .contact-mail { font-size: 19px; font-weight: 700; margin-top: 16px; }
  .contact-mail :global(.mail-link) { color: var(--accent); border-bottom: 2px solid var(--accent); padding-bottom: 1px; }
  .ct-fine { font-size: 12px; color: var(--muted); line-height: 1.85; margin-top: 16px; max-width: var(--measure); word-break: keep-all; }

  .ct-etc { margin: 44px 0 56px; }
  .ct-etc-list { margin: 16px 0 0; padding-left: 18px; }
  .ct-etc-list li { font-size: 13px; color: var(--sub); line-height: 1.9; margin-bottom: 6px; word-break: keep-all; }
</style>
