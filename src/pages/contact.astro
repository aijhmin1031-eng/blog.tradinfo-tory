---
// 협업 문의 — 2026-09-05 전면 개편에 맞춰 다시 썼다.
//
// 그전 판은 개편으로 폐기된 개념 위에 서 있었다: 「사람이 매일 앉아서 쓰는 블로그가
// 아닙니다」·「자동 생성된 이미지 페이지」·캐릭터 서명, 그리고 지워진 구역(`/forest/`·
// `/warehouse/`·`/pack/`)으로 가는 링크 넷. 편집 규약 2·3·4 에 정면으로 걸린다.
//
// 이 페이지는 설계 7종에 없다. 조판은 승인된 설계의 규약(64px 여백 · 표제부 + 지표 띠 ·
// 절마다 본문과 여백주)을 그대로 따르되 내용은 이 페이지의 것이다.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { GLOSSARY } from '../lib/glossary';
import { GROUPS, loadSeries } from '../lib/numbers';
import { url } from '../lib/site';

const corps = await getCollection('corps', ({ data }) => !data.draft);
const termCount = Object.keys(GLOSSARY).length;
const indicatorCount = GROUPS.reduce(
  (a, g) => a + g.ids.filter((id) => (loadSeries(id) as any)?.points?.length).length,
  0
);

// 지표는 손으로 적지 않는다 — 컬렉션과 계열에서 센다.
const stat = [
  { k: '공식 자료원', v: '6', n: '금융감독원 DART · 한국은행 ECOS · 미국 연방준비제도 FRED · 금융위원회 · 조달청 · 관세청' },
  { k: '분석 보고서', v: String(corps.length), n: '정기보고서 단위로 개정' },
  { k: '공개 지표', v: String(indicatorCount), n: '매일 06:50 갱신 · 기준일과 출처 표기' },
  { k: '용어 항목', v: String(termCount), n: '본문 용어 표시와 연결' },
];

const areas = [
  {
    n: '1', k: '강의 및 워크숍',
    v: '공공 API에서 지표를 수집하여 검증·축적·시각화에 이르는 절차를 실제 구현 사례로 다룹니다. 표 계산 도구의 질의·집계 기능과 대시보드 작성도 포함합니다.',
  },
  {
    n: '2', k: '자문',
    v: '수집 체계의 구조를 함께 설계합니다. 원자료 대조와 이상값 적발을 포함한 검증 규칙, 그리고 사람이 확인해야 하는 지점의 경계 설정이 주된 주제입니다.',
  },
  {
    n: '3', k: '공동 개발',
    v: '수집에서 배포까지 이어지는 체계를 함께 구축하고 운영합니다. 산출물과 축적한 방법을 양측이 함께 보유하는 방식으로 진행합니다.',
  },
];

const steps: [string, string][] = [
  ['대화', '어떤 일을 구상하고 계신지 한 줄이면 충분합니다. 정리되지 않은 단계라도 무방합니다.'],
  ['범위 확인', '각자 보유한 자료와 필요한 부분을 대조하여 협업의 형태를 정합니다.'],
  ['소규모 착수', '문서보다 동작하는 결과가 빠릅니다. 작은 범위를 먼저 구현하여 판단합니다.'],
  ['정리', '산출물과 축적한 방법을 양측이 나누어 보유하는 선에서 마무리합니다.'],
];

const desc =
  '데이터 수집 체계 구축과 지표 시각화를 주제로 강의·자문·공동 개발을 함께합니다. ' +
  '이 사이트가 6개 공식 자료원에서 지표를 수집하여 분석 보고서와 계산 도구로 공개하는 방식 그대로입니다.';
---

<Base title="협업 문의" description={desc} activeNav="">
  <section class="th">
    <div class="wrap">
      <div class="kick">문의</div>
      <h1>협업 문의</h1>
      <p class="lead">
        도토리경제는 6개 공식 자료원에서 지표를 수집하여 검증하고, 분석 보고서와 계산 도구로
        공개합니다. 이 체계를 구축하며 축적한 절차가 도움이 될 만한 자리가 있다면 말씀해 주십시오.
        대행이 아니라 함께 만드는 형태를 전제합니다.
      </p>
      <div class="strip">
        {stat.map((s) => (
          <div class="strip-c">
            <div class="strip-k">{s.k}</div>
            <div class="strip-v mono">{s.v}</div>
            <div class="strip-n">{s.n}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="tb">
    <section class="sec">
      <div>
        <div class="sec-k">협업 범위</div>
        <h2 class="sec-h">강의 · 자문 · 공동 개발</h2>
        <p class="tx">
          분야는 둘입니다. <b>데이터 수집·검증과 지표 시각화</b>, 그리고 <b>수집에서 배포까지의
          운영 체계</b>입니다. 이 사이트가 두 가지를 동시에 운영하고 있는 결과물입니다.
        </p>
        <div class="panes">
          {areas.map((a) => (
            <div class="pane">
              <div class="pane-h">
                <span class="pane-n mono">{a.n}</span>
                <span class="pane-k">{a.k}</span>
              </div>
              <div class="pane-v">{a.v}</div>
            </div>
          ))}
        </div>
      </div>
      <aside class="side">
        <div class="side-h">참고자료</div>
        <dl>
          <dt>분석 보고서</dt><dd><a href={url('/corp/')}>기업 분석</a></dd>
          <dt>계산 도구</dt><dd><a href={url('/tools/')}>지원 도구</a></dd>
          <dt>수집 지표</dt><dd><a href={url('/numbers/')}>오늘의 지표</a></dd>
        </dl>
      </aside>
    </section>

    <section class="sec">
      <div>
        <div class="sec-k">진행 절차</div>
        <h2 class="sec-h">착수까지 4단계</h2>
        <div class="tw">
          <table class="t">
            <caption>협업 진행 절차</caption>
            <thead><tr><th class="n">단계</th><th>구분</th><th>내용</th></tr></thead>
            <tbody>
              {steps.map(([k, v], i) => (
                <tr><td class="n">{i + 1}</td><td><b>{k}</b></td><td>{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="tx">
          문의하실 때 <b>구상하시는 일 한 줄, 하시는 일, 생각하시는 형태(강의·자문·공동 개발)</b>를
          함께 적어 주시면 절차가 빨라집니다. 확인하는 대로 회신드립니다.
        </p>
        <p class="mail" id="contact-mail" aria-label="문의 전자우편 주소">
          <noscript>전자우편 주소는 수집 방지를 위해 스크립트로 표시됩니다. dotori (점) workroom (골뱅이) gmail (점) com</noscript>
        </p>
      </div>
      <aside class="side">
        <div class="side-h">그 밖의 연락</div>
        <dl>
          <dt>정정 요청</dt><dd>수치 오류를 알려 주시면 해당 보고서에 정정 사실과 일시를 남기고 원문은 삭제하지 않습니다.</dd>
          <dt>인용</dt><dd>출처(도토리경제)와 기준일을 표기하시면 표와 도표를 인용하실 수 있습니다.</dd>
          <dt>고지</dt><dd>본 사이트의 내용은 정보 제공을 목적으로 하며 투자 자문이 아닙니다.</dd>
        </dl>
      </aside>
    </section>
  </div>
</Base>

<script>
  // 수집기 회피를 위해 주소를 실행 시점에 조립한다.
  const u = ['dotori', 'workroom'].join('.');
  const d = ['gmail', 'com'].join('.');
  const addr = u + '@' + d;
  const el = document.getElementById('contact-mail');
  if (el) {
    const a = document.createElement('a');
    a.href = 'mailto:' + addr + '?subject=' + encodeURIComponent('[도토리경제] 협업 문의');
    a.textContent = addr;
    a.className = 'mail-link';
    el.prepend(a);
  }
</script>

<style>
  .wrap { max-width: 1440px; margin: 0 auto; padding: 0 64px; }
  .th { background: #fff; border-bottom: 1px solid #e4e4de; padding: 54px 0 42px; }
  .kick { font-size: 10.5px; font-weight: 600; letter-spacing: 1.6px; color: #8e9299; margin-bottom: 18px; }
  h1 { font-size: 44px; line-height: 1.34; font-weight: 900; color: #15171a; margin: 0 0 26px; letter-spacing: -1.8px; }
  .lead { font-size: 17px; line-height: 1.95; color: #2e3238; max-width: 900px; margin: 0 0 34px; }
  .strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px;
           background: #e4e4de; border-top: 1.6px solid #15171a; border-bottom: 1px solid #e4e4de; }
  .strip-c { background: #fff; padding: 17px 22px 18px; }
  .strip-k { font-size: 12px; color: #71767d; margin-bottom: 8px; }
  .strip-v { font-size: 24px; font-weight: 500; color: #15171a; letter-spacing: -0.7px; }
  .strip-n { font-size: 11.5px; color: #8e9299; margin-top: 7px; line-height: 1.65; }

  .tb { max-width: 1440px; margin: 0 auto; padding: 12px 64px 54px; }
  .sec { display: grid; grid-template-columns: minmax(0, 1fr) 268px; gap: 52px;
         padding: 34px 0 38px; border-top: 1px solid #e4e4de; align-items: start; }
  .sec:first-child { border-top: none; }
  .sec-k { font-size: 11px; font-weight: 600; letter-spacing: 2.2px; color: #9a6b22; margin-bottom: 11px; }
  .sec-h { font-size: 26px; font-weight: 900; color: #15171a; letter-spacing: -0.95px; line-height: 1.45; margin: 0 0 18px; }
  .tx { font-size: 15px; line-height: 2; color: #3c4046; margin: 0 0 19px; }
  .tx b { font-weight: 600; color: #15171a; }

  .panes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 34px; margin-top: 4px; }
  .pane { border-top: 2px solid #16355e; padding-top: 14px; }
  .pane-h { display: flex; align-items: baseline; gap: 9px; margin-bottom: 9px; }
  .pane-n { font-size: 11px; color: #fff; background: #15171a; padding: 3px 8px; }
  .pane-k { font-size: 15px; font-weight: 800; color: #15171a; }
  .pane-v { font-size: 13.5px; line-height: 1.9; color: #4a4f56; }

  table.t { width: 100%; border-collapse: collapse; margin: 4px 0 22px; }
  .t caption { caption-side: top; text-align: left; font-size: 12px; color: #71767d; padding-bottom: 10px; }
  .t th { font-size: 12px; font-weight: 600; color: #71767d; text-align: left;
          padding: 0 14px 9px 0; border-bottom: 1.6px solid #15171a; white-space: nowrap; }
  .t td { font-size: 13.5px; line-height: 1.75; color: #3c4046; padding: 12px 14px 12px 0;
          border-bottom: 1px solid #eaeae4; vertical-align: top; }
  .t th.n, .t td.n { text-align: right; padding-left: 16px; }
  .t th:last-child, .t td:last-child { padding-right: 0; }
  .t td.n { font-family: 'IBM Plex Mono', 'IBM Plex Sans KR', monospace; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .t tr:last-child td { border-bottom: none; }
  .t td b { font-weight: 600; color: #15171a; }

  .mail { font-size: 20px; font-weight: 700; margin: 0; }
  .mail :global(.mail-link) { color: #16355e; border-bottom: 2px solid #16355e; padding-bottom: 1px; text-decoration: none; }

  .side { border-top: 1.6px solid #d2d2ca; padding-top: 14px; }
  .side-h { font-size: 11px; font-weight: 600; letter-spacing: 1.6px; color: #9a6b22; margin-bottom: 12px; }
  .side dl { margin: 0; }
  .side dt { font-size: 11.5px; color: #8e9299; margin-top: 11px; }
  .side dt:first-of-type { margin-top: 0; }
  .side dd { font-size: 12.5px; color: #4a4f56; line-height: 1.7; margin: 3px 0 0; }
  .side dd a { color: #16355e; text-decoration: none; border-bottom: 1px solid #d2d2ca; }
  .side dd a:hover { border-bottom-color: #16355e; }
  .mono { font-family: 'IBM Plex Mono', 'IBM Plex Sans KR', monospace; font-variant-numeric: tabular-nums; }

  @media (max-width: 720px) {
    .wrap, .tb { padding-left: 20px; padding-right: 20px; }
    h1 { font-size: 27px; letter-spacing: -1.1px; }
    .lead { font-size: 15px; line-height: 1.9; }
    .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sec { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    .sec-h { font-size: 20px; letter-spacing: -0.7px; }
    .tx { font-size: 14.5px; line-height: 1.95; }
    .panes { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .tw { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .tw > table { min-width: 560px; }
    .mail { font-size: 16px; word-break: break-all; }
  }
</style>
