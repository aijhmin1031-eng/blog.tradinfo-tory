---
// 데이터 데스크 — 우리가 가진 계열 전부를 표와 그래프로 놓는 자리.
//
// 소유주 지시(2026-08-31): **해석은 여기서 하지 않는다.** 「그래서 무엇을 뜻하는가」는
//   기사가 맡고, 이 화면은 수치·시계열·관계만 보인다. 대신 각 항목에 **관련 기사 링크**를
//   붙여 해석이 필요한 독자가 건너갈 수 있게 했다(빈 페이지로 보이지 않게 하는 길이기도 하다).
//
// 구조는 univer-radar(소유주의 대입 분석 도구)에서 가져왔다 — 좌 메뉴·중앙 게시판·우 미리보기.
//   그 도구가 통한 이유는 대시보드가 아니라 **개체별로 들어가 볼 수 있다는 것**이었다.
//
// ★ 정렬은 **그려진 글자가 아니라 데이터를 정렬한다.** univer-radar 는 표의 HTML 을 되읽어
//   숫자를 파싱했고(`sv()`), 그래서 「만원→원」·「음수」·「미공개」를 손으로 다 처리해야 했다.
//   여기서는 값을 숫자 그대로 들고 있으므로 그 함정이 아예 생기지 않는다.
//
// ★ Astro 스코프 CSS 함정: **JS 가 런타임에 만든 요소에는 스코프 해시가 안 붙는다.**
//   표의 행을 스크립트가 그리므로 스코프 규칙이 닿지 않는다. 그래서 이 페이지의 style 은
//   `is:global` 이고, 대신 전부 `.dk` 아래로 가둬 다른 페이지로 새지 않게 했다.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url, isPublished, todayIn, TZ_KST } from '../../lib/site';
import { buildDesk } from '../../lib/desk';
import { PICTOGRAMS } from '../../lib/pictograms';
import { flagUrl } from '../../lib/flags';

const sections = buildDesk();
const total = sections.reduce((a, s) => a + s.rows.length, 0);

// ── 계열 → 그 계열을 쓴 기사 ────────────────────────────────
// **발행된 기사만** 모은다. 예약 기사로 링크하면 독자에게 404 가 간다(운영 규칙).
const posts = await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate));
const usedBy: Record<string, { slug: string; title: string }[]> = {};
for (const p of posts) {
  const seen = new Set<string>();
  for (const m of p.body.matchAll(/series=["']([a-zA-Z0-9_]+)["']/g)) seen.add(m[1]);
  for (const id of seen) (usedBy[id] ??= []).push({ slug: p.slug ?? p.id, title: p.data.title });
}

// 화면에 넘길 표 정의. 갈래마다 칸이 다르므로 여기서 정하고 게시판은 갈래를 모른다.
const N = (key: string, label: string, opts: any = {}) => ({ key, label, num: true, ...opts });
const COLS: Record<string, any[]> = {
  indicators: [
    { key: 'name', label: '지표' },
    N('value', '현재값'), N('diff', '직전 대비', { signed: true }),
    { key: 'asOf', label: '기준일' }, N('n', '관측수', { frac: 0 }),
  ],
  countries: [
    { key: 'name', label: '국가', flag: true },
    N('exp', '수출', { frac: 1 }), N('imp', '수입', { frac: 1 }), N('bal', '수지', { signed: true, frac: 1 }),
    N('unitExp', '수출 $/kg', { frac: 2 }), { key: 'asOf', label: '기준월' },
  ],
  items: [
    { key: 'name', label: '품목' }, { key: 'hs', label: 'HS' },
    N('exp', '수출', { frac: 1 }), N('imp', '수입', { frac: 1 }), N('bal', '수지', { signed: true, frac: 1 }),
    N('unitExp', '수출 $/kg', { frac: 2 }), { key: 'asOf', label: '기준월' },
  ],
  chips: [
    { key: 'name', label: '경로', flag: true },
    N('exp', '수출', { frac: 1 }), N('imp', '수입', { frac: 1 }), N('bal', '수지', { signed: true, frac: 1 }),
    N('unitExp', '수출 $/kg', { frac: 2 }), { key: 'asOf', label: '기준월' },
  ],
  stocks: [
    { key: 'name', label: '종목' }, N('value', '종가'), N('diff', '직전 대비', { signed: true }),
    { key: 'asOf', label: '기준일' },
  ],
  customsfx: [
    { key: 'name', label: '통화' }, N('value', '과세환율', { frac: 2 }),
    { key: 'asOf', label: '적용 개시' },
  ],
};

const payload = sections.map((s) => ({
  key: s.key, name: s.name, note: s.note, cols: COLS[s.key] ?? COLS.indicators,
  rows: s.rows.map((r) => ({ ...r, flag: r.cc ? flagUrl(r.cc) : undefined, posts: usedBy[r.id] ?? [] })),
}));

const asOf = todayIn(TZ_KST);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '도토리경제 데이터 데스크',
  description: `한국은행 ECOS·미 연준 FRED·관세청·금융위원회에서 매일 자동 수집하는 경제·무역 시계열 ${total}종. 경제지표, 국가별·품목별 수출입실적과 kg당 단가, 관심 종목 주가, 관세환율을 표와 그래프로 제공한다.`,
  url: 'https://dotoriecon.com/desk/',
  isAccessibleForFree: true,
  dateModified: asOf,
  creator: { '@type': 'Organization', name: '도토리경제', url: 'https://dotoriecon.com/' },
};
---

<Base
  title="데이터 데스크"
  description={`경제지표·국가별 무역·품목별 무역·주가·관세환율 ${total}종을 표와 그래프로. 매일 아침 자동 갱신되며 값마다 기준일과 출처를 함께 적었습니다.`}
  compact
  activeNav="warehouse"
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />

  <div class="wrap dk">
    <header class="dk-head">
      <div class="kicker-en" style="color: var(--accent);">DATA DESK</div>
      <h1 class="serif dk-title">데이터 데스크</h1>
      <p class="dk-sub">
        매일 아침 자동 수집하는 계열 <strong>{total}종</strong>입니다.
        값마다 기준일과 출처를 함께 적었습니다. 항목을 고르면 오른쪽에 시계열이 그려집니다.
      </p>
    </header>

    <div class="dk-shell">
      <nav class="dk-side" aria-label="갈래">
        {payload.map((s, i) => (
          <button class:list={['dk-menu', i === 0 && 'is-on']} data-sec={s.key} type="button">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" set:html={PICTOGRAMS[sections[i].icon] ?? ''} />
            <span class="dk-menu-t">{s.name}</span>
            <span class="dk-menu-n mono">{s.rows.length}</span>
          </button>
        ))}
        <p class="dk-side-foot">
          자료: 한국은행 ECOS · 미 연준 FRED · 관세청 · 금융위원회<br />기준 {asOf} KST
        </p>
      </nav>

      <main class="dk-main">
        <div class="dk-bar">
          <label class="dk-search">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M15.8 15.8 L20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            <input type="search" id="dk-q" placeholder="이름·코드로 거르기" autocomplete="off" />
          </label>
          <span class="dk-count mono" id="dk-count"></span>
        </div>
        <div class="dk-tablewrap">
          <table class="dk-t"><thead id="dk-head"></thead><tbody id="dk-body"></tbody></table>
        </div>
        <div class="dk-page" id="dk-page"></div>
      </main>

      <aside class="dk-pv" id="dk-pv" aria-live="polite">
        <p class="dk-pv-empty">왼쪽 표에서 항목을 고르면<br />시계열과 출처가 여기 나옵니다.</p>
      </aside>
    </div>
  </div>

  <style is:global>
    /* ★ is:global 인 이유: 표의 행을 JS 가 만들기 때문이다(스코프 해시가 안 붙는다).
       대신 모든 규칙을 .dk 아래로 가둬 다른 페이지에 새지 않게 했다. */
    /* ★ 좌우는 건드리지 않는다. 단축 padding 으로 쓰면 `.wrap` 의 `padding: 0 18px`(모바일)·
       `0 24px`(데스크톱)를 0 으로 덮어써서 **390px 에서 글자가 화면 끝에 붙는다.**
       데스크톱은 max-width 여유 때문에 티가 안 나 눈으로는 못 잡는다(2026-08-31 실측으로 잡았다).
       CLAUDE.md 「단축 margin·padding 이 .wrap 의 가운데 정렬을 죽인다」와 같은 계열의 사고다. */
    .dk { margin: 0 auto; padding-top: 30px; padding-bottom: 60px; }
    .dk-head { margin: 0 0 22px; }
    .dk-title { font-size: 30px; margin: 4px 0 8px; }
    .dk-sub { color: var(--muted); font-size: 14px; line-height: 1.75; max-width: 62ch; word-break: keep-all; }
    .dk-shell { display: grid; grid-template-columns: 194px minmax(0, 1fr) 316px; gap: 18px; align-items: start; }

    .dk-side { position: sticky; top: 96px; border: 1px solid var(--hair); border-radius: 8px; background: var(--surface); padding: 8px; }
    .dk-menu { display: flex; align-items: center; gap: 9px; width: 100%; padding: 9px 10px; border: 0; border-radius: 6px;
      background: none; color: var(--muted); font: inherit; font-size: 13.5px; cursor: pointer; text-align: left; }
    .dk-menu:hover { background: var(--hair2); color: var(--ink); }
    .dk-menu.is-on { background: var(--tint, var(--hair2)); color: var(--ink); font-weight: 700; box-shadow: inset 2px 0 0 var(--accent); }
    .dk-menu-t { flex: 1; }
    .dk-menu-n { font-size: 11px; color: var(--muted); }
    .dk-side-foot { margin: 10px 8px 4px; font-size: 10.5px; line-height: 1.6; color: var(--muted); }

    /* ★ 그리드 자식은 기본 min-width 가 auto 라, 안에 든 표의 min-width(560px)가
       칸을 그만큼 넓혀 **페이지 전체에 가로 스크롤**을 만든다(390px 에서 172px 넘쳤다).
       overflow-x:auto 를 걸어 둔 것만으로는 막히지 않는다 — 줄어들 수 있어야 스크롤이 생긴다. */
    .dk-main { min-width: 0; }
    .dk-bar { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
    .dk-search { display: flex; align-items: center; gap: 7px; flex: 1; max-width: 320px; padding: 7px 11px;
      border: 1px solid var(--hair); border-radius: 6px; background: var(--surface); color: var(--muted); }
    .dk-search input { flex: 1; border: 0; background: none; font: inherit; font-size: 13px; color: var(--ink); outline: none; }
    .dk-count { font-size: 11.5px; color: var(--muted); }

    .dk-tablewrap { overflow-x: auto; border: 1px solid var(--hair); border-radius: 8px; background: var(--surface); }
    .dk-t { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 560px; }
    .dk-t th, .dk-t td { padding: 8px 11px; border-bottom: 1px solid var(--hair2); text-align: left; white-space: nowrap; }
    .dk-t thead th { font-size: 11px; letter-spacing: .04em; color: var(--muted); font-weight: 700;
      background: var(--paper); cursor: pointer; user-select: none; position: sticky; top: 0; z-index: 1; }
    .dk-t thead th:hover { color: var(--ink); }
    .dk-t thead th.r, .dk-t td.r { text-align: right; }
    .dk-t tbody tr { cursor: pointer; }
    .dk-t tbody tr:hover { background: var(--hair2); }
    .dk-t tbody tr.is-sel { background: var(--hair2); box-shadow: inset 2px 0 0 var(--accent); }
    .dk-t .mono { font-variant-numeric: tabular-nums; }
    .dk-nm { display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--ink); }
    .dk-nm img { width: 20px; height: 15px; object-fit: cover; border: 1px solid var(--hair); border-radius: 2px; flex: none; }
    .dk-nm svg { color: var(--muted); flex: none; }
    .dk-up { color: var(--up); } .dk-down { color: var(--down); }
    .dk-sort { opacity: .45; font-size: 9px; }
    .dk-empty { padding: 26px 12px; text-align: center; color: var(--muted); font-size: 13px; }

    .dk-page { display: flex; align-items: center; gap: 6px; margin-top: 10px; }
    .dk-page button { padding: 5px 10px; border: 1px solid var(--hair); border-radius: 5px; background: var(--surface);
      color: var(--muted); font: inherit; font-size: 12px; cursor: pointer; }
    .dk-page button:disabled { opacity: .4; cursor: default; }
    .dk-page button.is-on { border-color: var(--accent); color: var(--accent); font-weight: 700; }

    .dk-pv { position: sticky; top: 96px; border: 1px solid var(--hair); border-radius: 8px; background: var(--surface);
      padding: 15px; min-height: 260px; }
    .dk-pv-empty { color: var(--muted); font-size: 12.5px; line-height: 1.8; text-align: center; padding: 60px 0; }
    .dk-pv-t { font-size: 15px; font-weight: 700; margin: 0 0 2px; display: flex; align-items: center; gap: 8px; }
    .dk-pv-t img { width: 22px; height: 16.5px; object-fit: cover; border: 1px solid var(--hair); border-radius: 2px; }
    .dk-pv-s { font-size: 11px; color: var(--muted); margin: 0 0 12px; }
    .dk-pv-g { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 0 0 13px; }
    .dk-pv-c { border: 1px solid var(--hair2); border-radius: 6px; padding: 7px 9px; }
    .dk-pv-c dt { font-size: 10px; color: var(--muted); margin-bottom: 2px; }
    .dk-pv-c dd { margin: 0; font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; }
    .dk-pv-chart { border: 1px solid var(--hair2); border-radius: 6px; padding: 8px; margin-bottom: 12px; }
    .dk-pv-chart svg { display: block; width: 100%; height: auto; }
    .dk-pv-note { font-size: 10.5px; color: var(--muted); line-height: 1.65; }
    .dk-pv-links { margin: 12px 0 0; padding: 11px 0 0; border-top: 1px solid var(--hair2); }
    .dk-pv-links h4 { font-size: 10.5px; color: var(--muted); margin: 0 0 6px; font-weight: 700; letter-spacing: .04em; }
    .dk-pv-links a { display: block; font-size: 12.5px; line-height: 1.5; margin-bottom: 5px; color: var(--ink); text-decoration: none; word-break: keep-all; }
    .dk-pv-links a:hover { color: var(--accent); text-decoration: underline; }

    @media (max-width: 1080px) {
      .dk-shell { grid-template-columns: 1fr; }
      .dk-side { position: static; display: flex; flex-wrap: wrap; gap: 4px; }
      .dk-menu { width: auto; }
      .dk-side-foot { flex-basis: 100%; }
      .dk-pv { position: static; }
    }
  </style>

  <script is:inline define:vars={{ DATA: payload, BASE: url('/') }}>
    (function () {
      var PER = 25;
      var st = { sec: DATA[0].key, q: '', sort: null, dir: -1, page: 1, sel: null };
      var $ = function (id) { return document.getElementById(id); };
      var sec = function () { return DATA.filter(function (s) { return s.key === st.sec; })[0]; };

      function fmt(v, frac) {
        if (v === null || v === undefined) return '';
        var f = frac !== undefined ? frac : (Math.abs(v) >= 1000 ? 1 : 2);
        return v.toLocaleString('ko-KR', { minimumFractionDigits: f, maximumFractionDigits: f });
      }
      function esc(s) {
        return String(s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }

      function rows() {
        var s = sec();
        var q = st.q.trim().toLowerCase();
        var list = s.rows.filter(function (r) {
          if (!q) return true;
          return (r.name + ' ' + (r.hs || '') + ' ' + (r.cc || '') + ' ' + r.id).toLowerCase().indexOf(q) >= 0;
        });
        if (st.sort) {
          var col = s.cols.filter(function (c) { return c.key === st.sort; })[0];
          list = list.slice().sort(function (a, b) {
            var x = a[st.sort], y = b[st.sort];
            // 값이 없는 행은 방향과 무관하게 늘 아래로 (univer-radar 의 「미공개 하단 고정」 규칙)
            if (x === undefined || x === null) return 1;
            if (y === undefined || y === null) return -1;
            if (col && col.num) return (x - y) * st.dir;
            return String(x).localeCompare(String(y), 'ko') * st.dir;
          });
        }
        return list;
      }

      function render() {
        var s = sec(), list = rows();
        var pages = Math.max(1, Math.ceil(list.length / PER));
        if (st.page > pages) st.page = pages;
        var page = list.slice((st.page - 1) * PER, st.page * PER);

        $('dk-head').innerHTML = '<tr>' + s.cols.map(function (c) {
          var on = st.sort === c.key;
          return '<th class="' + (c.num ? 'r' : '') + '" data-col="' + c.key + '">' + esc(c.label) +
            (on ? ' <span class="dk-sort">' + (st.dir > 0 ? '▲' : '▼') + '</span>' : '') + '</th>';
        }).join('') + '</tr>';

        $('dk-body').innerHTML = page.length ? page.map(function (r) {
          return '<tr data-id="' + r.id + '"' + (st.sel === r.id ? ' class="is-sel"' : '') + '>' +
            s.cols.map(function (c) {
              var v = r[c.key];
              if (c.key === 'name') {
                var badge = r.flag ? '<img src="' + r.flag + '" width="20" height="15" alt="" loading="lazy">' : '';
                return '<td><span class="dk-nm">' + badge + esc(r.name) + '</span></td>';
              }
              if (v === undefined || v === null || v === '') return '<td class="' + (c.num ? 'r' : '') + '">—</td>';
              if (!c.num) return '<td>' + esc(v) + '</td>';
              var cls = 'r mono';
              var txt = fmt(v, c.frac !== undefined ? c.frac : r.frac);
              if (c.signed) { cls += v > 0 ? ' dk-up' : v < 0 ? ' dk-down' : ''; if (v > 0) txt = '+' + txt; }
              return '<td class="' + cls + '">' + txt + '</td>';
            }).join('') + '</tr>';
        }).join('') : '<tr><td class="dk-empty" colspan="' + s.cols.length + '">거른 결과가 없습니다.</td></tr>';

        $('dk-count').textContent = list.length + '개' + (list.length !== s.rows.length ? ' / 전체 ' + s.rows.length + '개' : '');

        var pg = '';
        if (pages > 1) {
          pg += '<button type="button" data-pg="' + (st.page - 1) + '"' + (st.page === 1 ? ' disabled' : '') + '>이전</button>';
          for (var i = 1; i <= pages; i++) pg += '<button type="button" data-pg="' + i + '"' + (i === st.page ? ' class="is-on"' : '') + '>' + i + '</button>';
          pg += '<button type="button" data-pg="' + (st.page + 1) + '"' + (st.page === pages ? ' disabled' : '') + '>다음</button>';
        }
        $('dk-page').innerHTML = pg;
      }

      // ── 시계열 그림 ───────────────────────────────────────
      // 색 규약: 오른 것은 빨강(--up), 내린 것은 파랑(--down) — 한국 금융 관례.
      // scale: 원자료 단위를 화면 단위로 낮춘다(관세청은 달러 원단위로 와서 아홉 자리가 찍힌다).
      //   표는 억 달러인데 차트만 원 단위였다 — 같은 화면에서 단위가 갈리면 독자가 값을 잘못 읽는다.
      // 날짜 키(YYYYMMDD 8자리 · YYYYMM 6자리)를 축 라벨로 줄인다.
      function dlab(d) {
        d = String(d || '');
        if (d.length === 8) return d.slice(2, 4) + '.' + d.slice(4, 6);
        if (d.length === 6) return d.slice(2, 4) + '.' + d.slice(4, 6);
        return d;
      }

      function chart(pts, field, scale, frac) {
        // 여백을 위·아래로 갈랐다. 아래는 가로축 날짜가 들어갈 자리다.
        var W = 280, H = 112, PL = 6, PT = 13, PB = 17, k = scale || 1;
        var rows = pts.map(function (p) {
            var v = field ? p[field] : p.v;
            return { d: p.d, v: typeof v === 'number' ? v / k : null };
          }).filter(function (r) { return r.v !== null; });
        if (rows.length < 2) return '<p class="dk-pv-note">그릴 점이 모자랍니다.</p>';
        var vals = rows.map(function (r) { return r.v; });
        var lo = Math.min.apply(null, vals), hi = Math.max.apply(null, vals), span = hi - lo || 1;
        var iHi = vals.indexOf(hi), iLo = vals.indexOf(lo);
        var x = function (i) { return PL + (i * (W - PL * 2)) / (vals.length - 1); };
        var y = function (v) { return H - PB - ((v - lo) / span) * (H - PT - PB); };
        var d = vals.map(function (v, i) { return (i ? 'L' : 'M') + x(i).toFixed(1) + ' ' + y(v).toFixed(1); }).join(' ');
        var up = vals[vals.length - 1] >= vals[0];
        var col = up ? 'var(--up)' : 'var(--down)';

        // 라벨이 그림 밖으로 나가지 않게 끝에서는 정렬을 바꾼다.
        function tx(px, s, dy, cls) {
          var a = px < 34 ? 'start' : px > W - 34 ? 'end' : 'middle';
          var ax = px < 34 ? PL : px > W - 34 ? W - PL : px;
          // 최고·최저 라벨은 곡선 위에 얹히는 자리가 많다(장기 계열에서 실제로 겹쳤다).
          // 글자 뒤에 배경색 테두리를 깔아 선 위에서도 읽히게 한다. `--surface` 는
          // 다크 모드에서 함께 뒤집히므로 두 테마 모두에서 맞는다.
          return '<text x="' + ax.toFixed(1) + '" y="' + dy.toFixed(1) + '" text-anchor="' + a +
            '" style="font-size:9px;fill:var(--' + (cls || 'muted') + ');stroke:var(--surface);' +
            'stroke-width:2.5px;paint-order:stroke;stroke-linejoin:round">' + s + '</text>';
        }

        // ★ 0선. 무역수지처럼 **부호가 뒤집히는 계열**에서 이것이 없으면
        //   적자와 흑자가 한 선으로 뭉개진다. 있을 때만 그린다(0을 지나지 않으면 군더더기다).
        var zero = '';
        if (lo < 0 && hi > 0) {
          var zy = y(0);
          zero = '<line x1="' + PL + '" y1="' + zy.toFixed(1) + '" x2="' + (W - PL) + '" y2="' + zy.toFixed(1) +
            '" stroke="var(--hair)" stroke-width="1" stroke-dasharray="3 3"/>' +
            '<text x="' + (W - PL) + '" y="' + (zy - 2.5).toFixed(1) +
            '" text-anchor="end" style="font-size:8.5px;fill:var(--muted)">0</text>';
        }

        return '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img">' +
          zero +
          '<path d="' + d + '" fill="none" stroke="' + col + '" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>' +
          '<circle cx="' + x(vals.length - 1).toFixed(1) + '" cy="' + y(vals[vals.length - 1]).toFixed(1) + '" r="3" fill="' + col + '"/>' +
          // 최고·최저는 **실제로 그 값이 난 자리**에 붙인다. 예전에는 왼쪽 위아래에 고정돼 있어
          // 어느 지점이 최고인지 그림에서 읽을 수 없었다.
          tx(x(iHi), fmt(hi, frac), Math.max(9, y(hi) - 5)) +
          // 최저 라벨은 **그림 안에** 둔다. 점 아래로 내리면 가로축 날짜와 겹치므로
          // (실측에서 -18.3 이 25.08 을 덮었다) 자리가 없으면 점 위로 올린다.
          tx(x(iLo), fmt(lo, frac), y(lo) + 10 > H - PB - 2 ? Math.max(9, y(lo) - 5) : y(lo) + 10) +
          // 가로축 — 언제부터 언제까지인지 그림 안에서 읽히게 한다.
          '<text x="' + PL + '" y="' + (H - 3) + '" style="font-size:8.5px;fill:var(--muted)">' + dlab(rows[0].d) + '</text>' +
          '<text x="' + (W - PL) + '" y="' + (H - 3) + '" text-anchor="end" style="font-size:8.5px;fill:var(--muted)">' +
            dlab(rows[rows.length - 1].d) + '</text>' +
          '</svg>';
      }

      function preview(id) {
        var s = sec();
        var r = s.rows.filter(function (x) { return x.id === id; })[0];
        if (!r) return;
        st.sel = id;
        var cards = [];
        if (r.value !== undefined) cards.push(['현재값', fmt(r.value, r.frac) + ' ' + esc(r.unit)]);
        if (r.diff !== undefined) cards.push(['직전 대비', (r.diff > 0 ? '+' : '') + fmt(r.diff, r.frac)]);
        if (r.exp !== undefined) { cards.push(['수출', fmt(r.exp, 1) + ' 억$']); cards.push(['수입', fmt(r.imp, 1) + ' 억$']); }
        if (r.bal !== undefined) cards.push(['무역수지', (r.bal > 0 ? '+' : '') + fmt(r.bal, 1) + ' 억$']);
        if (r.unitExp !== undefined) cards.push(['수출 단가', fmt(r.unitExp, 2) + ' $/kg']);
        cards.push(['관측', r.n + '개 · ' + r.cycle]);
        cards.push(['기간', r.first + ' ~']);

        var links = r.posts.length
          ? '<div class="dk-pv-links"><h4>이 자료를 쓴 기사</h4>' + r.posts.map(function (p) {
              return '<a href="' + BASE + 'posts/' + p.slug + '/">' + esc(p.title) + '</a>';
            }).join('') + '</div>'
          : '';

        $('dk-pv').innerHTML =
          '<h3 class="dk-pv-t">' + (r.flag ? '<img src="' + r.flag + '" width="22" height="16" alt="">' : '') + esc(r.name) + '</h3>' +
          '<p class="dk-pv-s">' + esc(r.id) + (r.hs ? ' · HS ' + esc(r.hs) : '') + ' · 기준 ' + esc(r.asOf) + '</p>' +
          '<div class="dk-pv-chart" id="dk-chart"><p class="dk-pv-note">불러오는 중…</p></div>' +
          '<dl class="dk-pv-g">' + cards.map(function (c) {
            return '<div class="dk-pv-c"><dt>' + c[0] + '</dt><dd>' + c[1] + '</dd></div>';
          }).join('') + '</dl>' +
          '<p class="dk-pv-note">자료: ' + esc(r.source) +
            (r.sourceUrl ? ' · <a href="' + r.sourceUrl + '" target="_blank" rel="noopener">원자료</a>' : '') + '</p>' +
          links;

        fetch(BASE + 'desk/series/' + id + '.json')
          .then(function (res) { return res.json(); })
          .then(function (j) {
            var el = $('dk-chart');
            var isTrade = r.exp !== undefined;
            if (el) el.innerHTML = chart(j.points, isTrade ? 'bal' : null, isTrade ? 1e8 : 1, isTrade ? 1 : r.frac) +
              '<p class="dk-pv-note">' + (isTrade ? '무역수지 · 억 달러' : esc(r.name) + ' · ' + esc(r.unit)) +
              ' · ' + j.n + '개 관측</p>';
          })
          .catch(function () {
            var el = $('dk-chart');
            if (el) el.innerHTML = '<p class="dk-pv-note">시계열을 불러오지 못했습니다.</p>';
          });
        render();
      }

      document.querySelectorAll('.dk-menu').forEach(function (b) {
        b.addEventListener('click', function () {
          document.querySelectorAll('.dk-menu').forEach(function (o) { o.classList.remove('is-on'); });
          b.classList.add('is-on');
          st.sec = b.dataset.sec; st.page = 1; st.sort = null; st.sel = null;
          $('dk-pv').innerHTML = '<p class="dk-pv-empty">왼쪽 표에서 항목을 고르면<br>시계열과 출처가 여기 나옵니다.</p>';
          render();
        });
      });
      $('dk-q').addEventListener('input', function (e) { st.q = e.target.value; st.page = 1; render(); });
      $('dk-head').addEventListener('click', function (e) {
        var th = e.target.closest('th'); if (!th) return;
        var k = th.dataset.col;
        if (st.sort === k) st.dir = -st.dir; else { st.sort = k; st.dir = -1; }
        st.page = 1; render();
      });
      $('dk-body').addEventListener('click', function (e) {
        var tr = e.target.closest('tr'); if (tr && tr.dataset.id) preview(tr.dataset.id);
      });
      $('dk-page').addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b || b.disabled) return;
        st.page = Number(b.dataset.pg); render();
      });
      render();
    })();
  </script>
</Base>
