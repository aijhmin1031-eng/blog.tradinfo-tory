---
import Base from '../layouts/Base.astro';
import StatTiles from '../components/StatTiles.astro';
import CorpPanel from '../components/CorpPanel.astro';
import TradePanel from '../components/TradePanel.astro';
import indicators from '../data/indicators.json';
import { getCollection } from 'astro:content';
import { url } from '../lib/site';

const briefs = (await getCollection('briefs')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 10);
---

<Base title="도토리 창고" description="도토리경제의 지표 대시보드, 환율, 금리, 수출입 핵심 지표를 한곳에서" compact activeNav="warehouse">
  <section class="wrap">
    <header class="wh-head">
      <div class="kicker-en" style="color: var(--accent);">WAREHOUSE</div>
      <h1 class="serif wh-title">도토리 창고</h1>
      <p class="wh-sub">토리가 매일 아침 6시 50분에 주워 오는 핵심 지표들. 한국은행 ECOS·미 연준 FRED·관세청·DART에서 자동 수집합니다. <span class="mono">(기준일: {indicators.asOf}, 주말·공휴일은 직전 영업일 값)</span></p>
      <nav class="wh-corners" aria-label="창고의 다른 코너">
        <a href={url('/numbers/')}>오늘의 숫자</a>
        <a href={url('/real-return/')}>예금 실질수익 계산기</a>
        <a href={url('/import-cost/')}>수입원가 계산기</a>
        <a href={url('/glossary/')}>용어 도토리</a>
        <a href={url('/galimgil/')}>토리의 갈림길</a>
        <a href={url('/map/')}>블로그 지도</a>
        <a href={url('/pack/')}>도토리 그림함</a>
        <a href={url('/board/')}>도토리 광장</a>
      </nav>
    </header>
    <div class="wh-grid">
      <div class="card wh-card"><StatTiles /></div>
      <div class="card wh-card">
        <div class="kicker" style="color: var(--sub); border-bottom: 1px solid var(--hair); padding-bottom: 9px; font-size: 11px;">입고 예정 지표</div>
        <ul class="wh-roadmap">
          <li>
            <div class="wh-rm-name">수출입 전체 총액</div>
            <div class="wh-rm-desc">국가 구분 없는 월별 수출입 총액과 무역수지 (관세청, API 제약 해소 시)</div>
          </li>
          <li>
            <div class="wh-rm-name">세계 교역 지표</div>
            <div class="wh-rm-desc">주요국 교역 규모와 한국의 위치 (UN Comtrade, 연동 검증 중)</div>
          </li>
          <li>
            <div class="wh-rm-name">원자재 가격</div>
            <div class="wh-rm-desc">구리·곡물 등 수입 물가를 좌우하는 원자재 시세 (FRED)</div>
          </li>
        </ul>
        <div class="wh-rm-note">위 지표는 데이터 검증을 마치는 순서대로 입고됩니다. 품목별 수출입(HS 8542·8486)과 국가별 무역수지, 관련주 시세·공시는 이미 아래에 입고되어 매일 갱신 중입니다.</div>
      </div>
    </div>

    <div class="wh-grid" style="margin-top: 28px;">
      <CorpPanel />
      <TradePanel />
    </div>

    <div class="wh-briefs">
      <h2 class="serif wh-briefs-title">아침 브리핑</h2>
      <p class="wh-briefs-sub">매일 아침, 파이프라인이 전 영업일 종가를 요약해 자동 발행합니다. <a href={url('/briefs/')} style="color: var(--accent); font-weight: 700;">전체 아카이브 →</a></p>
      {
        briefs.length === 0 ? (
          <p class="wh-briefs-sub">첫 브리핑이 준비되는 대로 이곳에 게시됩니다.</p>
        ) : (
          briefs.map((b) => (
            <a class="wh-brief-row" href={url(`/briefs/${b.id}/`)}>
              <span class="wbr-title serif">{b.data.title}</span>
              <span class="wbr-date mono">{b.data.date}</span>
            </a>
          ))
        )
      }
    </div>
  </section>
</Base>

<style>
  .wh-head { padding: 48px 0 26px 0; }
  .wh-title { font-size: 30px; font-weight: 900; margin: 8px 0 10px 0; }
  .wh-sub { color: var(--sub); font-size: 14.5px; max-width: 560px; line-height: 1.75; }
  .wh-sub .mono { font-size: 11px; color: var(--muted); }
  .wh-corners { display: flex; gap: 9px; flex-wrap: wrap; margin-top: 16px; }
  .wh-corners a { font-size: 12.5px; font-weight: 600; color: var(--sub); border: 1px solid var(--line); border-radius: 999px; padding: 7px 15px; }
  .wh-corners a:hover { color: var(--accent); border-color: var(--accent); }
  .wh-grid { display: grid; grid-template-columns: 1fr; gap: 28px; }
  @media (min-width: 860px) { .wh-grid { grid-template-columns: 1fr 1fr; } }
  .wh-card { padding: 26px 30px; }
  .wh-roadmap { list-style: none; margin: 0; padding: 0; }
  .wh-roadmap li { padding: 14px 0; border-bottom: 1px solid var(--hair2); }
  .wh-rm-name { font-size: 14.5px; font-weight: 700; margin-bottom: 4px; }
  .wh-rm-desc { font-size: 12.5px; color: var(--sub); line-height: 1.65; }
  .wh-rm-note { font-size: 11.5px; color: var(--muted); padding-top: 12px; }
  .wh-briefs { margin-top: 44px; }
  .wh-briefs-title {
    font-size: 22px;
    font-weight: 900;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 10px;
    margin: 0 0 8px 0;
  }
  .wh-briefs-sub { font-size: 13px; color: var(--sub); margin: 0 0 6px 0; }
  .wh-brief-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 15px 0;
    border-bottom: 1px solid var(--hair2);
  }
  .wbr-title { font-size: 15.5px; font-weight: 700; }
  .wh-brief-row:hover .wbr-title { color: var(--accent); }
  .wbr-date { font-size: 11px; color: var(--muted); }
</style>
