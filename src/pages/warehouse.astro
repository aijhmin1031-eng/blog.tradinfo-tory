---
import Base from '../layouts/Base.astro';
import StatTiles from '../components/StatTiles.astro';
import indicators from '../data/indicators.json';
import { url } from '../lib/site';
---

<Base title="도토리 창고" description="무역토리의 지표 대시보드 — 환율, 금리, 수출입 핵심 지표를 한곳에서" compact activeNav="warehouse">
  <section class="wrap">
    <header class="wh-head">
      <div class="kicker-en" style="color: var(--accent);">WAREHOUSE</div>
      <h1 class="serif wh-title">도토리 창고</h1>
      <p class="wh-sub">토리가 매일 주워 오는 핵심 지표들. 데이터 파이프라인 연결 후 평일 아침 자동 갱신됩니다. <span class="mono">(현재 기준일: {indicators.asOf})</span></p>
    </header>
    <div class="wh-grid">
      <div class="card wh-card"><StatTiles /></div>
      <div class="card wh-card wh-coming">
        <img src={url('/images/poses/pose-07.jpg')} alt="도토리를 줍는 토리" width="140" height="140" />
        <div>
          <div class="wh-coming-title">창고 확장 공사 중</div>
          <div class="wh-coming-desc">품목별 수출입 추이, 국가별 무역수지, 원자재 가격 차트가 이 자리에 들어옵니다. 토리가 부지런히 줍고 있어요.</div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .wh-head { padding: 48px 0 26px 0; }
  .wh-title { font-size: 30px; font-weight: 900; margin: 8px 0 10px 0; }
  .wh-sub { color: var(--sub); font-size: 14.5px; max-width: 560px; line-height: 1.75; }
  .wh-sub .mono { font-size: 11px; color: var(--muted); }
  .wh-grid { display: grid; grid-template-columns: 1fr; gap: 28px; }
  @media (min-width: 860px) { .wh-grid { grid-template-columns: 1fr 1fr; } }
  .wh-card { padding: 26px 30px; }
  .wh-coming { display: flex; gap: 22px; align-items: center; }
  .wh-coming img { width: 140px; height: 140px; border-radius: 50%; object-fit: cover; border: 1px solid var(--hair); flex-shrink: 0; }
  .wh-coming-title { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
  .wh-coming-desc { font-size: 13.5px; color: var(--sub); line-height: 1.75; }
</style>
