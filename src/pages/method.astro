---
// 「숫자를 다루는 방법」. 경제·금융 콘텐츠는 검색엔진이 신뢰도를 엄격하게 본다(YMYL).
// 익명을 유지하는 대신, 어디서 가져와 어떻게 검증하고 무엇을 하지 않는지를 공개해 신뢰를 세운다.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, url, isPublished } from '../lib/site';
import { GLOSSARY } from '../lib/glossary';
import { ALL_ITEMS } from '../data/pack';

const posts = await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate));
const abs = (p: string) => new URL(p, Astro.site).href;

const sources = [
  {
    name: '한국은행 ECOS',
    what: '기준금리, 시장금리, 원/달러 환율, 물가 지표',
    href: 'https://ecos.bok.or.kr/',
    note: '한국은행이 직접 공표하는 경제통계 시스템입니다.',
  },
  {
    name: '관세청 수출입무역통계',
    what: '국가별·품목별 수출입 실적, 무역수지, 통관 실적',
    href: 'https://tradedata.go.kr/',
    note: '통관 기준 확정·잠정 수치를 구분해 인용합니다.',
  },
  {
    name: '미 연준 FRED',
    what: '미국 국채 금리, 달러 지수, 국제 유가',
    href: 'https://fred.stlouisfed.org/',
    note: '세인트루이스 연방준비은행이 운영하는 경제 데이터 저장소입니다.',
  },
  {
    name: '금융감독원 DART',
    what: '상장사 공시, 실적 발표',
    href: 'https://dart.fss.or.kr/',
    note: '기업 관련 서술은 공시 원문을 근거로 합니다.',
  },
];

const rules = [
  {
    title: '숫자는 기관에서 직접 받습니다',
    body:
      '기사에 나오는 수치는 사람이 옮겨 적지 않습니다. 매일 새벽 위 네 곳의 공식 API를 직접 호출해 받아 온 값을 ' +
      '그대로 씁니다. 언론 보도를 인용해 재인용하는 방식은 쓰지 않습니다.',
  },
  {
    title: '기준 시점을 함께 적습니다',
    body:
      '같은 지표라도 어느 시점 기준이냐에 따라 값이 달라집니다. 기사마다 데이터 기준일을 표시하고, ' +
      '주말과 공휴일에는 직전 거래일 값에 머무는 것이 정상임을 밝힙니다.',
  },
  {
    title: '잠정치와 확정치를 구분합니다',
    body:
      '무역 통계는 발표 후 정정됩니다. 잠정 수치를 인용할 때는 그렇다고 적고, 확정치가 나오면 달라질 수 있음을 함께 씁니다.',
  },
  {
    title: '전망을 사실처럼 쓰지 않습니다',
    body:
      '앞일에 대한 서술은 근거와 함께 전망임을 밝힙니다. 「토리의 갈림길」 연재는 예측을 미리 적어 두고 ' +
      '나중에 맞았는지 공개로 채점합니다. 틀린 것도 지우지 않고 남깁니다.',
  },
  {
    title: '투자 판단을 대신하지 않습니다',
    body:
      '도토리경제는 정보를 전할 뿐입니다. 어떤 종목을 사라거나 팔라고 말하지 않으며, 모든 내용은 투자 자문이 아닙니다.',
  },
];

const desc =
  '도토리경제가 숫자를 어디서 가져와 어떻게 검증하는지 밝힙니다. 한국은행 ECOS, 관세청 수출입무역통계, ' +
  '미 연준 FRED, 금융감독원 DART 네 곳의 공식 데이터를 매일 새벽 직접 받아 씁니다.';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '숫자를 다루는 방법',
  description: desc,
  url: abs(url('/method/')),
  inLanguage: 'ko-KR',
  publisher: { '@type': 'Organization', name: SITE.name, url: abs(url('/')) },
  mainEntity: {
    '@type': 'Dataset',
    name: '도토리경제 지표 데이터',
    description: '한국은행·관세청·FRED·DART에서 매일 자동 수집하는 무역·환율·금리 지표',
    creator: { '@type': 'Organization', name: SITE.name },
    isAccessibleForFree: true,
  },
};
---

<Base title="숫자를 다루는 방법" description={desc} activeNav="warehouse" compact>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />

  <section class="wrap me-head">
    <div class="kicker-en" style="color: var(--accent);">METHODOLOGY</div>
    <h1 class="serif me-title">숫자를 다루는 방법</h1>
    <p class="me-sub">
      도토리경제는 쓰는 사람을 앞세우지 않습니다. 대신 <strong>어디서 가져와 어떻게 확인했는지</strong>를 공개합니다.
      읽는 분이 믿어야 할 것은 필자가 아니라 출처이기 때문입니다.
      지금까지 이 방식으로 <strong>{posts.length}편</strong>을 발행했습니다.
    </p>
  </section>

  <section class="wrap me-block">
    <h2 class="serif me-h2">어디서 가져오는가</h2>
    <p class="me-note">네 곳의 공식 데이터를 매일 새벽 직접 받아 옵니다. 언론 보도를 재인용하지 않습니다.</p>
    <div class="me-grid">
      {
        sources.map((s) => (
          <div class="me-src">
            <div class="me-src-name serif">{s.name}</div>
            <div class="me-src-what">{s.what}</div>
            <p class="me-src-note">{s.note}</p>
            <a class="me-src-link" href={s.href} target="_blank" rel="noopener noreferrer">원본 보기 →</a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap me-block">
    <h2 class="serif me-h2">어떻게 다루는가</h2>
    <ol class="me-rules">
      {
        rules.map((r, i) => (
          <li>
            <div class="mono me-no">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <div class="me-rule-title serif">{r.title}</div>
              <p class="me-rule-body">{r.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap me-block">
    <h2 class="serif me-h2">누가 쓰는가</h2>
    <p class="me-note">
      기사는 <a href={url('/about/')}>토리</a>라는 이름으로 나갑니다. 실명을 밝히지 않는 이유는 하나입니다.
      읽는 분이 보아야 할 것은 쓰는 사람의 이력이 아니라 숫자와 그 출처라고 보기 때문입니다.
      대신 위에 적은 출처와 원칙을 공개하고, 예측은 <a href={url('/galimgil/')}>공개로 채점</a>해 검증받습니다.
      데이터 오류를 발견하시면 <a href={url('/board/')}>도토리 광장</a>이나
      <a href={url('/contact/')}>협업 문의</a>로 알려 주십시오. 확인해 바로잡고 그 사실을 남깁니다.
    </p>
  </section>

  <section class="wrap me-block me-last">
    <h2 class="serif me-h2">쌓인 것</h2>
    <div class="me-proof">
      <div><span class="me-n mono">4</span><span class="me-label">곳의 공식 API</span></div>
      <div><span class="me-n mono">{posts.length}</span><span class="me-label">편의 기사</span></div>
      <div><span class="me-n mono">{Object.keys(GLOSSARY).length}</span><span class="me-label">개의 용어 풀이</span></div>
      <div><span class="me-n mono">{ALL_ITEMS.length}</span><span class="me-label">장의 무료 그림</span></div>
    </div>
  </section>
</Base>

<style>
  .me-head { padding-top: 46px; }
  .me-title { font-size: clamp(30px, 4.6vw, 44px); font-weight: 900; color: var(--ink); margin-top: 6px; }
  .me-sub { font-size: 15px; color: var(--sub); line-height: 1.95; margin-top: 14px; max-width: var(--measure-wide); word-break: keep-all; }

  .me-block { margin-top: 46px; }
  .me-last { padding-bottom: 60px; }
  .me-h2 { font-size: 19px; font-weight: 900; color: var(--ink); border-bottom: 2px solid var(--ink); padding-bottom: 10px; }
  .me-note { font-size: 14px; color: var(--sub); line-height: 1.95; margin-top: 14px; max-width: var(--measure-wide); word-break: keep-all; }

  .me-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
  @media (max-width: 760px) { .me-grid { grid-template-columns: 1fr; } }
  .me-src { border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; background: var(--paper); }
  .me-src-name { font-size: 16.5px; font-weight: 900; color: var(--ink); }
  .me-src-what { font-size: 12.5px; color: var(--accent); font-weight: 700; margin-top: 6px; word-break: keep-all; }
  .me-src-note { font-size: 13px; color: var(--sub); line-height: 1.85; margin-top: 8px; word-break: keep-all; }
  .me-src-link { display: inline-block; font-size: 12px; font-weight: 700; color: var(--accent); margin-top: 10px; }

  .me-rules { list-style: none; padding: 0; margin: 20px 0 0; }
  .me-rules li { display: flex; gap: 16px; padding: 16px 0; border-bottom: 1px dashed var(--hair, var(--line)); }
  .me-no { font-size: 12px; color: var(--accent); flex: 0 0 auto; padding-top: 3px; }
  .me-rule-title { font-size: 16px; font-weight: 900; color: var(--ink); word-break: keep-all; }
  .me-rule-body { font-size: 13.5px; color: var(--sub); line-height: 1.9; margin-top: 7px; max-width: var(--measure); word-break: keep-all; }

  .me-proof { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 18px; margin-top: 20px; }
  .me-proof > div { border-top: 2px solid var(--ink); padding-top: 12px; }
  .me-n { display: block; font-size: 30px; font-weight: 900; color: var(--accent); }
  .me-label { display: block; font-size: 13px; font-weight: 700; color: var(--ink); margin-top: 4px; }
</style>
