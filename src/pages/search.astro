---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
const bundle = url('/pagefind/');
---

<Base title="검색" description="토리노믹스의 기사와 지표를 검색합니다" compact>
  <section class="wrap sr">
    <header class="sr-head">
      <div class="kicker-en" style="color: var(--accent);">SEARCH</div>
      <h1 class="serif sr-title">도토리 찾기</h1>
      <p class="sr-sub">기사 제목, 본문, 용어를 검색할 수 있습니다.</p>
    </header>
    <div id="search"></div>
    <noscript>
      <p class="sr-sub">검색 기능은 자바스크립트가 활성화된 환경에서 이용하실 수 있습니다.</p>
    </noscript>
  </section>

  <link rel="stylesheet" href={url('/pagefind/pagefind-ui.css')} slot="head" />
  <script is:inline define:vars={{ bundle }}>
    (function () {
      const s = document.createElement('script');
      s.src = `${bundle}pagefind-ui.js`;
      s.onload = () => {
        new PagefindUI({
          element: '#search',
          bundlePath: bundle,
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: '검색어를 입력하세요',
            zero_results: '"[SEARCH_TERM]"에 해당하는 도토리를 찾지 못했습니다',
            many_results: '"[SEARCH_TERM]" 검색 결과 [COUNT]건',
            one_result: '"[SEARCH_TERM]" 검색 결과 1건',
            clear_search: '지우기',
            load_more: '결과 더 보기',
            searching: '검색 중…',
          },
        });
        const input = document.querySelector('#search input');
        if (input) input.focus();
      };
      s.onerror = () => {
        const el = document.getElementById('search');
        if (el) el.innerHTML = '<p style="color: var(--sub); font-size: 14px;">검색 색인을 불러오지 못했습니다. 잠시 후 다시 시도해 주시기 바랍니다.</p>';
      };
      document.head.appendChild(s);
    })();
  </script>
</Base>

<style is:global>
  .sr { max-width: 760px; }
  .sr-head { padding: 48px 0 22px 0; }
  .sr-title { font-size: 30px; font-weight: 900; margin: 8px 0 10px 0; }
  .sr-sub { color: var(--sub); font-size: 14.5px; }
  #search { padding-bottom: 48px; min-height: 300px; }
  #search .pagefind-ui {
    --pagefind-ui-primary: var(--brand);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--hair);
    --pagefind-ui-tag: var(--hair2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0px;
    --pagefind-ui-font: var(--font-sans);
  }
  #search .pagefind-ui__result-title { font-family: var(--font-serif); font-weight: 700; }
</style>
