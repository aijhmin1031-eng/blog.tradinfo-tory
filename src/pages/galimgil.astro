---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url, fmtDate, isPublished } from '../lib/site';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase';

// 갈림길 연재분: 발행분은 목록으로, 미발행 다음 화는 예고로
const all = (await getCollection('posts'))
  .filter((p) => ((p as { slug?: string; id: string }).slug ?? p.id).startsWith('tori-galimgil'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const episodes = all
  .filter((p) => isPublished(p.data.pubDate))
  .map((p) => {
    const slug = (p as { slug?: string; id: string }).slug ?? p.id;
    return {
      slug,
      href: url(`/posts/${slug}/`),
      title: p.data.title,
      description: p.data.description,
      date: fmtDate(p.data.pubDate),
      num: parseInt(slug.replace('tori-galimgil-', ''), 10) || 0,
    };
  });
const upcoming = all.filter((p) => !isPublished(p.data.pubDate)).pop();
const upcomingDate = upcoming ? fmtDate(upcoming.data.pubDate) : null;
---

<Base
  title="토리의 갈림길"
  description="매주 월요일, 조건이 붙은 두 갈래 길을 그리고 다음 주에 공개 채점하는 주간 전망 연재. 전 회차의 채점 기록을 아카이브로 공개합니다."
  activeNav="galimgil"
  compact
>
  <section class="wrap gl-head">
    <div class="kicker-en" style="color: var(--accent);">WEEKLY CROSSROADS</div>
    <h1 class="serif gl-title">토리의 갈림길</h1>
    <p class="gl-sub">
      매주 월요일, 토리는 방향을 예언하는 대신 조건이 붙은 두 갈래 길을 그립니다.
      그리고 다음 주, 어느 길이 실제로 열렸는지 이 게시판에 정직하게 표시합니다.
      이 연재의 전 재산은 아래 채점표입니다.
    </p>
  </section>

  <section class="wrap">
    <div
      class="gl-record"
      id="gl-record"
      data-sb-url={SUPABASE_URL}
      data-sb-key={SUPABASE_ANON_KEY}
      role="list"
      aria-label="연재 전적"
    >
      <div class="gl-rec-item" role="listitem">
        <div class="gl-rec-n mono" data-k="total">{episodes.length}</div>
        <div class="gl-rec-label">연재 회차</div>
      </div>
      <div class="gl-rec-item" role="listitem">
        <div class="gl-rec-n mono" data-k="scored">0</div>
        <div class="gl-rec-label">채점 완료</div>
      </div>
      <div class="gl-rec-item" role="listitem">
        <div class="gl-rec-n mono up" data-k="road_a">0</div>
        <div class="gl-rec-label">A의 길</div>
      </div>
      <div class="gl-rec-item" role="listitem">
        <div class="gl-rec-n mono down" data-k="road_b">0</div>
        <div class="gl-rec-label">B의 길</div>
      </div>
      <div class="gl-rec-item" role="listitem">
        <div class="gl-rec-n mono" data-k="partial">0</div>
        <div class="gl-rec-label">부분 개통</div>
      </div>
    </div>
    <p class="gl-rec-note">전적은 채점 아카이브에서 실시간으로 불러오며, A·B는 그 주에 실제로 열린 길을 뜻합니다.</p>
  </section>

  <section class="wrap gl-list-wrap">
    {
      upcomingDate && (
        <div class="gl-next">
          다음 화는 <strong>{upcomingDate}</strong> 아침에 발행됩니다.
        </div>
      )
    }
    {
      episodes.length === 0 && !upcomingDate && (
        <div class="gl-next">첫 화를 준비하고 있습니다.</div>
      )
    }
    <div class="gl-list">
      {episodes.map((e) => (
        <a href={e.href} class="gl-card" data-slug={e.slug}>
          <div class="gl-card-top">
            <span class="gl-ep mono">#{e.num}</span>
            <span class="gl-badge pending" data-role="badge">채점 대기</span>
          </div>
          <div class="gl-card-title serif">{e.title}</div>
          <div class="gl-card-desc">{e.description}</div>
          <div class="gl-card-meta">
            <span>{e.date}</span>
            <span class="gl-verdict-note" data-role="note"></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap gl-method">
    <div class="gl-method-in">
      <div class="gl-method-title">채점 규칙</div>
      <p>
        각 화는 실측 좌표에서 출발해 조건이 붙은 A·B 두 갈래 길과 세 개의 확인
        신호를 제시합니다. 다음 화에서 조건 충족 여부를 대조해 실제로 열린 길을
        표시하며, 판정 근거 수치는 한국은행 ECOS·금융위 시세정보·미 연준
        FRED·관세청 통계의 공표값입니다. 이 연재는 특정 종목·상품의 매매 권유가
        아닙니다.
      </p>
    </div>
  </section>
</Base>

<script>
  // 채점 아카이브 API에서 전적·판정을 불러와 정적 목록 위에 입힌다.
  const rec = document.getElementById('gl-record');
  if (rec) {
    const LABEL: Record<string, string> = { a: 'A의 길', b: 'B의 길', partial: '부분 개통', pending: '채점 대기' };
    fetch(`${rec.dataset.sbUrl}/functions/v1/galimgil-archive`, {
      headers: {
        apikey: rec.dataset.sbKey!,
        Authorization: `Bearer ${rec.dataset.sbKey}`,
      },
    })
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((data: { summary: Record<string, number>; episodes: { slug: string; verdict: string; verdict_note: string | null }[] }) => {
        for (const k of ['scored', 'road_a', 'road_b', 'partial']) {
          const el = rec.querySelector(`[data-k="${k}"]`);
          if (el) el.textContent = String(data.summary[k] ?? 0);
        }
        for (const ep of data.episodes) {
          const card = document.querySelector(`.gl-card[data-slug="${ep.slug}"]`);
          if (!card) continue;
          const badge = card.querySelector('[data-role="badge"]')!;
          badge.textContent = LABEL[ep.verdict] ?? ep.verdict;
          badge.className = `gl-badge ${ep.verdict}`;
          if (ep.verdict_note) card.querySelector('[data-role="note"]')!.textContent = ep.verdict_note;
        }
      })
      .catch(() => {});
  }
</script>

<style>
  .gl-head { padding-top: 46px; }
  .gl-title { font-size: clamp(30px, 4.6vw, 44px); font-weight: 900; color: var(--ink); letter-spacing: -0.01em; margin-top: 6px; }
  .gl-sub { font-size: 15px; color: var(--sub); line-height: 1.9; margin-top: 12px; max-width: var(--measure-wide); word-break: keep-all; }

  .gl-record { display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 26px; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); }
  .gl-rec-item { padding: 16px 14px 14px; border-left: 1px solid var(--line); }
  .gl-rec-item:first-child { border-left: none; padding-left: 2px; }
  .gl-rec-n { font-size: 30px; font-weight: 700; color: var(--ink); line-height: 1.1; }
  .gl-rec-n.up { color: var(--up); }
  .gl-rec-n.down { color: var(--down); }
  .gl-rec-label { font-size: 11.5px; color: var(--sub); margin-top: 6px; font-weight: 600; }
  .gl-rec-note { font-size: 11px; color: var(--muted); margin-top: 10px; word-break: keep-all; }
  @media (max-width: 720px) {
    .gl-record { grid-template-columns: repeat(2, 1fr) 1fr; }
    .gl-rec-item:nth-child(4) { border-left: none; padding-left: 2px; }
    .gl-rec-item:nth-child(n + 4) { border-top: 1px solid var(--line); }
  }

  .gl-list-wrap { margin-top: 34px; }
  .gl-next { font-size: 13px; color: var(--sub); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; margin-bottom: 18px; word-break: keep-all; }
  .gl-next strong { color: var(--accent); }
  .gl-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .gl-card { display: block; border: 1px solid var(--line); border-radius: 12px; padding: 18px 19px; background: var(--paper); transition: border-color 0.2s, transform 0.2s; }
  .gl-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .gl-card-top { display: flex; justify-content: space-between; align-items: center; }
  .gl-ep { font-size: 12px; color: var(--muted); }
  .gl-badge { font-size: 10.5px; font-weight: 700; border-radius: 999px; padding: 3px 10px; letter-spacing: 0.03em; }
  .gl-badge.pending { color: var(--muted); border: 1px solid var(--line); }
  .gl-badge.a { color: #fff; background: var(--up); }
  .gl-badge.b { color: #fff; background: var(--down); }
  .gl-badge.partial { color: var(--ink); border: 1.5px solid var(--ink); }
  .gl-card-title { font-size: 16.5px; font-weight: 800; color: var(--ink); margin-top: 11px; line-height: 1.5; word-break: keep-all; }
  .gl-card-desc { font-size: 12.5px; color: var(--sub); line-height: 1.75; margin-top: 7px; word-break: keep-all; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .gl-card-meta { display: flex; justify-content: space-between; gap: 10px; font-size: 11px; color: var(--muted); margin-top: 12px; }
  .gl-verdict-note { color: var(--sub); word-break: keep-all; text-align: right; }

  .gl-method { margin-top: 40px; padding-bottom: 56px; }
  .gl-method-in { border-top: 1px solid var(--line); padding-top: 16px; max-width: 640px; }
  .gl-method-title { font-size: 12px; font-weight: 700; color: var(--ink); margin-bottom: 7px; }
  .gl-method-in p { font-size: 12px; color: var(--muted); line-height: 1.9; word-break: keep-all; }
</style>
