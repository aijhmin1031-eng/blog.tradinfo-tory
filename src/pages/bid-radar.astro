---
// 입찰레이더 제품 안내 — 2026-09-05 전면 개편으로 승인된 설계를 그대로 구현한 판이다.
//
// 자리는 그대로다(2026-09-04 에 갈라 둔 대로) — **이 페이지는 안내, 도구는 `/bid-radar/app/`**.
// 안내와 도구를 가르면 각자 잘하는 일을 한다: 안내는 검색에 걸리고(가볍고 글이 있다),
// 앱은 일을 한다(무겁고 글이 없다).
//
// 설계에서 바뀐 것은 셋이다 — 캐릭터 배너를 **실제 화면 갈무리**로 교체(비유 폐기 규약) ·
// 판정 3구분과 기능 범위를 표로 · 제공하지 않는 항목을 같은 표 안에 함께 적는다.
//
// ★ 공고 자료(`bid-notices.json`, 1.5MB)를 **화면으로 내보내지 않는다.** 프런트매터에서
//   건수만 읽어 문장에 넣으므로 방문자는 그 파일을 받지 않는다.
//
// ★ 대조 사전의 규모는 손으로 적지 않는다. `bid-licenses.json` 과 `qualifier.js` 에서
//   빌드 시점에 세므로 목록이 늘면 문장도 함께 는다.
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { url } from '../lib/site';
import notices from '../data/bid-notices.json';
import licenses from '../data/bid-licenses.json';
import { REGION_ALIASES } from '../lib/bid-radar/qualifier.js';

const c = (notices as any).counts ?? {};
const total = c.notices ?? 0;
const withLicense = c.withLicense ?? 0;
const withRegion = c.withRegion ?? 0;
const withBasis = c.withBasis ?? 0;
const asOf = String((notices as any).generatedAt ?? '').slice(0, 10);
const isSample = (notices as any).source !== 'g2b';
const pct = (n: number) => (total ? ((n / total) * 100).toFixed(1) : '0.0');
const num = (n: number) => n.toLocaleString('ko-KR');

const licGroups = (licenses as any).groups ?? [];
const licCount = licGroups.reduce((a: number, g: any) => a + (g.items?.length ?? 0), 0);
const regionCount = Object.keys(REGION_ALIASES).length;

const stat = [
  { k: '수집 공고', v: num(total), n: `조달청 나라장터 · ${asOf} 수집분` },
  { k: '면허 요건 명시', v: num(withLicense), n: `전체의 ${pct(withLicense)}% · 나머지는 확인필요` },
  { k: '지역 제한 명시', v: num(withRegion), n: `전체의 ${pct(withRegion)}% · 나머지는 확인필요` },
  { k: '기초금액 기재', v: num(withBasis), n: `전체의 ${pct(withBasis)}% · 투찰가 산출 가능 공고` },
];

const panes = [
  {
    n: '1', k: '메뉴',
    v: '수집 조건과 기업 정보를 설정합니다. 소재지·보유 면허·업무구분·수집 기간을 지정하며, 조건을 변경하면 목록이 즉시 갱신됩니다.',
  },
  {
    n: '2', k: '공고 목록',
    v: '수집한 공고를 판정 결과와 함께 표시합니다. 열 단위 정렬과 마감 임박 표시를 제공하며, 행을 선택하면 우측에 상세가 표시됩니다.',
  },
  {
    n: '3', k: '공고 상세',
    v: '선택한 공고의 판정 근거·기초금액·마감일시·공동도급 조건을 표시합니다. 목록을 벗어나지 않고 같은 화면에서 대조합니다.',
  },
];

const verdicts = [
  ['참여가능', '공고에 기재된 지역 제한과 면허 요건을 기업 정보가 모두 충족하는 경우', '공동도급 · 투찰가 참고표 제공'],
  ['확인필요', '공고에 요건이 기재되지 않았거나, 대조 사전에 없는 표기로 기재되어 판정 근거를 확정할 수 없는 경우', '공고서 원문 확인 안내'],
  ['자격미달', '지역 제한 또는 면허 요건 가운데 하나 이상을 충족하지 않음이 확인된 경우', '미충족 요건 표시'],
];

const sheets = [
  ['1', '공고 비교표', '공고번호 · 공고명 · 발주기관 · 기초금액 · 마감일시 · 판정 및 근거'],
  ['2', '참여 체크리스트', '공고별 제출 서류와 확인 항목. 선택한 공고 기준으로 생성'],
  ['3', '공동도급 분류', '공동수급방식 · 주공종 · 지역의무공동도급 · 실적제한 해당 여부'],
  ['4', '투찰가 참고표', '낙찰하한율별 하한선과 조합 통과 비율. 참고용 통계'],
];

// 제공 범위. **미제공을 같은 표에 적는다** — 어디까지 신뢰할 수 있는지가 도구의 제원이다.
const scope: [string, boolean, string][] = [
  ['공고 수집 및 조건별 선별', true, '매일 06:50 갱신'],
  ['참여 자격 3구분 판정 및 근거', true, '규칙 기반 · 참고용'],
  ['공고별 관심 표시 · 메모 · 제출서류 점검', true, '사용 중인 브라우저에 저장'],
  ['공동도급 가능 여부 및 인정 실적', true, '기초자료 화면'],
  ['투찰가 참고표', true, '조합 통과 비율 · 낙찰 확률 아님'],
  ['낙찰 예측 및 순위 추정', false, '예정가격 결정은 추첨이며 예측 대상이 아닙니다'],
  ['공고 마감 알림 및 외부 전송', false, '웹판은 알림 연동을 포함하지 않습니다'],
  ['발주기관 자격 심사 대행', false, '최종 자격 확인은 공고서와 발주기관 기준을 따릅니다'],
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '입찰레이더',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  url: 'https://dotoriecon.com/bid-radar/app/',
  description:
    '조달청 나라장터 입찰공고를 기업의 소재지와 보유 면허를 기준으로 선별하여 참여가능·확인필요·자격미달의 3구분으로 판정하고, 공동도급 가능 여부와 투찰가 참고표를 함께 제공합니다.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  publisher: { '@type': 'Organization', name: '도토리경제' },
};
---

<Base
  title="입찰레이더"
  description="조달청 나라장터 입찰공고를 기업의 소재지와 보유 면허로 선별하여 참여가능·확인필요·자격미달을 판정합니다. 판정 근거를 공고별로 제시하며, 공동도급 가능 여부와 투찰가 참고표를 함께 제공합니다."
  activeNav="tools"
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />

  <section class="th">
    <div class="wrap">
      <div class="tag">
        <span class="kick">지원 도구</span>
        <span class="rule"></span>
        <span class="chip">공공조달 · 웹 응용프로그램</span>
      </div>
      <h1>입찰레이더</h1>
      <p class="lead">
        조달청 나라장터 입찰공고를 기업의 소재지와 보유 면허를 기준으로 선별하여 참여 자격을
        3구분으로 판정하는 도구입니다. 판정 근거를 공고별로 함께 제시합니다.
        설치와 회원가입 없이 브라우저에서 이용합니다.
      </p>
      <div class="strip">
        {stat.map((s) => (
          <div class="strip-c">
            <div class="strip-k">{s.k}</div>
            <div class="strip-v mono">{s.v}</div>
            <div class="strip-n">{s.n}</div>
          </div>
        ))}
      </div>
      {isSample && (
        <p class="sample">
          현재 표시된 공고는 화면 구성을 위한 예시입니다. 수집분이 연결되면 최신 값이 적용됩니다.
        </p>
      )}
    </div>
  </section>

  <section class="wrap shot-sec">
    <div class="sec-k">화면 구성</div>
    <h2 class="sec-h">좌측 메뉴 · 공고 목록 · 공고 상세</h2>
    <div class="shot">
      <Pic
        path="bid-radar-app.jpg"
        alt="입찰레이더 화면. 좌측에 메뉴, 중앙에 수집 공고 목록, 우측에 선택한 공고의 상세 정보가 배치된 3단 구성."
        width={1240}
        height={760}
      />
    </div>
    <div class="panes">
      {panes.map((p) => (
        <div class="pane">
          <div class="pane-h">
            <span class="pane-n mono">{p.n}</span>
            <span class="pane-k">{p.k}</span>
          </div>
          <div class="pane-v">{p.v}</div>
        </div>
      ))}
    </div>
  </section>

  <div class="tb">
    <section class="sec">
      <div>
        <div class="sec-k">판정 체계</div>
        <h2 class="sec-h">판정 3구분과 분류 기준</h2>
        <p class="tx">
          수집한 공고 전부를 다음 3구분으로 판정하고, 각 판정에 적용한 조건과 기업 정보의 대조
          결과를 함께 표시합니다.
        </p>
        <div class="tw">
          <table class="t">
            <caption>판정 구분 및 분류 기준</caption>
            <thead><tr><th>구분</th><th>분류 기준</th><th class="n">후속 처리</th></tr></thead>
            <tbody>
              {verdicts.map(([k, v, after]) => (
                <tr><td><b>{k}</b></td><td>{v}</td><td class="n">{after}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="tx">
          판정은 공고 본문의 표기를 대조 사전과 맞추는 <b>규칙 기반 방식</b>입니다. 면허는
          {licGroups.length}개 갈래 {licCount}종의 목록과 대조하고, 지역은 광역 {regionCount}종의
          표준 표기와 약칭을 맞춘 뒤 시·군·구 표기는 문자열 포함으로 판정합니다.
          {asOf} 수집분 {num(total)}건 가운데 면허 요건이 명시된 공고는 {num(withLicense)}건,
          지역 제한이 명시된 공고는 {num(withRegion)}건이며 나머지는 확인필요로 분류됩니다.
        </p>
      </div>
      <aside class="side">
        <div class="side-h">참고자료</div>
        <dl>
          <dt>자료</dt><dd>조달청 나라장터 입찰공고 오픈API</dd>
          <dt>대조 사전</dt><dd>면허 {licCount}종 · 광역 지역 {regionCount}종</dd>
          <dt>갱신</dt><dd>매일 06:50 KST 수집</dd>
        </dl>
      </aside>
    </section>

    <section class="sec">
      <div>
        <div class="sec-k">기초자료</div>
        <h2 class="sec-h">기초자료 4개 시트</h2>
        <p class="tx">
          조건에 부합하는 공고를 다음 4개 시트로 구성하여 제공합니다. 공동도급 인정 실적 산출도
          이 화면에서 수행합니다.
        </p>
        <div class="tw">
          <table class="t">
            <caption>기초자료 시트 구성</caption>
            <thead><tr><th class="n">번호</th><th>시트</th><th>수록 항목</th></tr></thead>
            <tbody>
              {sheets.map(([no, name, items]) => (
                <tr><td class="n">{no}</td><td><b>{name}</b></td><td>{items}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="tx">
          공고를 수집하고 판정하는 작업은 <b>입찰레이더</b>가 수행하고, 주공종·지역의무공동도급·
          실적제한과 같은 세부 조건의 검토와 공동도급 인정 실적 산출은 <b>기초자료</b>가
          수행합니다. 두 화면의 역할을 분리한 이유는 전자가 매일 갱신되는 목록이고 후자가 특정
          공고를 대상으로 하는 검토이기 때문입니다.
        </p>
        <p class="tx">
          세부 조건의 제공률은 공고마다 다릅니다. 지역의무공동도급 해당 여부는 공사 공고 전부에
          기재되지만(실측 100%), 주공종은 공사 공고의 <b>37.9%</b>에만 기재됩니다. 주공종이 기재되지
          않은 공고는 해당 조건의 선별 대상에서 제외되므로, 선별 결과만 확인하는 조건으로
          사용하시기 바랍니다.
        </p>
      </div>
      <aside class="side">
        <div class="side-h">참고자료</div>
        <dl>
          <dt>산출</dt><dd>공동도급 인정 실적 · 지분율별 환산</dd>
          <dt>검증</dt><dd>원 엔진과 판정 및 사유 문장을 문자열 단위로 대조</dd>
          <dt>형식</dt><dd>화면 표시 및 표 형식 내려받기</dd>
        </dl>
      </aside>
    </section>

    <section class="sec">
      <div>
        <div class="sec-k">제공 범위</div>
        <h2 class="sec-h">기능 범위와 제외 항목</h2>
        <p class="tx">
          도구의 범위를 사전에 명시합니다. 제공하지 않는 항목을 밝히는 이유는 이용자가 도구의
          산출값을 어디까지 신뢰할 수 있는지 판단하기 위해서입니다.
        </p>
        <div class="tw">
          <table class="t">
            <caption>기능 범위</caption>
            <thead><tr><th>항목</th><th class="n">제공</th><th>비고</th></tr></thead>
            <tbody>
              {scope.map(([item, yes, note]) => (
                <tr>
                  <td>{item}</td>
                  <td class:list={['n', !yes && 'off']}>{yes ? <b>제공</b> : '미제공'}</td>
                  <td>{note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <aside class="side">
        <div class="side-h">참고자료</div>
        <dl>
          <dt>이용 조건</dt><dd>설치 및 회원가입 불필요</dd>
          <dt>처리 방식</dt><dd>브라우저 내 연산 · 입력 정보 미전송</dd>
          <dt>책임 범위</dt><dd>산출값은 참고 자료이며 법적 효력이 없습니다</dd>
        </dl>
      </aside>
    </section>

    <section class="close">
      <h2 class="close-t">한계 및 이용상 유의사항</h2>
      <p class="tx">
        본 도구의 판정은 공고 본문에 기재된 표기를 대조 사전과 맞추는 규칙 기반 방식입니다. 공고가
        요건을 기재하지 않았거나 사전에 없는 표기를 사용한 경우 판정 근거를 확정할 수 없으며, 이러한
        공고는 확인필요로 분류됩니다. <b>참여가능 판정은 참여 자격의 보증이 아니며</b>, 최종 자격
        확인은 공고서 원문과 발주기관의 심사 기준을 따릅니다. 투찰가 참고표의 산출값은 하한선 미달로
        탈락하지 않을 조합의 비율이며 낙찰 확률이 아닙니다.
      </p>
      <div class="cta">
        <a class="b1" href={url('/bid-radar/app/')}>입찰레이더 이용</a>
        <a class="b2" href={url('/bid-radar/sheets/')}>기초자료 화면</a>
        <a class="b2" href={url('/bid-odds/')}>복수예가 투찰률 계산기</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .wrap { max-width: 1440px; margin: 0 auto; padding: 0 64px; }
  .th { background: #fff; border-bottom: 1px solid #e4e4de; padding: 52px 0 42px; }
  .tag { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .kick { font-size: 10.5px; font-weight: 600; letter-spacing: 1.6px; color: #8e9299; }
  .rule { width: 26px; height: 1px; background: #d2d2ca; }
  .chip { font-size: 11.5px; color: #71767d; border: 1px solid #e4e4de; padding: 2px 8px; }
  h1 { font-size: 44px; line-height: 1.34; font-weight: 900; color: #15171a; margin: 0 0 26px; letter-spacing: -1.8px; }
  .lead { font-size: 17px; line-height: 1.95; color: #2e3238; max-width: 900px; margin: 0 0 34px; }
  .strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px;
           background: #e4e4de; border-top: 1.6px solid #15171a; border-bottom: 1px solid #e4e4de; }
  .strip-c { background: #fff; padding: 17px 22px 18px; }
  .strip-k { font-size: 12px; color: #71767d; margin-bottom: 8px; }
  .strip-v { font-size: 24px; font-weight: 500; color: #15171a; letter-spacing: -0.7px; }
