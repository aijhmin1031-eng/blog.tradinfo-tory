---
// 입찰레이더 — 나라장터 공고 자동 선별 · 2026-09-03 신설.
//
// 입찰레이더(별도 repo `ai-bid-radar`)의 엔진을 그대로 옮긴 화면이다. 그 프로그램에는
// 웹 화면이 없다. 결과가 나가는 곳이 **텔레그램 알림 카드**와 **기초자료 엑셀 네 시트**뿐이라,
// 그 둘을 화면에 그대로 세웠다. 열 이름·순서·문구·이모지까지 같다.
//
// 이식한 것: 자격필터(qualifier.py) · 공동도급 분류(joint_supply.py) ·
//            기초자료(briefing.py, briefing_excel.py) · 알림 카드(notifier.py) ·
//            투찰가 산정(bid_price.py, `/bid-odds/` 와 같은 모듈)
// 판정은 전부 브라우저에서 돈다. 인증키는 이 사이트에 없다.
//
// 공고 데이터는 `src/data/bid-notices.json` 이고, CI 의 `scripts/pipeline/g2b.mjs` 가
// 나라장터에서 받아 갱신한다. 키가 없으면 예시 세트가 그대로 남고 화면이 그것을 밝힌다.
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { url } from '../lib/site';
import notices from '../data/bid-notices.json';
import licenseCatalog from '../data/bid-licenses.json';
import regions from '../data/bid-regions.json';

// 크몽 문의 업체(조경식재·지반조성 전문건설)의 업종을 기본값으로 둔다.
const DEFAULT_LICENSES = ['조경식재ㆍ시설물공사업', '지반조성ㆍ포장공사업'];
const DEFAULT_PROV = '경상남도';
const DEFAULT_DIST = '창원시';
const DEFAULT_REGION = `${DEFAULT_PROV} ${DEFAULT_DIST}`;

// ★ 고를 수 있는 이름은 **API 가 실제로 쓰는 이름**이어야 한다(2026-09-04).
// 손으로 적은 등록부는 반드시 낡으므로, 수집기가 함께 저장한 어휘와 합친다.
// 등록부에 없는 업종·지역이 공고에 나오면 그대로 목록에 선다.
const vocab = notices.licenseVocab || [];
const known = new Set(licenseCatalog.groups.flatMap((g) => g.items));
const extra = vocab.map((v) => v.name).filter((n) => n && !known.has(n));
const licenseGroups = extra.length
  ? [...licenseCatalog.groups, { label: '그 밖에 공고에 나온 업종', items: extra }]
  : licenseCatalog.groups;

// 지역도 같은 방식이다. 등록부의 기초 목록에 실제 어휘를 더한다.
const rvocab = notices.regionVocab || {};
const provMap = new Map(regions.provinces.map((p) => [p.name, { ...p, districts: [...p.districts] }]));
for (const [prov, dists] of Object.entries(rvocab)) {
  if (!provMap.has(prov)) provMap.set(prov, { name: prov, short: prov, districts: [] });
  const cur = provMap.get(prov);
  for (const d of dists) if (!cur.districts.includes(d)) cur.districts.push(d);
}
const provinces = [...provMap.values()].map((p) => ({
  ...p,
  districts: [...p.districts].sort((a, b) => a.localeCompare(b, 'ko')),
}));

const isSample = notices.source === 'sample';
const asOf = notices.generatedAt ? notices.generatedAt.slice(0, 10).replace(/-/g, '.') : '';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '입찰레이더',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  description:
    '나라장터 입찰공고를 업체의 지역·면허 조건으로 선별하고, 공동도급 가능 여부와 투찰가 참고표를 함께 냅니다.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  publisher: { '@type': 'Organization', name: '도토리경제' },
};
---

<Base
  title="입찰레이더"
  description="나라장터 입찰공고를 업체의 지역·보유 면허로 선별합니다. 참여가능·확인필요·자격미달을 가르고, 공동도급 가능 여부와 참여 체크리스트, 복수예가 투찰가 참고표를 한 화면에 냅니다."
  compact
  activeNav="warehouse"
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <script type="application/json" id="br-data" set:html={JSON.stringify(notices)} />
  <script
    type="application/json"
    id="br-regions"
    set:html={JSON.stringify({ provinces, defaultProv: DEFAULT_PROV, defaultDist: DEFAULT_DIST })}
  />

  <section class="wrap br">
    <header class="br-head">
      <div class="br-head-text">
        <div class="kicker-en" style="color: var(--accent);">BID RADAR</div>
        <h1 class="serif br-title">입찰레이더</h1>
        <p class="br-sub">
          나라장터 공고를 업체의 <strong>지역과 보유 면허</strong>로 갈라
          <strong>참여가능·확인필요·자격미달</strong>을 판정합니다. 통과한 공고에는 공동도급
          가능 여부, 참여 체크리스트, 복수예가 투찰가 참고표가 함께 붙습니다.
        </p>
        <p class="br-note">
          판정은 규칙 기반이며 참고용입니다. 최종 자격 확인은 공고서와 발주기관 기준을 따릅니다.
          {isSample
            ? ' 지금 보이는 공고는 화면 구성을 위한 예시입니다. 실제 수집이 연결되면 자동으로 교체됩니다.'
            : ` 수집 기준일 ${asOf}.`}
        </p>
      </div>
      <div class="br-head-art">
        <Pic
          path="bid-radar-banner.jpg"
          alt="네이비 조끼를 입고 둥근 안경을 쓴 다람쥐 분석가가 서류판을 들고 연필로 심사판을 가리키고 있다. 심사판에는 세 줄의 공고 서류가 놓여 있고 각 줄 왼쪽에 초록 체크·주황 물음표·빨강 가위표 표시가 차례로 붙어 있다."
          width={800}
          height={450}
        />
      </div>
    </header>

    <form class="br-form" id="br-form" autocomplete="off">
      {/* ── 1단: 업체 조건 ── 판정의 재료다. 소재지·면허 둘 다 선택으로 받는다. */}
      <div class="br-grid">
        <div class="br-f">
          <span class="br-l">업체 소재지 <em>목록에서 고릅니다</em></span>
          {/* 판정 쪽은 예전처럼 「경상남도 창원시」 같은 문자열 하나만 읽는다.
              두 선택칸이 이 숨은 칸을 채우므로 qualifier 는 손대지 않았다. */}
          <input type="hidden" id="f-region" value={DEFAULT_REGION} />
          <div class="br-two">
            <select id="f-prov" aria-label="광역시·도"></select>
            <select id="f-dist" aria-label="시·군·구"></select>
          </div>
        </div>
        <div class="br-f br-wide">
          <span class="br-l">보유 면허·업종 <em>목록에서 고릅니다</em></span>
          {/* 엔진은 예전처럼 쉼표로 이어 붙인 문자열 하나만 읽는다.
              드롭다운이 이 숨은 칸을 채우므로 판정 쪽은 손대지 않았다. */}
          <input type="hidden" id="f-lic" value={DEFAULT_LICENSES.join(', ')} />
          <div class="br-ms" id="br-ms">
            <button type="button" class="br-ms-btn" id="br-ms-btn"
                    aria-haspopup="listbox" aria-expanded="false">
              <span id="br-ms-label">면허를 고르십시오</span>
              <span class="br-ms-caret" aria-hidden="true">▾</span>
            </button>
            <div class="br-ms-pop" id="br-ms-pop" role="listbox" aria-multiselectable="true" hidden>
              <div class="br-ms-tools">
                <input type="search" id="br-ms-q" placeholder="면허 이름으로 좁히기" aria-label="면허 검색" />
                <button type="button" class="br-ms-clear" id="br-ms-clear">전체 해제</button>
              </div>
              <div class="br-ms-list" id="br-ms-list">
                {licenseGroups.map((g) => (
                  <div class="br-ms-g" data-group={g.label}>
                    <div class="br-ms-gl">{g.label}</div>
                    {g.items.map((it) => (
                      <label class="br-ms-o" data-name={it}>
                        <input type="checkbox" value={it} checked={DEFAULT_LICENSES.includes(it)} />
                        <span>{it}</span>
                      </label>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="br-ms-chips" id="br-ms-chips"></div>
        </div>
      </div>

      {/* ── 2단: 공고 조건 ── 입찰레이더 공고관리 화면(docs/18 §2-A)의 조건 막대를
          그대로 옮긴 자리다. 1행은 검색, 2행은 고르는 조건. 순서까지 같다. */}
      <div class="br-bar">
        <div class="br-search">
          <span class="br-si" aria-hidden="true">🔍</span>
          <input type="search" id="f-q" placeholder="공고명을 입력해 검색하십시오" aria-label="공고명 검색" />
          <button type="button" class="br-reset" id="f-reset">조건 초기화</button>
        </div>
        <div class="br-filters">
          <div class="br-seg" role="group" aria-label="판정">
            <button type="button" class="br-sg is-on" data-v="all" aria-pressed="true">전체</button>
            <button type="button" class="br-sg" data-v="eligible" aria-pressed="false">참여 가능</button>
            <button type="button" class="br-sg" data-v="unknown" aria-pressed="false">확인 필요</button>
          </div>
          <label class="br-fl">업무
            <select id="f-div"><option value="">전체</option></select>
          </label>
          {/* 기간 — 기준을 고르고, 프리셋으로 좁히고, 필요하면 달력으로 직접 잡는다.
              공고가 많을수록 먼저 쓰게 되는 조건이라 한 묶음으로 붙여 두었다. */}
          <span class="br-fl br-period">기간
            <select id="f-base" aria-label="기간 기준">
              <option value="clse">마감일</option>
              <option value="ntce">공고일</option>
            </select>
            <select id="f-period" aria-label="기간 범위">
              <option value="">전체</option>
              <option value="1">오늘</option>
              <option value="3">사흘</option>
              <option value="7">이레</option>
              <option value="30">한 달</option>
              <option value="custom">직접 지정</option>
            </select>
            <span class="br-dates" id="br-dates" hidden>
              <input type="date" id="f-from" aria-label="시작일" />
              <span class="br-tilde" aria-hidden="true">~</span>
              <input type="date" id="f-to" aria-label="종료일" />
            </span>
          </span>
          <label class="br-fl">추정가
            <select id="f-amt">
              <option value="">전체</option>
              <option value="a">1억원 미만</option>
              <option value="b">1억 ~ 10억원</option>
              <option value="c">10억원 이상</option>
            </select>
          </label>
          <label class="br-fl">발주처
            <select id="f-org"><option value="">전체</option></select>
          </label>
          <label class="br-chk"><input type="checkbox" id="f-joint" /> 공동도급 가능만</label>
        </div>
        <div class="br-active" id="br-active" hidden></div>
      </div>
    </form>

    <div class="br-tally" id="br-tally" role="status" aria-live="polite"></div>

    <section class="br-sheetwrap">
      <div class="br-rhead">
        <h2 class="br-h3">기초자료 <span class="br-h3s">엑셀 네 시트를 화면으로</span></h2>
        <button type="button" class="br-dl" id="br-dl">
          <span aria-hidden="true">⤓</span> 엑셀로 받기
        </button>
      </div>
      <p class="br-dlnote" id="br-dlnote">
        지금 화면에 보이는 공고가 네 시트로 담깁니다. 공고번호를 누르면 나라장터 원문이 열립니다.
      </p>
      <div class="br-tabs" role="tablist" id="br-tabs" aria-label="기초자료 네 시트">
        <button type="button" class="br-tab is-on" data-tab="compare" role="tab"
                aria-selected="true" aria-controls="br-sheet">공고 비교표</button>
        <button type="button" class="br-tab" data-tab="check" role="tab"
                aria-selected="false" aria-controls="br-sheet">참여 체크리스트</button>
        <button type="button" class="br-tab" data-tab="joint" role="tab"
                aria-selected="false" aria-controls="br-sheet">공동도급 분류</button>
        <button type="button" class="br-tab" data-tab="price" role="tab"
                aria-selected="false" aria-controls="br-sheet">투찰가 참고</button>
      </div>
      <p class="br-tabnote" id="br-tabnote"></p>
      <div class="br-scroll" tabindex="0" role="region" aria-label="기초자료 표 (가로로 스크롤됩니다)">
        <div id="br-sheet" role="tabpanel" aria-live="polite"></div></div>
    </section>

    <section class="br-explain">
      <h2 class="serif br-h2">판정이 갈리는 규칙</h2>
      <p>
        지역은 공고에 참가가능지역이 지정된 경우에만 봅니다. 지정돼 있으면 업체 소재지가 그 안에
        들어야 하고, 광역과 기초 표기 차이는 보정합니다. 경남과 경상남도는 같은 것으로 읽습니다.
        면허는 공고가 요구하는 면허 가운데 하나라도 보유 면허와 맞으면 통과합니다. 면허명 뒤에
        붙는 코드는 떼고 비교합니다.
      </p>
      <p>
        <strong>업종제한이 있다고 표시돼 있는데 면허 상세를 받지 못한 공고는 확인필요로 남깁니다.</strong>
        제한이 없는 것과 확인하지 못한 것은 다릅니다. 이 둘을 섞으면 참여 못 할 공고가
        참여가능으로 올라오거나, 될 공고가 조용히 사라집니다.
      </p>

      <h2 class="serif br-h2">공동도급에서 할 수 있는 것과 없는 것</h2>
      <p>
        공고의 공동수급방식으로 공동이행·분담이행·혼합·주계약자·단독을 가릅니다.
        <strong>분담이행</strong>은 공종을 나눠 각자 맡은 부분만 하므로, 타 공종 실적이 없는
        업체가 들어갈 자리가 여기서 생깁니다. <strong>공동이행</strong>은 출자비율대로 함께
        시공하고 실적도 지분만큼 인정됩니다.
      </p>
      <p>
        다만 <strong>실적 공동도급과 무실적 공동도급의 구분은 이 데이터로 알 수 없습니다.</strong>
        구성원별 실적 인정 비율과 최소 지분율은 공고서와 현장설명서 본문에 적히고, 조달청 API 는
        그 본문을 필드로 주지 않습니다. 그래서 화면은 어떤 방식이 열려 있는지까지만 말하고,
        실적 계산이 필요하다는 사실을 메모로 남깁니다.
      </p>

      <h2 class="serif br-h2">투찰가는 참고용 통계입니다</h2>
      <p>
        기초금액이 공개된 공고에는 복수예비가격 조합을 전수 전개한 투찰가 참고표가 붙습니다.
        낙찰 확률이 아니라 <strong>하한선 미달로 탈락하지 않을 조합의 비율</strong>이며,
        예정가격은 추첨으로 정해집니다. 계산 구조와 가정은
        <a href={url('/bid-odds/')}>복수예가 투찰률 계산기</a>에 자세히 있습니다.
        기초금액이 아직 공개되지 않은 공고는 비워 둡니다. 추정가격으로 대신 채우지 않습니다.
      </p>

      <h2 class="serif br-h2">데이터와 인증키</h2>
      <p>
        공고는 조달청 나라장터 입찰공고정보서비스에서 받습니다. 이 사이트는 정적 페이지라
        브라우저가 API 를 직접 부르지 않습니다. 수집은 서버 쪽 작업이 맡고, 화면은 그 결과 파일을
        읽습니다. 입력한 업체 정보는 어디에도 전송되지 않고 브라우저 안에서만 쓰입니다.
      </p>
    </section>
  </section>

  <script>
    import { evaluate as judge, VERDICT_LABEL } from '../lib/bid-radar/qualifier.js';
    import * as joint from '../lib/bid-radar/joint-supply.js';
    import {
      summarize, checklist, jointSupplyRows, bidPriceRow, noticeUrl,
      COMPARE_COLS, BID_PRICE_COLS,
    } from '../lib/bid-radar/briefing.js';
    import { buildWorkbook } from '../lib/bid-radar/xlsx.js';

    const $ = (id) => document.getElementById(id);
    const DATA = JSON.parse($('br-data').textContent);
    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');

    let tab = 'compare';
    // 정렬 상태. 열 머리를 누르면 없음 → 오름 → 내림 → 없음으로 돌아간다
    // (입찰레이더 공고관리 화면 docs/18 §2-E 와 같은 3단계다).
    let sort = { key: '', dir: '' };

    /** 정규컬럼(snake) 우선, 없으면 raw(camel). briefing.js 의 g() 와 같은 규칙이다. */
    function field(n, ...keys) {
      const r = n.raw || {};
      for (const k of keys) {
        const v = n[k];
        if (v !== undefined && v !== null && v !== '' && v !== '0') return v;
      }
      for (const k of keys) {
        const v = r[k];
        if (v !== undefined && v !== null && v !== '' && v !== '0') return v;
      }
      return null;
    }

    const nm = (n) => String(field(n, 'bid_ntce_nm', 'bidNtceNm') || '');
    const org = (n) => String(field(n, 'dminstt_nm', 'dminsttNm', 'ntce_instt_nm', 'ntceInsttNm') || '');
    const price = (n) => {
      const v = field(n, 'presmpt_prce', 'presmptPrce');
      const x = Number(String(v ?? '').replace(/,/g, ''));
      return Number.isFinite(x) ? x : NaN;
    };
    const timeOf = (n, ...keys) => {
      const t = String(field(n, ...keys) || '').trim();
      if (!t) return NaN;
      const d = new Date(t.replace(' ', 'T'));
      return Number.isNaN(d.getTime()) ? NaN : d.getTime();
    };
    const clseMs = (n) => timeOf(n, 'bid_clse_dt', 'bidClseDt');
    const openMs = (n) => timeOf(n, 'bid_ntce_dt', 'bidNtceDt');
    const divOf = (n) => String(n.work_div || '');
    const DIV_LABEL = { cnstwk: '공사', servc: '용역', thng: '물품', frgcpt: '외자', etc: '기타' };

    const profile = () => ({
      region: $('f-region').value.trim(),
      licenses: $('f-lic').value.split(',').map((s) => s.trim()).filter(Boolean),
    });

    function judged() {
      const p = profile();
      return DATA.notices.map((n) => ({
        notice: n,
        match: judge(n, n.licenseLimits || [], n.possibleRegions || [], p),
        joint: joint.evaluate(n, n.raw || {}),
      }));
    }

    // ── 조건 상태 ────────────────────────────────────────────────────
    // 입찰레이더 공고관리 화면(docs/18 §1 필수 2·4·5·6, 권장 15·17)의 조건을 옮겼다.
    let verdict = 'all';

    const cond = () => ({
      q: $('f-q').value.trim(),
      verdict,
      div: $('f-div').value,
      base: $('f-base').value,
      period: $('f-period').value,
      from: $('f-from').value,
      to: $('f-to').value,
      amt: $('f-amt').value,
      org: $('f-org').value,
      joint: $('f-joint').checked,
    });

    /** 기간 조건을 [시작, 끝] 밀리초로 편다. 조건이 없으면 null. */
    function span(c) {
      if (c.period === 'custom') {
        if (!c.from && !c.to) return null;
        // 끝날은 그날 하루를 통째로 포함한다(23:59:59.999).
        return [
          c.from ? new Date(`${c.from}T00:00:00`).getTime() : -Infinity,
          c.to ? new Date(`${c.to}T23:59:59.999`).getTime() : Infinity,
        ];
      }
      if (!c.period) return null;
      const n = Number(c.period) * 864e5;
      const now = Date.now();
      // 마감일은 **앞으로** 며칠, 공고일은 **최근** 며칠이다. 기준이 바뀌면 방향도 바뀐다.
      return c.base === 'ntce' ? [now - n, now] : [now, now + n];
    }

    const AMT = {
      a: (v) => Number.isFinite(v) && v < 1e8,
      b: (v) => Number.isFinite(v) && v >= 1e8 && v < 1e9,
      c: (v) => Number.isFinite(v) && v >= 1e9,
    };

    /**
     * 화면에 실을 공고. ★ 거르기와 정렬을 **여기 한 곳에서** 끝낸다.
     * 카드·표·집계·엑셀이 모두 이 함수를 거치므로, 한쪽만 정렬하면 엑셀
     * 하이퍼링크가 배열 순서와 어긋난다(그래서 정렬을 밖으로 빼지 않는다).
     */
    function shown(rows) {
      const c = cond();
      let out = rows;
      if (c.q) {
        const q = c.q.toLowerCase();
        out = out.filter((r) => nm(r.notice).toLowerCase().includes(q));
      }
      if (c.verdict !== 'all') out = out.filter((r) => r.match.verdict === c.verdict);
      if (c.div) out = out.filter((r) => divOf(r.notice) === c.div);
      if (c.org) out = out.filter((r) => org(r.notice) === c.org);
      if (c.amt) out = out.filter((r) => AMT[c.amt](price(r.notice)));
      const sp = span(c);
      if (sp) {
        out = out.filter((r) => {
          const t = c.base === 'ntce' ? openMs(r.notice) : clseMs(r.notice);
          return Number.isFinite(t) && t >= sp[0] && t <= sp[1];
        });
      }
      if (c.joint) out = out.filter((r) => r.joint.available);

      // 값이 없는 건은 늘 뒤로 보낸다(NaN 이 비교에 섞이면 순서가 무너진다).
      const cmp = {
        '공고명': (a, b) => nm(a.notice).localeCompare(nm(b.notice), 'ko'),
        '수요기관': (a, b) => org(a.notice).localeCompare(org(b.notice), 'ko'),
        '추정가격': (a, b) => numCmp(price(a.notice), price(b.notice)),
        '입찰마감': (a, b) => numCmp(clseMs(a.notice), clseMs(b.notice)),
        '공고게시': (a, b) => numCmp(openMs(a.notice), openMs(b.notice)),
      };
      const base = [...out];
      if (sort.key && cmp[sort.key]) {
        base.sort((a, b) => cmp[sort.key](a, b) * (sort.dir === 'desc' ? -1 : 1));
      } else {
        // 기본값은 마감 임박순이다. 입찰자가 가장 먼저 보는 값이므로.
        base.sort((a, b) => numCmp(clseMs(a.notice), clseMs(b.notice)));
      }
      return base;
    }

    function numCmp(a, b) {
      const na = Number.isFinite(a);
      const nb = Number.isFinite(b);
      if (!na && !nb) return 0;
      if (!na) return 1;
      if (!nb) return -1;
      return a - b;
    }

    // ── 조건 칸 채우기 ───────────────────────────────────────────────
    // 업무구분·발주처는 **실제 수집된 값만** 목록에 세운다(없는 항목을 세우면
    // 고르는 순간 0건이 되어 화면이 고장 난 것처럼 보인다).
    function fillChoices() {
      const divs = [...new Set(DATA.notices.map(divOf).filter(Boolean))];
      $('f-div').innerHTML = '<option value="">전체</option>'
        + divs.map((d) => `<option value="${esc(d)}">${esc(DIV_LABEL[d] || d)}</option>`).join('');
      const orgs = [...new Set(DATA.notices.map(org).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'ko'));
      $('f-org').innerHTML = '<option value="">전체</option>'
        + orgs.map((o) => `<option value="${esc(o)}">${esc(o)}</option>`).join('');
    }

    const BASE_LABEL = { clse: '마감일', ntce: '공고일' };
    const PERIOD_LABEL = { 1: '오늘', 3: '사흘', 7: '이레', 30: '한 달' };
    const AMT_LABEL = { a: '1억원 미만', b: '1억 ~ 10억원', c: '10억원 이상' };
    const VERDICT_TEXT = { eligible: '참여 가능', unknown: '확인 필요' };

    /** 지금 걸린 조건을 칩으로 편다. 하나씩 끄거나 한꺼번에 지운다. */
    function renderActive() {
      const c = cond();
      const chips = [];
      if (c.q) chips.push(['q', `"${c.q}" 검색`]);
      if (c.verdict !== 'all') chips.push(['verdict', `판정: ${VERDICT_TEXT[c.verdict]}`]);
      if (c.div) chips.push(['div', `업무: ${DIV_LABEL[c.div] || c.div}`]);
      if (c.period === 'custom' && (c.from || c.to)) {
        chips.push(['period', `기간: ${BASE_LABEL[c.base]} ${c.from || '처음'} ~ ${c.to || '끝'}`]);
      } else if (c.period) {
        const word = c.base === 'ntce'
          ? (c.period === '1' ? '오늘' : `최근 ${PERIOD_LABEL[c.period]}`)
          : `${PERIOD_LABEL[c.period]} 안`;
        chips.push(['period', `기간: ${BASE_LABEL[c.base]} ${word}`]);
      }
      if (c.amt) chips.push(['amt', `추정가: ${AMT_LABEL[c.amt]}`]);
      if (c.org) chips.push(['org', `발주처: ${c.org}`]);
      if (c.joint) chips.push(['joint', '공동도급 가능만']);
      if (sort.key) chips.push(['sort', `정렬: ${sort.key} ${sort.dir === 'desc' ? '내림' : '오름'}차순`]);
      const box = $('br-active');
      box.hidden = chips.length === 0;
      if (!chips.length) return;
      box.innerHTML = '<span class="br-al">적용된 조건</span>'
        + chips.map(([k, t]) => `<button type="button" class="br-chip" data-clear="${esc(k)}">${esc(t)}<span aria-hidden="true">×</span></button>`).join('')
        + '<button type="button" class="br-clearall" id="br-clearall">전체 해제</button>';
    }

    function clearCond(key) {
      if (key === 'q') $('f-q').value = '';
      else if (key === 'verdict') setVerdict('all');
      else if (key === 'div') $('f-div').value = '';
      else if (key === 'period') {
        $('f-period').value = '';
        $('f-from').value = '';
        $('f-to').value = '';
        syncPeriod();
      }
      else if (key === 'amt') $('f-amt').value = '';
      else if (key === 'org') $('f-org').value = '';
      else if (key === 'joint') $('f-joint').checked = false;
      else if (key === 'sort') sort = { key: '', dir: '' };
    }

    function clearAll() {
      ['q', 'verdict', 'div', 'period', 'amt', 'org', 'joint', 'sort'].forEach(clearCond);
    }

    function setVerdict(v) {
      verdict = v;
      [...document.querySelectorAll('.br-sg')].forEach((b) => {
        const on = b.dataset.v === v;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      });
    }

    function renderTally(rows, list) {
      const c = { eligible: 0, unknown: 0, ineligible: 0 };
      rows.forEach((r) => { c[r.match.verdict] += 1; });
      const total = rows.length;
      const cut = total ? Math.round(((total - c.eligible) / total) * 100) : 0;
      const q = cond().q;
      $('br-tally').innerHTML = `
        <div class="br-tl">
          <div class="br-tn">${total}</div><div class="br-tt">수집 공고</div>
        </div>
        <div class="br-tl br-ok">
          <div class="br-tn">${c.eligible}</div><div class="br-tt">✅ 참여가능</div>
        </div>
        <div class="br-tl">
          <div class="br-tn">${c.unknown}</div><div class="br-tt">❓ 확인필요</div>
        </div>
        <div class="br-tl">
          <div class="br-tn">${c.ineligible}</div><div class="br-tt">❌ 자격미달</div>
        </div>
        <div class="br-tsum">전체 ${total}건 중 참여 가능 ${c.eligible}건${q ? ` · "${esc(q)}" 검색` : ''}.
          볼 공고가 <strong>${cut}%</strong> 줄었고, 지금 화면에 ${list.length}건을 폅니다.</div>`;
    }

    /**
     * 마감까지 남은 시간. 입찰자가 가장 먼저 보는 값이라 마감 칸에 배지로 붙인다.
     * ★ 표의 열 이름·값은 파이썬 정본과 같아야 하므로 손대지 않았다.
     * 이것은 그 칸 안에 **덧붙인 별개 표시**다(엑셀에는 나가지 않는다).
     */
    function dday(clse) {
      const t = String(clse || '').trim();
      if (!t) return null;
      const d = new Date(t.replace(' ', 'T'));
      if (Number.isNaN(d.getTime())) return null;
      const ms = d.getTime() - Date.now();
      if (ms < 0) return { cls: 'is-over', text: '마감' };
      const h = Math.floor(ms / 36e5);
      if (h < 24) return { cls: 'is-soon', text: `오늘 ${h}시간` };
      const day = Math.floor(h / 24);
      if (day <= 3) return { cls: 'is-soon', text: `D-${day}` };
      return { cls: '', text: `D-${day}` };
    }

    /** 공고번호 칸에 거는 원문 링크. URL 이 없으면 번호만 적는다(지어내지 않는다). */
    function noLink(no, url) {
      if (!url) return esc(no ?? '-');
      return `<a class="br-nolink" href="${esc(url)}" rel="nofollow noopener" target="_blank"
        title="나라장터에서 이 공고의 원문을 엽니다">${esc(no)}<span class="br-ext" aria-hidden="true">↗</span></a>`;
    }

    // 열 머리를 눌러 정렬할 수 있는 열. 표시값이 아니라 **공고의 원값**으로 정렬한다
    // (「5.7억」 같은 사람 표기를 글자로 늘어놓으면 순서가 뒤죽박죽이 된다).
    const SORTABLE = new Set(['공고명', '수요기관', '추정가격', '입찰마감', '공고게시']);

    /**
     * 판정 표시. ★ 색과 이모지로만 가르지 않는다 — 흑백 인쇄와 색각 이상에서
     * 셋이 한 덩어리가 된다. 그래서 **글자를 함께 적는다**(참여가능·확인필요·자격미달).
     * 표의 열 이름·값은 파이썬 정본과 같아야 하므로 열을 늘리지 않고
     * 공고번호 칸에 배지를 얹었다(엑셀에는 나가지 않는다).
     */
    function verdictBadge(m) {
      if (!m) return '';
      const v = VERDICT_LABEL[m.verdict];
      const why = (m.reasons || []).join(' · ');
      return `<span class="br-vb br-v-${m.verdict}" title="${esc(why)}">`
        + `<span aria-hidden="true">${v.icon}</span> ${esc(v.text)}</span>`;
    }

    function table(cols, rows, opts = {}) {
      if (!rows.length) return '';
      const th = cols.map((c) => {
        if (!SORTABLE.has(c)) return `<th>${esc(c)}</th>`;
        const on = sort.key === c;
        const aria = on ? (sort.dir === 'desc' ? 'descending' : 'ascending') : 'none';
        const mark = on ? (sort.dir === 'desc' ? '▼' : '▲') : '⇅';
        return `<th aria-sort="${aria}" class="br-th-s${on ? ' is-on' : ''}">`
          + `<button type="button" class="br-sortbtn" data-sort="${esc(c)}">${esc(c)}`
          + `<span class="br-sortmark" aria-hidden="true">${mark}</span></button></th>`;
      }).join('');
      const tr = rows.map((r, i) => `<tr>${cols.map((c) => {
        const v = r[c];
        // 공고번호 자체를 원문으로 연결한다 — 표 어디에 있어도 한 번에 넘어간다.
        if (c === '공고번호') {
          return `<td class="br-nocell" data-col="공고번호">${noLink(v, r.원문URL || r.__url || '')}`
            + `${verdictBadge((opts.meta || [])[i])}</td>`;
        }
        if (c === '원문URL') {
          return v
            ? '<td data-col="원문URL"><a href="' + esc(v) + '" rel="nofollow noopener" target="_blank">공고 원문</a></td>'
            : '<td class="br-dim" data-col="원문URL">미제공</td>';
        }
        const text = v ?? '-';
        if (c === '입찰마감') {
          const d = dday(r.__clse ?? v);
          return `<td data-col="입찰마감" title="${esc(text)}"><span class="br-cx">${esc(text)}`
            + (d ? `<span class="br-dd ${d.cls}">${esc(d.text)}</span>` : '') + '</span></td>';
        }
        return `<td data-col="${esc(c)}" title="${esc(text)}"><span class="br-cx">${esc(text)}</span></td>`;
      }).join('')}</tr>`).join('');
      return `<table class="br-t"><thead><tr>${th}</tr></thead><tbody>${tr}</tbody></table>`;
    }

    const NOTES = {
      compare: '엑셀 「공고 비교표」 시트와 같은 열·같은 순서입니다. 밑줄 친 열 이름을 누르면 그 열로 정렬됩니다.',
      check: '공고마다 준비할 것을 항목·내용·메모로 폅니다. ★ 표시는 놓치면 참여 자체가 막히는 항목입니다.',
      joint: '공고의 공동수급방식으로 분류했습니다. 구성원별 실적 인정 비율은 공고서 본문에서 확인해야 합니다.',
      price: '참고용 통계입니다. 예정가격은 추첨으로 정해지므로 낙찰을 예측하거나 보장하지 않습니다. 투찰률 x% 열은 하한 통과 조합이 x% 이상이 되는 가장 낮은 투찰률입니다.',
    };

    /** 조건에 걸려 0건일 때. 「없습니다」로 끝내지 않고 무엇을 풀면 되는지 적는다. */
    function emptyBox() {
      const c = cond();
      const why = [];
      if (c.q) why.push('검색어 지우기');
      if (c.verdict !== 'all') why.push('판정을 「전체」로');
      if (c.div) why.push('업무를 「전체」로');
      if (c.period) why.push('기간을 「전체」로');
      if (c.amt) why.push('추정가를 「전체」로');
      if (c.org) why.push('발주처를 「전체」로');
      if (c.joint) why.push('「공동도급 가능만」 해제');
      if (!$('f-lic').value.trim()) why.push('보유 면허 선택');
      if ($('f-dist').value) why.push('시·군·구를 「광역 전체」로 되돌리기');
      const tip = why.length
        ? `이렇게 해 보십시오 — ${why.join(' · ')}.`
        : '수집된 공고 자체가 없습니다. 다음 아침 수집을 기다려 주십시오.';
      return `<p class="br-empty"><strong>조건에 맞는 공고가 없습니다.</strong><br />${esc(tip)}`
        + '<br /><button type="button" class="br-clearall" id="br-clearall2">조건 초기화</button></p>';
    }

    function renderSheet(list) {
      const notices = list.map((r) => r.notice);
      $('br-tabnote').textContent = NOTES[tab];
      if (!notices.length) { $('br-sheet').innerHTML = emptyBox(); return; }
      // 공동도급·투찰가 표에는 원문URL 열이 없다. 공고번호를 링크로 걸려면 주소가
      // 필요하므로 `__url` 로 얹어 준다(열로는 나오지 않는다).
      const withUrl = (rows) => rows.map((r, i) => ({ ...r, __url: noticeUrl(notices[i]) }));
      const meta = list.map((r) => r.match);

      if (tab === 'compare') {
        $('br-sheet').innerHTML = table(COMPARE_COLS, notices.map(summarize), { meta });
      } else if (tab === 'joint') {
        $('br-sheet').innerHTML = table(
          ['공고번호', '공고명', '구분', '가능여부', '공고표기', '지역제한', '메모'],
          withUrl(jointSupplyRows(notices)), { meta },
        );
      } else if (tab === 'price') {
        $('br-sheet').innerHTML = table(
          BID_PRICE_COLS, withUrl(notices.map((n) => bidPriceRow(n, n.basis))), { meta },
        );
      } else {
        // 체크리스트는 공고별 블록이다(엑셀도 블록으로 쌓는다)
        $('br-sheet').innerHTML = list.map(({ notice, match }) => {
          const s = summarize(notice);
          const items = checklist(notice, notice.licenseLimits, notice.possibleRegions);
          const rows = items.map(([item, val, memo]) => `<tr><td class="br-cbox">☐</td><th>${esc(item)}</th>`
            + `<td title="${esc(val)}"><span class="br-cx">${esc(val)}</span></td>`
            + `<td class="br-memo" title="${esc(memo)}"><span class="br-cx">${esc(memo)}</span></td></tr>`).join('');
          return `<div class="br-block"><div class="br-bt">▣ ${esc(s.공고명)}<span class="br-bno">${noLink(s.공고번호, s.원문URL)}</span>${verdictBadge(match)}</div>
            <table class="br-t br-ct"><tbody>${rows}</tbody></table></div>`;
        }).join('');
      }
    }

    function render() {
      const rows = judged();
      const list = shown(rows);
      renderTally(rows, list);
      renderActive();
      renderSheet(list);
    }

    // ── 면허 드롭다운 ────────────────────────────────────────────────
    // 고른 것을 숨은 #f-lic 에 쉼표로 이어 붙인다. 판정 쪽은 예전 그대로
    // 그 칸 하나만 읽으므로 엔진에는 손대지 않았다.
    const msPop = $('br-ms-pop');
    const msBtn = $('br-ms-btn');
    const msBoxes = () => [...msPop.querySelectorAll('input[type="checkbox"]')];

    function msSelected() {
      return msBoxes().filter((b) => b.checked).map((b) => b.value);
    }

    function msSync() {
      const picked = msSelected();
      $('f-lic').value = picked.join(', ');
      $('br-ms-label').textContent =
        picked.length === 0 ? '면허를 고르십시오'
        : picked.length === 1 ? picked[0]
        : `${picked[0]} 외 ${picked.length - 1}건`;
      $('br-ms-chips').innerHTML = picked
        .map((n) => `<button type="button" class="br-chip" data-off="${n}">${n}<span aria-hidden="true">×</span></button>`)
        .join('');
      render();
    }

    msPop.addEventListener('change', msSync);
    $('br-ms-chips').addEventListener('click', (ev) => {
      const b = ev.target.closest('[data-off]');
      if (!b) return;
      const box = msBoxes().find((x) => x.value === b.dataset.off);
      if (box) { box.checked = false; msSync(); }
    });
    $('br-ms-clear').addEventListener('click', () => {
      msBoxes().forEach((b) => { b.checked = false; });
      msSync();
    });
    $('br-ms-q').addEventListener('input', (ev) => {
      const q = ev.target.value.trim();
      msPop.querySelectorAll('.br-ms-o').forEach((o) => {
        o.hidden = q ? !o.dataset.name.includes(q) : false;
      });
      msPop.querySelectorAll('.br-ms-g').forEach((g) => {
        g.hidden = ![...g.querySelectorAll('.br-ms-o')].some((o) => !o.hidden);
      });
    });

    function msOpen(on) {
      msPop.hidden = !on;
      msBtn.setAttribute('aria-expanded', String(on));
      if (on) $('br-ms-q').focus();
    }
    msBtn.addEventListener('click', () => msOpen(msPop.hidden));
    document.addEventListener('click', (ev) => {
      if (!$('br-ms').contains(ev.target)) msOpen(false);
    });
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && !msPop.hidden) { msOpen(false); msBtn.focus(); }
    });

    msSync();

    // ── 소재지 2단 선택 ──────────────────────────────────────────────
    // 소유주 지적: 「업체 소재지 선택이 입력이라 어려움이 있음」. 자유 입력이던 칸을
    // 광역(17) → 시·군·구(228) 두 칸으로 갈랐다. 고른 값을 숨은 #f-region 에
    // 「경상남도 창원시」 꼴로 이어 붙이므로 판정 로직은 그대로다.
    const RG = JSON.parse($('br-regions').textContent);
    const provSel = $('f-prov');
    const distSel = $('f-dist');

    function fillProvinces() {
      provSel.innerHTML = RG.provinces
        .map((p) => `<option value="${esc(p.name)}"${p.name === RG.defaultProv ? ' selected' : ''}>${esc(p.name)}</option>`)
        .join('');
    }

    function fillDistricts(keep) {
      const p = RG.provinces.find((x) => x.name === provSel.value);
      const ds = p ? p.districts : [];
      // 첫 칸은 「광역 전체」다 — 지역제한이 광역 단위로만 걸린 공고를 넓게 받는다.
      // 기초자치단체가 없는 광역(세종)은 이 칸이 잠긴다(빈 목록을 지어내지 않는다).
      distSel.innerHTML = ds.length
        ? `<option value="">광역 전체</option>${ds.map((d) => `<option>${esc(d)}</option>`).join('')}`
        : '<option value="">기초자치단체 없음</option>';
      distSel.disabled = !ds.length;
      if (keep && ds.includes(keep)) distSel.value = keep;
    }

    function syncRegion() {
      $('f-region').value = [provSel.value, distSel.value].filter(Boolean).join(' ');
      render();
    }

    provSel.addEventListener('change', () => { fillDistricts(null); syncRegion(); });
    distSel.addEventListener('change', syncRegion);
    fillProvinces();
    fillDistricts(RG.defaultDist);

    // ── 공고 조건 ────────────────────────────────────────────────────
    fillChoices();

    // 검색은 글자마다 다시 그리면 60건에서도 손이 무겁다. 300ms 쉬고 그린다
    // (입찰레이더 공고관리 화면과 같은 값이다).
    let qTimer = null;
    $('f-q').addEventListener('input', () => {
      clearTimeout(qTimer);
      qTimer = setTimeout(render, 300);
    });
    $('f-q').addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter') { ev.preventDefault(); clearTimeout(qTimer); render(); }
    });

    ['f-div', 'f-amt', 'f-org'].forEach((id) => $(id).addEventListener('change', render));
    $('f-joint').addEventListener('change', render);

    // ── 기간 ─────────────────────────────────────────────────────────
    // 프리셋의 말이 기준에 따라 달라진다. 마감일은 「이레 안」(앞으로),
    // 공고일은 「최근 이레」(뒤로)다. 같은 말로 두면 반대 뜻이 된다.
    const ymd = (ms) => {
      const d = new Date(ms);
      const p2 = (n) => String(n).padStart(2, '0');
      return `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;
    };

    /** 수집분에 실제로 있는 날짜 범위. 달력의 양끝을 그 밖으로 못 가게 잡아 준다. */
    function dataRange(base) {
      const ts = DATA.notices.map((n) => (base === 'ntce' ? openMs(n) : clseMs(n)))
        .filter((t) => Number.isFinite(t));
      if (!ts.length) return null;
      return [Math.min(...ts), Math.max(...ts)];
    }

    function syncPeriod() {
      const base = $('f-base').value;
      const custom = $('f-period').value === 'custom';
      $('br-dates').hidden = !custom;
      // 프리셋 문구를 기준에 맞춘다
      [...$('f-period').options].forEach((o) => {
        if (!PERIOD_LABEL[o.value]) return;
        // 「최근 오늘」은 말이 안 된다. 하루짜리는 그냥 「오늘」이다.
        o.textContent = base === 'ntce'
          ? (o.value === '1' ? '오늘' : `최근 ${PERIOD_LABEL[o.value]}`)
          : `${PERIOD_LABEL[o.value]} 안`;
      });
      const rg = dataRange(base);
      if (rg) {
        const lo = ymd(rg[0]);
        const hi = ymd(rg[1]);
        ['f-from', 'f-to'].forEach((id) => { $(id).min = lo; $(id).max = hi; });
        // 직접 지정으로 처음 넘어오면 수집분의 양끝을 채워 둔다(빈 칸에서 시작하지 않는다).
        if (custom && !$('f-from').value && !$('f-to').value) {
          $('f-from').value = lo;
          $('f-to').value = hi;
        }
      }
    }

    $('f-base').addEventListener('change', () => { syncPeriod(); render(); });
    $('f-period').addEventListener('change', () => { syncPeriod(); render(); });
    ['f-from', 'f-to'].forEach((id) => $(id).addEventListener('change', render));
    syncPeriod();

    document.querySelector('.br-seg').addEventListener('click', (ev) => {
      const b = ev.target.closest('.br-sg');
      if (!b) return;
      setVerdict(b.dataset.v);
      render();
    });

    $('f-reset').addEventListener('click', () => { clearAll(); render(); });

    // 조건 칩(하나 끄기 · 전체 해제)과 빈 화면의 초기화 단추
    document.addEventListener('click', (ev) => {
      const one = ev.target.closest('[data-clear]');
      if (one) { clearCond(one.dataset.clear); render(); return; }
      if (ev.target.closest('#br-clearall') || ev.target.closest('#br-clearall2')) { clearAll(); render(); }
    });

    // 열 머리 정렬 — 없음 → 오름 → 내림 → 없음
    $('br-sheet').addEventListener('click', (ev) => {
      const b = ev.target.closest('[data-sort]');
      if (!b) return;
      const k = b.dataset.sort;
      if (sort.key !== k) sort = { key: k, dir: 'asc' };
      else if (sort.dir === 'asc') sort = { key: k, dir: 'desc' };
      else sort = { key: '', dir: '' };
      render();
    });
    // ── 엑셀로 받기 ──────────────────────────────────────────────────
    // 화면에 보이는 그대로를 시트 넷으로 담는다. 시트 이름·열 순서는 입찰레이더
    // `briefing_excel.py` 와 같다. 공고번호 칸에 원문 하이퍼링크를 건다.
    const CHECK_COLS = ['공고번호', '공고명', '항목', '내용', '메모'];

    function workbookSheets(list) {
      const notices = list.map((r) => r.notice);
      const urls = notices.map(noticeUrl);

      // ① 공고 비교표
      const cmp = notices.map(summarize);
      const cmpRows = [COMPARE_COLS, ...cmp.map((r) => COMPARE_COLS.map((c) => (
        c === '원문URL' ? (r.원문URL ? '공고 원문' : '미제공') : (r[c] ?? '')
      )))];
      const cmpLinks = [];
      cmp.forEach((r, i) => {
        if (!r.원문URL) return;
        cmpLinks.push({ row: i + 1, col: COMPARE_COLS.indexOf('공고번호'), url: r.원문URL });
        cmpLinks.push({ row: i + 1, col: COMPARE_COLS.indexOf('원문URL'), url: r.원문URL });
      });

      // ② 참여 체크리스트 — 공고마다 여러 줄이라 공고번호를 각 줄에 편다
      const chkRows = [CHECK_COLS];
      const chkLinks = [];
      notices.forEach((n, i) => {
        const sm = summarize(n);
        checklist(n, n.licenseLimits, n.possibleRegions).forEach(([item, val, memo]) => {
          if (urls[i]) chkLinks.push({ row: chkRows.length, col: 0, url: urls[i] });
          chkRows.push([sm.공고번호, sm.공고명, item, val, memo]);
        });
      });

      // ③ 공동도급 분류
      const jCols = ['공고번호', '공고명', '구분', '가능여부', '공고표기', '지역제한', '메모'];
      const jSrc = jointSupplyRows(notices);
      const jRows = [jCols, ...jSrc.map((r) => jCols.map((c) => r[c] ?? ''))];
      const jLinks = jSrc.map((_, i) => (urls[i] ? { row: i + 1, col: 0, url: urls[i] } : null)).filter(Boolean);

      // ④ 투찰가 참고 — 금액은 숫자로 넣어야 엑셀에서 계산이 된다
      const pSrc = notices.map((n) => bidPriceRow(n, n.basis));
      const pRows = [BID_PRICE_COLS, ...pSrc.map((r) => BID_PRICE_COLS.map((c) => r[c] ?? ''))];
      const pLinks = pSrc.map((_, i) => (urls[i] ? { row: i + 1, col: 0, url: urls[i] } : null)).filter(Boolean);

      return [
        { name: '공고 비교표', rows: cmpRows, links: cmpLinks },
        { name: '참여 체크리스트', rows: chkRows, links: chkLinks },
        { name: '공동도급 분류', rows: jRows, links: jLinks },
        { name: '투찰가 참고', rows: pRows, links: pLinks },
      ];
    }

    $('br-dl').addEventListener('click', () => {
      const list = shown(judged());
      if (!list.length) {
        $('br-dlnote').textContent = '내려받을 공고가 없습니다. 조건을 넓혀 보십시오.';
        return;
      }
      const btn = $('br-dl');
      btn.disabled = true;
      try {
        const blob = buildWorkbook(workbookSheets(list));
        const d = new Date();
        const stamp = `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`;
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `입찰레이더_기초자료_${stamp}.xlsx`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        // 즉시 해제하면 사파리에서 저장이 끊긴다.
        setTimeout(() => URL.revokeObjectURL(url), 4000);
        $('br-dlnote').textContent = `공고 ${list.length}건을 네 시트로 내려받았습니다. 공고번호를 누르면 나라장터 원문이 열립니다.`;
      } catch (err) {
        $('br-dlnote').textContent = '엑셀을 만들지 못했습니다. 새로 고침 뒤 다시 시도해 주십시오.';
        console.error('[bid-radar] 엑셀 생성 실패', err);
      } finally {
        btn.disabled = false;
      }
    });

    function selectTab(b) {
      if (!b) return;
      tab = b.dataset.tab;
      [...$('br-tabs').children].forEach((c) => {
        const on = c === b;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-selected', String(on));   // 색만으로 알리지 않는다
      });
      renderSheet(shown(judged()));
    }

    $('br-tabs').addEventListener('click', (ev) => selectTab(ev.target.closest('.br-tab')));

    // 탭은 화살표로 옮겨 다니는 것이 표준이다(WAI-ARIA tablist).
    $('br-tabs').addEventListener('keydown', (ev) => {
      const tabs = [...$('br-tabs').children];
      const i = tabs.indexOf(document.activeElement);
      if (i < 0) return;
      const to = ev.key === 'ArrowRight' ? i + 1
        : ev.key === 'ArrowLeft' ? i - 1
        : ev.key === 'Home' ? 0
        : ev.key === 'End' ? tabs.length - 1
        : -1;
      if (to === -1) return;
      ev.preventDefault();
      const next = tabs[(to + tabs.length) % tabs.length];
      next.focus();
      selectTab(next);
    });
    render();
  </script>

  {/* ★ 스코프 CSS 함정: 이 화면의 표·카드·집계는 전부 **런타임에 innerHTML 로 꽂는다.**
      Astro 스코프는 템플릿에 있던 요소에만 속성을 붙이므로 그 규칙이 하나도 안 닿는다
      (빌드도 통과하고 글자도 보여서 눈으로만 잡힌다). 선택자를 전부 `.br-` 로 묶어 두고
      스타일 블록을 전역으로 연다. 낱낱이 `:global()` 로 감싸는 것보다 새는 곳이 없다. */}
  <style is:global>
    .br { max-width: var(--measure-wide); padding-top: 26px; padding-bottom: 60px; }
    /* 머리글 2단 — 글 왼쪽, 그림 오른쪽. 좁아지면 그림이 위로 올라가 한 단이 된다.
       ★ 그리드 칸에 min-width: 0 이 없으면 문서 전체에 가로 스크롤이 생긴다(390px 실측). */
    .br-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
               gap: 12px 28px; align-items: center; }
    .br-head-text { min-width: 0; }
    .br-head-art { min-width: 0; }
    /* ★ 이 블록은 이미 is:global 이다. 여기에 :global() 을 또 쓰면 그 문자열이
       CSS 에 그대로 나가 규칙 전체가 죽는다(실제로 border-radius 가 0 이었다).
       스코프 안에서만 :global() 을 쓸 것. 확인은 getComputedStyle 로. */
    .br-head-art img {
      display: block; width: 100%; height: auto; border-radius: 12px;
      border: 1px solid var(--line);
    }
    @media (max-width: 760px) {
      .br-head { grid-template-columns: minmax(0, 1fr); }
      .br-head-art { order: -1; max-width: 420px; }
    }

    .br-title { margin: 6px 0 0; font-size: clamp(26px, 4.4vw, 36px); letter-spacing: -.022em; }
    .br-sub { margin: 10px 0 0; font-size: 15px; color: var(--sub); line-height: 1.8; word-break: keep-all; max-width: 64ch; }
    .br-note { margin: 8px 0 0; font-size: 12.5px; color: var(--muted); word-break: keep-all; max-width: 70ch; }

    .br-form { margin-top: 20px; }
    .br-grid { display: grid; grid-template-columns: 1fr 1.6fr auto; gap: 14px 18px; align-items: start; }
    .br-f { display: grid; gap: 5px; }
    .br-l { font-size: 12.5px; color: var(--sub); font-weight: 600; }
    .br-l em { font-style: normal; font-weight: 400; color: var(--muted); font-size: 11.5px; margin-left: 5px; }
    .br-f input[type="text"] {
      font-size: 14px; padding: 8px 10px; width: 100%;
      border: 1px solid var(--hair); border-radius: 3px; background: var(--surface); color: var(--ink);
    }
    .br-f input[type="text"]:focus { outline: none; border-color: var(--accent); }
    /* 소재지 2단 선택 — 좁아지면 두 칸이 위아래로 쌓인다.
       ★ 네이티브 <select> 를 쓰는 이유는 모양이 아니라 조작이다. 휴대전화에서는
       기기 자체의 선택판이 뜨고, 키보드·스크린리더도 손댈 것이 없다. */
    .br-two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px; }
    .br-two select {
      font: inherit; font-size: 14px; padding: 8px 10px; width: 100%; min-width: 0;
      border: 1px solid var(--hair); border-radius: 3px; background: var(--surface); color: var(--ink);
    }
    .br-two select:focus { outline: none; border-color: var(--accent); }
    .br-two select:disabled { color: var(--muted); background: var(--bg); }
    @media (max-width: 520px) { .br-two { grid-template-columns: minmax(0, 1fr); } }
    /* 면허 다중 선택 드롭다운 — 기존 입력칸과 같은 테두리·여백을 쓴다. */
    .br-ms { position: relative; }
    .br-ms-btn {
      display: flex; align-items: center; justify-content: space-between; gap: 8px;
      width: 100%; font: inherit; font-size: 14px; padding: 8px 10px; text-align: left;
      border: 1px solid var(--hair); border-radius: 3px; background: var(--surface);
      color: var(--ink); cursor: pointer;
    }
    .br-ms-btn:focus-visible { outline: none; border-color: var(--accent); }
    .br-ms-caret { color: var(--muted); font-size: 11px; }
    .br-ms-pop {
      position: absolute; z-index: 30; top: calc(100% + 4px); left: 0; right: 0;
      background: var(--surface); border: 1px solid var(--hair); border-radius: 4px;
      box-shadow: 0 10px 26px rgba(0, 0, 0, .18);
    }
    .br-ms-tools { display: flex; gap: 8px; padding: 8px; border-bottom: 1px solid var(--hair); }
    .br-ms-tools input[type="search"] {
      flex: 1; min-width: 0; font: inherit; font-size: 13px; padding: 6px 8px;
      border: 1px solid var(--hair); border-radius: 3px; background: var(--bg); color: var(--ink);
    }
    .br-ms-tools input[type="search"]:focus { outline: none; border-color: var(--accent); }
    .br-ms-clear {
      font: inherit; font-size: 12.5px; color: var(--sub); background: none;
      border: 1px solid var(--hair); border-radius: 3px; padding: 6px 9px; cursor: pointer; white-space: nowrap;
    }
    .br-ms-list { max-height: 260px; overflow-y: auto; padding: 6px; }
    .br-ms-gl {
      font-size: 11.5px; font-weight: 700; color: var(--muted); letter-spacing: .02em;
      padding: 8px 6px 4px;
    }
    .br-ms-o {
      display: flex; align-items: center; gap: 7px; padding: 5px 6px; border-radius: 3px;
      font-size: 13.5px; color: var(--ink); cursor: pointer; word-break: keep-all;
    }
    .br-ms-o:hover { background: var(--bg); }
    .br-ms-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 7px; }
    .br-chip {
      display: inline-flex; align-items: center; gap: 5px; font: inherit; font-size: 12px;
      padding: 3px 8px; border: 1px solid var(--hair); border-radius: 999px;
      background: var(--bg); color: var(--sub); cursor: pointer;
    }
    .br-chip:hover { border-color: var(--accent); color: var(--accent); }
    .br-chip span { color: var(--muted); }

    .br-opts { align-content: end; }
    .br-chk { font-size: 13px; color: var(--sub); display: inline-flex; align-items: center; gap: 5px; margin-right: 12px; white-space: nowrap; }

    .br-tally {
      display: grid; grid-template-columns: repeat(4, auto) 1fr; gap: 0 26px; align-items: end;
