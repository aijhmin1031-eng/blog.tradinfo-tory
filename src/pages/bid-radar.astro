    /* 엑셀 시트처럼 내용 폭으로 벌리고 좁으면 가로로 민다. width:100% 로 묶으면
       열 열아홉 개가 한 화면에 눌려 공고명이 네 줄로 접힌다. */
    .br-t { border-collapse: collapse; width: max-content; min-width: 100%; }
    /* 줄바꿈되는 칸이 있으면 행이 그 높이만큼 커진다. 위로 붙여야 빈 줄처럼 보이지 않는다. */
    .br-t th, .br-t td { padding: 7px 9px; font-size: 12px; border-bottom: 1px solid var(--hair2); text-align: left; white-space: nowrap; vertical-align: top; }
    .br-t thead th { background: var(--brand); color: #fff; font-weight: 700; font-size: 11.5px; white-space: nowrap; }
