    .br-th-s.is-on .br-sortmark { opacity: 1; }
    .br-th-s.is-on { background: var(--accent); }
    .br-block { padding: 12px 12px 4px; }
    .br-bt { font-size: 13px; font-weight: 700; color: var(--brand); margin-bottom: 6px; }
    .br-bno { font-weight: 400; color: var(--muted); font-size: 11.5px; margin-left: 8px; }
    .br-ct { min-width: 560px; }
    .br-cbox { width: 26px; color: var(--muted); }
    .br-memo { white-space: normal; color: var(--muted); min-width: 200px; word-break: keep-all; }

    .br-explain { margin-top: 34px; max-width: var(--measure); }
    .br-h2 { font-size: 19px; margin: 24px 0 8px; letter-spacing: -.022em; }
    .br-explain p { margin: 0 0 10px; font-size: 14.5px; line-height: 1.85; color: var(--sub); word-break: keep-all; }
