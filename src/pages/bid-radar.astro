    }
    .br-fl select:focus { outline: none; border-color: var(--accent); }
    /* ★ 기간 묶음은 칸이 넷이라 390px 에서 문서를 밀어낸다(실측 65px).
       줄바꿈을 허용하고 달력 칸이 남은 너비를 나눠 갖게 한다. */
    .br-period { gap: 6px; flex-wrap: wrap; white-space: normal; }
    .br-dates { display: inline-flex; align-items: center; gap: 5px; flex: 1 1 auto; min-width: 0; }
