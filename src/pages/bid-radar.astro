    /* 정렬 가능한 열 머리. 누르면 없음 → 오름 → 내림 → 없음. */
    .br-t thead th.br-th-s { padding: 0; }
    .br-sortbtn {
      font: inherit; font-size: 11.5px; font-weight: 700; color: #fff; background: transparent;
      border: 0; padding: 7px 9px; cursor: pointer; white-space: nowrap; width: 100%; text-align: left;
      text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255, 255, 255, .45);
    }
