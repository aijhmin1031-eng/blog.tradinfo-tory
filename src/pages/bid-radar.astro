    /* ★ 칸을 넘는 글자가 옆 칸을 침범하지 않게 한다(소유주 지시, 2026-09-04).
       한 칸은 반드시 한 줄이고, 넘치면 말줄임표로 끊는다. 끊긴 글자는 칸에 건
       title 로 그대로 볼 수 있다. td 에 직접 걸면 표 레이아웃이 auto 라
       max-width 가 먹지 않으므로 **안쪽 블록**에 건다. */
    .br-t .br-cx {
      display: block; max-width: 150px; overflow: hidden;
      text-overflow: ellipsis; white-space: nowrap;
    }
    .br-t td[data-col="공고명"] .br-cx { max-width: 300px; }
    .br-t td[data-col="수요기관"] .br-cx,
    .br-t td[data-col="메모"] .br-cx,
    .br-t td[data-col="산출근거"] .br-cx { max-width: 230px; }
    .br-t td[data-col="입찰마감"] .br-cx,
    .br-t td[data-col="개찰일시"] .br-cx,
    .br-t td[data-col="자격등록마감"] .br-cx,
    .br-t td[data-col="공고게시"] .br-cx { max-width: 190px; }
    .br-ct .br-cx { max-width: 260px; }
