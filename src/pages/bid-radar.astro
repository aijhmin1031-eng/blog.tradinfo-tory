    @media (max-width: 900px) {
      .br-grid { grid-template-columns: 1fr; }
      .br-tally { grid-template-columns: repeat(4, 1fr); gap: 8px 12px; }
      .br-tsum { grid-column: 1 / -1; text-align: left; }
      .br-tn { font-size: 22px; }
    }
