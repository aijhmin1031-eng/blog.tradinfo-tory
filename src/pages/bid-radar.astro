    /* 판정 배지. ★ 색·이모지만으로 가르지 않고 글자를 함께 적는다 —
       흑백 인쇄와 색각 이상에서 셋이 한 덩어리로 보이기 때문이다. */
    .br-vb {
      display: inline-block; margin-left: 7px; font-size: 10.5px; font-weight: 700;
      padding: 1px 6px; border-radius: 2px; white-space: nowrap;
      border: 1px solid var(--hair); color: var(--sub); background: var(--surface);
    }
    .br-vb.br-v-eligible { color: #fff; background: var(--brand); border-color: var(--brand); }
    .br-vb.br-v-unknown { color: var(--accent); border-color: var(--accent); }
    .br-vb.br-v-ineligible { color: var(--muted); }

    /* ★ 포커스가 어디 있는지 보이게 한다. 이 화면은 누를 것이 수십 개다. */
    .br :is(button, select, input, a):focus-visible,
    .br-ms-o:focus-within {
      outline: 2px solid var(--accent); outline-offset: 1px; border-radius: 2px;
    }

    /* 마감 칸에 덧붙인 D-day. 표의 값은 정본 그대로 두고 배지만 얹는다. */
    .br-dd {
      display: inline-block; margin-left: 6px; font-size: 10.5px; font-weight: 700;
