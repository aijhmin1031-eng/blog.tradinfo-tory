---
/**
 * 입찰레이더 데스크톱판을 **그대로** 옮긴 화면 (2026-09-04 소유주 지시
 * 「모든 기능과 모든 UI 100% 동일하게… 정품인증과 텔레그램만 빼고」).
 *
 * 왜 이 방법이 되는가: 데스크톱판(`ai-bid-radar/src/gui_web/index.html`, 3,809줄)은
 * **이미 웹 화면**이다. 파이썬과는 `api()` 한 함수로만 이야기한다 —
 *   `function api(){ return (window.pywebview && window.pywebview.api) || null; }`
 * 그래서 화면(CSS 1,065줄 · JS 2,609줄 · 마크업 121줄)은 **한 글자도 고치지 않고** 싣고,
 * 그 함수 뒤에 있던 파이썬만 `lib/bid-radar/web-bridge.js` 로 갈아 끼웠다.
 *
 * ★ 블로그 조판(Base.astro·global.css)을 쓰지 않는다. 앱 CSS 가 `:root` 와 `body`,
 *   `body.view-status` 에 규칙을 걸어 문서 전체를 전제로 짜여 있다. 블로그 토큰과
 *   같은 이름(--bg·--surface·--primary…)을 쓰므로 한 문서에 섞으면 **사이트 전체 색이
 *   바뀐다.** 앱은 앱대로 한 문서를 쓰는 것이 원본과 같고 안전하다.
 */
import { url, canonicalUrl } from '../../lib/site';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../../lib/supabase';
import notices from '../../data/bid-notices.json';
// ★ `?raw` 로 읽는다. `readFileSync(new URL(..., import.meta.url))` 은 빌드 산출물 기준으로
//    풀려 `dist/lib/...` 를 찾다가 없다고 죽는다(실제로 한 번 죽었다).
import markup from '../../lib/bid-radar/app-markup.html?raw';
const appCss = url('/bid-radar/app.css');
const appJs = url('/bid-radar/app.js');
// 방문 계측은 정본(Vercel)에서만 돈다 — 미러에서 세면 같은 방문이 두 번 잡힌다.
const onVercel = !!process.env.VERCEL;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI 입찰레이더 · 도토리경제</title>
    <meta name="description" content="나라장터 입찰공고를 업체의 지역·보유 면허로 선별합니다. 참여가능·확인필요·자격미달 판정, 공동도급 분류, 투찰가 참고표를 한 화면에 제공합니다." />
    <link rel="canonical" href={canonicalUrl('/bid-radar/app/')} />
    <link rel="stylesheet" href={appCss} />
    {/* ★ `is:global` 이어야 한다. Astro 의 `<style>` 은 기본이 스코프라 선택자에
        `[data-astro-cid-…]` 가 붙는데, 표는 `app.js` 가 **런타임에 innerHTML 로** 꽂으므로
        그 표시가 없다. 스코프인 채로 두면 규칙이 조용히 아무 데도 안 닿는다
        (실제로 `min-width` 가 760px 그대로였다 — CLAUDE.md CSS 함정 ⑥).
        ★ 그리고 `is:global` 안에서는 `:global()` 을 쓰지 않는다(함정 ⑦). */}
    <style is:global>
      /* 원본은 창 전체를 쓴다. 블로그로 돌아갈 길만 한 줄 얹는다. */
      .brback { position: fixed; right: 12px; bottom: 12px; z-index: 80;
        font: 500 12px/1 system-ui, sans-serif; color: #4A5568; background: #fff;
        border: 1px solid #D8DEE8; border-radius: 999px; padding: 8px 14px;
        text-decoration: none; box-shadow: 0 2px 8px rgba(16,24,40,.08); }
      .brback:hover { color: #0B50D0; border-color: #256EF4; }

      /* ★ 공고명 칸이 눌리는 것 보정 (2026-09-04 소유주 지적).
         원인은 산수다 — 고정폭 열의 합이 **718px**(업무 92 + 발주처 132 + 추정가 96 +
         마감 162 + 판정 96 + 관리 140)인데 표의 `min-width` 가 **760px** 이라
         공고명 몫이 **42px** 밖에 남지 않는다(1600px 실측값이 정확히 760 − 718 이었다).
         `table-layout: fixed` 라 폭을 안 준 **공고명 칸이 남는 몫을 받는 구조**여서,
         표가 좁아질수록 공고명만 눌린다. 고정폭 합에 읽을 만한 공고명 폭을 더해 올린다.
         넘치는 만큼은 표가 가로로 스크롤된다 — 읽을 수 없는 칸보다 스크롤이 낫다.
         ★ `app.css` 는 건드리지 않는다(원본과 바이트가 같아야 한다). 이 페이지에서 덮는다. */
      .tbl--notices { min-width: 980px; }
      @media (max-width: 1180px) { .tbl--notices { min-width: 900px; } }
    </style>
  </head>
  <body>
    <Fragment set:html={markup} />
    <a class="brback" href={url('/')}>← 도토리경제</a>

    <script type="application/json" id="br-app-data" set:html={JSON.stringify(notices)} />
    <script>
      // 파이썬 브리지 대역을 먼저 꽂는다. 화면 코드는 80ms 간격으로 폴링하므로
      // 순서가 어긋나도 붙지만, 첫 화면이 한 박자 늦게 뜨는 것을 막는다.
      import { install } from '../../lib/bid-radar/web-bridge.js';
      install(JSON.parse(document.getElementById('br-app-data').textContent));
    </script>
    <script is:inline src={appJs}></script>

    {/* 방문 계측. 이 페이지는 블로그 조판(Base.astro)을 쓰지 않아 계측이 빠져 있었다
        (2026-09-04 소유주 지적). Base 와 **같은 코드**를 싣는다 — 방문자 구분값 형식,
        봇 UA 1차 거르기, 체류 신호(5초·상호작용)까지 같아야 사람·보류·봇 3분할이
        이 페이지에도 그대로 적용된다. */}
    {onVercel && (
    <script define:vars={{ sbUrl: SUPABASE_URL, sbKey: SUPABASE_ANON_KEY }}>
      (function () {
        try {
          if (navigator.webdriver) return;
          var h = location.hostname;
          if (h === 'localhost' || h === '127.0.0.1') return;

          // 봇 1차 거르기(2026-08-26 신설). 여기서 거르는 것은 쓸데없는 요청을 아끼기
          // 위한 것일 뿐이고, 최종 판정은 서버 함수 log_visit 가 User-Agent 로 한다.
          // 검색엔진 렌더러는 우리 JS 를 실제로 실행하므로 이 층이 없으면 '방문자'로 잡힌다.
          var ua = (navigator.userAgent || '').toLowerCase();
          if (!ua) return;
          if (/[a-z]bot|bot\/|crawler|crawling|spider|slurp|yeti|scrapy|headless|phantom|lighthouse|inspectiontool|bingpreview|fetcher|archiver|facebookexternalhit|embedly|daumoa/.test(ua)) return;

          // 방문자 구분값은 '그날 하루'만 산다. 날짜가 바뀌면 새로 만들어진다.
          var day = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Seoul' });
          var key = 'dv:' + day;

          // 저장소를 실제로 쓸 수 있는지 먼저 확인한다(2026-08-26 보강).
          // 시크릿 모드·저장소 차단 브라우저에서는 localStorage 가 던진다. 그때 값을
          // 매번 새로 만들면 한 사람이 페이지마다 다른 방문자로 세어져 숫자가 부풀었다.
          // sessionStorage 로라도 물러서면 최소한 그 방문 내내 한 사람으로 유지된다.
          var store = null;
          try { localStorage.setItem('dv:t', '1'); localStorage.removeItem('dv:t'); store = localStorage; } catch (e) {}
          if (!store) {
            try { sessionStorage.setItem('dv:t', '1'); sessionStorage.removeItem('dv:t'); store = sessionStorage; } catch (e) {}
          }

          var id = null;
          try { id = store && store.getItem(key); } catch (e) {}
          if (!id) {
            var b = new Uint8Array(8);
            crypto.getRandomValues(b);
            id = Array.from(b, function (x) { return x.toString(16).padStart(2, '0'); }).join('');
            try {
              if (store) {
                store.setItem(key, id);
                // 지난 날짜 값은 지운다 — 오래 남겨 둘 이유가 없다.
                Object.keys(store).forEach(function (k2) {
                  if (k2.indexOf('dv:') === 0 && k2 !== key) store.removeItem(k2);
                });
              }
            } catch (e) {}
          }

          function send() {
            fetch(sbUrl + '/rest/v1/rpc/log_visit', {
              method: 'POST',
              headers: { apikey: sbKey, Authorization: 'Bearer ' + sbKey, 'Content-Type': 'application/json' },
              body: JSON.stringify({ p_path: location.pathname, p_visitor: id, p_ref: document.referrer || '' }),
              keepalive: true,
            }).catch(function () {});
          }

          // 사람이 실제로 화면을 본 순간에만 센다(2026-08-26 신설).
          // 미리 렌더(prerender)와 링크 미리보기는 화면에 뜨지 않은 채 스크립트만 돈다.
          // 다만 '지금 숨어 있다'고 버리지는 않는다 — 새 탭으로 연 사람도 숨은 상태로
          // 시작하므로, 보이는 순간을 기다렸다가 보낸다.
          // ★ 체류 신호 (2026-09-04 신설). User-Agent 층은 이미 한계다 —
          // log_visit 의 낱말 목록이 스무 개가 넘는데 30일간 걸린 것이 gptbot 1건뿐이었고,
          // 남은 것들은 **진짜 브라우저 UA 를 쓰는 렌더러**였다. 낱말을 더 넣어도 안 잡힌다.
          // 그래서 UA 가 아니라 행동으로 가른다: 화면을 5초 이상 보았거나 한 번이라도
          // 만졌으면 두 번째 신호를 보내 그 기록에 사람 표시를 덧칠한다.
          // **첫 기록은 그대로 남는다** — 지우는 것이 아니라 덧칠하는 것이다.
          var engaged = false;
          var seenMs = 0;
          var since = 0;
          var timer = null;

          function markEngaged() {
            if (engaged) return;
            engaged = true;
            if (timer) { clearTimeout(timer); timer = null; }
            fetch(sbUrl + '/rest/v1/rpc/mark_engaged', {
              method: 'POST',
              headers: { apikey: sbKey, Authorization: 'Bearer ' + sbKey, 'Content-Type': 'application/json' },
              body: JSON.stringify({ p_path: location.pathname, p_visitor: id }),
              keepalive: true,
            }).catch(function () {});
          }

          // 숨은 동안은 시간을 세지 않는다. 배경 탭에 5초 있었다고 읽은 것은 아니다.
          function clockOn() {
            if (engaged || since) return;
            since = Date.now();
            timer = setTimeout(markEngaged, Math.max(0, 5000 - seenMs));
          }
          function clockOff() {
            if (!since) return;
            seenMs += Date.now() - since;
            since = 0;
            if (timer) { clearTimeout(timer); timer = null; }
          }

          function watch() {
            clockOn();
            document.addEventListener('visibilitychange', function () {
              if (document.visibilityState === 'visible') clockOn(); else clockOff();
            });
            // 한 번이라도 만졌으면 사람이다. 5초를 기다릴 것 없다.
            ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (ev) {
              window.addEventListener(ev, markEngaged, { once: true, passive: true });
            });
          }

          function start() { send(); watch(); }

          if (document.prerendering) {
            document.addEventListener('prerenderingchange', start, { once: true });
          } else if (document.visibilityState === 'visible') {
            start();
          } else {
            document.addEventListener('visibilitychange', function onVis() {
              if (document.visibilityState !== 'visible') return;
              document.removeEventListener('visibilitychange', onVis);
              start();
            });
          }
        } catch (e) {}
      })();
    </script>
    )}
  </body>
</html>
