---
// 도토리 광장, 자유 의견 게시판 (giscus, mapping=specific 고정 스레드)
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
import { GISCUS, COMMENTS_ENABLED, NATIVE_COMMENTS_LIVE } from '../lib/comments';
import CommentThread from '../components/CommentThread.astro';
---

<Base
  title="도토리 광장"
  description="무역토리의 자유 게시판입니다. 의견과 주제 제안, 데이터 제보를 남기는 곳입니다."
  activeNav="board"
  compact
>
  <section class="wrap" style="max-width: 760px; padding-top: 48px;">
    <div class="kicker-en" style="color: var(--accent);">PLAZA</div>
    <h1 class="serif" style="font-size: 28px; font-weight: 900; margin-top: 6px;">도토리 광장</h1>
    <p class="plaza-sub">
      기사에 담기지 않은 이야기를 나누는 자리입니다. 다뤄 줬으면 하는 주제와
      숫자에 대한 질문, 데이터 오류 제보, 그리고 응원까지. 특정 기사에 대한
      의견은 그 기사 하단의 댓글에 남겨 주시면 맥락이 이어집니다.
    </p>
    <ul class="plaza-rules">
      <li>검증 가능한 근거가 있는 제보는 확인 후 기사에 반영하고 정정 이력을 남깁니다.</li>
      <li>특정 종목의 매수·매도 추천을 구하거나 권하는 글은 다루지 않습니다.</li>
      <li>협업·제휴 문의는 <a href={url('/contact/')}>문의 페이지</a>의 연락 채널을 이용해 주십시오.</li>
    </ul>

    {NATIVE_COMMENTS_LIVE ? (
      <CommentThread
        term="/board/"
        title="광장 글"
        note="구글 계정으로 로그인해 글을 남길 수 있습니다."
      />
    ) : COMMENTS_ENABLED ? (
      <div class="giscus-wrap">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={GISCUS.repo}
          data-repo-id={GISCUS.repoId}
          data-category={GISCUS.category}
          data-category-id={GISCUS.categoryId}
          data-mapping="specific"
          data-term="dotori-plaza"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang="ko"
          data-loading="lazy"
          crossorigin="anonymous"
          async
        />
      </div>
    ) : (
      <div class="plaza-pending">
        <p class="serif">광장 개장 준비 중입니다.</p>
        <p>댓글 시스템 연결이 끝나는 대로 이 자리에서 바로 글을 남길 수 있습니다. 그 전의 제보·문의는 <a href={url('/contact/')}>문의 페이지</a>로 부탁드립니다.</p>
      </div>
    )}
  </section>
</Base>

<style>
  .plaza-sub { font-size: 15px; color: var(--sub); line-height: 1.9; margin-top: 14px; word-break: keep-all; }
  .plaza-rules { margin: 18px 0 26px; padding-left: 18px; font-size: 13.5px; color: var(--sub); line-height: 2; word-break: keep-all; }
  .plaza-rules a { color: var(--accent); }
  .giscus-wrap { min-height: 200px; margin-top: 8px; }
  .plaza-pending { border: 1px dashed var(--line); border-radius: 12px; padding: 26px; text-align: center; color: var(--muted); margin-top: 8px; }
  .plaza-pending .serif { font-size: 17px; color: var(--ink); margin-bottom: 6px; }
  .plaza-pending p { font-size: 13.5px; line-height: 1.9; word-break: keep-all; }
  .plaza-pending a { color: var(--accent); }
</style>
