---
import Base from '../layouts/Base.astro';
import StatTiles from '../components/StatTiles.astro';
import ThreeLines from '../components/ThreeLines.astro';
import LineChart from '../components/LineChart.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, url, fmtDate, heroFor, SITE, isPublished, todayIn, TZ_KST, readingMinutesOf } from '../lib/site';
import { TOPICS } from '../lib/topics';
import { EPISODES } from '../data/story';

const all = (await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// 머리기사는 언제나 최신이어야 한다. featured 플래그는 '오늘 올린 글을 위로 올리는' 편집 장치이므로
// KST 기준 그날 하루만 효력이 있다. 플래그를 지우는 것을 잊어도 1면이 낡지 않게 하는 안전장치다.
// 예전에는 48시간 TTL이었는데, pubDate가 UTC 자정으로 파싱돼 만료 시각이 KST 오전 9시가 되는 바람에
// 06:50 아침 빌드는 늘 만료 전이었다 — 어제 글이 오늘 1면에 그대로 남는 문제가 있었다.
// 발행 게이트(isPublished)와 같은 'KST 날짜 문자열 비교' 방식으로 맞춰 하루 단위로 정확히 끊는다.
const todayKST = todayIn(TZ_KST);
const pinned = all.find((p) => p.data.featured && p.data.pubDate.toISOString().slice(0, 10) === todayKST);
const featured = pinned ?? all[0];
const rest = all.filter((p) => p.id !== featured?.id);

// 카툰은 상단 메뉴 깊숙이 두면 아무도 못 찾는다. 1면에 최근 세 화를 걸어 둔다.
const storyEps = EPISODES.filter((e) => !e.gateAtPosts || all.length >= e.gateAtPosts)
  .sort((a, b) => b.order - a.order)
  .slice(0, 3);
const storyCuts = EPISODES.filter((e) => !e.gateAtPosts || all.length >= e.gateAtPosts).reduce((n, e) => n + e.cuts, 0);

// 1면 편집: 이번 주(최근 7일, 최대 8편)만 시간순으로, 나머지는 분야별 블록으로 정리한다.
const WEEK_MS = 7 * 86400 * 1000;
const weekPosts = rest
  .filter((p) => p.data.pubDate.valueOf() >= Date.now() - WEEK_MS)
  .slice(0, 8);
const shownIds = new Set([featured?.id, ...weekPosts.map((p) => p.id)]);

// 연중 특집 밴드 (등록부 첫 특집)
const mainTopic = TOPICS[0];
const topicPosts = mainTopic
  ? all.filter((p) => (p.data.topics ?? []).includes(mainTopic.key)).slice(0, 3)
  : [];

// 분야별 아카이브: 위에서 이미 보여준 기사는 제외한 최신 3편씩
const catBlocks = (Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[])
  .map((key) => ({
    ...CATEGORIES[key],
    posts: all.filter((p) => p.data.category === key && !shownIds.has(p.id)).slice(0, 3),
  }))
  .filter((b) => b.posts.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  url: Astro.site ? new URL(url('/'), Astro.site).toString() : undefined,
};
---

<Base activeNav="home">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {
    featured && (
      <section class="hero wrap">
        <div class="hero-main">
          <div class:list={['kicker', CATEGORIES[featured.data.category].cls]}>
            {CATEGORIES[featured.data.category].name}, 오늘의 머리기사
          </div>
          <h1 class="hero-title serif">
            <a href={url(`/posts/${featured.id}/`)}>{featured.data.title}</a>
          </h1>
          <p class="hero-dek">{featured.data.description}</p>
          <div class="hero-byline">
            <span class="byline-name">토리</span>
            <span class="sep" />
            <span>{readingMinutesOf(featured.body ?? '')}분 읽기</span>
            <span class="sep" />
            <time datetime={featured.data.pubDate.toISOString()}>
              {fmtDate(featured.data.pubDate)}
            </time>
          </div>
          <a class="hero-image" href={url(`/posts/${featured.id}/`)}>
            <img
              src={heroFor(featured.data.category, featured.data.hero)}
              alt={`${featured.data.title} 대표 이미지`}
              width="1200"
              height="675"
              fetchpriority="high"
            />
          </a>
          {featured.data.chart && (
            <div class="hero-chart">
              <LineChart {...featured.data.chart} height={210} />
            </div>
          )}
          <a class="hero-cta" href={url(`/posts/${featured.id}/`)}>
            기사 읽기
            <svg class="cta-arrow" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path
                d="M2 6 H10 M6.5 2.5 L10 6 L6.5 9.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
        <aside class="hero-side">
          {featured.data.three && (
            <ThreeLines
              what={featured.data.three.what}
              why={featured.data.three.why}
              next={featured.data.three.next}
            />
          )}
          <StatTiles />
        </aside>
      </section>
    )
  }

  {
    weekPosts.length > 0 && (
      <section class="list wrap">
        <div class="list-head">
          <h2 class="list-title serif">이번 주 도토리</h2>
        </div>
        {weekPosts.map((p) => (
          <a class="row reveal" href={url(`/posts/${p.id}/`)}>
            <div class="row-thumb">
              <img src={heroFor(p.data.category, p.data.hero)} alt="" width="160" height="90" loading="lazy" />
            </div>
            <div class="row-body">
              <div class="row-title serif">{p.data.title}</div>
              <div class="row-dek">{p.data.description}</div>
            </div>
            <div class="row-meta">
              <span class:list={['chip', CATEGORIES[p.data.category].cls]}>
                {CATEGORIES[p.data.category].name}
              </span>
              <span class="row-date mono">{fmtDate(p.data.pubDate)}</span>
            </div>
          </a>
        ))}
      </section>
    )
  }

  {
    mainTopic && topicPosts.length > 0 && (
      <section class="fband wrap reveal">
        <div class="fband-head">
          <div>
            <div class="kicker-en" style="color: var(--accent);">SPECIAL REPORT</div>
            <h2 class="serif fband-title">연중 특집, {mainTopic.name}</h2>
            <p class="fband-desc">{mainTopic.desc}</p>
          </div>
          <a class="fband-more" href={url(mainTopic.href)}>특집 허브 보기 →</a>
        </div>
        <div class="fband-cards">
          {topicPosts.map((p) => (
            <a class="fband-card" href={url(`/posts/${p.id}/`)}>
              <div class="fband-thumb">
                <img src={heroFor(p.data.category, p.data.hero)} alt="" width="320" height="180" loading="lazy" />
              </div>
              <div class="fband-card-title serif">{p.data.title}</div>
              <div class="fband-card-date mono">{fmtDate(p.data.pubDate)}</div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    catBlocks.length > 0 && (
      <section class="catgrid wrap">
        <div class="list-head">
          <h2 class="list-title serif">분야별 아카이브</h2>
        </div>
        <div class="cg-grid">
          {catBlocks.map((b) => (
            <div class="cg-block reveal">
              <div class="cg-head">
                <span class:list={['chip', b.cls]}>{b.name}</span>
                <p class="cg-desc">{b.desc}</p>
              </div>
              {b.posts.map((p) => (
                <a class="cg-row" href={url(`/posts/${p.id}/`)}>
                  <span class="cg-row-title serif">{p.data.title}</span>
                  <span class="cg-row-date mono">{fmtDate(p.data.pubDate)}</span>
                </a>
              ))}
              <a class="cg-more" href={url(`/category/${b.slug}/`)}>{b.name} 전체 보기 →</a>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <aside id="tori-greet" hidden aria-live="polite">
    <div class="tg-bubble">오늘 주운 도토리, 보고 가세요!</div>
    <img src={url('/images/poses/pose-01.jpg')} alt="손을 흔드는 토리" width="88" height="88" />
    <button id="tg-close" aria-label="인사 닫기">&times;</button>
  </aside>

  <script>
    // 토리 인사 팝업, 세션당 1회, 잠시 인사하고 내려간다
    try {
      const KEY = 'tori-greeted';
      const greet = document.getElementById('tori-greet');
      if (greet && !sessionStorage.getItem(KEY)) {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const show = () => {
          greet.hidden = false;
          requestAnimationFrame(() => greet.classList.add('show'));
        };
        const hide = () => {
          greet.classList.remove('show');
          setTimeout(() => (greet.hidden = true), 700);
        };
        setTimeout(show, reduce ? 400 : 1300);
        const autoHide = setTimeout(hide, 9500);
        sessionStorage.setItem(KEY, '1');
        document.getElementById('tg-close')?.addEventListener('click', () => {
          clearTimeout(autoHide);
          hide();
        });
      }
    } catch (e) {}
  </script>

  <section class="plaza-band wrap reveal">
    <div>
      <div class="pb-title serif">도토리 광장이 열려 있습니다</div>
      <p class="pb-desc">다뤄 줬으면 하는 주제, 숫자에 대한 질문, 데이터 오류 제보, 그리고 응원까지. 기사에 담기지 않은 이야기를 나누는 자유 게시판입니다.</p>
    </div>
    <a class="pb-cta" href={url('/board/')}>광장 가기 →</a>
  </section>

  <section class="story-band wrap reveal">
    <div class="sb-head">
      <div>
        <div class="sb-title serif">토리 이야기</div>
        <p class="sb-desc">
          숫자를 세는 다람쥐가 어쩌다 매일 새벽 장부를 적게 됐는지, 카툰 {storyCuts}컷으로 그렸습니다.
        </p>
      </div>
      <a class="sb-all" href={url('/story/')}>이야기 전체 보기 →</a>
    </div>
    <div class="sb-grid">
      {
        storyEps.map((e) => (
          <a class="sb-card" href={url(`/story/${e.slug}/`)}>
            <div class="sb-thumb">
              <img
                src={url(`/images/story/${e.cover}.jpg`)}
                alt={`${e.title} 대표 컷`}
                width="360"
                height="270"
                loading="lazy"
              />
            </div>
            <div class="sb-card-title">{e.title}</div>
            <div class="mono sb-meta">{e.series} · {e.cuts}컷</div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mascot wrap reveal">
    <img
      src={url('/images/tori/tori.jpg')}
      alt="네이비 베스트를 입은 다람쥐 이코노미스트 토리"
      class="mascot-img tori-idle"
      width="180"
      height="180"
      loading="lazy"
    />
    <div>
      <div class="mascot-quote serif">&ldquo;{SITE.tagline}&rdquo;</div>
      <div class="mascot-sub">
        토리는 매일 아침 무역·환율·금리 데이터를 줍고, 차트 한 장과 세 줄로 정리합니다.
        <a href={url('/about/')}>토리는 누구인가 →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .story-band { margin-top: 52px; }
  .sb-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; flex-wrap: wrap; border-bottom: 2px solid var(--ink); padding-bottom: 12px; }
  .sb-title { font-size: 19px; font-weight: 900; color: var(--ink); }
  .sb-desc { font-size: 13px; color: var(--sub); line-height: 1.8; margin-top: 6px; max-width: var(--measure); word-break: keep-all; }
  .sb-all { font-size: 12.5px; font-weight: 700; color: var(--accent); white-space: nowrap; }
  .sb-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 20px; }
  @media (max-width: 760px) { .sb-grid { grid-template-columns: 1fr 1fr; } .sb-grid > :nth-child(3) { display: none; } }
  .sb-card { display: block; }
  .sb-thumb { border: 1px solid var(--ink); border-radius: 4px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--surface); }
  .sb-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sb-card-title { font-size: 14px; font-weight: 700; color: var(--ink); line-height: 1.5; margin-top: 9px; word-break: keep-all; }
  .sb-card:hover .sb-card-title { color: var(--accent); }
  .sb-meta { font-size: 11px; color: var(--muted); margin-top: 4px; }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding-top: 52px;
    padding-bottom: 52px;
    border-bottom: 1px solid var(--ink);
  }
  @media (min-width: 960px) {
    .hero { grid-template-columns: 2fr 1fr; gap: 48px; }
    .hero-side { border-left: 1px solid var(--hair); padding-left: 36px; }
  }
  .hero-main { display: flex; flex-direction: column; gap: 17px; align-items: flex-start; }
  .hero-title {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 900;
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: pretty;
  }
  .hero-dek { font-size: 16px; line-height: 1.75; color: var(--sub); max-width: 640px; margin: 0; }
  .hero-byline { display: flex; align-items: center; gap: 11px; font-size: 12px; color: var(--sub); }
  .byline-name { font-weight: 700; color: var(--ink); }
  .sep { width: 1px; height: 11px; background: var(--hair); }
  .hero-image {
    display: block;
    width: 100%;
    border: 1px solid var(--hair);
    background: var(--surface);
    overflow: hidden;
  }
  .hero-image img { display: block; width: 100%; height: auto; transition: transform 0.4s ease; }
  .hero-image:hover img { transform: scale(1.02); }
  .hero-chart { width: 100%; }
  .hero-chart :global(.chart) { margin: 6px 0 0 0; max-width: none; }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--brand);
    color: #fff;
    font-size: 13.5px;
    font-weight: 700;
    padding: 11px 22px;
    transition: background 0.15s ease;
  }
  .hero-cta:hover { background: var(--brand-hover); color: #fff; }
  .hero-cta .cta-arrow { transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .hero-cta:hover .cta-arrow { transform: translateX(4px); }
  .hero-side { display: flex; flex-direction: column; gap: 26px; }
  .hero-side :global(.three) { margin-bottom: 0; }

  .list { padding-top: 52px; }
  .list-head { border-bottom: 1px solid var(--ink); margin-bottom: 4px; }
  .list-title { font-size: 25px; font-weight: 900; margin: 0 0 14px 0; }
  .row {
    display: grid;
    grid-template-columns: 148px 1fr auto;
    gap: 22px;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid var(--hair2);
  }
  .row-thumb {
    width: 148px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--hair);
    background: var(--surface);
    overflow: hidden;
  }
  .row-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .row:hover .row-thumb img { transform: scale(1.05); }
  .row-title {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.5;
    transition: color 0.15s ease, transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .row:hover .row-title { color: var(--accent); transform: translateX(6px); }
  .row .row-no { transition: color 0.2s ease; }
  .row:hover .row-no { color: var(--accent); }
  .row-dek { font-size: 14px; color: var(--sub); line-height: 1.7; margin-top: 6px; }
  .row-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
    flex-shrink: 0;
  }
  .row-date { font-size: 11px; color: var(--muted); }
  @media (max-width: 640px) {
    .row { grid-template-columns: 96px 1fr; }
    .row-meta { grid-column: 2; flex-direction: row; align-items: center; justify-content: flex-start; }
    .row-thumb { width: 96px; }
  }

  #tori-greet {
    position: fixed;
    right: 20px;
    bottom: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 9px;
    transform: translateY(120%);
    transition: transform 0.65s cubic-bezier(0.2, 0.9, 0.25, 1.15);
    padding-bottom: 16px;
  }
  #tori-greet.show { transform: translateY(0); }
  #tori-greet img {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 18%;
    border: 2px solid var(--ink);
    background: #fff;
    animation: tori-bob 3.2s ease-in-out infinite;
  }
  .tg-bubble {
    background: #fff;
    color: #231a10;
    border: 2px solid #231a10;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 14px;
    position: relative;
    box-shadow: 0 4px 14px rgba(22, 20, 15, 0.12);
  }
  .tg-bubble::before {
    content: '';
    position: absolute;
    bottom: -11px;
    right: 30px;
    border: solid transparent;
    border-width: 11px 7px 0 7px;
    border-top-color: #231a10;
  }
  .tg-bubble::after {
    content: '';
    position: absolute;
    bottom: -7px;
    right: 32px;
    border: solid transparent;
    border-width: 8px 5px 0 5px;
    border-top-color: #fff;
  }
  #tg-close {
    position: absolute;
    top: -6px;
    right: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    #tori-greet { transition: none; }
    #tori-greet img { animation: none; }
  }
  @media (max-width: 640px) {
    #tori-greet img { width: 68px; height: 68px; }
    .tg-bubble { font-size: 12px; }
  }

  /* 연중 특집 밴드 */
  .fband { margin-top: 56px; border-top: 2px solid var(--ink); padding-top: 22px; }
  .fband-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 18px; flex-wrap: wrap; margin-bottom: 20px; }
  .fband-title { font-size: 24px; font-weight: 900; margin: 6px 0 8px; }
  .fband-desc { font-size: 13.5px; color: var(--sub); max-width: var(--measure); line-height: 1.75; margin: 0; word-break: keep-all; }
  .fband-more { font-size: 13px; font-weight: 700; color: var(--accent); flex-shrink: 0; padding-bottom: 3px; }
  .fband-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .fband-card { display: block; }
  .fband-thumb { aspect-ratio: 16 / 9; border: 1px solid var(--hair); background: var(--surface); overflow: hidden; }
  .fband-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .fband-card:hover .fband-thumb img { transform: scale(1.04); }
  .fband-card-title { font-size: 15.5px; font-weight: 700; line-height: 1.55; margin-top: 11px; word-break: keep-all; }
  .fband-card:hover .fband-card-title { color: var(--accent); }
  .fband-card-date { font-size: 11px; color: var(--muted); margin-top: 5px; }
  @media (max-width: 720px) {
    .fband-cards { grid-template-columns: 1fr; gap: 18px; }
    .fband-card { display: grid; grid-template-columns: 120px 1fr; gap: 0 14px; align-items: start; }
    .fband-thumb { grid-row: span 2; }
    .fband-card-title { margin-top: 0; }
  }

  /* 분야별 아카이브 */
  .catgrid { padding-top: 56px; }
  .cg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 34px 44px; padding-top: 10px; }
  @media (max-width: 720px) { .cg-grid { grid-template-columns: 1fr; } }
  .cg-block { border-top: 2px solid var(--ink); padding-top: 15px; }
  .cg-head { margin-bottom: 4px; }
  .cg-desc { font-size: 12.5px; color: var(--muted); margin: 9px 0 4px; line-height: 1.7; word-break: keep-all; }
