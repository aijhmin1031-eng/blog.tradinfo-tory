---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/site';
import indicators from '../../data/series/usdkrw.json';

// ★ 2026-09-05 전면 개편으로 새로 쓴 홈이다. 그전 판은 기사·브리핑·특집·카툰을 얹고 있었고
//   그 구역이 전부 사라져 다시 썼다. 조판 정본은 `docs/redesign-2026-09.md`.
const corps = (await getCollection('corps')).sort(
  (a, b) => +new Date(b.data.updated) - +new Date(a.data.updated),
);
const lead = corps[0];

const tools = [
  { tag: '공공조달', name: '입찰레이더', href: '/bid-radar/',
    desc: '나라장터 입찰공고를 소재지와 보유 면허로 선별하여 참여가능·확인필요·자격미달을 판정합니다.' },
  { tag: '공공조달', name: '복수예가 투찰률 계산기', href: '/bid-odds/',
    desc: '복수예비가격 조합 1,365가지를 전수 전개하여 하한 통과 비율을 산출합니다. 낙찰 확률이 아닙니다.' },
  { tag: '무역', name: '수입원가 계산기', href: '/import-cost/',
    desc: '관세와 부가가치세를 산출하고 협정관세 적용·미적용을 나란히 비교합니다.' },
  { tag: '자금', name: '실질금리 계산기', href: '/real-return/',
    desc: '예금의 세후 실질수익과 손익분기 금리를 산출합니다.' },
];

const chapters = [
  ['1장', '사업 구조'], ['2장', '매출 및 영업이익 추이'], ['3장', '재무 건전성'],
  ['4장', '가치평가 지표'], ['5장', '리스크 요인 및 자본 정책'], ['6장', '향후 방향'],
  ['7장', '반증 검토'],
];
---

<Base description="상장기업의 정기보고서를 분기 단위로 이어 분석합니다. 공공조달·무역·자금 실무에 사용하는 계산 도구를 함께 제공합니다.">
  <div class="hero">
    <div class="wrap">
      <div class="kick">기업 분석 · 실무 도구</div>
      <h1 class="hd">기업 재무의 구간 분석</h1>
      <p class="lead">
        상장기업의 정기보고서를 분기 단위로 이어 붙여 5~6개 사업연도의 형태를 봅니다.
        공공조달·무역·자금 실무에 사용하는 계산 도구를 함께 제공합니다.
      </p>
      <div class="btns">
        <a class="b1" href={url('/corp/')}>기업 분석 보기</a>
        <a class="b2" href={url('/tools/')}>지원 도구 열기</a>
      </div>
    </div>
  </div>

  {lead && (
    <div class="wrap sec">
      <div class="sec-hd"><h2 class="hd sec-t">최신 분석</h2><span class="rule"></span></div>
      <div class="lead-card">
        <div class="lead-meta">
          <span class="mono code">{lead.data.stock}</span>
          <span class="hd nm">{lead.data.name}</span>
          <span class="tag">{lead.data.market} · {lead.data.label}</span>
        </div>
        <h3 class="hd lead-t">{lead.data.title}</h3>
        <p class="lead-d">{lead.data.description}</p>
        <a class="b1 sm" href={url(`/corp/${lead.id}/`)}>보고서 전문 보기</a>
        <span class="mono upd">최종 갱신 {new Date(lead.data.updated).toISOString().slice(0, 10)}</span>
      </div>
    </div>
  )}

  <div class="wrap sec">
    <div class="sec-hd"><h2 class="hd sec-t">기업 지원 도구</h2><span class="rule"></span></div>
    <div class="tools">
      {tools.map((t) => (
        <a class="tool" href={url(t.href)}>
          <div class="t-tag">{t.tag}</div>
          <div class="hd t-name">{t.name}</div>
          <div class="t-desc">{t.desc}</div>
        </a>
      ))}
    </div>
  </div>

  <div class="dark">
    <div class="wrap">
      <h2 class="hd dk-t">분석 보고서의 7개 장</h2>
      <p class="dk-s">기업마다 같은 순서를 따르므로 기업 간 비교가 가능합니다.</p>
      <div class="chaps">
        {chapters.map(([n, k], i) => (
          <div class={i === 6 ? 'chap last' : 'chap'}>
            <div class="mono c-n">{n}</div>
            <div class="hd c-k">{k}</div>
          </div>
        ))}
      </div>
      <p class="dk-p">
        마지막 장을 따로 둡니다. <span class="w">7장은 해당 보고서의 해석을 반박할 수 있는 설명을
        세우고 검토하는 절입니다.</span> 반론이 성립하는 부분은 성립한다고 적고, 그 검토를 거치고도
        남는 것만 결론으로 제시합니다.
      </p>
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 1440px; margin: 0 auto; padding: 0 64px; }
  .hero { background: #fff; border-bottom: 1px solid #e4e4de; padding: 66px 0 60px; }
  .kick { font-size: 11px; font-weight: 600; letter-spacing: 2.4px; color: #9a6b22; margin-bottom: 20px; }
  h1 { font-size: 60px; line-height: 1.22; font-weight: 900; color: #15171a; margin: 0 0 26px; letter-spacing: -2.6px; }
  .lead { font-size: 17px; line-height: 1.9; color: #4a4f56; margin: 0 0 34px; max-width: 700px; }
  .btns { display: flex; gap: 14px; }
  .b1 { background: #15171a; color: #fff; padding: 14px 28px; font-family: 'Gothic A1', sans-serif;
        font-size: 15px; font-weight: 700; border-radius: 2px; text-decoration: none; }
  .b1.sm { background: #16355e; padding: 11px 22px; font-size: 13.5px; }
  .b2 { border: 1px solid #c8cbd0; color: #15171a; padding: 13px 26px; font-family: 'Gothic A1', sans-serif;
        font-size: 15px; font-weight: 700; border-radius: 2px; text-decoration: none; }
  .sec { padding: 52px 64px 0; }
  .sec-hd { display: flex; align-items: baseline; gap: 14px; margin-bottom: 26px; }
  .sec-t { font-size: 15px; font-weight: 800; color: #15171a; margin: 0; white-space: nowrap; }
  .rule { flex: 1; height: 1px; background: #e4e4de; }
  .lead-card { max-width: 900px; }
  .lead-meta { display: flex; align-items: center; gap: 11px; margin-bottom: 16px; flex-wrap: wrap; }
  .code { font-size: 11.5px; color: #9a6b22; }
  .nm { font-size: 14px; font-weight: 800; color: #15171a; }
  .tag { font-size: 11px; color: #71767d; border: 1px solid #e4e4de; padding: 2px 8px; }
  .lead-t { font-size: 34px; line-height: 1.35; font-weight: 900; color: #15171a; margin: 0 0 20px; letter-spacing: -1.2px; }
  .lead-d { font-size: 15px; line-height: 1.95; color: #4a4f56; margin: 0 0 26px; }
  .upd { font-size: 11.5px; color: #8e9299; margin-left: 18px; }
  .tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .tool { border: 1px solid #e4e4de; background: #fff; padding: 22px 24px 24px; text-decoration: none;
          transition: border-color .16s ease; display: block; }
  .tool:hover { border-color: #b9bcb4; }
  .t-tag { font-size: 10.5px; font-weight: 600; letter-spacing: 1.6px; color: #9a6b22; margin-bottom: 8px; }
  .t-name { font-size: 16px; font-weight: 800; color: #15171a; margin-bottom: 8px; }
  .t-desc { font-size: 13px; line-height: 1.85; color: #6b7076; }
  .dark { background: #15171a; padding: 44px 0 46px; margin-top: 60px; }
  .dk-t { font-size: 22px; font-weight: 900; color: #fff; margin: 0 0 6px; letter-spacing: -0.7px; }
  .dk-s { font-size: 12.5px; color: #8e9299; margin: 0 0 26px; }
  .chaps { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 1px; background: #2a2e33; }
  .chap { background: #15171a; padding: 16px 14px 18px; border-top: 2px solid #3a3f45; }
  .chap.last { border-top-color: #9a6b22; }
  .c-n { font-size: 11px; color: #8e9299; margin-bottom: 9px; }
  .chap.last .c-n { color: #c79a52; }
  .c-k { font-size: 14px; font-weight: 800; color: #fff; line-height: 1.45; }
  .dk-p { font-size: 13.5px; line-height: 1.9; color: #a8acb1; margin: 22px 0 0; max-width: 900px; }
  .dk-p .w { color: #fff; }
  .mono { font-family: 'IBM Plex Mono', 'IBM Plex Sans KR', monospace; font-variant-numeric: tabular-nums; }
  @media (max-width: 720px) {
    .wrap { padding: 0 20px; }
    .sec { padding: 40px 20px 0; }
    h1 { font-size: 30px; letter-spacing: -1.2px; }
    .lead { font-size: 15px; }
    .lead-t { font-size: 22px; letter-spacing: -0.7px; }
    .tools { grid-template-columns: minmax(0, 1fr); }
    .chaps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .btns { flex-wrap: wrap; }
  }
</style>
