---
// 도토리 그림함 — 무료 이미지 나눔 목록.
// 낱장 페이지(/pack/<slug>/)로만 내려받게 두어, 한 번에 쓸어 담는 대신 필요한 그림을 골라 보게 한다.
// 검색 유입이 목적이므로 팩 소개와 이미지 설명은 사람이 읽는 문장으로 적고 구조화 데이터를 함께 싣는다.
import Pic from '../components/Pic.astro';
import Base from '../layouts/Base.astro';
import Collab from '../components/Collab.astro';
import { url } from '../lib/site';
import { PACKS, thumbOf, fileOf, ALL_ITEMS } from '../data/pack';

const total = ALL_ITEMS.length;
const pageDesc =
  `블로그와 SNS, 발표 자료에 바로 쓰는 무료 이미지 ${total}장을 나눕니다. ` +
  '출처만 표기하면 상업적 사용까지 가능하고, 전부 배경이 비어 있는 1600픽셀 투명 PNG로 제공합니다.';

const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '도토리 그림함 무료 이미지',
  description: pageDesc,
  url: new URL(url('/pack/'), Astro.site).href,
  inLanguage: 'ko',
  isPartOf: { '@type': 'WebSite', name: '도토리경제', url: new URL(url('/'), Astro.site).href },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: total,
    itemListElement: ALL_ITEMS.map(({ pack, item }, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(url(`/pack/${item.slug}/`), Astro.site).href,
      name: `${item.name} 무료 이미지`,
      image: new URL(url(fileOf(pack, item)), Astro.site).href,
    })),
  },
};
---

<Base altPath="/pack/"
  title={`무료 이미지 ${total}장 나눔 · 상업적 이용 가능`}
  description={pageDesc}
  activeNav="pack"
  compact
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collection)} />
  </Fragment>

  <section class="wrap pk-head">
    <div class="kicker-en" style="color: var(--accent);">FREE IMAGE PACK</div>
    <h1 class="serif pk-title">무료 이미지 나눔, 도토리 그림함</h1>
    <p class="pk-sub">
      도토리경제가 그린 일러스트 {total}장을 무료로 나눕니다. 블로그 썸네일과 SNS 카드,
      발표 자료와 인쇄물까지 아래 조건만 지키면 상업적 사용도 가능합니다.
      전부 배경이 비어 있는 1600픽셀 투명 PNG라, 어떤 색 위에 올려도 흰 네모가 생기지 않습니다.
    </p>
    <p class="pk-sub">
      그림은 한 장씩 골라 받는 방식입니다. 이름을 누르면 그 그림만 크게 보고, 어디에 쓰면 좋은지
      확인한 뒤 내려받을 수 있습니다. 새 그림은 이 함에 계속 쌓입니다.
    </p>
    <div class="pk-license">
      <div class="pk-lic-col">
        <div class="pk-lic-title ok">이렇게 쓸 수 있습니다</div>
        <ul>
          <li>블로그·SNS·영상·발표 자료·상업적 사용 전부 가능</li>
          <li>조건은 하나, 출처 <strong>"도토리경제"</strong>를 표기하고 이곳 링크를 남겨 주십시오</li>
          <li>크기 조절·자르기·색 변경 등 편집 가능</li>
        </ul>
      </div>
      <div class="pk-lic-col">
        <div class="pk-lic-title no">이것만은 안 됩니다</div>
        <ul>
          <li>이미지 자체를 판매하거나 유료 소재로 재배포</li>
          <li>본인이 만든 것처럼 출처를 감추는 사용</li>
          <li>토리 캐릭터를 다른 서비스의 마스코트로 사용</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap pk-filter" aria-label="그림 찾기">
    <label class="pk-search">
      <span class="sr-only">그림 이름이나 쓰임으로 찾기</span>
      <input
        type="search"
        id="pk-q"
        placeholder="찾으시는 그림이 있습니까 (예: 차트, 노트북, 커피)"
        autocomplete="off"
      />
    </label>
    <div class="pk-tabs" role="group" aria-label="묶음 고르기">
      <button class="pk-tab is-on" data-filter="all" type="button">전체 {total}장</button>
      {PACKS.map((pack) => (
        <button class="pk-tab" data-filter={pack.key} type="button">
          {pack.label ?? `${pack.vol}탄`} {pack.items.length}
        </button>
      ))}
    </div>
    <p class="pk-hit mono" id="pk-hit" hidden></p>
  </section>

  <section class="wrap pk-body">
    {
      PACKS.map((pack, idx) => (
        <div class="pk-pack" data-pack data-key={pack.key}>
          <div class="pk-pack-head" id={pack.key} style={idx > 0 ? 'margin-top: 52px;' : ''}>
            <h2 class="serif pk-pack-title">
              {pack.label ?? `${pack.vol}탄`}, {pack.title}
              <span class="pk-badge">{pack.transparent ? '투명 배경' : '단색 배경'}</span>
              <span class="pk-count mono">{pack.items.length}장</span>
            </h2>
            <span class="pk-format mono">{pack.size}</span>
          </div>
          <p class="pk-pack-sub">
            {pack.note}
            {pack.origin && (
              <>
                {' '}
                <a href={pack.origin.href} rel="noopener">{pack.origin.name}</a>에서 온 그림입니다.
              </>
            )}
          </p>
          <div class="pk-grid">
            {pack.items.map((item) => (
              <a
                class="pk-card"
                href={url(`/pack/${item.slug}/`)}
                data-item
                data-search={`${item.name} ${item.slug} ${item.keywords.join(' ')}`}
              >
                <div class={`pk-thumb${pack.transparent ? ' pk-thumb-alpha alpha-grid' : ''}`}>
                  <Pic
                    path={thumbOf(pack, item)}
                    alt={`${item.name} 무료 이미지 · 도토리경제 그림함`}
                    width={400}
                    height={400}
                  />
                </div>
                <div class="pk-card-foot">
                  <span class="pk-name">{item.name}</span>
                  <span class="pk-dl mono">받기</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))
    }
    <p class="pk-note">
      그림은 낱장으로만 드립니다. 한 번에 묶어 받는 파일은 두지 않았습니다.
      필요한 그림을 골라 쓰는 편이 서로에게 낫다고 보기 때문입니다.
    </p>
  </section>

  <section class="wrap" style="padding-bottom: 56px;">
    <Collab source="site" variant="inline" />
  </section>
</Base>
<script>
  // 58장이 되면서 훑기가 버거워졌다. 이름·키워드로 걸러 주고, 묶음 탭으로 좁힌다.
  const q = document.getElementById('pk-q') as HTMLInputElement | null;
  const hit = document.getElementById('pk-hit');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.pk-tab'));
  const packs = Array.from(document.querySelectorAll<HTMLElement>('[data-pack]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'));
  let group = 'all';

  const apply = () => {
    const term = (q?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const el of items) {
      const inGroup = group === 'all' || el.closest('[data-pack]')?.dataset.key === group;
      const match = !term || (el.dataset.search ?? '').toLowerCase().includes(term);
      const on = inGroup && match;
      el.hidden = !on;
      if (on) shown += 1;
    }
    // 남은 그림이 없는 묶음은 제목까지 접는다
    for (const p of packs) {
      const any = Array.from(p.querySelectorAll<HTMLElement>('[data-item]')).some((el) => !el.hidden);
      p.hidden = !any;
    }
    if (hit) {
      const filtering = term || group !== 'all';
      hit.hidden = !filtering;
      hit.textContent = shown === 0 ? '찾으시는 그림이 없습니다. 다른 말로 찾아보십시오.' : `${shown}장`;
    }
  };

  q?.addEventListener('input', apply);
  for (const t of tabs) {
    t.addEventListener('click', () => {
      group = t.dataset.filter ?? 'all';
      for (const o of tabs) o.classList.toggle('is-on', o === t);
      apply();
    });
  }
</script>



<style>
  .pk-filter { margin-top: 34px; }
  .pk-search input {
    width: 100%; max-width: var(--measure); box-sizing: border-box;
    font: inherit; font-size: 14.5px; color: var(--ink);
    background: var(--paper); border: 1px solid var(--line); border-radius: 10px;
    padding: 13px 16px;
  }
  .pk-search input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
  .pk-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .pk-tab {
    font: inherit; font-size: 12.5px; font-weight: 700; color: var(--sub); cursor: pointer;
    background: var(--paper); border: 1px solid var(--line); border-radius: 999px; padding: 7px 14px;
  }
  .pk-tab:hover { border-color: var(--accent); color: var(--accent); }
  .pk-tab.is-on { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .pk-hit { font-size: 11.5px; color: var(--muted); margin-top: 10px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* hidden 속성의 기본 display:none 은 작성자 display 규칙에 진다.
     .pk-card 가 display:block 이라 걸러도 카드가 남아 있었다. */
  .pk-card[hidden], .pk-pack[hidden] { display: none; }

  .pk-head { padding-top: 46px; }
  .pk-title { font-size: clamp(30px, 4.6vw, 44px); font-weight: 900; color: var(--ink); margin-top: 6px; }
  .pk-sub { font-size: 15px; color: var(--sub); line-height: 1.9; margin-top: 12px; max-width: var(--measure-wide); word-break: keep-all; }
  .pk-license { display: grid; grid-template-columns: 1fr 1fr; gap: 0 34px; border: 1px solid var(--line); border-radius: 14px; padding: 20px 24px; margin-top: 22px; }
  @media (max-width: 720px) { .pk-license { grid-template-columns: 1fr; gap: 16px; } }
  .pk-lic-title { font-size: 13px; font-weight: 800; margin-bottom: 9px; }
  .pk-lic-title.ok { color: var(--up); }
  .pk-lic-title.no { color: var(--down); }
  .pk-license ul { margin: 0; padding-left: 18px; }
  .pk-license li { font-size: 13px; color: var(--sub); line-height: 1.85; word-break: keep-all; }

  .pk-body { margin-top: 40px; }
  .pk-pack-head { scroll-margin-top: 120px; display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; border-bottom: 2px solid var(--ink); padding-bottom: 12px; }
  .pk-pack-title { font-size: 22px; font-weight: 900; word-break: keep-all; }
  .pk-count { font-size: 13px; color: var(--muted); font-weight: 500; margin-left: 6px; }
  .pk-format { font-size: 11px; color: var(--muted); }
  .pk-badge { font-size: 11px; font-weight: 700; color: var(--accent); border: 1.5px solid var(--accent); border-radius: 999px; padding: 3px 10px; vertical-align: 3px; margin-left: 8px; letter-spacing: 0.03em; }
  .pk-pack-sub { font-size: 13.5px; color: var(--sub); line-height: 1.85; margin-top: 14px; max-width: var(--measure-wide); word-break: keep-all; }
  .pk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 18px; margin-top: 22px; }
  .pk-card { display: block; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--paper); transition: border-color 0.2s, transform 0.2s; }
  .pk-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .pk-thumb { aspect-ratio: 1; background-color: var(--surface); }
  /* 투명 팩은 전역 .alpha-grid 의 체커보드를 살려야 하므로 단색을 덮지 않는다 */
  .pk-thumb.alpha-grid { background-color: var(--grid-b); }
  .pk-thumb-alpha { padding: 14px; box-sizing: border-box; }
  .pk-thumb :global(img) { width: 100%; height: 100%; object-fit: contain; display: block; }
  .pk-card-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px 13px; }
  .pk-name { font-size: 13px; font-weight: 700; color: var(--ink); }
  .pk-dl { font-size: 10px; color: var(--muted); }
  .pk-card:hover .pk-dl { color: var(--accent); }
  .pk-note { font-size: 12px; color: var(--muted); margin-top: 24px; line-height: 1.8; word-break: keep-all; }
</style>
