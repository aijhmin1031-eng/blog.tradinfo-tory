---
// 본문 속 전문용어 설명 칩, 점선 밑줄 용어를 탭하면 픽토그램과 한두 문장 정의 카드가 열린다.
// 사용: <Term t="스프레드" /> 또는 표기를 바꿀 때 <Term t="베이시스포인트">bp</Term>
import { GLOSSARY } from '../lib/glossary';
import { PICTOGRAMS } from '../lib/pictograms';
import { url } from '../lib/site';

interface Props {
  t: keyof typeof GLOSSARY | string;
}
const { t } = Astro.props;
const entry = GLOSSARY[t as string];
if (!entry) throw new Error(`glossary에 없는 용어: ${t}`);

const pictograms = PICTOGRAMS;
const icon = pictograms[entry.icon] ?? pictograms.spread;
---

<span class="term-wrap"
  ><button type="button" class="term-chip" aria-expanded="false"><slot>{t}</slot></button
  ><span class="term-card" role="note" hidden>
    <span class="term-tag mono">토리의 용어 메모</span>
    <span class="term-main">
      <span class="term-pict" set:html={`<svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">${icon}</svg>`} />
      <span class="term-body">
        <b class="term-name">{entry.label}</b>
        <span class="term-def">{entry.def}</span>
      </span>
    </span>
    <a class="term-more" href={url(`/glossary/${t}/`)}>{entry.label} 자세히 보기 →</a>
  </span></span><style>
  .term-wrap {
    position: relative;
    display: inline;
  }
  .term-chip {
    all: unset;
    cursor: help;
    font: inherit;
    color: inherit;
    border-bottom: 1.5px dotted var(--accent);
    padding-bottom: 1px;
    transition: color 0.15s ease;
  }
  .term-chip:hover,
  .term-chip[aria-expanded='true'] {
    color: var(--accent);
  }
  .term-chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .term-card {
    position: absolute;
    z-index: 40;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(calc(-50% + var(--term-shift, 0px)));
    width: max-content;
    max-width: min(340px, 86vw);
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--hair);
    border-left: 3px solid var(--accent);
    box-shadow: 0 10px 28px rgba(16, 20, 28, 0.13);
    padding: 12px 16px 11px;
    text-align: left;
    word-break: keep-all;
  }
  .term-card[hidden] {
    display: none;
  }
  .term-tag {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .term-main {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .term-more {
    align-self: flex-end;
    font-size: 11.5px;
    color: var(--muted);
    text-decoration: none;
    border-top: 1px solid var(--hair2, var(--hair));
    padding-top: 7px;
    width: 100%;
    text-align: right;
  }
  .term-more:hover {
    color: var(--accent);
  }
  .term-card::before {
    content: '';
    position: absolute;
    top: -5px;
    left: calc(50% - var(--term-shift, 0px));
    width: 9px;
    height: 9px;
    transform: translateX(-50%) rotate(45deg);
    background: var(--surface);
    border-top: 1px solid var(--hair);
    border-left: 1px solid var(--hair);
  }
  .term-pict {
    flex: none;
    color: var(--accent);
    display: inline-flex;
    margin-top: 2px;
  }
  .term-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .term-name {
    font-family: var(--font-serif);
    font-size: 14.5px;
    font-weight: 700;
    color: var(--ink);
  }
  .term-def {
    font-size: 13px;
    line-height: 1.75;
    color: var(--sub);
  }
  @media (prefers-reduced-motion: no-preference) {
    .term-card:not([hidden]) {
      animation: term-in 0.18s ease-out;
    }
    @keyframes term-in {
      from {
        opacity: 0;
        translate: 0 -4px;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }
  }
</style><script>
  function closeAll(except?: Element) {
    document.querySelectorAll<HTMLElement>('.term-card:not([hidden])').forEach((card) => {
      if (card === except) return;
      card.hidden = true;
      card.parentElement?.querySelector('.term-chip')?.setAttribute('aria-expanded', 'false');
    });
  }
  document.addEventListener('click', (e) => {
    const chip = (e.target as Element).closest?.('.term-chip');
    if (!chip) {
      if (!(e.target as Element).closest?.('.term-card')) closeAll();
      return;
    }
    const card = chip.parentElement?.querySelector<HTMLElement>('.term-card');
    if (!card) return;
    const opening = card.hidden;
    closeAll(card);
    card.hidden = !opening;
    chip.setAttribute('aria-expanded', String(opening));
    if (opening) {
      card.style.setProperty('--term-shift', '0px');
      const r = card.getBoundingClientRect();
      const pad = 14;
      let shift = 0;
      if (r.left < pad) shift = pad - r.left;
      else if (r.right > innerWidth - pad) shift = innerWidth - pad - r.right;
      if (shift) card.style.setProperty('--term-shift', `${shift}px`);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>