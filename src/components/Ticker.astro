---
import indicators from '../data/indicators.json';
import Delta from './Delta.astro';
---

<div class="ticker" role="marquee" aria-label="주요 시세">
  <div class="ticker-inner mono">
    {
      indicators.ticker.map((t) => (
        <span class="tk">
          <span class="tk-label">{t.label}</span>
          <span class="tk-value">{t.value}</span>
          <Delta dir={t.dir as 'up' | 'down'} text={t.delta} onDark />
        </span>
      ))
    }
    <span class="tk tk-asof">기준 {indicators.asOf}</span>
  </div>
</div>

<style>
  .ticker {
    background: var(--dark-band);
    color: var(--dark-band-ink);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .ticker::-webkit-scrollbar { display: none; }
  .ticker-inner {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 13px 24px;
    font-size: 12px;
    white-space: nowrap;
    max-width: var(--w-page);
    margin: 0 auto;
  }
  .tk { display: inline-flex; align-items: center; gap: 6px; }
  .tk-label { color: var(--dark-band-sub); }
  .tk-value { font-weight: 500; }
  .tk-asof { color: var(--dark-band-sub); font-size: 10px; margin-left: auto; }
</style>
