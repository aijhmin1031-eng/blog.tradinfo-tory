---
import indicators from '../data/indicators.json';
import Delta from './Delta.astro';

interface Props {
  /** 영문판(/en/)에서는 라벨과 기준일 표기를 영어로 바꾼다. */
  lang?: 'ko' | 'en';
}
const { lang = 'ko' } = Astro.props;
const isEn = lang === 'en';

// 라벨은 파이프라인이 만든 indicators.json 에서 온다. 대부분 기호(USD/KRW·WTI·KOSPI)라
// 그대로 쓰면 되고, 한국어인 둘만 갈아 끼운다. 사전에 없는 라벨은 원문 그대로 둔다
// (파이프라인이 항목을 늘려도 조용히 빈칸이 되지 않게 — 모르는 것은 지우지 않는다).
const EN_LABEL: Record<string, string> = {
  '美 10Y': 'US 10Y',
  '국고채 10Y': 'KTB 10Y',
};
// ★ 기준일은 **항목마다 다르다**(2026-09-01 수리). 그전에는 오른쪽에 고정 칩으로
//   「기준 08.31 종가」 하나만 띄웠는데, 그 08.31 은 **원/달러 하나의 최신일**이었다.
//   실측하면 WTI 08.25 · 美 10Y 08.28 로 며칠씩 다르다(FRED 계열이 늦게 온다).
//   여섯 값에 남의 날짜를 붙여 놓고 「종가」라고 부른 셈이라 절대 규칙 2 위반이었다.
//   이제 값 옆에 자기 날짜를 붙이고 고정 칩은 없앤다.
//   `asOf` 가 없는 옛 데이터로 빌드해도 깨지지 않게 전체 기준일로 물러선다
//   (파이프라인이 한 번 더 돌면 항목마다 채워진다).
const short = (d?: string) => (d ? d.slice(5).replace('-', '.') : '');
const items = indicators.ticker.map((t: any) => ({
  ...t,
  label: isEn ? (EN_LABEL[t.label] ?? t.label) : t.label,
  asOfShort: short(t.asOf ?? indicators.asOf),
}));
---

<div class="ticker" aria-label={isEn ? 'Market snapshot' : '주요 시세'}>
  <div class="tk-scroll">
    <div class="tk-track mono">
      {
        [0, 1].map((copy) => (
          <div class="tk-set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {items.map((t) => (
              <span class="tk">
                <span class="tk-label">{t.label}</span>
                <span class="tk-value">{t.value}</span>
                <Delta dir={t.dir as 'up' | 'down'} text={t.delta} onDark lang={lang} />
                <span class="tk-asof">{t.asOfShort}</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div class="tk-fixed mono" title={isEn ? 'Each figure carries its own reference date' : '숫자마다 기준일이 다릅니다'}>
    <span class="tk-fixed-label">{isEn ? 'close' : '종가'}</span>
  </div>
</div>

<style>
  .ticker {
    background: var(--dark-band);
    color: var(--dark-band-ink);
    overflow: hidden;
    display: flex;
    align-items: stretch;
  }
  /* 데스크톱에서는 내비게이션 아래에 고정, 지표가 스크롤과 무관하게 항상 보인다.
     모바일은 세로 공간을 아끼기 위해 고정하지 않는다. */
  @media (min-width: 860px) {
    .ticker {
      position: sticky;
      top: 56px;
      z-index: 49;
    }
  }
  .tk-scroll {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .tk-track {
    display: flex;
    width: max-content;
    animation: tk-scroll 48s linear infinite;
  }
  .ticker:hover .tk-track { animation-play-state: paused; }
  @keyframes tk-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .tk-set {
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 13px 15px;
    padding-right: 30px;
    font-size: 12px;
    white-space: nowrap;
  }
  .tk { display: inline-flex; align-items: center; gap: 6px; }
  .tk-label { color: var(--dark-band-sub); }
  .tk-value { font-weight: 500; }
  /* 값이 어느 날 것인지 바로 옆에 붙인다. 흐르는 띠라 항목과 떨어지면 짝이 안 보인다. */
  .tk-asof { color: var(--dark-band-sub); font-size: 10px; letter-spacing: 0.02em; }
  .tk-fixed {
    flex: none;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 15px 0 14px;
    font-size: 11px;
    white-space: nowrap;
    border-left: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: -14px 0 14px -6px var(--dark-band);
  }
  .tk-fixed-label { color: var(--dark-band-sub); font-size: 10px; }
  @media (prefers-reduced-motion: reduce) {
    .tk-track { animation: none; }
    .tk-scroll { overflow-x: auto; scrollbar-width: none; }
  }
</style>
