---
// 카툰 컷 + 캡션, 갈림길 등 연재 기사 본문용. img 는 /images/story/ 하위 파일명(확장자 제외).
import { url } from '../lib/site';
interface Props {
  img: string;
  alt?: string;
  cap?: string;
  quote?: boolean; // 인용 컷, 캡션을 경구체로 강조
}
const { img, alt = '', cap = '', quote = false } = Astro.props;
---
<figure class:list={['story-cut', quote ? 'is-quote' : '']}><img src={url(`/images/story/${img}.jpg`)} alt={alt} width="1200" height="896" loading="lazy" />{cap && <figcaption class:list={[quote ? 'serif' : '']}>{cap}</figcaption>}</figure><style>
  .story-cut { margin: 26px 0; }
  .story-cut img { width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--line); display: block; }
  .story-cut figcaption { margin-top: 10px; font-size: 14px; line-height: 1.8; color: var(--sub); word-break: keep-all; }
  .story-cut.is-quote figcaption { font-size: 16.5px; color: var(--ink); font-weight: 700; text-align: center; padding: 6px 12px 0; }
</style>
