---
// 공유 줄. 2026-08-31 신설.
//
// 왜 만들었나 — `docs/traffic.md` 가 짚은 최대 병목이 **외부 링크 0개·외부 채널 0개**인데,
// 기사 114편에 **공유 수단이 하나도 없었다.** 읽고 나서 남에게 건넬 방법이 없으면
// 유통은 검색 하나에만 걸린다.
//
// 무엇을 가져왔나 — 경쟁 사례(baeksang.dev)에서 배울 것은 「단순함」이 아니라
// **마찰 제거**다. 공유 문구를 사이트가 미리 써 주면 독자는 「이걸 뭐라고 소개하지」를
// 고민하지 않는다.
//
// ★ 2026-09-01 소유주 지시로 **담는 내용을 바꿨다.** 처음에는 그 기사의 세 줄 요약을
// 담았는데, 메신저가 링크를 카드로 펴면 **제목·설명·그림이 이미 카드에 나온다**
// (소유주 확인: 「기사 요약 내용이 그림 아래 나가더라」). 같은 말을 두 번 쓰는 셈이었고
// 정작 「이 블로그가 무엇인가」는 어디에도 없었다. 카드가 기사를 맡고, **글은 블로그를
// 맡는다** — 한 번 읽고 마는 사람에게 남길 것은 요약이 아니라 다시 올 이유다.
// 문구 정본은 `lib/site.ts` 의 `sharePitch()` 한 곳이다.
//
// 왜 카카오 SDK 가 아닌가 — SDK 는 Kakao Developers 앱 키가 필요하다(소유주 몫).
// `navigator.share` 는 키가 0개고, 모바일에서 네이티브 공유 시트를 띄우면
// **그 안에 카카오톡이 들어 있다.** 먼저 되는 것부터 낸다.
interface Props {
  title: string;
}
const { title } = Astro.props;
import { CANONICAL_ORIGIN, canonicalUrl, SITE, sharePitch } from '../lib/site';
// 계열 수는 손으로 적지 않고 **세어서** 넣는다(HomeTools 와 같은 방식).
const series = import.meta.glob('../../data/series/*.json', { eager: true });
const nSeries = Object.values(series).filter((s: any) => s?.default?.points?.length).length;
// 주소는 넘겨받지 않고 **현재 페이지에서 뽑는다** — canonical 과 같은 함수를 쓰므로
// 공유된 링크와 검색엔진이 보는 주소가 어긋날 수 없다.
const abs = canonicalUrl(Astro.url.pathname);
// 붙여넣기용 덩어리. 제목과 주소가 위, 블로그 소개 세 줄이 아래다.
// 카드가 펴지면 위쪽은 카드가 대신 말하고, 안 펴지는 자리(텍스트만 되는 방)에서는
// 제목이 그 몫을 한다. 어느 쪽이든 **소개 세 줄은 남는다.**
const pitch = sharePitch(nSeries);
const block = [title, abs, '', `[${SITE.name}]`, ...pitch.map((l) => `· ${l}`), CANONICAL_ORIGIN].join('\n');
---

<section class="sh" aria-labelledby="sh-h">
  <h2 id="sh-h" class="sh-h">공유</h2>
  <div class="sh-row">
    <button type="button" class="sh-btn sh-primary" data-share>단톡방·메신저로 보내기</button>
    <button type="button" class="sh-btn" data-copy>요약과 주소 복사</button>
  </div>
  <p class="sh-note" data-note>제목과 주소에 도토리경제 소개 세 줄을 함께 담습니다.</p>
</section>

<script define:vars={{ block, abs, title, sheetText: [`[${SITE.name}] ${SITE.taglineSub}`, ...pitch].join('\n') }}>
  // ★ 이 안에는 날 JS 를 그대로 쓴다(CLAUDE.md 함정 — 템플릿 리터럴로 감싸면 조용히 죽는다).
  var root = document.currentScript.previousElementSibling;
  var note = root.querySelector('[data-note]');
  var base = note.textContent;
  var timer = null;
  function say(msg) {
    note.textContent = msg;
    clearTimeout(timer);
    timer = setTimeout(function () { note.textContent = base; }, 2600);
  }
  function copy(text, ok) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () { say(ok); }, function () { say('복사하지 못했습니다. 주소창의 주소를 직접 복사해 주십시오.'); });
    } else {
      say('이 브라우저에서는 복사가 지원되지 않습니다. 주소창의 주소를 직접 복사해 주십시오.');
    }
  }
  root.querySelector('[data-share]').addEventListener('click', function () {
    if (navigator.share) {
      // 취소(AbortError)는 실패가 아니므로 아무 말도 하지 않는다.
      navigator.share({ title: title, text: sheetText, url: abs }).catch(function () {});
    } else {
      // 데스크톱에는 공유 시트가 없다. 붙여넣을 수 있게 덩어리째 넘긴다.
      copy(block, '복사했습니다. 단톡방에 붙여넣으시면 됩니다.');
    }
  });
  root.querySelector('[data-copy]').addEventListener('click', function () {
    copy(block, '복사했습니다.');
  });
</script>

<style>
  .sh { max-width: 880px; margin: 34px auto 0; padding-top: 22px; border-top: 1px solid var(--hair); }
  .sh-h { font-size: 12px; font-weight: 700; letter-spacing: 0.16em; color: var(--muted); margin: 0 0 13px; }
  .sh-row { display: flex; flex-wrap: wrap; gap: 9px; }
  .sh-btn {
    font: inherit;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 11px 18px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .sh-btn:hover { border-color: var(--brand); color: var(--brand); }
  .sh-primary { background: var(--brand); border-color: var(--brand); color: #fff; }
  .sh-primary:hover { background: var(--brand-hover); border-color: var(--brand-hover); color: #fff; }
  .sh-note { font-size: 12.5px; color: var(--muted); margin: 11px 0 0; line-height: 1.75; word-break: keep-all; }
  @media (max-width: 640px) {
    .sh-row { flex-direction: column; }
    .sh-btn { width: 100%; }
  }
</style>
