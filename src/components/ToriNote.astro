---
// 토리의 한 마디, 기사 맺음 코멘트 (감사 인사 포즈)
import Pic from './Pic.astro';
import { url } from '../lib/site';
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<aside class="tori-note" aria-label="토리의 한 마디">
  <Pic path="pose-06.jpg" alt="가슴에 손을 얹고 인사하는 토리" width={64} height={64} />
  <div>
    <div class="tn-title">토리의 한 마디</div>
    <div class="tn-text">{text}</div>
  </div>
</aside>

<style>
  .tori-note {
    max-width: var(--w-prose);
    margin: 48px auto 0 auto;
    background: var(--hair2);
    border: 1px solid var(--hair);
    padding: 22px 26px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .tori-note img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 20%;
    border: 1px solid var(--hair);
    flex-shrink: 0;
  }
  .tn-title { font-size: 13px; font-weight: 700; margin-bottom: 6px; }
  .tn-text { font-size: 14.5px; line-height: 1.75; color: var(--sub); }
</style>
