---
// 문답형 요약 블록 — `상식 사전`(basics)의 요약 장치.
//
// 왜 만들었나: 발행분 69편의 **PointCards 사용률이 네 분야 모두 100%** 였다(2026-08-28 실측).
// 규칙을 분야별로 갈라도 요약 장치가 하나뿐이면 결국 같은 모양이 된다.
// 개념 설명글에는 아이콘 카드보다 **묻고 답하는 결**이 맞는다 — 입문자가 실제로 갖는
// 물음의 순서를 그대로 따라가기 때문이다.
//
// 사용: <AskBlock items={[{q:'코픽스가 무엇인가', a:'은행이 자금을 조달한 평균 비용이다.'}, ...]} />
//
// PointCards 와 다른 점: 아이콘이 없고, 제목이 **물음표로 끝나는 질문**이고,
// 세로 목록이라 읽는 순서가 강제된다(카드 그리드는 눈이 아무 데나 먼저 간다).
interface Item {
  q: string;
  a: string;
}
interface Props {
  items: Item[];
  /** 블록 위에 붙이는 라벨. 기본은 「짚고 갈 것」 */
  label?: string;
}
const { items, label = '짚고 갈 것' } = Astro.props;
---

<section class="ask">
  <div class="ask-label">{label}</div>
  <dl class="ask-list">
    {
      items.map((it) => (
        <div class="ask-row">
          <dt class="ask-q">{it.q}</dt>
          <dd class="ask-a" set:html={it.a} />
        </div>
      ))
    }
  </dl>
</section>

<style>
  .ask {
    margin: 30px auto;
    max-width: var(--measure);
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--hair);
    padding: 14px 0 4px;
  }
  .ask-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .ask-list { margin: 0; }
  .ask-row { padding: 11px 0; border-top: 1px solid var(--hair2); }
  .ask-row:first-child { border-top: 0; }
  /* 질문은 세리프로 세워 본문과 결을 맞추고, 답은 산세리프로 낮춘다.
     같은 서체로 두면 문답이 한 덩어리로 뭉쳐 읽힌다. */
  .ask-q {
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.55;
    word-break: keep-all;
  }
  .ask-a {
    margin: 5px 0 0;
    font-size: 14.5px;
    color: var(--body-ink);
    line-height: 1.85;
    word-break: keep-all;
  }
  @media (max-width: 560px) {
    .ask-q { font-size: 15px; }
    .ask-a { font-size: 14px; }
  }
</style>
