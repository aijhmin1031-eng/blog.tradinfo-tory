---
// 협업 카드. 뉴스레터 구독 폼이 있던 자리(기사 끝·푸터·창고 코너)를 대신한다.
// 용역을 받겠다는 자리가 아니다. 같은 문제를 다루는 사람과 강의·자문·공동 개발로 만나는 창구다.
// variant: 'inline'(밝은 카드, 본문 흐름 안) | 'footer'(어두운 지면, 푸터)
import { url } from '../lib/site';

interface Props {
  variant?: 'inline' | 'footer';
  /** 어디에서 눌렀는지 구분해 문의 메일 제목에 남긴다 */
  source?: string;
}
const { variant = 'footer', source = 'site' } = Astro.props;
---

<div class:list={['cb', variant]} data-source={source}>
  <div class="cb-body">
    <div class="cb-title serif">협업 문의</div>
    <p class="cb-sub">
      매일 아침 스스로 지표를 거둬 기사와 대시보드로 바꾸는 구조로 굴러갑니다.
      그 과정에서 쌓인 것이 쓸 만한 자리가 있다면 메일 한 통이면 됩니다.
    </p>
    {/* ★ 2026-08-31: 주소를 그대로 드러낸다. 그전에는 `/contact/` 로 한 번 보내야
        주소가 보였고, 그 클릭 하나가 문의를 잃는 자리였다.
        주소는 스팸 수집기를 피해 런타임에 조립한다(contact.astro 와 같은 방식). */}
    <p class="cb-mail"><span class="cb-mail-slot" data-mail /></p>
  </div>
  <a class="cb-cta" href={url('/contact/')}>협업 안내 보기</a>
</div>

<script>
  // 스팸 수집기 회피를 위해 주소를 런타임에 조립한다(정적 HTML 에 문자열로 남기지 않는다).
  var addr = ['dotori', 'workroom'].join('.') + '@' + ['gmail', 'com'].join('.');
  document.querySelectorAll('[data-mail]').forEach(function (slot) {
    var a = document.createElement('a');
    a.href = 'mailto:' + addr + '?subject=' + encodeURIComponent('[도토리경제] 협업 문의');
    a.textContent = addr;
    slot.appendChild(a);
  });
</script>

<style>
  .cb { border-radius: 14px; padding: 26px 28px; display: flex; gap: 28px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .cb.inline { background: var(--surface); border: 1px solid var(--line); margin: 34px auto; max-width: 880px; }
  .cb.footer { background: transparent; border: 0; padding: 0; }
  .cb-body { flex: 1 1 340px; min-width: 0; max-width: 620px; }
  .cb-title { font-size: 18px; font-weight: 900; color: var(--ink); letter-spacing: -0.01em; }
  .cb.footer .cb-title { color: #fff; }
  .cb-sub { font-size: 13px; line-height: 1.85; color: var(--sub); margin-top: 8px; word-break: keep-all; }
  .cb-mail { margin: 12px 0 0; font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
  /* ★ 스코프 CSS 함정의 넷째 얼굴 — **JS 로 만든 요소에는 스코프 클래스가 없다.**
     Astro 는 `.cb-mail a` 를 `.cb-mail a:where(.astro-…)` 로 컴파일하는데, 이 `<a>` 는
     스팸 회피 때문에 런타임에 만들어지므로 그 클래스가 없어 **색 규칙이 통째로 죽는다.**
     빌드도 통과하고 주소도 보여서, 계산값(color)을 찍어야만 갈렸다. `:global()` 로 감싼다. */
  .cb-mail :global(a) { color: var(--brand); border-bottom: 1px solid transparent; }
  .cb-mail :global(a:hover) { border-bottom-color: var(--brand); }
  .cb.footer .cb-mail :global(a) { color: #fff; }
  .cb.footer .cb-mail :global(a:hover) { border-bottom-color: rgba(255, 255, 255, 0.6); }
  .cb.footer .cb-sub { color: rgba(255, 255, 255, 0.72); }
  .cb-list { list-style: none; padding: 0; margin: 12px 0 0; }
  .cb-list li { font-size: 12.5px; line-height: 1.85; color: var(--sub); word-break: keep-all; }
  .cb-list li::before { content: '·'; margin-right: 7px; color: var(--accent); font-weight: 900; }
  .cb.footer .cb-list li { color: rgba(255, 255, 255, 0.72); }
  .cb-cta { flex: 0 0 auto; align-self: center; background: var(--brand); color: #fff; font-size: 13.5px; font-weight: 700; padding: 13px 26px; border-radius: 4px; white-space: nowrap; }
  @media (max-width: 620px) { .cb { padding: 20px 20px; gap: 18px; } .cb-cta { width: 100%; text-align: center; } }
  .cb-cta:hover { background: var(--brand-hover); color: #fff; }
  .cb.footer .cb-cta { background: var(--accent); }
  .cb.footer .cb-cta:hover { filter: brightness(1.08); }
</style>
