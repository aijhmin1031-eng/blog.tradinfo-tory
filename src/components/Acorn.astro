---
// 도토리경제 심볼, 도토리 마크
// 줄기 / 깍정이(질감 아크) / 열매(하이라이트) 3부 구성. 색은 프롭으로 제어.
interface Props {
  size?: number;
  cap?: string;
  body?: string;
  label?: string;
}
const {
  size = 24,
  cap = 'var(--ink)',
  body = 'var(--accent)',
  label = '도토리경제 도토리 심볼',
} = Astro.props;
const h = Math.round((size * 28) / 24);
---

<svg
  width={size}
  height={h}
  viewBox="0 0 24 28"
  role="img"
  aria-label={label}
  style="display:block;flex-shrink:0;"
>
  <path
    d="M12.7 0.9 C11.7 1.7 11.4 2.6 11.9 3.6"
    fill="none"
    stroke={cap}
    stroke-width="1.7"
    stroke-linecap="round"></path>
  <path
    d="M12 3.1 C7 3.1 3.3 6.1 2.7 10.2 C2.6 10.9 3.1 11.5 3.8 11.5 L20.2 11.5 C20.9 11.5 21.4 10.9 21.3 10.2 C20.7 6.1 17 3.1 12 3.1 Z"
    fill={cap}></path>
  <path
    d="M6.2 6.6 C7.8 5.1 9.8 4.3 12 4.3 M4.6 9 C5 7.9 5.7 6.9 6.6 6.1"
    fill="none"
    stroke="rgba(255,255,255,0.32)"
    stroke-width="1.1"
    stroke-linecap="round"></path>
  <path
    d="M4.2 13 C4.9 19.3 7.8 24.1 11.3 26.2 C11.75 26.5 12.25 26.5 12.7 26.2 C16.2 24.1 19.1 19.3 19.8 13 Z"
    fill={body}></path>
  <path
    d="M6.5 14.2 C7.1 18.6 8.9 22 11 23.8"
    fill="none"
    stroke="rgba(255,255,255,0.34)"
    stroke-width="1.5"
    stroke-linecap="round"></path>
</svg>
