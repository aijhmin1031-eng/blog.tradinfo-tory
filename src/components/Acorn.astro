---
// 도토리경제 심볼, 도토리 마크
//
// 2026-08-27 재작도(소유주 지적: 작은 크기에서 품질이 낮다).
// 이전 판의 결함은 셋이었다.
//   ① **깍정이와 열매 사이에 1.5단위 틈**이 있어(깍정이 밑변 11.5, 열매 윗변 13)
//      17~22px 에서 검은 덩어리와 주황 덩어리가 따로 놀았다. 지금은 열매를 깍정이 **밑으로
//      밀어 넣고** 깍정이를 나중에 그려 이음매를 덮는다.
//   ② 하이라이트 선이 알파 0.32~0.34 라 작은 크기에서는 보이지 않으면서 화소만 흐렸다.
//      크기에 따라 **디테일을 켜고 끈다**(28px 이상에서만 질감·하이라이트).
//   ③ 깍정이 밑변이 직선이라 접시처럼 보였다. 얕은 아치로 바꿔 열매를 물게 했다.
interface Props {
  size?: number;
  cap?: string;
  body?: string;
  label?: string;
}
const {
  size = 24,
  cap = 'var(--ink)',
  body = 'var(--accent)',
  label = '도토리경제 도토리 심볼',
} = Astro.props;
const h = Math.round((size * 28) / 24);
// 작은 마크에 잔선을 넣으면 뭉갠 것처럼 보인다. 큰 자리에서만 질감을 준다.
const detail = size >= 28;
---

<svg
  width={size}
  height={h}
  viewBox="0 0 24 28"
  role="img"
  aria-label={label}
  style="display:block;flex-shrink:0;"
>
  {/* 줄기. 짧고 곧게. 길면 큰 크기에서 갈고리처럼 보인다. */}
  <path
    d="M12.0 1.5 C12.8 2.1 13.0 3.0 12.6 4.1"
    fill="none"
    stroke={cap}
    stroke-width="1.7"
    stroke-linecap="round"></path>

  {/* 열매 — 어깨를 부풀리고 끝을 둥글게 남긴다. 윗변 10.4 로 깍정이 밑에 물린다. */}
  <path
    d="M4.8 10.4 C4.8 11.7 5.0 13.1 5.4 14.7
       C6.4 19.5 8.6 23.6 11.1 25.9 C11.6 26.4 12.4 26.4 12.9 25.9
       C15.4 23.6 17.6 19.5 18.6 14.7 C19.0 13.1 19.2 11.7 19.2 10.4 Z"
    fill={body}></path>

  {detail && (
    <path
      d="M7.4 13.2 C7.9 17.8 9.4 21.4 11.1 23.4"
      fill="none"
      stroke="rgba(255,255,255,0.36)"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  )}

  {/* 깍정이 — 낮은 베레모. 이전 판은 갓이 높고 넓어 버섯으로 읽혔다. */}
  <path
    d="M12 4.4 C7.6 4.4 4.2 6.8 3.6 10.2 C3.5 10.9 4.0 11.4 4.7 11.4
       L19.3 11.4 C20.0 11.4 20.5 10.9 20.4 10.2 C19.8 6.8 16.4 4.4 12 4.4 Z"
    fill={cap}></path>

  {detail && (
    <path
      d="M6.6 7.6 C8.1 6.2 9.9 5.5 12 5.5 M5.0 9.6 C5.3 8.7 5.8 7.9 6.5 7.2"
      fill="none"
      stroke="rgba(255,255,255,0.30)"
      stroke-width="1.2"
      stroke-linecap="round"></path>
  )}
</svg>
