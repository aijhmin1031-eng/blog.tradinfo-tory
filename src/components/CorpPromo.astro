---
/**
 * 기업 분석 자체 광고 배너 — 2026-09-03 소유주 지시.
 *
 * 「우리 블로그를 살릴 수 있는 핵심 콘텐츠」라는 판단으로 기업 분석을 홈 맨 위에 올렸다.
 * 그 자리를 **광고**가 채운다. 다만 우리가 우리를 광고하는 것이므로 과장하지 않는다 —
 * 파는 것이 아니라 **무엇을 하는 방인지 보여 주는 것**이 이 배너의 일이다.
 *
 * ★ 회사 목록은 `corps` 컬렉션에서 직접 읽는다. 손으로 적어 두면 낱장이 늘 때 여기만 낡는다.
 * ★ 한 줄 요약은 제목의 가운뎃점 뒤를 쓴다(제목이 이미 「회사명 · 발견」 꼴이다).
 *   그래서 프런트매터에 홍보 문구를 따로 두지 않았다 — 두 곳에 같은 말을 두면 갈린다.
 */
import { getCollection } from 'astro:content';
import Pic from './Pic.astro';
import { url } from '../lib/site';

interface Props {
  /** 홈처럼 배경이 밝은 자리에서 위아래 여백을 줄일 때 */
  compact?: boolean;
}
const { compact = false } = Astro.props as Props;

const corps = (await getCollection('corps', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);
// 제목 「회사명 · 발견」 에서 뒤쪽만 떼어 한 줄 요약으로 쓴다.
const finding = (title: string, name: string) => {
  const i = title.indexOf('·');
  return i > -1 ? title.slice(i + 1).trim() : title.replace(name, '').trim();
};
---

{corps.length > 0 && (
  <section class:list={['promo wrap', { compact }]} aria-labelledby="promo-h">
    <div class="promo-box">
      <div class="promo-text">
        <div class="promo-tag">기업 분석<span class="promo-new">신설</span></div>
        <h2 id="promo-h" class="promo-h serif">
          공시 원문을 열어, 숫자를 해부합니다
        </h2>
        <p class="promo-dek">
          시장이 붙인 이름표와 회사가 금융감독원에 <strong>직접 제출한 표</strong>를 나란히 놓습니다.
          어긋나는 자리를 찾는 것이 이 방이 하는 일입니다.
        </p>

        <ul class="promo-list">
          {corps.map((c) => (
            <li>
              <a href={url(`/corp/${c.id}/`)}>
                <span class="pl-name">{c.data.name}</span>
                <span class="pl-find">{finding(c.data.title, c.data.name)}</span>
                <span class="pl-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="promo-foot">
          <a class="promo-cta" href={url('/corp/')}>기업 분석 전체 보기</a>
          <span class="promo-note">종목 추천·목표주가는 쓰지 않습니다</span>
        </div>
      </div>

      <a class="promo-art" href={url('/corp/')} aria-hidden="true" tabindex="-1">
        <Pic path="corp-banner.jpg" alt="" width={800} height={450} />
      </a>
    </div>
  </section>
)}

<style>
  .promo { margin-top: 26px; }
  .promo.compact { margin-top: 16px; }

  .promo-box {
    border: 1px solid var(--hair);
    border-top: 3px solid var(--accent);
    border-radius: 4px;
    background: var(--surface);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: stretch;
    overflow: hidden;
  }

  .promo-text { padding: 22px 24px 20px; min-width: 0; }

  .promo-tag {
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.06em;
    color: var(--accent); display: flex; align-items: center; gap: 7px;
  }
  .promo-new {
    border: 1px solid var(--accent); border-radius: 3px;
    padding: 1px 5px; font-size: 10px; letter-spacing: 0.02em;
  }

  .promo-h { margin: 8px 0 0; font-size: clamp(1.3rem, 3.2vw, 1.72rem); line-height: 1.32; letter-spacing: -0.01em; }
  .promo-dek { margin: 9px 0 0; font-size: 0.92rem; line-height: 1.7; color: var(--sub); word-break: keep-all; }
  .promo-dek strong { color: var(--body-ink); font-weight: 600; }

  .promo-list { margin: 16px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--hair2); }
  .promo-list li { border-bottom: 1px solid var(--hair2); }
  .promo-list a {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline; gap: 10px;
    padding: 10px 2px; text-decoration: none; color: inherit;
  }
  .pl-name { font-weight: 700; font-size: 0.9rem; white-space: nowrap; }
  .pl-find { font-size: 0.86rem; color: var(--sub); line-height: 1.5; word-break: keep-all; }
  .pl-arrow { color: var(--accent); font-size: 0.9rem; }
  .promo-list a:hover .pl-name,
  .promo-list a:hover .pl-find { color: var(--accent); }

  .promo-foot { margin-top: 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .promo-cta {
    display: inline-block; padding: 8px 16px;
    background: var(--brand); color: #fff; text-decoration: none;
    border-radius: 3px; font-size: 0.88rem; font-weight: 700;
  }
  .promo-cta:hover { background: var(--brand-hover); }
  .promo-note { font-size: 0.76rem; color: var(--sub); }

  /* ★ 그림은 장식이므로 alt 를 비우고 aria-hidden 을 걸었다(왼쪽 글에 같은 내용이 있다).
     크기 규칙은 :global 로 자식 컴포넌트의 img 에 닿게 한다(스코프 CSS 함정 ①).
     ★ object-fit 은 cover 가 아니라 **contain** 이다. 이 그림은 「여섯은 닫혔고 하나만 갈렸다」가
     전부라서 바깥 도토리가 잘리면 뜻이 무너진다(cover 로 두었더니 실제로 잘렸다).
     여백이 생기는 만큼 바탕을 **그림의 종이색과 같은 값**으로 칠해 이음매를 없앴다(실측 #FCF6E4). */
  .promo-art { display: block; border-left: 1px solid var(--hair2); background: #F9F2E2; }
  .promo-art :global(img) { width: 100%; height: 100%; object-fit: contain; display: block; }

  @media (max-width: 760px) {
    .promo-box { grid-template-columns: 1fr; }
    /* 좁은 화면에서는 그림을 위로 올리고 높이를 눌러 글이 먼저 보이게 한다. */
    .promo-art { order: -1; border-left: 0; border-bottom: 1px solid var(--hair2); }
    /* 좁은 화면에서는 높이를 풀어 원본 비율(16:9) 그대로 앉힌다. */
    .promo-art :global(img) { height: auto; }
    .promo-text { padding: 18px 16px 16px; }
  }
</style>
