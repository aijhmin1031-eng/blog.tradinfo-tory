---
import indicators from '../data/indicators.json';
import Delta from './Delta.astro';
import Spark from './Spark.astro';
---

<div class="tiles">
  <div class="tiles-head kicker">오늘의 지표</div>
  {
    indicators.tiles.map((t) => (
      <div class="tile">
        <div class="tile-info">
          <div class="tile-label">{t.label}</div>
          <div class="tile-row">
            <span class="tile-value mono">{t.value}</span>
            <Delta dir={t.dir as 'up' | 'down'} text={t.delta} />
          </div>
        </div>
        <Spark spark={t.spark} dir={t.dir as 'up' | 'down'} hi={t.sparkHi} lo={t.sparkLo} />
      </div>
    ))
  }
  <div class="tiles-asof mono">기준 {indicators.asOf} · 한국은행 ECOS · 美 FRED</div>
</div>

<style>
  .tiles { display: flex; flex-direction: column; }
  .tiles-head {
    color: var(--sub);
    border-bottom: 1px solid var(--hair);
    padding-bottom: 9px;
    font-size: 11px;
  }
  .tile {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 15px 0;
    border-bottom: 1px solid var(--hair2);
  }
  .tile-label { font-size: 12px; color: var(--sub); margin-bottom: 3px; }
  .tile-row { display: flex; align-items: baseline; gap: 9px; }
  .tile-value { font-size: 19px; font-weight: 500; }
  .tiles-asof { font-size: 10px; color: var(--muted); padding-top: 11px; }
</style>

<script>
  // 지표 숫자 카운트업, 화면에 들어올 때 0부터 실제 값까지
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const animateValue = (el: Element) => {
    const text = (el.textContent || '').trim();
    const m = text.match(/-?[\d,]+(\.\d+)?/);
    if (!m || m.index === undefined) return;
    const target = parseFloat(m[0].replace(/,/g, ''));
    const frac = (m[0].split('.')[1] || '').length;
    const prefix = text.slice(0, m.index);
    const suffix = text.slice(m.index + m[0].length);
    const t0 = performance.now();
    const D = 950;
    const step = (now: number) => {
      const p = Math.min(1, (now - t0) / D);
      const v = target * easeOut(p);
      el.textContent =
        prefix +
        v.toLocaleString('ko-KR', { minimumFractionDigits: frac, maximumFractionDigits: frac }) +
        suffix;
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            animateValue(e.target);
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.6 }
    );
    document.querySelectorAll('.tile-value').forEach((el) => io.observe(el));
  }
</script>
