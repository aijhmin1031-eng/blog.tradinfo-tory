---
/**
 * 구조 도해 — 「무엇이 들어와서 무엇으로 나가는가」를 한 줄로 보인다.
 * 수치가 없는 자리가 아니라, **각 갈래에 매출과 비중을 적어** 구조와 크기를 함께 읽게 한다.
 */
interface Out { name: string; value: string; pct: string; slot: number; hi?: boolean }
interface Props {
  title: string; inputs: { name: string; value: string }[]; core: string; coreNote?: string;
  outputs: Out[]; source: string; note?: string;
}
const { title, inputs, core, coreNote, outputs, source, note } = Astro.props as Props;
---

<figure class="fig">
  <figcaption class="fig-t">{title}</figcaption>
  <div class="flow">
    <div class="col in">
      <div class="coltag">들어오는 것 · 원재료</div>
      {inputs.map((x) => (
        <div class="chip"><span class="cn">{x.name}</span><span class="cv">{x.value}</span></div>
      ))}
    </div>
    <div class="arrow" aria-hidden="true"><span /></div>
    <div class="col core">
      <div class="corebox">
        <strong>{core}</strong>
        {coreNote && <span>{coreNote}</span>}
      </div>
    </div>
    <div class="arrow" aria-hidden="true"><span /></div>
    <div class="col out">
      <div class="coltag">나가는 것 · 전방 산업별 매출</div>
      {outputs.map((o) => (
        <div class={`chip o s${o.slot} ${o.hi ? 'hi' : ''}`}>
          <span class="cn">{o.name}</span>
          <span class="cv">{o.value} <b>{o.pct}</b></span>
        </div>
      ))}
    </div>
  </div>
  <p class="fig-s">{note && <span class="fig-note">{note} · </span>}자료: {source}</p>
</figure>

<style>
  .fig { margin: 26px 0; }
  .fig-t { font-weight: 700; font-size: 15px; color: var(--ink); margin-bottom: 10px; word-break: keep-all; }
  .flow { display: grid; grid-template-columns: 1fr 22px 1.05fr 22px 1.15fr; gap: 6px; align-items: center; }
  .coltag { font-size: 10.5px; color: var(--muted); margin-bottom: 6px; letter-spacing: 0.01em; }
  .chip { display: flex; justify-content: space-between; align-items: baseline; gap: 8px;
    border: 1px solid var(--hair); border-radius: 5px; padding: 7px 9px; margin-bottom: 5px; background: var(--surface); }
  .cn { font-size: 12.5px; font-weight: 700; color: var(--ink); word-break: keep-all; }
  .cv { font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cv b { color: var(--ink); font-size: 12.5px; }
  .chip.o { border-left-width: 4px; }
  .chip.o.hi { border-color: var(--ink); box-shadow: 0 0 0 1px var(--ink) inset; }
  .corebox { border: 1.5px solid var(--brand); border-radius: 6px; padding: 14px 10px; text-align: center; background: var(--surface); }
  .corebox strong { display: block; font-size: 13.5px; color: var(--brand); word-break: keep-all; }
  .corebox span { display: block; font-size: 11px; color: var(--muted); margin-top: 4px; word-break: keep-all; }
  .arrow { display: flex; justify-content: center; }
  .arrow span { display: block; width: 100%; height: 2px; background: var(--hair); position: relative; }
  .arrow span::after { content: ''; position: absolute; right: -1px; top: -3px; border-left: 6px solid var(--hair); border-top: 4px solid transparent; border-bottom: 4px solid transparent; }
  .chip.o.s0 { border-left-color: #2a78d6; } .chip.o.s1 { border-left-color: #eb6834; }
  .chip.o.s2 { border-left-color: #1baf7a; } .chip.o.s3 { border-left-color: #eda100; }
  .chip.o.s4 { border-left-color: #e87ba4; }
  .fig-s { font-size: 11.5px; color: var(--muted); margin-top: 10px; line-height: 1.55; word-break: keep-all; }
  .fig-note { color: var(--sub); }
  @media (max-width: 560px) {
    .flow { grid-template-columns: 1fr; }
    .arrow { height: 18px; } .arrow span { width: 2px; height: 100%; }
    .arrow span::after { right: -3px; top: auto; bottom: -1px; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 6px solid var(--hair); border-bottom: 0; }
  }
</style>
