---
/**
 * 대조군 — 같은 이름표를 단 두 대상을 같은 축에 나란히 놓는다.
 * 반증 시도를 그림으로 보이는 자리다.
 */
interface Side { name: string; sub?: string; pct: number; value: string; rest: string }
interface Props { title: string; metric: string; left: Side; right: Side; verdict: string; source: string }
const { title, metric, left, right, verdict, source } = Astro.props as Props;
const bar = (s: Side) => Math.max(2, Math.min(100, s.pct));
---

<figure class="fig">
  <figcaption class="fig-t">{title}</figcaption>
  <p class="vs-m">{metric}</p>
  {[left, right].map((s) => (
    <div class="vs-row">
      <div class="vs-head">
        <span class="vs-n">{s.name}{s.sub && <em>{s.sub}</em>}</span>
        <span class="vs-p">{s.pct}%</span>
      </div>
      <div class="vs-track">
        <div class="vs-fill" style={`width:${bar(s)}%`} />
      </div>
      <div class="vs-foot"><span>{s.value}</span><span>{s.rest}</span></div>
    </div>
  ))}
  <p class="vs-v">{verdict}</p>
  <p class="fig-s">자료: {source}</p>
</figure>

<style>
  .fig { margin: 26px 0; }
  .fig-t { font-weight: 700; font-size: 15px; color: var(--ink); margin-bottom: 4px; word-break: keep-all; }
  .vs-m { font-size: 12px; color: var(--muted); margin: 0 0 14px; }
  .vs-row { margin-bottom: 16px; }
  .vs-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 5px; }
  .vs-n { font-size: 13.5px; font-weight: 700; color: var(--ink); }
  .vs-n em { font-style: normal; font-weight: 500; font-size: 11.5px; color: var(--muted); margin-left: 6px; }
  .vs-p { font-size: 20px; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .vs-track { height: 14px; background: var(--hair2); border-radius: 3px; overflow: hidden; }
  .vs-fill { height: 100%; background: #1baf7a; border-radius: 3px; }
  .vs-foot { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--muted); margin-top: 5px; }
  .vs-v { font-size: 13px; color: var(--body-ink); border-left: 3px solid var(--accent); padding-left: 11px; margin: 18px 0 0; word-break: keep-all; line-height: 1.65; }
  .fig-s { font-size: 11.5px; color: var(--muted); margin-top: 12px; }
  :root[data-theme='dark'] .vs-fill { background: #199e70; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .vs-fill { background: #199e70; } }
</style>
