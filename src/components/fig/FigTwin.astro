---
/**
 * 두 지표의 시계열 — **위아래 두 패널로 나누고 x축만 공유한다.**
 *
 * ★ 이중 축(y축 두 개)을 쓰지 않는다. 규모가 다른 두 지표를 한 축에 겹치면
 *   두 선의 교차점이 아무 뜻도 없는데 뜻이 있는 것처럼 읽힌다. 패널을 나누는 것이 정답이다.
 * ★ 값을 모든 점에 적지 않는다. 최고·최저·마지막만 직접 라벨한다.
 */
interface Panel { name: string; unit: string; values: number[]; marks?: number[]; zero?: boolean }
interface Props { title: string; labels: string[]; panels: Panel[]; source: string; note?: string }
const { title, labels, panels, source, note } = Astro.props as Props;
const W = 720, LEFT = 54, RIGHT = 44, PH = 128, PGAP = 34, TOP = 16;
const plotW = W - LEFT - RIGHT;
const H = TOP + panels.length * (PH + PGAP) + 16;
const fmt = (v: number) => v.toLocaleString('ko-KR');
const geo = panels.map((p) => {
  const lo = Math.min(0, ...p.values), hi = Math.max(0, ...p.values);
  const pad = (hi - lo) * 0.12 || 1;
  return { lo: lo - (lo < 0 ? pad : 0), hi: hi + pad };
});
---

<figure class="fig">
  <figcaption class="fig-t">{title}</figcaption>
  <div class="fig-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title}. ${panels.map((p) => `${p.name} ${p.values.at(-1)}${p.unit}`).join(', ')}`}>
      {panels.map((p, pi) => {
        const g = geo[pi];
        const top = TOP + pi * (PH + PGAP);
        const y = (v: number) => top + PH - ((v - g.lo) / (g.hi - g.lo)) * PH;
        const bw = plotW / p.values.length;
        const zeroY = y(0);
        return (
          <g>
            <text class="pname" x={LEFT} y={top - 4}>{p.name}<tspan class="punit"> ({p.unit})</tspan></text>
            <line class="axis" x1={LEFT} y1={zeroY} x2={LEFT + plotW} y2={zeroY} />
            {p.values.map((v, i) => {
              const cx = LEFT + i * bw;
              const h = Math.abs(y(v) - zeroY);
              const neg = v < 0;
              return (
                <rect x={cx + 1.5} y={neg ? zeroY : y(v)} width={Math.max(bw - 3, 1)} height={Math.max(h, 1)} rx="2"
                      class={neg ? 'bar neg' : 'bar pos'} />
              );
            })}
            {(p.marks ?? []).map((i) => {
              const v = p.values[i];
              const cx = LEFT + i * bw + bw / 2;
              const ly = v < 0 ? y(v) + 13 : y(v) - 5;
              return <text class="vlab" x={cx} y={ly} text-anchor="middle">{fmt(v)}</text>;
            })}
            <text class="endlab" x={LEFT + plotW + 6} y={y(p.values.at(-1)!)} dominant-baseline="middle">{fmt(p.values.at(-1)!)}</text>
          </g>
        );
      })}
      {labels.map((t, i) => t && (
        <text class="xlab" x={LEFT + (i + 0.5) * (plotW / labels.length)} y={H - 2} text-anchor="middle">{t}</text>
      ))}
    </svg>
  </div>
  <p class="fig-s">{note && <span class="fig-note">{note} · </span>}자료: {source}</p>
</figure>

<style>
  .fig { margin: 26px 0; }
  .fig-t { font-weight: 700; font-size: 15px; color: var(--ink); margin-bottom: 10px; word-break: keep-all; }
  .fig-scroll { overflow-x: auto; }
  .fig-scroll svg { width: 100%; min-width: 500px; height: auto; display: block; }
  .pname { font-size: 12.5px; font-weight: 700; fill: var(--ink); }
  .punit { font-weight: 500; fill: var(--muted); }
  .axis { stroke: var(--hair); stroke-width: 1; }
  .bar.pos { fill: var(--up); }
  .bar.neg { fill: var(--down); }
  .vlab { font-size: 11px; font-weight: 700; fill: var(--sub); }
  .endlab { font-size: 12px; font-weight: 700; fill: var(--ink); }
  .xlab { font-size: 11px; fill: var(--muted); }
  .fig-s { font-size: 11.5px; color: var(--muted); margin-top: 10px; line-height: 1.55; word-break: keep-all; }
  .fig-note { color: var(--sub); }
</style>
