---
// 결론형 제목의 선 그래프 (빌드 타임 SVG 렌더)
// - 단일 시리즈: 범례 없음, 제목이 결론을 말한다 (Chartr 원칙)
// - 스크롤 도달 시 선이 그려지는 애니메이션 (reduced-motion 시 정지)
interface Props {
  title: string; // 결론형 제목: "관세에도 반도체 수출은 18% 늘었다"
  unit?: string;
  values: number[];
  xLabels?: { idx: number; text: string }[];
  yTicks?: number[];
  source: string;
  color?: 'down' | 'up' | 'accent';
  endLabel?: string;
  height?: number;
}
const {
  title,
  unit = '',
  values,
  xLabels = [],
  yTicks = [],
  source,
  color = 'down',
  endLabel = '',
  height = 250,
} = Astro.props;

const W = 720;
const H = height + 50;
const padL = 52;
const padR = 30;
const padT = 24;
const plotH = height - 10;
const min = Math.min(...values, ...(yTicks.length ? yTicks : values));
const max = Math.max(...values, ...(yTicks.length ? yTicks : values));
const span = max - min || 1;
const xs = values.map((_, i) => padL + (i * (W - padL - padR)) / (values.length - 1));
const ys = values.map((v) => padT + plotH - ((v - min) / span) * plotH);
const points = xs.map((x, i) => `${x.toFixed(1)},${ys[i].toFixed(1)}`).join(' ');
const tickY = (v: number) => padT + plotH - ((v - min) / span) * plotH;
const strokeVar =
  color === 'up' ? 'var(--up)' : color === 'accent' ? 'var(--accent)' : 'var(--down)';
const fmt = (v: number) => v.toLocaleString('ko-KR');
---

<figure class="chart card" data-chart>
  <figcaption class="chart-head">
    <span class="chart-title">{title}</span>
    {unit && <span class="chart-unit mono">단위: {unit}</span>}
  </figcaption>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={title}
    style="width:100%;height:auto;display:block;"
  >
    {yTicks.map((t) => (
      <>
        <line
          x1={padL}
          y1={tickY(t)}
          x2={W - padR}
          y2={tickY(t)}
          stroke="var(--chart-grid)"
          stroke-width="1"
        />
        <text
          x={padL - 8}
          y={tickY(t) + 3}
          text-anchor="end"
          style="font-family:var(--font-mono);font-size:10px;fill:var(--muted);"
        >
          {fmt(t)}
        </text>
      </>
    ))}
    <line
      x1={padL}
      y1={padT + plotH + 12}
      x2={W - padR}
      y2={padT + plotH + 12}
      stroke="var(--chart-axis)"
      stroke-width="1"></line>
    {xLabels.map((l) => (
      <text
        x={xs[l.idx]}
        y={padT + plotH + 30}
        text-anchor="middle"
        style="font-family:var(--font-mono);font-size:10px;fill:var(--muted);"
      >
        {l.text}
      </text>
    ))}
    <polyline
      class="chart-line"
      points={points}
      fill="none"
      stroke={strokeVar}
      stroke-width="2"
      stroke-linejoin="round"
      stroke-linecap="round"
      pathLength="1600"></polyline>
    <circle
      cx={xs[xs.length - 1]}
      cy={ys[ys.length - 1]}
      r="4"
      fill={strokeVar}
      stroke="var(--surface)"
      stroke-width="2"></circle>
    {endLabel && (
      <text
        x={xs[xs.length - 1] - 6}
        y={Math.max(ys[ys.length - 1] - 13, 14)}
        text-anchor="end"
        style="font-size:12px;font-weight:700;fill:var(--ink);"
      >
        {endLabel}
      </text>
    )}
  </svg>
  <div class="chart-src mono">{source}</div>
</figure>

<style>
  .chart { padding: 22px 24px 14px 24px; margin: 40px auto; max-width: 760px; }
  .chart-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
  }
  .chart-title { font-size: 14.5px; font-weight: 700; }
  .chart-unit { font-size: 10px; color: var(--muted); }
  .chart-src {
    font-size: 10px;
    color: var(--muted);
    border-top: 1px solid var(--hair2);
    padding-top: 8px;
    margin-top: 8px;
  }
  .chart-line { stroke-dasharray: 1600; stroke-dashoffset: 0; }
  :global(.chart.animate) .chart-line {
    animation: draw-line 1.6s cubic-bezier(0.3, 0.6, 0.3, 1) both;
  }
</style>
