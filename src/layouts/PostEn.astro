---
/**
 * 영문 기사 조판 (2026-08-26 신설).
 *
 * PostLayout(한글) 을 재사용하지 않는 이유: 그 파일은 카테고리 칩·토리 이야기·협업 카드·
 * 조회수 칩·용어 칩 등 **한국어 세계관에 묶인 조각**이 절반이다. 분기를 그 안에 심으면
 * 두 언어가 한 파일에서 서로를 망가뜨린다. 영문판은 「데이터 데스크」라 필요한 것이 훨씬
 * 적으므로 따로 두는 편이 얇고 안전하다.
 *
 * 캐릭터는 절충안이다(소유주 결정): **데이터는 무기명**, Tori's Note 만 서명 칼럼으로 남긴다.
 */
import Base from './Base.astro';
import Pic from '../components/Pic.astro';
import { T } from '../lib/i18n';
import { readingMinutesOf } from '../lib/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'postsEn'>;
  /** 본문 원문. 읽기 시간을 실측하는 데 쓴다(손으로 적지 않는다 — 8/25 폐지). */
  body: string;
}
const { post, body } = Astro.props;
const { title, description, pubDate, hero, three, toriNote, dataAsOf, sources = [], translationOf } = post.data;
const t = T.en;

// 영문은 한글과 읽기 속도가 다르다. readingMinutesOf 는 한글 글자수만 세므로 영문에서 0분이 된다.
// 영어는 분당 220단어로 잡는다(경제 해설은 숫자가 섞여 느리다 — 독자에게 유리하게).
const words = (body.replace(/<[^>]+>/g, ' ').match(/[A-Za-z][A-Za-z'-]*/g) ?? []).length;
const minutes = Math.max(1, Math.round(words / 220));

const dateText = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const isoDate = pubDate.toISOString().slice(0, 10);
---

<Base
  title={title}
  description={description}
  lang="en"
  activeNav="analysis"
  ogType="article"
  altPath={translationOf ? `/posts/${translationOf}/` : undefined}
  footerNewsletter={false}
>
  <article class="en-post">
    <header class="ep-head">
      <p class="ep-kicker">Analysis</p>
      <h1>{title}</h1>
      <p class="ep-standfirst">{description}</p>
      <p class="ep-meta mono">
        <time datetime={isoDate}>{dateText}</time>
        <span class="ep-sep">·</span>
        <span>{t.readingTime(minutes)}</span>
        {dataAsOf && (<><span class="ep-sep">·</span><span>{t.dataAsOf} {dataAsOf}</span></>)}
      </p>
    </header>

    {hero && (
      <figure class="ep-hero">
        <Pic path={hero} alt={`${title} illustration`} width={1200} height={675} eager />
      </figure>
    )}

    {three && (
      <aside class="ep-three" aria-label={t.threeTitle}>
        <div class="ep-three-head">
          <span class="ep-three-title">{t.threeTitle}</span>
          <span class="ep-three-sub mono">{t.threeSub}</span>
        </div>
        <dl>
          <div><dt>{t.threeWhat}</dt><dd set:html={three.what} /></div>
          <div><dt>{t.threeWhy}</dt><dd set:html={three.why} /></div>
          <div><dt>{t.threeNext}</dt><dd set:html={three.next} /></div>
        </dl>
      </aside>
    )}

    <div class="prose">
      <slot />
    </div>

    {toriNote && (
      <aside class="ep-note">
        <div class="ep-note-title">{t.toriNote}</div>
        <p>{toriNote}</p>
      </aside>
    )}

    {sources.length > 0 && (
      <section class="ep-sources" aria-labelledby="ep-src-h">
        <h2 id="ep-src-h">{t.sources}</h2>
        <ul>
          {sources.map((s) => (
            <li>
              <span class="ep-src-org">{s.org}</span>
              {s.url ? <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a> : <span>{s.name}</span>}
              {s.note && <span class="ep-src-note">{s.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {translationOf && (
      <p class="ep-alt">
        A Korean-language version of this article is available at{' '}
        <a href={`/posts/${translationOf}/`} hreflang="ko">도토리경제</a>.
      </p>
    )}
  </article>
</Base>

<style>
  .en-post { max-width: var(--w-prose); margin: 0 auto; padding: 8px 0 40px; }
  .ep-head { border-bottom: 2px solid var(--ink); padding-bottom: 18px; margin-bottom: 22px; }
  .ep-kicker { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 700; margin: 0 0 8px; }
  .en-post h1 { font-family: var(--font-serif); font-size: 38px; line-height: 1.2; margin: 0 0 12px; color: var(--ink); }
  .ep-standfirst { font-size: 17px; line-height: 1.75; color: var(--sub); margin: 0 0 14px; }
  .ep-meta { font-size: 12.5px; color: var(--muted); margin: 0; }
  .ep-sep { margin: 0 7px; }
  .ep-hero { margin: 0 0 26px; }
  .ep-three { border: 1px solid var(--ink); padding: 20px 24px; margin: 0 0 30px; background: var(--surface); }
  .ep-three-head { display: flex; align-items: baseline; gap: 10px; border-bottom: 1px solid var(--hair); padding-bottom: 9px; margin-bottom: 12px; }
  .ep-three-title { font-family: var(--font-serif); font-weight: 700; color: var(--ink); }
  .ep-three-sub { font-size: 11.5px; color: var(--muted); }
  .ep-three dl { margin: 0; }
  .ep-three dl > div { display: grid; grid-template-columns: 118px 1fr; gap: 12px; padding: 6px 0; }
  .ep-three dt { font-size: 12px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.04em; padding-top: 3px; }
  .ep-three dd { margin: 0; font-size: 15px; line-height: 1.75; color: var(--body-ink); }
  .ep-note { border-left: 2px solid var(--accent); padding: 6px 0 6px 18px; margin: 34px 0; }
  .ep-note-title { font-family: var(--font-serif); font-weight: 700; color: var(--accent); margin-bottom: 5px; }
  .ep-note p { margin: 0; font-size: 15.5px; line-height: 1.8; color: var(--sub); }
  .ep-sources { margin-top: 40px; border-top: 1px solid var(--hair); padding-top: 18px; }
  .ep-sources h2 { font-family: var(--font-serif); font-size: 16px; margin: 0 0 10px; color: var(--ink); }
  .ep-sources ul { margin: 0; padding-left: 1.1em; }
  .ep-sources li { font-size: 13.5px; line-height: 1.8; color: var(--sub); margin-bottom: 4px; }
  .ep-src-org { font-weight: 700; color: var(--ink); margin-right: 6px; }
  .ep-src-note { display: block; color: var(--muted); font-size: 12.5px; }
  .ep-alt { margin-top: 28px; font-size: 14px; color: var(--sub); }
  @media (max-width: 720px) {
    .en-post h1 { font-size: 29px; }
    .ep-three dl > div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
