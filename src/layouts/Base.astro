        </div>
        <div class="footer-legal">
          {isEn
            ? 'This publication is for information only and does not constitute investment advice. Data sources: Bank of Korea (ECOS), Korea Customs Service, U.S. Federal Reserve (FRED) and UN Comtrade. Figures are subject to revision by the issuing agencies.'
            : '본 콘텐츠는 정보 제공을 목적으로 하며 투자 자문이 아닙니다. 인용 데이터의 출처: 한국은행 ECOS, 관세청 수출입무역통계, 미 연준 FRED, UN Comtrade. 데이터는 발표 기관 사정에 따라 정정될 수 있습니다.'}
        </div>
      </div>
    </footer>

    <script>
      // 모바일 메뉴 시트. 데스크톱은 CSS hover 로 .nav-panel 을 열고, 좁은 화면에서는
      // .nav-in 밖에 있는 .nav-sheet 를 탭으로 여닫는다(클리핑·스크롤 문제를 구조로 없앤 설계).
      (() => {
        const mq = matchMedia('(max-width: 859.98px)');
        const backdrop = document.querySelector('.nav-backdrop');
        const parents = [...document.querySelectorAll('.nav-parent')];
        const sheets = [...document.querySelectorAll('.nav-sheet')];
        const sheetFor = (key) => sheets.find((s) => s.dataset.sheet === key);

        const close = () => {
          sheets.forEach((s) => {
            s.classList.remove('open');
            s.style.maxHeight = '';
          });
          parents.forEach((p) => {
            p.classList.remove('open');
            p.setAttribute('aria-expanded', 'false');
          });
          backdrop?.classList.remove('show');
          document.body.classList.remove('nav-menu-open');
        };

        parents.forEach((parent) => {
          parent.addEventListener('click', (e) => {
            if (!mq.matches) return; // 데스크톱: 링크 이동 + hover 드롭다운 그대로
            const sheet = sheetFor(parent.dataset.navKey);
            if (!sheet) return; // 시트가 없으면 평범한 링크로 둔다
            e.preventDefault();
            const wasOpen = sheet.classList.contains('open');
            close();
            if (!wasOpen) {
              sheet.classList.add('open');
              parent.classList.add('open');
              parent.setAttribute('aria-expanded', 'true');
              backdrop?.classList.add('show');
              document.body.classList.add('nav-menu-open'); // 떠 있는 위젯을 잠시 숨긴다
              // 남은 화면 높이에 맞춰 시트를 자른다. 페이지 최상단에서는 머리글까지 있어
              // 시트가 화면 밖으로 밀리는데, 스크롤하면 닫히니 마지막 항목에 닿을 수 없다.
              // (CSS 의 max-height:70vh 는 이 계산이 실패할 때의 안전값으로 남겨 둔다.)
              const top = sheet.getBoundingClientRect().top;
              const room = window.innerHeight - top - 10;
              if (room > 160) sheet.style.maxHeight = room + 'px';
            }
          });
        });

        // 닫는 길을 여러 개 둔다: 닫기 버튼 · 바깥 탭 · ESC · 스크롤(60px 문턱).
        document.querySelectorAll('.nav-sheet-close').forEach((b) => b.addEventListener('click', close));
        backdrop?.addEventListener('click', close);
        addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
        // 스크롤로는 닫지 않는다. 시트가 sticky 인 .nav 에 붙어 있어 스크롤해도 어긋나지 않고,
        // 문서에 부드러운 스크롤(scroll-behavior:smooth)이 걸려 있어서 손가락이 조금만 움직여도
        // 스크롤 이벤트가 이어져 메뉴가 제멋대로 닫혔다(2026-08-25 원인 규명).
        // 데스크톱 폭으로 커지면 모바일 상태를 정리한다.
        addEventListener('resize', () => {
          if (!mq.matches) close();
        });
      })();

      // 테마 토글
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const cur =
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = cur === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });

      // 이스터에그, 홈에서 마스트헤드 도토리를 누르면 도토리 비
      const logo = document.querySelector('.masthead-logo');
      if (logo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const ACORN =
          '<svg width="22" height="26" viewBox="0 0 24 28"><path d="M12 3.1 C7 3.1 3.3 6.1 2.7 10.2 C2.6 10.9 3.1 11.5 3.8 11.5 L20.2 11.5 C20.9 11.5 21.4 10.9 21.3 10.2 C20.7 6.1 17 3.1 12 3.1 Z" fill="#5C3A22"></path><path d="M4.2 13 C4.9 19.3 7.8 24.1 11.3 26.2 C11.75 26.5 12.25 26.5 12.7 26.2 C16.2 24.1 19.1 19.3 19.8 13 Z" fill="#B4552D"></path></svg>';
        logo.addEventListener('click', (e) => {
          e.preventDefault();
          for (let i = 0; i < 14; i++) {
            const el = document.createElement('span');
            el.className = 'acorn-drop';
            el.innerHTML = ACORN;
            el.style.left = `${Math.random() * 96}vw`;
            el.style.animationDelay = `${Math.random() * 0.5}s`;
            el.style.animationDuration = `${1.1 + Math.random() * 0.9}s`;
            document.body.appendChild(el);
            el.addEventListener('animationend', () => el.remove());
          }
        });
      }

      // 스크롤 리빌 + 차트 그리기
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add(e.target.hasAttribute('data-chart') ? 'animate' : 'is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.25 }
      );
      document.querySelectorAll('.reveal, [data-chart]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .topbar { border-bottom: 1px solid var(--hair); }
  .topbar-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 11px;
    padding-bottom: 11px;
    font-size: 12px;
    font-weight: 500;
    color: var(--sub);
    letter-spacing: 0.01em;
  }
  .topbar-et {
    display: none;
    margin-left: 8px;
    padding-left: 8px;
    border-left: 1px solid var(--hair);
    color: var(--muted);
    font-size: 0.92em;
  }
  @media (min-width: 720px) { .topbar-et { display: inline; } }
  .topbar-slogan { display: none; }
  @media (min-width: 860px) { .topbar-slogan { display: inline; } }
  .topbar-actions { display: inline-flex; align-items: center; gap: 14px; }
  /* 좁은 화면에서는 상단바가 두 줄로 깨졌다(언어 전환 버튼이 늘어난 뒤, 2026-08-26 제보).
     덜 급한 것부터 접는다: 뉴욕 날짜 → 토리 이야기. 협업 문의·검색·언어·테마는 남긴다. */
  @media (max-width: 560px) {
    .topbar-et { display: none; }
    .topbar-date { white-space: nowrap; font-size: 11.5px; }
  }
  @media (max-width: 430px) {
    .topbar-actions a[href$="/story/"] { display: none; }
  }
  .topbar-icon { display: inline-flex; color: var(--sub); }
  .topbar-icon:hover { color: var(--accent); }
  #theme-toggle {
    background: none;
    border: none;
    color: var(--sub);
    cursor: pointer;
    padding: 2px;
    display: inline-flex;
  }
  #theme-toggle:hover { color: var(--accent); }

  .masthead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-top: 42px;
    padding-bottom: 28px;
    text-align: center;
  }
  .masthead-logo { display: flex; align-items: center; gap: 13px; }
  .masthead-name {
    font-size: clamp(38px, 7vw, 58px);
    font-weight: 900;
    letter-spacing: 0.05em;
    line-height: 1;
  }
  .masthead-tagline { font-size: 13.5px; color: var(--sub); letter-spacing: 0.13em; }

  .compact-head { padding-top: 14px; padding-bottom: 14px; }
  .compact-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 19px;
    font-weight: 900;
    letter-spacing: 0.03em;
  }

  .nav {
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    position: sticky;
    top: 0;
    background: var(--paper);
    z-index: 50;
  }
  .nav-in {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav-in::-webkit-scrollbar { display: none; }
  /* 좁은 화면: 가운데 정렬 + 넘침은 첫 항목 왼쪽이 잘려 닿을 수 없게 되므로 좌측 정렬로 스크롤,
     오른쪽 페이드로 이어짐을 표시한다 */
  @media (max-width: 859px) {
    .nav { position: relative; }
    .nav-in { justify-content: flex-start; }
    .nav::after { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 30px; background: linear-gradient(to left, var(--paper), transparent); pointer-events: none; }
  }
  /* 데스크톱: 내비 폭이 넉넉하므로 스크롤 컨테이너를 풀어 드롭다운이 잘리지 않게 한다 */
  @media (min-width: 860px) {
    .nav-in { overflow: visible; }
  }
  .skip-link { position: absolute; left: -9999px; top: 0; z-index: 200; background: var(--ink); color: var(--paper); padding: 10px 18px; font-size: 13px; font-weight: 700; }
  .skip-link:focus { left: 0; }
  .nav-group { position: relative; display: flex; }
  .nav-caret {
    font-size: 8px;
    margin-left: 5px;
    color: var(--muted);
    display: none;
  }
  .nav-panel { display: none; }
  @media (min-width: 860px) {
    .nav-caret { display: inline; }
    .nav-panel {
      display: block;
      visibility: hidden;
      opacity: 0;
      translate: 0 -4px;
      transition: opacity 0.15s ease, translate 0.15s ease, visibility 0.15s;
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      min-width: 230px;
      /* 항목이 늘면 패널이 화면 아래로 넘친다(소개 추가로 8항목이 되며 692px, 실제로 잘렸다).
         넘칠 때만 패널 안에서 스크롤한다 — 항목을 지우지 않고 목록을 지키는 쪽을 택한다.
         빼는 값은 내비 하단까지의 거리다: 홈은 머리글이 커서 267px, 기사·목록은 compact 라 166px.
         큰 쪽에 여유 16px 을 더해 잡는다(작은 쪽에서는 조금 손해지만 어느 쪽도 잘리지 않는다). */
      max-height: calc(100vh - 283px);
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--surface);
      border: 1px solid var(--hair);
      border-top: 2px solid var(--ink);
      box-shadow: 0 12px 30px rgba(16, 20, 28, 0.12);
      padding: 6px 0;
      z-index: 60;
    }
    .nav-group:hover .nav-panel,
    .nav-group:focus-within .nav-panel {
      visibility: visible;
      opacity: 1;
      translate: 0 0;
    }
    .nav-sub {
      display: block;
      padding: 9px 18px;
      text-decoration: none;
    }
    .nav-sub:hover { background: var(--paper); }
    .nav-sub-name {
      display: block;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--ink);
    }
    .nav-sub.active .nav-sub-name { color: var(--accent); }
    .nav-sub:hover .nav-sub-name { color: var(--accent); }
    .nav-sub-desc {
      display: block;
      font-size: 11.5px;
      color: var(--muted);
      margin-top: 3px;
      word-break: keep-all;
    }
  }
  /* ── 모바일 메뉴 시트 (2026-08-25 재설계) ─────────────────────────────
     데스크톱 드롭다운(.nav-panel)을 좁은 화면에 밀어 넣는 방식은 두 번 실패했다.
     ① position:fixed + body 스크롤 잠금 → 모바일에서 잠금이 안 먹어 패널이 화면에 붙어 떠 있었다.
     ② .nav-in(가로 스크롤 컨테이너) 안에 둔 채 absolute 로 빼내기 → 기준·클리핑이 계속 얽혔다.
     그래서 마크업부터 갈랐다. 모바일은 .nav-in **밖**에 있는 `.nav-sheet` 를 쓴다.
     클리핑할 조상이 아예 없으니 위치가 어긋날 여지가 없다. 데스크톱은 .nav-panel 그대로. */
  .nav-sheet { display: none; }
  @media (max-width: 859.98px) {
    .nav-caret { display: inline; transition: rotate 0.16s ease; }
    .nav-parent.open .nav-caret { rotate: 180deg; }
