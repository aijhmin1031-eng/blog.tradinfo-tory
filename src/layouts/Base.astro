---
import '../styles/global.css';
import Ticker from '../components/Ticker.astro';
import Newsletter from '../components/Newsletter.astro';
import { TOPICS } from '../lib/topics';
import Acorn from '../components/Acorn.astro';
import { SITE, CATEGORIES, url, fmtDate } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  compact?: boolean;
  ogImage?: string;
  activeNav?: string;
  /** 본문에 구독 박스가 이미 있는 페이지(기사)는 푸터 폼을 생략해 2중 노출을 피한다 */
  footerNewsletter?: boolean;
  ogType?: 'website' | 'article';
}
const {
  title,
  description = SITE.description,
  compact = false,
  ogImage = url('/images/og-default.jpg'),
  activeNav = '',
  footerNewsletter = true,
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.taglineSub}`;
const today = new Date();
const days = ['일', '월', '화', '수', '목', '금', '토'];
const dateLine = `${today.getFullYear()}년 ${today.getMonth() + 1}월 ${today.getDate()}일 ${days[today.getDay()]}요일`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Vercel 병행 배포는 커스텀 도메인 연결 전까지 검색 중복 방지를 위해 색인 제외
const isVercelBuild = !!process.env.VERCEL;

// 내비게이션은 7슬롯 고정, 특집·창고는 드롭다운(데스크톱)이 증가분을 흡수한다.
// 새 특집은 lib/topics.ts에만 추가하면 된다.
const navItems: {
  key: string;
  name: string;
  href: string;
  children?: { key: string; name: string; href: string; desc?: string }[];
}[] = [
  { key: 'home', name: '오늘의 도토리', href: url('/') },
  ...Object.values(CATEGORIES).map((c) => ({
    key: c.slug,
    name: c.name,
    href: url(`/category/${c.slug}/`),
  })),
  {
    key: 'topics',
    name: '특집',
    href: url('/topics/'),
    children: TOPICS.map((t) => ({ key: t.key, name: t.name, href: url(t.href), desc: t.desc })),
  },
  {
    key: 'warehouse',
    name: '도토리 창고',
    href: url('/warehouse/'),
    children: [
      { key: 'warehouse', name: '오늘의 지표', href: url('/warehouse/'), desc: '환율·금리·관련주·무역수지 대시보드' },
      { key: 'glossary', name: '용어 도토리', href: url('/glossary/'), desc: '무역·경제 용어 사전' },
      { key: 'galimgil', name: '토리의 갈림길', href: url('/galimgil/'), desc: '주간 전망 연재·공개 채점 아카이브' },
      { key: 'pack', name: '도토리 그림함', href: url('/pack/'), desc: '무료 이미지 나눔 · 출처 표기 시 상업적 이용 가능' },
      { key: 'board', name: '도토리 광장', href: url('/board/'), desc: '자유 의견·주제 제안·제보 게시판' },
      { key: 'map', name: '블로그 지도', href: url('/map/'), desc: '전체 콘텐츠 구성을 한눈에 (매일 자동 갱신)' },
    ],
  },
];
const isActive = (n: (typeof navItems)[number]) =>
  activeNav === n.key || (n.children?.some((c) => c.key === activeNav) ?? false);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isVercelBuild && <meta name="robots" content="noindex" />}
    {SITE.naverVerify && <meta name="naver-site-verification" content={SITE.naverVerify} />}
    {SITE.googleVerify && <meta name="google-site-verification" content={SITE.googleVerify} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@500;700;900&family=IBM+Plex+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // 테마 초기화 (FOUC 방지), localStorage 실패 시 시스템 설정 따름
      (function () {
        document.documentElement.classList.add('js');
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <header>
      <div class="topbar">
        <div class="wrap topbar-in">
          <span class="topbar-date">{dateLine}</span>
          <span class="topbar-slogan">매일 아침 7시, 새 도토리가 올라옵니다</span>
          <span class="topbar-actions">
            <a href={url('/about/')}>토리 이야기</a>
            <a href={url('/search/')} aria-label="검색" title="검색" class="topbar-icon">
              <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
                <path d="M11 11 L15 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
            </a>
            <button id="theme-toggle" aria-label="화면 테마 전환" title="라이트/다크 전환">
              <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.6"
                ></circle>
                <path
                  d="M8 0.8 V2.6 M8 13.4 V15.2 M0.8 8 H2.6 M13.4 8 H15.2 M2.9 2.9 L4.2 4.2 M11.8 11.8 L13.1 13.1 M13.1 2.9 L11.8 4.2 M4.2 11.8 L2.9 13.1"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"></path>
              </svg>
            </button>
          </span>
        </div>
      </div>

      {
        !compact ? (
          <div class="masthead wrap">
            <a href={url('/')} class="masthead-logo">
              <Acorn size={36} />
              <span class="masthead-name serif">도토리경제</span>
            </a>
            <div class="masthead-tagline">{SITE.taglineSub}</div>
          </div>
        ) : (
          <div class="compact-head wrap">
            <a href={url('/')} class="compact-logo">
              <Acorn size={19} label="도토리경제" />
              <span class="serif">도토리경제</span>
            </a>
          </div>
        )
      }
      {!compact && <div class="double-rule wrap" style="padding:0;" />}
    </header>

    <nav class="nav" aria-label="주요 카테고리">
      <div class="wrap nav-in">
        {
          navItems.map((n) =>
            n.children ? (
              <div class="nav-group">
                <a href={n.href} class:list={['nav-item', 'nav-parent', { active: isActive(n) }]}>
                  {n.name}<span class="nav-caret" aria-hidden="true">▾</span>
                </a>
                <div class="nav-panel" role="menu">
                  {n.children.map((c) => (
                    <a href={c.href} class:list={['nav-sub', { active: activeNav === c.key }]} role="menuitem">
                      <span class="nav-sub-name">{c.name}</span>
                      {c.desc && <span class="nav-sub-desc">{c.desc}</span>}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={n.href}
                class:list={['nav-item', { active: activeNav === n.key }]}
                aria-current={activeNav === n.key ? 'page' : undefined}
              >
                {n.name}
              </a>
            )
          )
        }
      </div>
    </nav>

    <Ticker />

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-in">
        <div class="footer-brand">
          <div class="footer-logo">
            <Acorn size={17} cap="#8CA0BF" body="#C77B4A" label="도토리경제" />
            <span class="serif">도토리경제</span>
          </div>
          <div class="footer-tag">{SITE.tagline}<br />&copy; {today.getFullYear()} Dotori Economy</div>
        </div>
        <div class="footer-links">
          <div>
            <div class="footer-col-title">콘텐츠</div>
            {
              Object.values(CATEGORIES).map((c) => (
                <a href={url(`/category/${c.slug}/`)}>{c.name}</a>
              ))
            }
          </div>
          <div>
            <div class="footer-col-title">도토리경제</div>
            <a href={url('/about/')}>소개</a>
            <a href={url('/board/')}>도토리 광장</a>
            <a href={url('/contact/')}>문의</a>
            <a href={url('/privacy/')}>개인정보처리방침</a>
            <a href={url('/rss.xml')}>RSS</a>
          </div>
        </div>
        <div class="footer-legal">
          본 콘텐츠는 정보 제공을 목적으로 하며 투자 자문이 아닙니다. 인용 데이터의 출처: 한국은행
          ECOS, 관세청 수출입무역통계, 미 연준 FRED, UN Comtrade. 데이터는 발표 기관 사정에 따라
          정정될 수 있습니다.
        </div>
        {footerNewsletter && <Newsletter source="footer" />}
      </div>
    </footer>

    <script>
      // 테마 토글
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const cur =
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = cur === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });

      // 이스터에그, 홈에서 마스트헤드 도토리를 누르면 도토리 비
      const logo = document.querySelector('.masthead-logo');
      if (logo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const ACORN =
          '<svg width="22" height="26" viewBox="0 0 24 28"><path d="M12 3.1 C7 3.1 3.3 6.1 2.7 10.2 C2.6 10.9 3.1 11.5 3.8 11.5 L20.2 11.5 C20.9 11.5 21.4 10.9 21.3 10.2 C20.7 6.1 17 3.1 12 3.1 Z" fill="#5C3A22"></path><path d="M4.2 13 C4.9 19.3 7.8 24.1 11.3 26.2 C11.75 26.5 12.25 26.5 12.7 26.2 C16.2 24.1 19.1 19.3 19.8 13 Z" fill="#B4552D"></path></svg>';
        logo.addEventListener('click', (e) => {
          e.preventDefault();
          for (let i = 0; i < 14; i++) {
            const el = document.createElement('span');
            el.className = 'acorn-drop';
            el.innerHTML = ACORN;
            el.style.left = `${Math.random() * 96}vw`;
            el.style.animationDelay = `${Math.random() * 0.5}s`;
            el.style.animationDuration = `${1.1 + Math.random() * 0.9}s`;
            document.body.appendChild(el);
            el.addEventListener('animationend', () => el.remove());
          }
        });
      }

      // 스크롤 리빌 + 차트 그리기
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add(e.target.hasAttribute('data-chart') ? 'animate' : 'is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.25 }
      );
      document.querySelectorAll('.reveal, [data-chart]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .topbar { border-bottom: 1px solid var(--hair); }
  .topbar-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 11px;
    padding-bottom: 11px;
    font-size: 12px;
    font-weight: 500;
    color: var(--sub);
    letter-spacing: 0.01em;
  }
  .topbar-slogan { display: none; }
  @media (min-width: 860px) { .topbar-slogan { display: inline; } }
  .topbar-actions { display: inline-flex; align-items: center; gap: 14px; }
  .topbar-icon { display: inline-flex; color: var(--sub); }
  .topbar-icon:hover { color: var(--accent); }
  #theme-toggle {
    background: none;
    border: none;
    color: var(--sub);
    cursor: pointer;
    padding: 2px;
    display: inline-flex;
  }
  #theme-toggle:hover { color: var(--accent); }

  .masthead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-top: 42px;
    padding-bottom: 28px;
    text-align: center;
  }
  .masthead-logo { display: flex; align-items: center; gap: 13px; }
  .masthead-name {
    font-size: clamp(38px, 7vw, 58px);
    font-weight: 900;
    letter-spacing: 0.05em;
    line-height: 1;
  }
  .masthead-tagline { font-size: 13.5px; color: var(--sub); letter-spacing: 0.13em; }

  .compact-head { padding-top: 14px; padding-bottom: 14px; }
  .compact-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 19px;
    font-weight: 900;
    letter-spacing: 0.03em;
  }

  .nav {
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    position: sticky;
    top: 0;
    background: var(--paper);
    z-index: 50;
  }
  .nav-in {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav-in::-webkit-scrollbar { display: none; }
  /* 좁은 화면: 가운데 정렬 + 넘침은 첫 항목 왼쪽이 잘려 닿을 수 없게 되므로 좌측 정렬로 스크롤,
     오른쪽 페이드로 이어짐을 표시한다 */
  @media (max-width: 859px) {
    .nav { position: relative; }
    .nav-in { justify-content: flex-start; }
    .nav::after { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 30px; background: linear-gradient(to left, var(--paper), transparent); pointer-events: none; }
  }
  /* 데스크톱: 내비 폭이 넉넉하므로 스크롤 컨테이너를 풀어 드롭다운이 잘리지 않게 한다 */
  @media (min-width: 860px) {
    .nav-in { overflow: visible; }
  }
  .skip-link { position: absolute; left: -9999px; top: 0; z-index: 200; background: var(--ink); color: var(--paper); padding: 10px 18px; font-size: 13px; font-weight: 700; }
  .skip-link:focus { left: 0; }
  .nav-group { position: relative; display: flex; }
  .nav-caret {
    font-size: 8px;
    margin-left: 5px;
    color: var(--muted);
    display: none;
  }
  .nav-panel { display: none; }
  @media (min-width: 860px) {
    .nav-caret { display: inline; }
    .nav-panel {
      display: block;
      visibility: hidden;
      opacity: 0;
      translate: 0 -4px;
      transition: opacity 0.15s ease, translate 0.15s ease, visibility 0.15s;
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      min-width: 230px;
      background: var(--surface);
      border: 1px solid var(--hair);
      border-top: 2px solid var(--ink);
      box-shadow: 0 12px 30px rgba(16, 20, 28, 0.12);
      padding: 6px 0;
      z-index: 60;
    }
    .nav-group:hover .nav-panel,
    .nav-group:focus-within .nav-panel {
      visibility: visible;
      opacity: 1;
      translate: 0 0;
    }
    .nav-sub {
      display: block;
      padding: 11px 18px;
      text-decoration: none;
    }
    .nav-sub:hover { background: var(--paper); }
    .nav-sub-name {
      display: block;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--ink);
    }
    .nav-sub.active .nav-sub-name { color: var(--accent); }
    .nav-sub:hover .nav-sub-name { color: var(--accent); }
    .nav-sub-desc {
      display: block;
      font-size: 11.5px;
      color: var(--muted);
      margin-top: 3px;
      word-break: keep-all;
    }
  }
  /* 모바일: 드롭다운 없이 부모 링크만, 특집은 /topics/ 인덱스로 이동 */
  @media (max-width: 859.98px) {
    .nav-panel { display: none !important; }
  }
  .nav-item {
    padding: 15px 22px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--sub);
    white-space: nowrap;
    transition: box-shadow 0.15s ease, color 0.15s ease;
  }
  .nav-item:hover { color: var(--ink); box-shadow: inset 0 -2px 0 var(--hair); }
  .nav-item.active {
    color: var(--ink);
    font-weight: 700;
    box-shadow: inset 0 -2px 0 var(--ink);
  }
  @media (max-width: 720px) {
    .nav-in { justify-content: flex-start; }
    .nav-item { padding: 13px 15px; font-size: 13.5px; }
  }

  .footer { background: var(--dark-band); color: var(--dark-band-ink); margin-top: 72px; }
  .footer-in {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding-top: 44px;
    padding-bottom: 44px;
  }
  @media (min-width: 860px) {
    .footer-in { grid-template-columns: 1fr auto 1fr; align-items: start; }
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 900;
    margin-bottom: 10px;
  }
  .footer-tag { font-size: 12px; color: var(--dark-band-sub); line-height: 1.7; }
  .footer-links { display: flex; gap: 48px; font-size: 12.5px; }
  .footer-links a { display: block; margin-bottom: 9px; color: var(--dark-band-ink); }
  .footer-links a:hover { color: var(--dark-band-up); }
  .footer-col-title { color: var(--dark-band-sub); font-size: 11px; margin-bottom: 10px; }
  .footer-legal {
    max-width: 340px;
    font-size: 11px;
    color: var(--dark-band-sub);
    line-height: 1.75;
  }
</style>
