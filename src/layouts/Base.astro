---
import '../styles/global.css';
import Ticker from '../components/Ticker.astro';
import Collab from '../components/Collab.astro';
import { TOPICS } from '../lib/topics';
import Acorn from '../components/Acorn.astro';
import { SITE, CATEGORIES, url, fmtDate, dateLineIn, shortDateIn, todayIn, TZ_KST, TZ_ET } from '../lib/site';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase';

interface Props {
  title?: string;
  description?: string;
  compact?: boolean;
  ogImage?: string;
  activeNav?: string;
  /** 본문에 구독 박스가 이미 있는 페이지(기사)는 푸터 폼을 생략해 2중 노출을 피한다 */
  footerNewsletter?: boolean;
  ogType?: 'website' | 'article';
}
const {
  title,
  description = SITE.description,
  compact = false,
  ogImage = url('/images/og-default.jpg'),
  activeNav = '',
  footerNewsletter = true,
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.taglineSub}`;
// 이 블로그의 기준 시간은 한국이다. 빌드가 UTC 서버에서 돌아 예전에는 하루가 밀려 나왔다.
// 미 국채·달러 지표가 '어제 값'인 이유를 읽는 분이 알 수 있도록 뉴욕 날짜를 참고로 함께 적는다.
const now = new Date();
const dateLine = dateLineIn(TZ_KST, now);
const etLine = shortDateIn(TZ_ET, now);
const kstYear = todayIn(TZ_KST, now).slice(0, 4);
// 정본 주소는 커스텀 도메인 한 곳이다. GitHub Pages 미러도 canonical은 이 도메인을 가리켜
// 색인 신호가 둘로 갈리지 않게 한다(중복 페이지는 noindex가 아니라 canonical로 합치는 것이 권장 방식).
const CANONICAL_ORIGIN = 'https://dotoriecon.com';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalPath = (basePath && Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length)
  : Astro.url.pathname) || '/';
const canonical = new URL(canonicalPath, CANONICAL_ORIGIN).href;
// 정본(Vercel) 빌드에서만 켜는 것들 — GitHub Pages 미러에는 없는 엔드포인트다.
const onVercel = !!process.env.VERCEL;

// 내비게이션은 7슬롯 고정, 특집·창고는 드롭다운(데스크톱)이 증가분을 흡수한다.
// 새 특집은 lib/topics.ts에만 추가하면 된다.
const navItems: {
  key: string;
  name: string;
  href: string;
  children?: { key: string; name: string; href: string; desc?: string }[];
}[] = [
  { key: 'home', name: '오늘의 도토리', href: url('/') },
  {
    // 읽을거리(기사)는 전부 '숲' 아래로. 카테고리를 상단에 평평하게 늘어놓으면
    // 도구 모음인 창고와 같은 층으로 보여 위계가 사라진다.
    key: 'forest',
    name: '도토리 숲',
    href: url('/forest/'),
    children: [
      ...Object.values(CATEGORIES).map((c) => ({
        key: c.slug,
        name: c.name,
        href: url(`/category/${c.slug}/`),
        desc: c.desc,
      })),
      ...TOPICS.map((t) => ({ key: t.key, name: `${t.name} 특집`, href: url(t.href), desc: t.desc })),
      { key: 'story', name: '토리 이야기', href: url('/story/'), desc: '토리를 그린 카툰 연재 · 화별로 읽기' },
      { key: 'forest', name: '숲 전체 보기', href: url('/forest/'), desc: '분야·특집·최신 기사를 한 화면에서' },
    ],
  },
  {
    // 창고는 유입이 큰 코너를 위로 둔다(무료 이미지·용어 사전).
    key: 'warehouse',
    name: '도토리 창고',
    href: url('/warehouse/'),
    children: [
      { key: 'pack', name: '도토리 그림함', href: url('/pack/'), desc: '무료 이미지 나눔 · 출처 표기 시 상업적 이용 가능' },
      { key: 'glossary', name: '용어 도토리', href: url('/glossary/'), desc: '무역·경제 용어 사전' },
      { key: 'warehouse', name: '오늘의 지표', href: url('/warehouse/'), desc: '환율·금리·관련주·무역수지 대시보드' },
      { key: 'galimgil', name: '토리의 갈림길', href: url('/galimgil/'), desc: '주간 전망 연재·공개 채점 아카이브' },
      { key: 'board', name: '도토리 광장', href: url('/board/'), desc: '자유 의견·주제 제안·제보 게시판' },
      { key: 'method', name: '숫자를 다루는 방법', href: url('/method/'), desc: '데이터 출처와 검증 원칙' },
      { key: 'map', name: '블로그 지도', href: url('/map/'), desc: '전체 콘텐츠 구성을 한눈에 (매일 자동 갱신)' },
    ],
  },
];
const FOREST_KEYS = new Set(['forest', 'topics', 'story', 'about', ...Object.values(CATEGORIES).map((c) => c.slug), ...TOPICS.map((t) => t.key)]);
const isActive = (n: (typeof navItems)[number]) =>
  activeNav === n.key ||
  (n.children?.some((c) => c.key === activeNav) ?? false) ||
  (n.key === 'forest' && FOREST_KEYS.has(activeNav));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {SITE.naverVerify && <meta name="naver-site-verification" content={SITE.naverVerify} />}
    {SITE.googleVerify && <meta name="google-site-verification" content={SITE.googleVerify} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@500;700;900&family=IBM+Plex+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // 테마 초기화 (FOUC 방지), localStorage 실패 시 시스템 설정 따름
      (function () {
        document.documentElement.classList.add('js');
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    {
      /* Vercel Web Analytics — 순 방문자·유입 경로(referrer)·국가·기기를 잡는다.
         자체 집계(bump_view)는 페이지 조회 수만 세고 방문자를 구분하지 못해
         "실제 외부 방문자가 있는가"에 답하지 못했다. 이 스크립트가 그 자리를 메운다.
         쿠키를 쓰지 않고 개인 식별자도 남기지 않는다.
         정본에서만 넣는다 — GH Pages 미러에는 이 엔드포인트가 없어 404가 날 뿐이다.
         **Vercel 대시보드에서 Analytics 를 켜야 실제 수집이 시작된다.** */
      onVercel && <script defer src="/_vercel/insights/script.js"></script>
    }
    {
      /* 방문 기록 — 기사뿐 아니라 모든 페이지에서 한 번씩.
         남기는 것은 '그날치 난수 + 경로 + 유입 도메인' 뿐이다(scripts/sql/visit_log.sql 참조).
         자정이 지나면 난수가 새로 만들어져 같은 사람을 이틀 이상 추적할 수 없다.
         RPC 가 아직 없으면(SQL 미적용) 조용히 실패하고 아무것도 깨지지 않는다. */
      onVercel && (
        <script define:vars={{ sbUrl: SUPABASE_URL, sbKey: SUPABASE_ANON_KEY }}>
          {`(function () {
            try {
              if (navigator.webdriver) return;
              var h = location.hostname;
              if (h === 'localhost' || h === '127.0.0.1') return;

              // 방문자 구분값은 '그날 하루'만 산다. 날짜가 바뀌면 새로 만들어진다.
              var day = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Seoul' });
              var key = 'dv:' + day;
              var id = null;
              try { id = localStorage.getItem(key); } catch (e) {}
              if (!id) {
                var b = new Uint8Array(8);
                crypto.getRandomValues(b);
                id = Array.from(b, function (x) { return x.toString(16).padStart(2, '0'); }).join('');
                try {
                  localStorage.setItem(key, id);
                  // 지난 날짜 값은 지운다 — 오래 남겨 둘 이유가 없다.
                  Object.keys(localStorage).forEach(function (k2) {
                    if (k2.indexOf('dv:') === 0 && k2 !== key) localStorage.removeItem(k2);
                  });
                } catch (e) {}
              }

              fetch(sbUrl + '/rest/v1/rpc/log_visit', {
                method: 'POST',
                headers: { apikey: sbKey, Authorization: 'Bearer ' + sbKey, 'Content-Type': 'application/json' },
                body: JSON.stringify({ p_path: location.pathname, p_visitor: id, p_ref: document.referrer || '' }),
                keepalive: true,
              }).catch(function () {});
            } catch (e) {}
          })();`}
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <header>
      <div class="topbar">
        <div class="wrap topbar-in">
          <span class="topbar-date">
            {dateLine}
            <span class="topbar-et" title="뉴욕 현지 날짜 · 미 증시와 국채 지표의 기준">뉴욕 {etLine}</span>
          </span>
          <span class="topbar-slogan">매일 아침 7시, 새 도토리가 올라옵니다</span>
          <span class="topbar-actions">
            <a href={url('/story/')}>토리 이야기</a>
            <a href={url('/contact/')} class="topbar-work">협업 문의</a>
            <a href={url('/search/')} aria-label="검색" title="검색" class="topbar-icon">
              <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
                <path d="M11 11 L15 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
            </a>
            <button id="theme-toggle" aria-label="화면 테마 전환" title="라이트/다크 전환">
              <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.6"
                ></circle>
                <path
                  d="M8 0.8 V2.6 M8 13.4 V15.2 M0.8 8 H2.6 M13.4 8 H15.2 M2.9 2.9 L4.2 4.2 M11.8 11.8 L13.1 13.1 M13.1 2.9 L11.8 4.2 M4.2 11.8 L2.9 13.1"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"></path>
              </svg>
            </button>
          </span>
        </div>
      </div>

      {
        !compact ? (
          <div class="masthead wrap">
            <a href={url('/')} class="masthead-logo">
              <Acorn size={36} />
              <span class="masthead-name serif">도토리경제</span>
            </a>
            <div class="masthead-tagline">{SITE.taglineSub}</div>
          </div>
        ) : (
          <div class="compact-head wrap">
            <a href={url('/')} class="compact-logo">
              <Acorn size={19} label="도토리경제" />
              <span class="serif">도토리경제</span>
            </a>
          </div>
        )
      }
      {!compact && <div class="double-rule wrap" style="padding:0;" />}
    </header>

    <nav class="nav" aria-label="주요 카테고리">
      <div class="wrap nav-in">
        {
          navItems.map((n) =>
            n.children ? (
              <div class="nav-group">
                <a
                  href={n.href}
                  class:list={['nav-item', 'nav-parent', { active: isActive(n) }]}
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  {n.name}<span class="nav-caret" aria-hidden="true">▾</span>
                </a>
                <div class="nav-panel" role="menu">
                  {n.children.map((c) => (
                    <a href={c.href} class:list={['nav-sub', { active: activeNav === c.key }]} role="menuitem">
                      <span class="nav-sub-name">{c.name}</span>
                      {c.desc && <span class="nav-sub-desc">{c.desc}</span>}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={n.href}
                class:list={['nav-item', { active: activeNav === n.key }]}
                aria-current={activeNav === n.key ? 'page' : undefined}
              >
                {n.name}
              </a>
            )
          )
        }
      </div>
    </nav>
    <div class="nav-backdrop" aria-hidden="true"></div>

    <Ticker />

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      {footerNewsletter && (
        <div class="wrap footer-collab">
          <Collab source="footer" />
        </div>
      )}
      <div class="wrap footer-in">
        <div class="footer-brand">
          <div class="footer-logo">
            <Acorn size={17} cap="#8CA0BF" body="#C77B4A" label="도토리경제" />
            <span class="serif">도토리경제</span>
          </div>
          <div class="footer-tag">{SITE.tagline}<br />&copy; {kstYear} Dotori Economy</div>
        </div>
        <div class="footer-links">
          <div>
            <div class="footer-col-title">콘텐츠</div>
            {
              Object.values(CATEGORIES).map((c) => (
                <a href={url(`/category/${c.slug}/`)}>{c.name}</a>
              ))
            }
          </div>
          <div>
            <div class="footer-col-title">도토리경제</div>
            <a href={url('/about/')}>토리는 누구인가</a>
            <a href={url('/method/')}>숫자를 다루는 방법</a>
            <a href={url('/story/')}>토리 이야기</a>
            <a href={url('/board/')}>도토리 광장</a>
            <a href={url('/contact/')}>협업 문의</a>
            <a href={url('/privacy/')}>개인정보처리방침</a>
            <a href={url('/rss.xml')}>RSS</a>
          </div>
        </div>
        <div class="footer-legal">
          본 콘텐츠는 정보 제공을 목적으로 하며 투자 자문이 아닙니다. 인용 데이터의 출처: 한국은행
          ECOS, 관세청 수출입무역통계, 미 연준 FRED, UN Comtrade. 데이터는 발표 기관 사정에 따라
          정정될 수 있습니다.
        </div>
      </div>
    </footer>

    <script>
      // 모바일 내비 드롭다운, hover 가 없으므로 탭으로 열고 닫는다.
      // (데스크톱은 CSS hover 그대로 두고, 여기서는 좁은 화면일 때만 개입한다.)
      (() => {
        const mq = matchMedia('(max-width: 859.98px)');
        const nav = document.querySelector('.nav');
        const backdrop = document.querySelector('.nav-backdrop');
        const groups = [...document.querySelectorAll('.nav-group')];
        let openScrollY = 0;
        const closeAll = () => {
          groups.forEach((g) => {
            g.classList.remove('open');
            g.querySelector('.nav-parent')?.setAttribute('aria-expanded', 'false');
          });
          backdrop?.classList.remove('show');
        };
        groups.forEach((group) => {
          const parent = group.querySelector('.nav-parent');
          parent?.addEventListener('click', (e) => {
            if (!mq.matches) return; // 데스크톱: 링크 이동 + hover 드롭다운 그대로
            e.preventDefault();
            const wasOpen = group.classList.contains('open');
            closeAll();
            if (!wasOpen) {
              group.classList.add('open');
              parent.setAttribute('aria-expanded', 'true');
              backdrop?.classList.add('show');
              openScrollY = window.scrollY;
            }
          });
        });
        backdrop?.addEventListener('click', closeAll);
        // 화면이 데스크톱 폭으로 커지면 모바일 열림 상태를 정리한다.
        addEventListener('resize', () => {
          if (!mq.matches) closeAll();
        });
        // 스크롤하면 닫는다. 탭 순간의 미세한 스크롤로 즉시 닫히지 않게 60px 문턱을 둔다.
        addEventListener('scroll', () => {
          if (!document.querySelector('.nav-group.open')) return;
          if (Math.abs(window.scrollY - openScrollY) > 60) closeAll();
        }, { passive: true });
        // ESC 로 닫기(키보드 접근성)
        addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeAll();
        });
      })();

      // 테마 토글
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const cur =
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = cur === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });

      // 이스터에그, 홈에서 마스트헤드 도토리를 누르면 도토리 비
      const logo = document.querySelector('.masthead-logo');
      if (logo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const ACORN =
          '<svg width="22" height="26" viewBox="0 0 24 28"><path d="M12 3.1 C7 3.1 3.3 6.1 2.7 10.2 C2.6 10.9 3.1 11.5 3.8 11.5 L20.2 11.5 C20.9 11.5 21.4 10.9 21.3 10.2 C20.7 6.1 17 3.1 12 3.1 Z" fill="#5C3A22"></path><path d="M4.2 13 C4.9 19.3 7.8 24.1 11.3 26.2 C11.75 26.5 12.25 26.5 12.7 26.2 C16.2 24.1 19.1 19.3 19.8 13 Z" fill="#B4552D"></path></svg>';
        logo.addEventListener('click', (e) => {
          e.preventDefault();
          for (let i = 0; i < 14; i++) {
            const el = document.createElement('span');
            el.className = 'acorn-drop';
            el.innerHTML = ACORN;
            el.style.left = `${Math.random() * 96}vw`;
            el.style.animationDelay = `${Math.random() * 0.5}s`;
            el.style.animationDuration = `${1.1 + Math.random() * 0.9}s`;
            document.body.appendChild(el);
            el.addEventListener('animationend', () => el.remove());
          }
        });
      }

      // 스크롤 리빌 + 차트 그리기
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add(e.target.hasAttribute('data-chart') ? 'animate' : 'is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.25 }
      );
      document.querySelectorAll('.reveal, [data-chart]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .topbar { border-bottom: 1px solid var(--hair); }
  .topbar-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 11px;
    padding-bottom: 11px;
    font-size: 12px;
    font-weight: 500;
    color: var(--sub);
    letter-spacing: 0.01em;
  }
  .topbar-et {
    display: none;
    margin-left: 8px;
    padding-left: 8px;
    border-left: 1px solid var(--hair);
    color: var(--muted);
    font-size: 0.92em;
  }
  @media (min-width: 720px) { .topbar-et { display: inline; } }
  .topbar-slogan { display: none; }
