        {
          nav.map((n) =>
            n.children ? (
              <div class="nav-group">
                <a
                  href={n.href}
                  data-nav-key={n.key}
                  class:list={['nav-item', 'nav-parent', { active: isActive(n) }]}
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  {n.name}<span class="nav-caret" aria-hidden="true">▾</span>
                </a>
                <div class="nav-panel" role="menu">
                  {n.children.map((c) => (
                    <a href={c.href} class:list={['nav-sub', { active: activeNav === c.key }]} role="menuitem">
                      <span class="nav-sub-name">{c.name}</span>
                      {c.desc && <span class="nav-sub-desc">{c.desc}</span>}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={n.href}
                class:list={['nav-item', { active: activeNav === n.key }]}
                aria-current={activeNav === n.key ? 'page' : undefined}
              >
                {n.short ? <><span class="nav-long">{n.name}</span><span class="nav-short">{n.short}</span></> : n.name}
              </a>
            )
          )
        }
      </div>
      {
        /* 모바일 전용 메뉴 시트. 데스크톱 드롭다운(.nav-panel)을 좁은 화면에 밀어 넣으면
           .nav-in 의 가로 스크롤 컨테이너에 갇혀 계속 문제가 났다. 그래서 시트를
           .nav-in 밖(.nav 직속)에 따로 두어 클리핑 자체를 없앤다. 데스크톱에서는 숨는다. */
        nav
          .filter((n) => n.children)
          .map((n) => (
            <div class="nav-sheet" data-sheet={n.key}>
