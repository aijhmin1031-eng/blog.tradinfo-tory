                  {isEn ? 'Close ✕' : '닫기 ✕'}
                </button>
              </div>
              {n.children!.map((c) => (
                <a href={c.href} class:list={['nav-sheet-item', { active: activeNav === c.key }]}>
                  <span class="nav-sheet-name">{c.name}</span>
                  {c.desc && <span class="nav-sheet-desc">{c.desc}</span>}
                </a>
              ))}
            </div>
          ))
      }
    </nav>
    <div class="nav-backdrop" aria-hidden="true"></div>

    <Ticker lang={lang} />

