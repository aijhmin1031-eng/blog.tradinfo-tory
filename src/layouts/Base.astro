---
import '../styles/global.css';
import { SITE, url, shortDateIn, todayIn, TZ_KST, canonicalUrl } from '../lib/site';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase';
import { ADSENSE_PUB_ID, adsenseOn } from '../lib/adsense';

// ★ 2026-09-05 전면 개편으로 새로 쓴 껍데기다. 그전 판은 1,080줄이었고 영문판·특집·
//   숲/창고 드롭다운과 얽혀 있었다. 옛 구역을 지우면서 참조가 125곳 끊겨 다시 썼다.
//   내비는 승인된 설계대로 **4슬롯 평면**이다 — 드롭다운이 없다.
//   경위는 `docs/redesign-2026-09.md`.

const {
  title,
  description,
  ogImage = url('/images/og-default.jpg'),
  activeNav = '',
  ogType = 'website',
} = Astro.props;

const pageDesc = description ?? SITE.description;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.taglineSub}`;

const now = new Date();
const dateLine = shortDateIn(TZ_KST, now);
const kstYear = todayIn(TZ_KST, now).slice(0, 4);
const canonical = canonicalUrl(Astro.url.pathname);
const onVercel = !!import.meta.env.VERCEL;

// 4슬롯 고정. 항목을 늘리지 않는다 — 390px 에서 네 칸이 한 줄에 들어가는 폭이 한계다.
const nav = [
  { key: 'corp', name: '기업 분석', href: url('/corp/') },
  { key: 'tools', name: '지원 도구', href: url('/tools/') },
  { key: 'numbers', name: '오늘의 지표', href: url('/numbers/') },
  { key: 'about', name: '소개', href: url('/about/') },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {adsenseOn && <meta name="google-adsense-account" content={ADSENSE_PUB_ID} />}
    {SITE.naverVerify && <meta name="naver-site-verification" content={SITE.naverVerify} />}
    {SITE.googleVerify && <meta name="google-site-verification" content={SITE.googleVerify} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gothic+A1:wght@700;800;900&family=IBM+Plex+Sans+KR:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    { onVercel && <script defer src="/_vercel/insights/script.js"></script> }
    {
      /* 방문 기록 — 기사뿐 아니라 모든 페이지에서 한 번씩.
         남기는 것은 '그날치 난수 + 경로 + 유입 도메인' 뿐이다(scripts/sql/visit_log.sql 참조).
         자정이 지나면 난수가 새로 만들어져 같은 사람을 이틀 이상 추적할 수 없다.
         RPC 가 아직 없으면(SQL 미적용) 조용히 실패하고 아무것도 깨지지 않는다.

         ★ 2026-08-26 수리: 아래 본문을 {`...`} 로 감싸 두었었다. Astro 의 <script> 안은
         **원시 텍스트**라 그 중괄호가 표현식으로 평가되지 않고 그대로 나간다. 결과가
         「블록 하나 + 템플릿 문자열 하나」라 문법 오류도 없이 조용히 아무 일도 안 했고,
         방문 기록이 8/25 도입 이후 한 건도 쌓이지 않았다. define:vars 스크립트 안에는
         **날 JS 를 그대로 쓴다.** 같은 파일의 다른 스크립트들이 그렇게 되어 있다. */
      onVercel && (
        <script define:vars={{ sbUrl: SUPABASE_URL, sbKey: SUPABASE_ANON_KEY }}>
          (function () {
            try {
              if (navigator.webdriver) return;
              var h = location.hostname;
              if (h === 'localhost' || h === '127.0.0.1') return;

              // 봇 1차 거르기(2026-08-26 신설). 여기서 거르는 것은 쓸데없는 요청을 아끼기
              // 위한 것일 뿐이고, 최종 판정은 서버 함수 log_visit 가 User-Agent 로 한다.
              // 검색엔진 렌더러는 우리 JS 를 실제로 실행하므로 이 층이 없으면 '방문자'로 잡힌다.
              var ua = (navigator.userAgent || '').toLowerCase();
              if (!ua) return;
              if (/[a-z]bot|bot\/|crawler|crawling|spider|slurp|yeti|scrapy|headless|phantom|lighthouse|inspectiontool|bingpreview|fetcher|archiver|facebookexternalhit|embedly|daumoa/.test(ua)) return;

              // 방문자 구분값은 '그날 하루'만 산다. 날짜가 바뀌면 새로 만들어진다.
              var day = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Seoul' });
              var key = 'dv:' + day;

              // 저장소를 실제로 쓸 수 있는지 먼저 확인한다(2026-08-26 보강).
              // 시크릿 모드·저장소 차단 브라우저에서는 localStorage 가 던진다. 그때 값을
              // 매번 새로 만들면 한 사람이 페이지마다 다른 방문자로 세어져 숫자가 부풀었다.
              // sessionStorage 로라도 물러서면 최소한 그 방문 내내 한 사람으로 유지된다.
              var store = null;
              try { localStorage.setItem('dv:t', '1'); localStorage.removeItem('dv:t'); store = localStorage; } catch (e) {}
              if (!store) {
                try { sessionStorage.setItem('dv:t', '1'); sessionStorage.removeItem('dv:t'); store = sessionStorage; } catch (e) {}
              }

              var id = null;
              try { id = store && store.getItem(key); } catch (e) {}
              if (!id) {
                var b = new Uint8Array(8);
                crypto.getRandomValues(b);
                id = Array.from(b, function (x) { return x.toString(16).padStart(2, '0'); }).join('');
                try {
                  if (store) {
                    store.setItem(key, id);
                    // 지난 날짜 값은 지운다 — 오래 남겨 둘 이유가 없다.
                    Object.keys(store).forEach(function (k2) {
                      if (k2.indexOf('dv:') === 0 && k2 !== key) store.removeItem(k2);
                    });
                  }
                } catch (e) {}
              }

              function send() {
                fetch(sbUrl + '/rest/v1/rpc/log_visit', {
                  method: 'POST',
                  headers: { apikey: sbKey, Authorization: 'Bearer ' + sbKey, 'Content-Type': 'application/json' },
                  body: JSON.stringify({ p_path: location.pathname, p_visitor: id, p_ref: document.referrer || '' }),
                  keepalive: true,
                }).catch(function () {});
              }

              // 사람이 실제로 화면을 본 순간에만 센다(2026-08-26 신설).
              // 미리 렌더(prerender)와 링크 미리보기는 화면에 뜨지 않은 채 스크립트만 돈다.
              // 다만 '지금 숨어 있다'고 버리지는 않는다 — 새 탭으로 연 사람도 숨은 상태로
              // 시작하므로, 보이는 순간을 기다렸다가 보낸다.
              // ★ 체류 신호 (2026-09-04 신설). User-Agent 층은 이미 한계다 —
              // log_visit 의 낱말 목록이 스무 개가 넘는데 30일간 걸린 것이 gptbot 1건뿐이었고,
              // 남은 것들은 **진짜 브라우저 UA 를 쓰는 렌더러**였다. 낱말을 더 넣어도 안 잡힌다.
              // 그래서 UA 가 아니라 행동으로 가른다: 화면을 5초 이상 보았거나 한 번이라도
              // 만졌으면 두 번째 신호를 보내 그 기록에 사람 표시를 덧칠한다.
              // **첫 기록은 그대로 남는다** — 지우는 것이 아니라 덧칠하는 것이다.
              var engaged = false;
              var seenMs = 0;
              var since = 0;
              var timer = null;

              function markEngaged() {
                if (engaged) return;
                engaged = true;
                if (timer) { clearTimeout(timer); timer = null; }
                fetch(sbUrl + '/rest/v1/rpc/mark_engaged', {
                  method: 'POST',
                  headers: { apikey: sbKey, Authorization: 'Bearer ' + sbKey, 'Content-Type': 'application/json' },
                  body: JSON.stringify({ p_path: location.pathname, p_visitor: id }),
                  keepalive: true,
                }).catch(function () {});
              }

              // 숨은 동안은 시간을 세지 않는다. 배경 탭에 5초 있었다고 읽은 것은 아니다.
              function clockOn() {
                if (engaged || since) return;
                since = Date.now();
                timer = setTimeout(markEngaged, Math.max(0, 5000 - seenMs));
              }
              function clockOff() {
                if (!since) return;
                seenMs += Date.now() - since;
                since = 0;
                if (timer) { clearTimeout(timer); timer = null; }
              }

              function watch() {
                clockOn();
                document.addEventListener('visibilitychange', function () {
                  if (document.visibilityState === 'visible') clockOn(); else clockOff();
                });
                // 한 번이라도 만졌으면 사람이다. 5초를 기다릴 것 없다.
                ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (ev) {
                  window.addEventListener(ev, markEngaged, { once: true, passive: true });
                });
              }

              function start() { send(); watch(); }

              if (document.prerendering) {
                document.addEventListener('prerenderingchange', start, { once: true });
              } else if (document.visibilityState === 'visible') {
                start();
              } else {
                document.addEventListener('visibilitychange', function onVis() {
                  if (document.visibilityState !== 'visible') return;
                  document.removeEventListener('visibilitychange', onVis);
                  start();
                });
              }
            } catch (e) {}
          })();
        </script>
      )
    }
    <slot name="head" />
  </head>

  <body>
    <header class="hd-bar">
      <div class="hd-in">
        <a class="hd-mark" href={url('/')}>도토리경제</a>
        <nav class="hd-nav" aria-label="주요 메뉴">
          {nav.map((n) => (
            <a href={n.href} class={activeNav === n.key ? 'on' : ''}>{n.name}</a>
          ))}
        </nav>
        <div class="hd-right">
          <span class="hd-date mono">{dateLine}</span>
          <a class="hd-cta" href={url('/bid-radar/')}>입찰레이더 이용</a>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="ft">
      <div class="ft-in">
        <div class="ft-src">
          금융감독원 전자공시(DART) · 한국은행 ECOS · 미국 연방준비제도 FRED ·
          금융위원회 주식시세정보 · 조달청 나라장터 · 관세청<br />
          본 사이트의 내용은 정보 제공을 목적으로 하며 투자 자문이 아닙니다.
        </div>
        <nav class="ft-nav" aria-label="하단 메뉴">
          <a href={url('/corp/')}>기업 분석</a>
          <a href={url('/tools/')}>지원 도구</a>
          <a href={url('/numbers/')}>오늘의 지표</a>
          <a href={url('/glossary/')}>용어</a>
          <a href={url('/about/')}>소개</a>
          <a href={url('/contact/')}>문의</a>
          <a href={url('/privacy/')}>개인정보</a>
        </nav>
        <div class="ft-btm">
          <span class="mono">© {kstYear} {SITE.name}</span>
          <span class="mono">dotoriecon.com</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* 승인된 설계의 조판 규약. 정본은 docs/redesign-2026-09.md 4절. */
  .hd-bar { background: #fff; border-bottom: 1px solid #e4e4de; }
  .hd-in { max-width: 1440px; margin: 0 auto; padding: 0 64px; height: 66px;
           display: flex; align-items: stretch; justify-content: space-between; }
  .hd-mark { font-family: 'Gothic A1', sans-serif; font-size: 18px; font-weight: 900;
             color: #15171a; letter-spacing: -0.4px; display: flex; align-items: center;
             text-decoration: none; margin-right: 36px; }
  .hd-nav { display: flex; align-items: stretch; gap: 26px; }
  .hd-nav a { display: flex; align-items: center; font-size: 13.5px; color: #6b7076;
              text-decoration: none; border-bottom: 2px solid transparent; }
  .hd-nav a:hover { color: #15171a; }
  .hd-nav a.on { font-family: 'Gothic A1', sans-serif; font-weight: 700; color: #15171a;
                 border-bottom-color: #16355e; }
  .hd-in > .hd-nav { margin-right: auto; }
  .hd-right { display: flex; align-items: center; gap: 18px; }
  .hd-date { font-size: 11px; color: #8e9299; }
  .hd-cta { background: #16355e; color: #fff; padding: 9px 18px; font-size: 13px;
            font-weight: 600; border-radius: 2px; text-decoration: none; }
  .ft { border-top: 1px solid #e4e4de; background: #fff; margin-top: 64px; }
  .ft-in { max-width: 1440px; margin: 0 auto; padding: 30px 64px 36px; }
  .ft-src { font-size: 12px; color: #8e9299; line-height: 1.95; }
  .ft-nav { display: flex; flex-wrap: wrap; gap: 18px; margin: 18px 0 16px; }
  .ft-nav a { font-size: 12.5px; color: #4a4f56; text-decoration: none; }
  .ft-nav a:hover { color: #16355e; }
  .ft-btm { display: flex; justify-content: space-between; font-size: 11px; color: #a8acb1;
            border-top: 1px solid #efefe9; padding-top: 14px; }
  .mono { font-family: 'IBM Plex Mono', 'IBM Plex Sans KR', monospace; font-variant-numeric: tabular-nums; }

  /* 모바일 390px — 좌우 여백 20px, 머리글 두 줄. 규약은 설계 문서와 같다. */
  @media (max-width: 720px) {
    .hd-in { height: auto; padding: 12px 20px; flex-wrap: wrap; row-gap: 10px; }
    .hd-mark { margin-right: 20px; }
    .hd-nav { gap: 16px; font-size: 12.5px; }
    .hd-nav a { font-size: 12.5px; border-bottom: none; padding-bottom: 2px; }
    .hd-right { gap: 12px; }
    .hd-cta { padding: 7px 12px; font-size: 12px; }
    .ft-in { padding: 26px 20px 30px; }
  }
</style>
