---
import '../styles/global.css';
import Ticker from '../components/Ticker.astro';
import Collab from '../components/Collab.astro';
import { TOPICS } from '../lib/topics';
import Acorn from '../components/Acorn.astro';
import { SITE, CATEGORIES, url, fmtDate, shortDateIn, shortDateEnIn, todayIn, TZ_KST, TZ_ET } from '../lib/site';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase';
import { ADSENSE_PUB_ID, adsenseOn } from '../lib/adsense';
import { T, HTML_LANG, OG_LOCALE, HREFLANG, localizedPath, type Lang } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  compact?: boolean;
  ogImage?: string;
  activeNav?: string;
  /** 본문에 구독 박스가 이미 있는 페이지(기사)는 푸터 폼을 생략해 2중 노출을 피한다 */
  footerNewsletter?: boolean;
  ogType?: 'website' | 'article';
  /** 페이지 언어. 영문판(/en/)은 'en' 을 넘긴다. */
  lang?: Lang;
  /**
   * 짝이 되는 다른 언어 페이지의 **중립 경로**(`/posts/x/` 처럼 /en 접두어 없이).
   * 넘기면 hreflang 을 **양방향**으로 걸고 언어 전환 버튼이 그 글로 간다.
   * 구글은 짝이 서로를 가리킬 때만 hreflang 을 인정하므로, 짝이 실제로 있을 때만 넘길 것.
   */
  altPath?: string;
}
const {
  title,
  description,
  compact = false,
  ogImage = url('/images/og-default.jpg'),
  activeNav = '',
  footerNewsletter = true,
  ogType = 'website',
  lang = 'ko',
  altPath,
} = Astro.props;

const t = T[lang];
const isEn = lang === 'en';
const pageDesc = description ?? t.description;

const pageTitle = title ? `${title} | ${t.siteName}` : (isEn ? `${t.siteName} | ${t.tagline}` : `${SITE.name} | ${SITE.taglineSub}`);
// 이 블로그의 기준 시간은 한국이다. 빌드가 UTC 서버에서 돌아 예전에는 하루가 밀려 나왔다.
// 미 국채·달러 지표가 '어제 값'인 이유를 읽는 분이 알 수 있도록 뉴욕 날짜를 참고로 함께 적는다.
const now = new Date();
// 날짜도 판을 따라간다. 영문 페이지에 한국어 날짜가 찍히고 있었다(2026-08-26 수리).
// isEn 은 아래에서 정해지므로 여기서는 lang 을 직접 본다.
const _isEnDate = lang === 'en';
// 한국·뉴욕 두 날짜를 **같은 형식**으로 내고 지명을 앞에 붙인다(소유주 지시 2026-08-28).
const dateLine = _isEnDate ? shortDateEnIn(TZ_KST, now) : shortDateIn(TZ_KST, now);
const etLine = _isEnDate ? shortDateEnIn(TZ_ET, now) : shortDateIn(TZ_ET, now);
const kstYear = todayIn(TZ_KST, now).slice(0, 4);
// 정본 주소는 커스텀 도메인 한 곳이다. GitHub Pages 미러도 canonical은 이 도메인을 가리켜
// 색인 신호가 둘로 갈리지 않게 한다(중복 페이지는 noindex가 아니라 canonical로 합치는 것이 권장 방식).
const CANONICAL_ORIGIN = 'https://dotoriecon.com';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalPath = (basePath && Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length)
  : Astro.url.pathname) || '/';
const canonical = new URL(canonicalPath, CANONICAL_ORIGIN).href;

// ── hreflang (2026-08-26) ────────────────────────────────────────────
// 같은 내용의 두 언어판이 **서로를 가리킬 때만** 구글이 hreflang 을 인정한다.
// 한쪽만 걸면 무시될 뿐 아니라 두 판이 중복 콘텐츠로 경쟁할 수 있다.
// 그래서 짝(altPath)이 실제로 있을 때만 내보낸다. x-default 는 한글판이다(정본).
const otherLang: Lang = isEn ? 'ko' : 'en';
const altHref = altPath ? new URL(localizedPath(altPath, otherLang), CANONICAL_ORIGIN).href : null;
const koHref = altHref ? (isEn ? altHref : canonical) : null;
const enHref = altHref ? (isEn ? canonical : altHref) : null;
// 언어 전환 버튼의 착지. 짝이 없으면 그 언어의 홈으로 보낸다(막다른 곳을 만들지 않는다).
const switchHref = url(localizedPath(altPath ?? '/', otherLang));
// 정본(Vercel) 빌드에서만 켜는 것들 — GitHub Pages 미러에는 없는 엔드포인트다.
const onVercel = !!process.env.VERCEL;

// 내비게이션은 7슬롯 고정, 특집·창고는 드롭다운(데스크톱)이 증가분을 흡수한다.
// 새 특집은 lib/topics.ts에만 추가하면 된다.
const navItems: {
  key: string;
  name: string;
  /** 좁은 화면용 짧은 라벨. 영문 내비는 다섯 칸이라 정식 라벨로는 390px 에서 460px 을
   *  차지해 마지막 칸이 잘렸다(2026-08-26 수리). 한글 라벨은 원래 짧아 필요 없다. */
  short?: string;
  href: string;
  children?: { key: string; name: string; href: string; desc?: string }[];
}[] = [
  { key: 'home', name: '오늘의 도토리', href: url('/') },
  {
    // 읽을거리(기사)는 전부 '숲' 아래로. 카테고리를 상단에 평평하게 늘어놓으면
    // 도구 모음인 창고와 같은 층으로 보여 위계가 사라진다.
    key: 'forest',
    name: '도토리 숲',
    href: url('/forest/'),
    children: [
      ...Object.values(CATEGORIES).map((c) => ({
        key: c.slug,
        name: c.name,
        href: url(`/category/${c.slug}/`),
        desc: c.desc,
      })),
      ...TOPICS.map((t) => ({ key: t.key, name: `${t.name} 특집`, href: url(t.href), desc: t.desc })),
      { key: 'story', name: '토리 이야기', href: url('/story/'), desc: '토리를 그린 카툰 연재 · 화별로 읽기' },
      { key: 'forest', name: '숲 전체 보기', href: url('/forest/'), desc: '분야·특집·최신 기사를 한 화면에서' },
    ],
  },
  {
    // 창고는 유입이 큰 코너를 위로 둔다(무료 이미지·용어 사전).
    key: 'warehouse',
    name: '도토리 창고',
    href: url('/warehouse/'),
    children: [
      { key: 'pack', name: '도토리 그림함', href: url('/pack/'), desc: '무료 이미지 나눔 · 출처 표기 시 상업적 이용 가능' },
      { key: 'glossary', name: '용어 도토리', href: url('/glossary/'), desc: '무역·경제 용어 사전' },
      { key: 'warehouse', name: '오늘의 지표', href: url('/warehouse/'), desc: '환율·금리·관련주·무역수지 대시보드' },
      { key: 'galimgil', name: '토리의 갈림길', href: url('/galimgil/'), desc: '주간 전망 연재·공개 채점 아카이브' },
      { key: 'board', name: '도토리 광장', href: url('/board/'), desc: '자유 의견·주제 제안·제보 게시판' },
      { key: 'method', name: '숫자를 다루는 방법', href: url('/method/'), desc: '데이터 출처와 검증 원칙' },
      { key: 'map', name: '블로그 지도', href: url('/map/'), desc: '전체 콘텐츠 구성을 한눈에 (매일 자동 갱신)' },
    ],
  },
  // 소개는 드롭다운 안에 두면 8항목 중 하나로 묻힌다(소유주 지시 2026-08-27로 밖으로 뺐다).
  // 「누가 쓰는가」는 처음 온 독자와 심사자가 가장 먼저 찾는 자리라 한 번에 보이는 편이 낫다.
  // 3슬롯 고정 규약을 4슬롯으로 고친 것이며, 그만큼 모바일 여백을 줄여 폭을 맞췄다(실측 355px).
  { key: 'about', name: '소개', href: url('/about/') },
];
// 영문 내비는 **세계관 용어를 쓰지 않는다**(소유주 결정 2026-08-26).
// Acorn Forest·Acorn Warehouse 는 영어권에서 유아용으로 읽힌다. 기능 이름으로 간다.
// 그리고 영문판은 「데이터 데스크」라 트래커가 기사보다 앞에 온다.
const navItemsEn: typeof navItems = [
  { key: 'home', name: T.en.navHome, href: url('/en/') },
  { key: 'tracker', name: T.en.navTracker, short: 'Tracker', href: url('/en/tracker/') },
  { key: 'analysis', name: T.en.navArticles, href: url('/en/analysis/') },
  { key: 'pack', name: T.en.navPack, short: 'Illustrations', href: url('/en/pack/') },
  { key: 'about', name: T.en.navAbout, href: url('/en/about/') },
];
const nav = isEn ? navItemsEn : navItems;

// 'about' 을 뺐다: 소개가 최상위 칸이 되면서, 남겨 두면 /about/ 에서 숲과 소개가 함께 강조된다.
const FOREST_KEYS = new Set(['forest', 'topics', 'story', ...Object.values(CATEGORIES).map((c) => c.slug), ...TOPICS.map((t) => t.key)]);
const isActive = (n: (typeof navItems)[number]) =>
  activeNav === n.key ||
  (n.children?.some((c) => c.key === activeNav) ?? false) ||
  (n.key === 'forest' && FOREST_KEYS.has(activeNav));
---

<!doctype html>
<html lang={HTML_LANG[lang]} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />

    {/* 애드센스 소유 확인·광고 게재. 게시자 ID 가 없으면 아무것도 나가지 않는다.
        구글이 요구하는 세 방법(메타 태그·코드 조각·ads.txt) 중 둘을 여기서, ads.txt 는
        `src/pages/ads.txt.ts` 가 낸다. 심사 중에도 코드가 살아 있어야 하는 경우가 있어 함께 둔다. */}
    {adsenseOn && <meta name="google-adsense-account" content={ADSENSE_PUB_ID} />}
    {adsenseOn && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUB_ID}`}
        crossorigin="anonymous"></script>
    )}
    {koHref && <link rel="alternate" hreflang={HREFLANG.ko} href={koHref} />}
    {enHref && <link rel="alternate" hreflang={HREFLANG.en} href={enHref} />}
    {koHref && <link rel="alternate" hreflang="x-default" href={koHref} />}
    {SITE.naverVerify && <meta name="naver-site-verification" content={SITE.naverVerify} />}
    {SITE.googleVerify && <meta name="google-site-verification" content={SITE.googleVerify} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {!isEn && <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@500;700;900&family=IBM+Plex+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // 테마 초기화 (FOUC 방지), localStorage 실패 시 시스템 설정 따름
      (function () {
        document.documentElement.classList.add('js');
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    {
      /* Vercel Web Analytics — 순 방문자·유입 경로(referrer)·국가·기기를 잡는다.
         자체 집계(bump_view)는 페이지 조회 수만 세고 방문자를 구분하지 못해
         "실제 외부 방문자가 있는가"에 답하지 못했다. 이 스크립트가 그 자리를 메운다.
         쿠키를 쓰지 않고 개인 식별자도 남기지 않는다.
         정본에서만 넣는다 — GH Pages 미러에는 이 엔드포인트가 없어 404가 날 뿐이다.
         **Vercel 대시보드에서 Analytics 를 켜야 실제 수집이 시작된다.** */
      onVercel && <script defer src="/_vercel/insights/script.js"></script>
    }
    {
      /* 방문 기록 — 기사뿐 아니라 모든 페이지에서 한 번씩.
         남기는 것은 '그날치 난수 + 경로 + 유입 도메인' 뿐이다(scripts/sql/visit_log.sql 참조).
         자정이 지나면 난수가 새로 만들어져 같은 사람을 이틀 이상 추적할 수 없다.
         RPC 가 아직 없으면(SQL 미적용) 조용히 실패하고 아무것도 깨지지 않는다.

         ★ 2026-08-26 수리: 아래 본문을 {`...`} 로 감싸 두었었다. Astro 의 <script> 안은
         **원시 텍스트**라 그 중괄호가 표현식으로 평가되지 않고 그대로 나간다. 결과가
         「블록 하나 + 템플릿 문자열 하나」라 문법 오류도 없이 조용히 아무 일도 안 했고,
         방문 기록이 8/25 도입 이후 한 건도 쌓이지 않았다. define:vars 스크립트 안에는
         **날 JS 를 그대로 쓴다.** 같은 파일의 다른 스크립트들이 그렇게 되어 있다. */
      onVercel && (
        <script define:vars={{ sbUrl: SUPABASE_URL, sbKey: SUPABASE_ANON_KEY }}>
          (function () {
            try {
              if (navigator.webdriver) return;
              var h = location.hostname;
              if (h === 'localhost' || h === '127.0.0.1') return;

              // 봇 1차 거르기(2026-08-26 신설). 여기서 거르는 것은 쓸데없는 요청을 아끼기
              // 위한 것일 뿐이고, 최종 판정은 서버 함수 log_visit 가 User-Agent 로 한다.
              // 검색엔진 렌더러는 우리 JS 를 실제로 실행하므로 이 층이 없으면 '방문자'로 잡힌다.
              var ua = (navigator.userAgent || '').toLowerCase();
              if (!ua) return;
              if (/[a-z]bot|bot\/|crawler|crawling|spider|slurp|yeti|scrapy|headless|phantom|lighthouse|inspectiontool|bingpreview|fetcher|archiver|facebookexternalhit|embedly|daumoa/.test(ua)) return;

              // 방문자 구분값은 '그날 하루'만 산다. 날짜가 바뀌면 새로 만들어진다.
              var day = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Seoul' });
              var key = 'dv:' + day;

              // 저장소를 실제로 쓸 수 있는지 먼저 확인한다(2026-08-26 보강).
              // 시크릿 모드·저장소 차단 브라우저에서는 localStorage 가 던진다. 그때 값을
              // 매번 새로 만들면 한 사람이 페이지마다 다른 방문자로 세어져 숫자가 부풀었다.
              // sessionStorage 로라도 물러서면 최소한 그 방문 내내 한 사람으로 유지된다.
              var store = null;
              try { localStorage.setItem('dv:t', '1'); localStorage.removeItem('dv:t'); store = localStorage; } catch (e) {}
              if (!store) {
                try { sessionStorage.setItem('dv:t', '1'); sessionStorage.removeItem('dv:t'); store = sessionStorage; } catch (e) {}
              }

              var id = null;
              try { id = store && store.getItem(key); } catch (e) {}
              if (!id) {
                var b = new Uint8Array(8);
                crypto.getRandomValues(b);
                id = Array.from(b, function (x) { return x.toString(16).padStart(2, '0'); }).join('');
                try {
                  if (store) {
                    store.setItem(key, id);
                    // 지난 날짜 값은 지운다 — 오래 남겨 둘 이유가 없다.
                    Object.keys(store).forEach(function (k2) {
                      if (k2.indexOf('dv:') === 0 && k2 !== key) store.removeItem(k2);
                    });
                  }
                } catch (e) {}
              }

              function send() {
                fetch(sbUrl + '/rest/v1/rpc/log_visit', {
                  method: 'POST',
                  headers: { apikey: sbKey, Authorization: 'Bearer ' + sbKey, 'Content-Type': 'application/json' },
                  body: JSON.stringify({ p_path: location.pathname, p_visitor: id, p_ref: document.referrer || '' }),
                  keepalive: true,
                }).catch(function () {});
              }

              // 사람이 실제로 화면을 본 순간에만 센다(2026-08-26 신설).
              // 미리 렌더(prerender)와 링크 미리보기는 화면에 뜨지 않은 채 스크립트만 돈다.
              // 다만 '지금 숨어 있다'고 버리지는 않는다 — 새 탭으로 연 사람도 숨은 상태로
              // 시작하므로, 보이는 순간을 기다렸다가 보낸다.
              if (document.prerendering) {
                document.addEventListener('prerenderingchange', send, { once: true });
              } else if (document.visibilityState === 'visible') {
                send();
              } else {
                document.addEventListener('visibilitychange', function onVis() {
                  if (document.visibilityState !== 'visible') return;
                  document.removeEventListener('visibilitychange', onVis);
                  send();
                });
              }
            } catch (e) {}
          })();
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{isEn ? 'Skip to content' : '본문 바로가기'}</a>
    <header>
      <div class="topbar">
        <div class="wrap topbar-in">
          <span class="topbar-date">
            <span title={isEn ? 'Korea Standard Time, the reference for this publication' : '한국 표준시 · 이 매체의 기준 시각'}
            >{isEn ? 'Seoul ' : '한국 '}{dateLine}</span>
            <span
              class="topbar-et"
              title={isEn
                ? 'New York local date, the reference for US equity and Treasury figures'
                : '뉴욕 현지 날짜 · 미 증시와 국채 지표의 기준'}
            >{isEn ? 'New York ' : '뉴욕 '}{etLine}</span>
          </span>
          <span class="topbar-slogan">
            {isEn ? 'Data updated each Korean morning · new analysis each US morning' : '매일 아침 7시, 새 도토리가 올라옵니다'}
          </span>
