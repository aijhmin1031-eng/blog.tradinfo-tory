---
/**
 * 기업 분석 낱장 — `/corp/<슬러그>/`. 2026-09-02 신설.
 *
 * **기사 조판(PostLayout)을 쓰지 않는 이유**는 이 페이지가 기사가 아니기 때문이다.
 * 기사는 「그날 무슨 일이 있었나」를 발행일에 못 박지만, 이 낱장은 **분기마다 다시 쓰인다.**
 * 그래서 머리에 발행일·읽기 시간 대신 **갱신일·데이터 기준일**이 오고,
 * 세 줄 요약 자리에는 **한눈 카드**(사실만)가 온다.
 *
 * 기계 인용을 노린 자리가 둘이다 — 한눈 카드의 `<dl>` 과 head 의 JSON-LD.
 * 둘은 **같은 프런트매터에서 나온다.** 베껴 들면 한쪽만 고치는 사고가 나므로 그러지 않았다.
 */
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from './Base.astro';
import Pic from '../components/Pic.astro';
import QuarterGrid from '../components/QuarterGrid.astro';
import { metaByPath } from '../lib/images';
import { dedupeSources } from '../lib/sources';
import { url, canonicalUrl } from '../lib/site';

interface Props { corp: CollectionEntry<'corps'>; headings?: { depth: number; slug: string; text: string }[] }
const { corp, headings = [] } = Astro.props;
// 차례는 본문의 실제 소제목에서 뽑는다. 손으로 적으면 본문이 바뀔 때 여기만 낡는다.
const toc = headings.filter((h) => h.depth === 2);
const d = corp.data;
const sources = dedupeSources(d.sources ?? []);

const heroMeta = d.hero ? metaByPath(d.hero) : undefined;
const heroImg = heroMeta ? (await getImage({ src: heroMeta, width: 1200, format: 'jpeg' })).src : undefined;

const fmtDate = (x: Date) =>
  `${x.getFullYear()}년 ${x.getMonth() + 1}월 ${x.getDate()}일`;

const pagePath = `/corp/${corp.id}/`;

// 기계가 읽는 자리. Article 이 아니라 **Dataset 을 함께 낸다** — 한눈 카드는 서술이 아니라
// 값의 묶음이고, 인용하는 쪽이 찾는 것도 그 값이다(`/numbers/` 에서 같은 판단을 했다).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  inLanguage: 'ko',
  dateModified: d.updated.toISOString(),
  mainEntityOfPage: canonicalUrl(pagePath),
  author: { '@type': 'Organization', name: '도토리경제' },
  about: {
    '@type': 'Corporation',
    name: d.name,
    tickerSymbol: `${d.market}:${d.stock}`,
    identifier: [
      { '@type': 'PropertyValue', propertyID: '종목코드', value: d.stock },
      { '@type': 'PropertyValue', propertyID: 'DART 고유번호', value: d.corpCode },
    ],
  },
  ...(sources.length ? { citation: sources.map((s) => `${s.org} ${s.name}`).join(', ') } : {}),
};
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `${d.name} 한눈 카드`,
  description: `${d.name}(${d.market} ${d.stock})의 공시 기준 주요 수치. ${d.dataAsOf} 기준.`,
  inLanguage: 'ko',
  dateModified: d.updated.toISOString(),
  isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: '도토리경제' },
  variableMeasured: d.glance.map((g) => ({
    '@type': 'PropertyValue',
    name: g.k,
    value: g.v,
    description: g.note,
  })),
};
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: canonicalUrl('/') },
    { '@type': 'ListItem', position: 2, name: '기업 분석', item: canonicalUrl('/corp/') },
    { '@type': 'ListItem', position: 3, name: d.name, item: canonicalUrl(pagePath) },
  ],
};
---

<Base title={d.title} description={d.description} activeNav="corp" ogImage={heroImg} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(datasetLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />

  <div class="ch">
    <div class="wrap">
      <div class="c-id">
        <span class="kick">기업 분석</span>
        <span class="c-sep"></span>
        <span class="hd c-nm">{d.name}</span>
        <span class="mono c-code">{d.stock}</span>
        {d.label && <span class="c-tag">{d.market} · {d.label}</span>}
      </div>
      <h1 class="hd c-title">{d.title}</h1>
      <p class="c-lead">{d.description}</p>
      <div class="mono c-meta">
        최종 갱신 <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time>
        <span class="c-dot">·</span> 데이터 기준 {d.dataAsOf}
      </div>
      <div class="strip">
        {d.glance.slice(0, 4).map((g) => (
          <div class="strip-c">
            <div class="strip-k">{g.k}</div>
            <div class="strip-v mono">{g.v}</div>
            <div class="strip-n">{g.note}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="wrap body-wrap">
    <aside class="toc">
      <div class="toc-h">차례</div>
      {toc.map((h, i) => (
        <a class="toc-i" href={`#${h.slug}`}>
          <span class="mono toc-n">{i + 1}</span>
          <span>{h.text.replace(/^\d+장\.\s*/, '')}</span>
        </a>
      ))}
      <p class="toc-f">정기보고서 제출 시마다 갱신합니다. 전망과 투자 판단은 제공하지 않습니다.</p>
    </aside>

    <div class="body">
      {d.quarters && (
        <section class="qsec">
          <div class="sec-k">분기 영업이익</div>
          <h2 class="hd sec-h">{d.quarters.values.length}개 분기 영업이익</h2>
          <QuarterGrid from={d.quarters.from} values={d.quarters.values} />
          <p class="qnote">
            분기보고서는 1분기부터 3분기까지만 제출되므로 4분기 값은 공시에 그대로 기재된 수치가
            아닙니다. <b>사업보고서의 연간 금액에서 3분기까지의 누적을 차감하여 산출하였습니다.</b>
          </p>
        </section>
      )}

      <div class="prose"><slot /></div>

      {d.watch && d.watch.length > 0 && (
        <section class="wsec">
          <div class="sec-k">검증</div>
          <h2 class="hd sec-h">검증 지표 및 확인 시점</h2>
          <div class="tw">
            <table class="t">
              <thead><tr><th>지표</th><th class="n">현재</th><th class="n">판별선</th><th class="n">확인 시점</th></tr></thead>
              <tbody>
                {d.watch.map((w) => (
                  <tr>
                    <td>{w.metric}</td>
                    <td class="n mono">{w.now}</td>
                    <td class="n mono">{w.line}</td>
                    <td class="n mono">{w.when}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {/* ★ 되풀이되는 문장은 본문이 아니라 조판이 든다(2026-09-06).
             「저평가·고평가 판정은 붙이지 않는다」는 보고서마다 다시 쓸 말이 아니라
             이 방의 규약이다. 본문에 두었더니 두 편에 **글자 그대로 같은 문단**이 생겼고,
             그것이 곧 자동생성 지문이 된다. 한 곳에서 한 번만 말한다. */}
      <p class="stand">
        가치평가 지표는 산출하여 제시하되 저평가·고평가 판정은 붙이지 않습니다.
        판단은 읽는 분의 몫입니다.
      </p>

      {sources.length > 0 && (
        <section class="ssec">
          <div class="sec-k">참고자료</div>
          <h2 class="hd sec-h">확인한 자료</h2>
          <ul class="slist">
            {sources.map((s) => (
              <li>
                <span class="s-org">{s.org}</span>
                {s.url ? <a class="s-nm" href={s.url} rel="noopener">{s.name}</a> : <span class="s-nm">{s.name}</span>}
                {s.note && <span class="s-note">{s.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 1440px; margin: 0 auto; padding: 0 64px; }
  .ch { background: #fff; border-bottom: 1px solid #e4e4de; padding: 52px 0 42px; }
  .c-id { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
  .kick { font-size: 10.5px; font-weight: 600; letter-spacing: 1.6px; color: #8e9299; }
  .c-sep { width: 26px; height: 1px; background: #d2d2ca; }
  .c-nm { font-size: 14px; font-weight: 800; color: #15171a; }
  .c-code { font-size: 12.5px; color: #71767d; }
  .c-tag { font-size: 11.5px; color: #71767d; border: 1px solid #e4e4de; padding: 2px 8px; }
  .c-title { font-size: 43px; line-height: 1.35; font-weight: 900; color: #15171a; margin: 0 0 26px;
             letter-spacing: -1.7px; max-width: 1060px; }
  .c-lead { font-size: 17px; line-height: 1.95; color: #2e3238; max-width: 880px; margin: 0 0 18px; }
  .c-meta { font-size: 11.5px; color: #8e9299; margin-bottom: 32px; }
  .c-dot { margin: 0 6px; }
  .strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px;
           background: #e4e4de; border-top: 1.6px solid #15171a; border-bottom: 1px solid #e4e4de; }
  .strip-c { background: #fff; padding: 17px 22px 18px; }
  .strip-k { font-size: 12px; color: #71767d; margin-bottom: 8px; }
  .strip-v { font-size: 25px; font-weight: 500; color: #15171a; letter-spacing: -0.8px; }
  .strip-n { font-size: 11.5px; color: #8e9299; margin-top: 7px; line-height: 1.65; }

  .body-wrap { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 52px;
               padding: 44px 64px 54px; align-items: start; }
  .toc { position: sticky; top: 22px; }
  .toc-h { font-size: 10.5px; font-weight: 600; letter-spacing: 1.6px; color: #8e9299; margin-bottom: 14px; }
  .toc-i { display: flex; gap: 11px; padding: 10px 0; border-bottom: 1px solid #efefe9;
           font-size: 13px; color: #4a4f56; text-decoration: none; line-height: 1.5; }
  .toc-i:hover { color: #16355e; }
  .toc-n { font-size: 11.5px; color: #a8acb1; flex: 0 0 auto; }
  .toc-f { margin-top: 22px; font-size: 11.5px; color: #8e9299; line-height: 1.85; }

  .sec-k { font-size: 11px; font-weight: 600; letter-spacing: 2.2px; color: #9a6b22; margin-bottom: 11px; }
  .sec-h { font-size: 26px; font-weight: 900; color: #15171a; letter-spacing: -0.95px;
           line-height: 1.45; margin: 0 0 18px; }
  .qsec, .wsec, .ssec { padding: 32px 0 36px; border-top: 1px solid #e4e4de; }
  .qsec:first-child { border-top: none; padding-top: 0; }
  .qnote { font-size: 14.5px; line-height: 1.95; color: #4a4f56; margin: 20px 0 0; max-width: 900px; }
  .qnote b { font-weight: 600; color: #15171a; }
  /* 상시 고지 — 본문이 아니라 조판이 드는 문장이다(반복을 한 곳으로). */
  .stand { font-size: 13px; line-height: 1.9; color: #71767d; margin: 34px 0 0;
           border-left: 3px solid #d2d2ca; padding: 2px 0 2px 16px; max-width: 900px; }
  .tw { overflow-x: auto; }
  table.t { width: 100%; border-collapse: collapse; }
  .t th { font-size: 12px; font-weight: 600; color: #71767d; text-align: left;
          padding: 0 14px 9px 0; border-bottom: 1.6px solid #15171a; white-space: nowrap; }
  .t td { font-size: 13.5px; line-height: 1.75; color: #3c4046; padding: 12px 14px 12px 0;
          border-bottom: 1px solid #eaeae4; vertical-align: top; }
  .t th.n, .t td.n { text-align: right; padding-left: 16px; }
  .t th:last-child, .t td:last-child { padding-right: 0; }
  .t tr:last-child td { border-bottom: none; }
  .slist { list-style: none; margin: 0; padding: 0; }
  .slist li { padding: 13px 0; border-bottom: 1px solid #eaeae4; font-size: 13.5px; line-height: 1.8; }
  .slist li:last-child { border-bottom: none; }
  .s-org { font-weight: 600; color: #15171a; margin-right: 10px; }
  .s-nm { color: #16355e; }
  .s-note { display: block; font-size: 12px; color: #8e9299; margin-top: 4px; }

  /* 본문 — 이 화면의 주인은 글이다. 한 줄 44자 안팎, 행간 2.05. */
  /* global.css 의 .prose 는 margin: 0 auto 라 가운데로 밀린다. 왼쪽 정렬로 되돌린다. */
  .prose { max-width: 900px; margin: 0; }
  .prose :global(h2) { font-family: 'Gothic A1', sans-serif; font-size: 26px; font-weight: 900;
                       color: #15171a; letter-spacing: -0.95px; line-height: 1.45;
                       margin: 46px 0 18px; padding-top: 34px; border-top: 1px solid #e4e4de; }
  .prose :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: none; }
  .prose :global(h3) { font-family: 'Gothic A1', sans-serif; font-size: 18px; font-weight: 800;
                       color: #15171a; margin: 32px 0 12px; }
  .prose :global(p) { font-size: 15.5px; line-height: 2.05; color: #3c4046; margin: 0 0 21px; }
  .prose :global(strong) { font-weight: 600; color: #15171a; }
  .prose :global(a) { color: #16355e; }
  .prose :global(ul), .prose :global(ol) { font-size: 15.5px; line-height: 2.05; color: #3c4046;
                                           margin: 0 0 21px; padding-left: 20px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 4px 0 26px; font-size: 13.5px; }
  .prose :global(thead th) { font-size: 12px; font-weight: 600; color: #71767d; text-align: left;
                             padding: 0 14px 9px 0; border-bottom: 1.6px solid #15171a; white-space: nowrap; }
  .prose :global(tbody td) { padding: 11px 14px 11px 0; border-bottom: 1px solid #eaeae4;
                             line-height: 1.75; vertical-align: top; }
  .prose :global(tbody tr:last-child td) { border-bottom: none; }
  .prose :global(th:last-child), .prose :global(td:last-child) { padding-right: 0; }
  .prose :global(blockquote) { border-left: 3px solid #9a6b22; padding: 4px 0 4px 20px;
                               margin: 0 0 21px; color: #4a4f56; }
  .prose :global(figure) { margin: 26px 0; }
  .prose :global(figure img) { width: 100%; height: auto; border: 1px solid #e4e4de; }
  .prose :global(figcaption) { font-size: 12px; color: #8e9299; line-height: 1.7; margin-top: 9px; }
  /* 표는 좁은 화면에서 스스로 스크롤한다. 통에 안 넣으면 문서를 밀어낸다. */
  .prose :global(table) { display: block; overflow-x: auto; white-space: nowrap; }
  .prose :global(tbody td), .prose :global(thead th) { white-space: normal; }

  .mono { font-family: 'IBM Plex Mono', 'IBM Plex Sans KR', monospace; font-variant-numeric: tabular-nums; }

  @media (max-width: 720px) {
    .wrap { padding-left: 20px; padding-right: 20px; }
    .body-wrap { grid-template-columns: minmax(0, 1fr); gap: 28px; padding: 30px 20px 40px; }
    .toc { position: static; }
    .c-title { font-size: 27px; letter-spacing: -1.1px; }
    .c-lead { font-size: 15px; }
    .sec-h { font-size: 20px; letter-spacing: -0.7px; }
    .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .strip-v { font-size: 21px; }
    .tw > table { min-width: 560px; }
    .prose :global(h2) { font-size: 20px; letter-spacing: -0.7px; }
    .prose :global(p) { font-size: 14.5px; line-height: 1.95; }
    .prose :global(table) { min-width: 100%; }
  }
</style>
