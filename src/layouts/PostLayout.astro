---
import Pic from '../components/Pic.astro';
import Base from './Base.astro';
import ThreeLines from '../components/ThreeLines.astro';
import ToriNote from '../components/ToriNote.astro';
import { CATEGORIES, url, fmtDate, SITE, readingMinutesOf } from '../lib/site';
import { getImage } from 'astro:assets';
import { heroMeta, metaByPath } from '../lib/images';
import { dedupeSources } from '../lib/sources';
import { TOPICS } from '../lib/topics';
import Comments from '../components/Comments.astro';
import CommentThread from '../components/CommentThread.astro';
import { NATIVE_COMMENTS_LIVE } from '../lib/comments';
import Collab from '../components/Collab.astro';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  related: CollectionEntry<'posts'>[];
  newer?: CollectionEntry<'posts'>;
  older?: CollectionEntry<'posts'>;
}
const { post, related, newer, older } = Astro.props;
const { title, description, category, pubDate, place, three, toriNote, dataAsOf, hero } = post.data;
// 기사가 실제로 쓴 원자료. 없으면 자료 블록도 citation 도 만들지 않는다 — 지어내지 않기 위해서다.
const sources = dedupeSources(post.data.sources ?? []);
const readingMinutes = readingMinutesOf(post.body ?? '');
// 조회수: 배포 주소(GitHub Pages·Vercel)와 무관한 논리 경로로 집계한다
const viewPath = `/posts/${(post as { slug?: string; id: string }).slug ?? post.id}/`;
const cat = CATEGORIES[category];
// og:image·JSON-LD 는 URL 문자열이 필요하다. 최적화된 파일의 주소를 여기서 한 번 만든다.
// OG 는 호환성 때문에 JPEG 로 뽑는다(일부 수집기가 WebP 를 못 읽는다).
const heroSrc = heroMeta(category, hero);
// 토리 초상은 로고(JSON-LD)와 본문 양쪽에서 쓰인다. 빌드 주소를 한 번 만들어 함께 쓴다.
const toriMeta = metaByPath('tori.jpg');
const toriBuilt = toriMeta ? await getImage({ src: toriMeta, width: 180, height: 180 }) : null;
const toriSrc = toriBuilt ? toriBuilt.src : url('/images/og-default.jpg');
const heroOg = heroSrc ? await getImage({ src: heroSrc, width: 1200, height: 675, format: 'jpeg' }) : null;
const heroImg = heroOg ? heroOg.src : url('/images/og-default.jpg');
// 이 기사가 속한 특집, 기사→특집 역링크 배너 (특집 편성 기준 §3 상호 링크)
const postTopics = TOPICS.filter((t) => (post.data.topics ?? []).includes(t.key));

// 경제·금융은 검색엔진이 신뢰도를 특별히 엄격하게 보는 영역(YMYL)이다.
// 익명은 유지하되, 쓰는 주체(토리)와 발행 주체·데이터 출처·검증 절차를 명시해 신호를 남긴다.
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).toString() : p);
const authorLd = {
  '@type': 'Person',
  name: '토리',
  description: '도토리경제의 데이터 브리핑을 쓰는 다람쥐 이코노미스트. 확인한 수치만 적는다.',
  url: abs(url('/about/')),
  knowsAbout: ['무역', '환율', '금리', '관세', '수출입 통계'],
};
const publisherLd = {
  '@type': 'Organization',
  name: SITE.name,
  url: abs(url('/')),
  logo: { '@type': 'ImageObject', url: abs(toriSrc) },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: abs(heroImg),
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  inLanguage: 'ko-KR',
  articleSection: cat.name,
  author: authorLd,
  publisher: publisherLd,
  mainEntityOfPage: { '@type': 'WebPage', '@id': abs(url(viewPath)) },
  isAccessibleForFree: true,
  // citation 은 이 기사가 실제로 인용한 것만 적는다. 전에는 104편 전부 같은 문자열이 박혀 있었다.
  ...(sources.length
    ? { citation: sources.map((s) => `${s.org} ${s.name}`).join(', ') }
    : {}),
};

const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '도토리경제', item: abs(url('/')) },
    { '@type': 'ListItem', position: 2, name: '도토리 숲', item: abs(url('/forest/')) },
    { '@type': 'ListItem', position: 3, name: cat.name, item: abs(url(`/category/${cat.slug}/`)) },
    { '@type': 'ListItem', position: 4, name: title },
  ],
};
---

<Base
  title={title}
  description={description}
  compact
  activeNav={cat.slug}
  footerNewsletter={false}
  ogImage={heroImg}
  ogType="article"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
  <div class="progress" id="read-progress" aria-hidden="true"></div>

  <article class="wrap">
    <header class="post-head">
      <div class:list={['kicker', cat.cls]}>{cat.name}</div>
      <h1 class="post-title serif">{title}</h1>
      <p class="post-dek">{description}</p>
      <div class="post-byline">
        <img
          src={toriSrc}
          alt="토리"
          width="26"
          height="26"
          class="byline-tori"
        />
        <span class="byline-name">토리</span>
        <span class="sep"></span>
        <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
        <span class="sep"></span>
        <span>{readingMinutes}분 읽기</span>
        {
          dataAsOf && (
            <>
              <span class="sep" />
              <span class="mono asof">데이터 기준 {dataAsOf}</span>
            </>
          )
        }
        <span
          class="view-chip"
          hidden
          data-sb-url={SUPABASE_URL}
          data-sb-key={SUPABASE_ANON_KEY}
          data-path={viewPath}
        ><span class="sep"></span><span>조회 <span class="mono view-n"></span></span></span>
      </div>
      {place && <div class="post-place">오늘은 <strong>{place}</strong>에 다녀왔습니다.</div>}
    </header>

    <figure class="post-hero">
      <Pic category={category} hero={hero} alt={`${title} 대표 이미지`} width={1200} height={675} eager />
    </figure>

    {three && <ThreeLines what={three.what} why={three.why} next={three.next} />}

    <div class="prose">
      <slot />
    </div>

    {
      sources.length > 0 && (
        <section class="sources" aria-labelledby="sources-h">
          <h2 id="sources-h" class="sources-h">자료</h2>
          <ul class="sources-list">
            {sources.map((s) => (
              <li>
                <span class="src-org">{s.org}</span>
                {s.url ? (
                  <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
                ) : (
                  <span>{s.name}</span>
                )}
                {s.note && <span class="src-note-inline">{s.note}</span>}
              </li>
            ))}
          </ul>
          <p class="sources-foot">
            수치는 발표 기관 원자료를 파이프라인이 매일 자동 수집한 값이다.
            기관 사정으로 사후 정정될 수 있으며, <strong>투자 자문이 아니다.</strong>
          </p>
        </section>
      )
    }

    {
      postTopics.map((t) => (
        <a class="topic-banner" href={url(t.href)}>
          <span class="tb-kicker mono">SPECIAL</span>
          <span class="tb-body">
            <span class="tb-name serif">특집, {t.name}</span>
            <span class="tb-desc">{t.desc}</span>
          </span>
          <span class="tb-arrow" aria-hidden="true">→</span>
        </a>
      ))
    }

    {toriNote && <ToriNote text={toriNote} />}

    <Collab source="post" variant="inline" />

    {
      related.length > 0 && (
        <section class="related">
          <h2 class="related-title serif">함께 주우면 좋은 도토리</h2>
          {related.map((r) => (
            <a class="related-row" href={url(`/posts/${r.id}/`)}>
              <span class="related-thumb">
                <Pic category={r.data.category} hero={r.data.hero} width={96} height={54} />
              </span>
              <span class="related-name">{r.data.title}</span>
              <span class:list={['chip', CATEGORIES[r.data.category].cls]}>
                {CATEGORIES[r.data.category].name}
              </span>
            </a>
          ))}
        </section>
      )
    }
    {
      (older || newer) && (
        <nav class="pn" aria-label="이전·다음 기사">
          {older ? (
            <a class="pn-item" href={url(`/posts/${older.id}/`)} rel="prev">
              <span class="pn-label">← 이전 도토리</span>
              <span class="pn-title serif">{older.data.title}</span>
            </a>
          ) : (
            <span class="pn-item pn-empty" />
          )}
          {newer ? (
            <a class="pn-item pn-next" href={url(`/posts/${newer.id}/`)} rel="next">
              <span class="pn-label">다음 도토리 →</span>
              <span class="pn-title serif">{newer.data.title}</span>
            </a>
          ) : (
            <span class="pn-item pn-empty" />
          )}
        </nav>
      )
    }

    {NATIVE_COMMENTS_LIVE ? <CommentThread term={viewPath} /> : <Comments term={viewPath} />}
  </article>

  <script>
    const bar = document.getElementById('read-progress');
    if (bar) {
      const onScroll = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        bar.style.width = `${max > 0 ? (h.scrollTop / max) * 100 : 0}%`;
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    // 조회수 집계·표시. 자동화 브라우저와 로컬 미리보기는 세지 않는다.
    const chip = document.querySelector<HTMLElement>('.view-chip');
    if (chip && !navigator.webdriver && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
      fetch(`${chip.dataset.sbUrl}/rest/v1/rpc/bump_view`, {
        method: 'POST',
        headers: {
          apikey: chip.dataset.sbKey!,
          Authorization: `Bearer ${chip.dataset.sbKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ p_path: chip.dataset.path }),
      })
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((n: number) => {
          chip.querySelector('.view-n')!.textContent = Number(n).toLocaleString('ko-KR');
          chip.hidden = false;
        })
        .catch(() => {});
    }
  </script>
</Base>

<style is:global>
  /* 자료 각주 — 기사 끝에서 출처·표본·한계를 밝히는 자리.
     숫자를 쓴 기사는 독자가 원자료로 되짚어 갈 수 있어야 한다. */
  .prose .src-note {
    margin-top: 34px;
    padding: 14px 16px;
    border-top: 1px solid var(--hair);
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .prose .src-note a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose .src-note a:hover { color: var(--accent); }
  .prose .src-note strong { color: var(--body-ink); font-weight: 600; }
</style>

<style>
  /* 「자료」 블록 — 기사가 쓴 원자료로 독자가 되짚어 갈 수 있는 자리.
     본문 뒤, 특집 배너 앞. 눈에 띄되 본문을 방해하지 않는 무게로. */
  .sources {
    max-width: var(--measure);
    margin: 44px auto 0;
    padding: 18px 20px;
    border: 1px solid var(--hair);
    border-radius: 3px;
    background: var(--grid-b);
  }
  .sources-h {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin: 0 0 10px;
  }
  .sources-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .sources-list li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--sub);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
  }
  .src-org {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--muted);
    border: 1px solid var(--hair);
    background: var(--grid-b);
    border-radius: 2px;
    padding: 1px 6px;
    white-space: nowrap;
  }
  .sources-list a {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sources-list a:hover { color: var(--brand-hover); }
  .src-note-inline { font-size: 0.82rem; color: var(--muted); }
  .sources-foot {
    margin: 12px 0 0;
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--muted);
  }
  .sources-foot strong { color: var(--sub); font-weight: 600; }

  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: var(--accent);
    z-index: 100;
  }
  .post-head {
    max-width: 820px;
    margin: 0 auto;
    padding: 52px 0 30px 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .post-title {
    font-size: clamp(27px, 5vw, 38px);
    font-weight: 900;
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: pretty;
  }
  .post-dek { font-size: 16.5px; color: var(--sub); line-height: 1.75; margin: 0; }
  .post-byline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 11px;
    font-size: 12px;
    color: var(--sub);
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    padding: 11px 0;
  }
  .byline-tori {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 22%;
    border: 1px solid var(--hair);
  }
  .byline-name { font-weight: 700; color: var(--ink); }
  .sep { width: 1px; height: 11px; background: var(--hair); }
  .view-chip { display: inline-flex; align-items: center; gap: 11px; }
  .view-chip[hidden] { display: none; }
  .related-thumb { display: block; width: 96px; aspect-ratio: 16 / 9; border: 1px solid var(--hair); background: var(--surface); overflow: hidden; }
  .related-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .pn { max-width: var(--w-prose); margin: 40px auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pn-item { display: flex; flex-direction: column; gap: 7px; border: 1px solid var(--line); border-radius: 12px; padding: 15px 18px; min-width: 0; }
  .pn-item:hover { border-color: var(--accent); }
  .pn-empty { border: none; }
  .pn-next { text-align: right; }
  .pn-label { font-size: 11px; font-weight: 700; color: var(--muted); letter-spacing: 0.03em; }
  .pn-item:hover .pn-label { color: var(--accent); }
  .pn-title { font-size: 14.5px; font-weight: 700; color: var(--ink); line-height: 1.5; word-break: keep-all; }
  @media (max-width: 640px) {
    .pn { grid-template-columns: 1fr; }
    .pn-next { text-align: left; }
    .pn-empty { display: none; }
  }
  .asof { font-size: 10.5px; color: var(--muted); }
  .post-place { font-size: 13.5px; color: var(--sub); }
  .post-place strong { color: var(--ink); }

  .post-hero {
    max-width: 900px;
    margin: 8px auto 0 auto;
    border: 1px solid var(--hair);
    background: var(--surface);
    overflow: hidden;
  }
  .post-hero img { display: block; width: 100%; height: auto; }

  article :global(.three) { max-width: 820px; margin-left: auto; margin-right: auto; }

  .topic-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: var(--w-prose);
    margin: 44px auto 0 auto;
    background: var(--surface);
    border: 1px solid var(--hair);
    border-left: 3px solid var(--accent);
    padding: 16px 20px;
    text-decoration: none;
  }
  .tb-kicker { font-size: 10px; letter-spacing: 0.1em; color: var(--accent); flex: none; }
  .tb-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .tb-name { font-size: 15.5px; font-weight: 700; color: var(--ink); }
  .topic-banner:hover .tb-name { color: var(--accent); }
  .tb-desc { font-size: 12.5px; color: var(--sub); word-break: keep-all; }
  .tb-arrow { margin-left: auto; color: var(--muted); flex: none; }
  .related { max-width: var(--w-prose); margin: 56px auto 0 auto; }
  .related-title {
    font-size: 17px;
    font-weight: 900;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 9px;
    margin: 0 0 4px 0;
  }
  .related-row {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--hair2);
    font-size: 14.5px;
    font-weight: 500;
  }
</style>
