---
import Base from './Base.astro';
import ThreeLines from '../components/ThreeLines.astro';
import ToriNote from '../components/ToriNote.astro';
import { CATEGORIES, url, fmtDate, heroFor, SITE } from '../lib/site';
import { TOPICS } from '../lib/topics';
import Comments from '../components/Comments.astro';
import CommentThread from '../components/CommentThread.astro';
import { NATIVE_COMMENTS_LIVE } from '../lib/comments';
import Newsletter from '../components/Newsletter.astro';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  related: CollectionEntry<'posts'>[];
}
const { post, related } = Astro.props;
const { title, description, category, pubDate, readingMinutes, place, three, toriNote, dataAsOf, hero } =
  post.data;
// 조회수: 배포 주소(GitHub Pages·Vercel)와 무관한 논리 경로로 집계한다
const viewPath = `/posts/${(post as { slug?: string; id: string }).slug ?? post.id}/`;
const cat = CATEGORIES[category];
const heroImg = heroFor(category, hero);
// 이 기사가 속한 특집, 기사→특집 역링크 배너 (특집 편성 기준 §3 상호 링크)
const postTopics = TOPICS.filter((t) => (post.data.topics ?? []).includes(t.key));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
};
---

<Base title={title} description={description} compact activeNav={cat.slug} footerNewsletter={false}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="progress" id="read-progress" aria-hidden="true"></div>

  <article class="wrap">
    <header class="post-head">
      <div class:list={['kicker', cat.cls]}>{cat.name}</div>
      <h1 class="post-title serif">{title}</h1>
      <p class="post-dek">{description}</p>
      <div class="post-byline">
        <img
          src={url('/images/tori/tori.jpg')}
          alt="토리"
          width="26"
          height="26"
          class="byline-tori"
        />
        <span class="byline-name">토리</span>
        <span class="sep"></span>
        <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
        <span class="sep"></span>
        <span>{readingMinutes}분 읽기</span>
        {
          dataAsOf && (
            <>
              <span class="sep" />
              <span class="mono asof">데이터 기준 {dataAsOf}</span>
            </>
          )
        }
        <span
          class="view-chip"
          hidden
          data-sb-url={SUPABASE_URL}
          data-sb-key={SUPABASE_ANON_KEY}
          data-path={viewPath}
        ><span class="sep"></span><span>조회 <span class="mono view-n"></span></span></span>
      </div>
      {place && <div class="post-place">오늘은 <strong>{place}</strong>에 다녀왔습니다.</div>}
    </header>

    <figure class="post-hero">
      <img src={heroImg} alt={`${title} 대표 이미지`} width="1200" height="675" fetchpriority="high" />
    </figure>

    {three && <ThreeLines what={three.what} why={three.why} next={three.next} />}

    <div class="prose">
      <slot />
    </div>

    {
      postTopics.map((t) => (
        <a class="topic-banner" href={url(t.href)}>
          <span class="tb-kicker mono">SPECIAL</span>
          <span class="tb-body">
            <span class="tb-name serif">특집, {t.name}</span>
            <span class="tb-desc">{t.desc}</span>
          </span>
          <span class="tb-arrow" aria-hidden="true">→</span>
        </a>
      ))
    }

    {toriNote && <ToriNote text={toriNote} />}

    <Newsletter source="post" variant="inline" />

    {
      related.length > 0 && (
        <section class="related">
          <h2 class="related-title serif">함께 주우면 좋은 도토리</h2>
          {related.map((r) => (
            <a class="related-row" href={url(`/posts/${r.id}/`)}>
              <span class="related-thumb">
                <img src={heroFor(r.data.category, r.data.hero)} alt="" width="96" height="54" loading="lazy" />
              </span>
              <span class="related-name">{r.data.title}</span>
              <span class:list={['chip', CATEGORIES[r.data.category].cls]}>
                {CATEGORIES[r.data.category].name}
              </span>
            </a>
          ))}
        </section>
      )
    }
    {NATIVE_COMMENTS_LIVE ? <CommentThread term={viewPath} /> : <Comments term={viewPath} />}
  </article>

  <script>
    const bar = document.getElementById('read-progress');
    if (bar) {
      const onScroll = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        bar.style.width = `${max > 0 ? (h.scrollTop / max) * 100 : 0}%`;
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    // 조회수 집계·표시. 자동화 브라우저와 로컬 미리보기는 세지 않는다.
    const chip = document.querySelector<HTMLElement>('.view-chip');
    if (chip && !navigator.webdriver && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
      fetch(`${chip.dataset.sbUrl}/rest/v1/rpc/bump_view`, {
        method: 'POST',
        headers: {
          apikey: chip.dataset.sbKey!,
          Authorization: `Bearer ${chip.dataset.sbKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ p_path: chip.dataset.path }),
      })
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((n: number) => {
          chip.querySelector('.view-n')!.textContent = Number(n).toLocaleString('ko-KR');
          chip.hidden = false;
        })
        .catch(() => {});
    }
  </script>
</Base>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: var(--accent);
    z-index: 100;
  }
  .post-head {
    max-width: 820px;
    margin: 0 auto;
    padding: 52px 0 30px 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .post-title {
    font-size: clamp(27px, 5vw, 38px);
    font-weight: 900;
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: pretty;
  }
  .post-dek { font-size: 16.5px; color: var(--sub); line-height: 1.75; margin: 0; }
  .post-byline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 11px;
    font-size: 12px;
    color: var(--sub);
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    padding: 11px 0;
  }
  .byline-tori {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 22%;
    border: 1px solid var(--hair);
  }
  .byline-name { font-weight: 700; color: var(--ink); }
  .sep { width: 1px; height: 11px; background: var(--hair); }
  .view-chip { display: inline-flex; align-items: center; gap: 11px; }
  .view-chip[hidden] { display: none; }
  .related-thumb { display: block; width: 96px; aspect-ratio: 16 / 9; border: 1px solid var(--hair); background: var(--surface); overflow: hidden; }
  .related-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .asof { font-size: 10.5px; color: var(--muted); }
  .post-place { font-size: 13.5px; color: var(--sub); }
  .post-place strong { color: var(--ink); }

  .post-hero {
    max-width: 900px;
    margin: 8px auto 0 auto;
    border: 1px solid var(--hair);
    background: var(--surface);
    overflow: hidden;
  }
  .post-hero img { display: block; width: 100%; height: auto; }

  article :global(.three) { max-width: 820px; margin-left: auto; margin-right: auto; }

  .topic-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: var(--w-prose);
    margin: 44px auto 0 auto;
    background: var(--surface);
    border: 1px solid var(--hair);
    border-left: 3px solid var(--accent);
    padding: 16px 20px;
    text-decoration: none;
  }
  .tb-kicker { font-size: 10px; letter-spacing: 0.1em; color: var(--accent); flex: none; }
  .tb-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .tb-name { font-size: 15.5px; font-weight: 700; color: var(--ink); }
  .topic-banner:hover .tb-name { color: var(--accent); }
  .tb-desc { font-size: 12.5px; color: var(--sub); word-break: keep-all; }
  .tb-arrow { margin-left: auto; color: var(--muted); flex: none; }
  .related { max-width: var(--w-prose); margin: 56px auto 0 auto; }
  .related-title {
    font-size: 17px;
    font-weight: 900;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 9px;
    margin: 0 0 4px 0;
  }
  .related-row {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--hair2);
    font-size: 14.5px;
    font-weight: 500;
  }
</style>
